# Scientific expression evaluator for the Xenon IDE.
# Edit `expression` and `degrees_mode` at the bottom of this file.

# App metadata and default geometry.
const APP_TITLE = "Calculator"
const APP_DEFAULT_WIDTH = 240
const APP_DEFAULT_HEIGHT = 190

# Model and state.
var calculator_window: graphics::Window
var calculator_clipboard: string
var calculator_selected_all: bool
var calculator_number_text: string

enum class FunctionCode {
	NONE,
	SIN,
	COS,
	TAN,
	ASIN,
	ACOS,
	ATAN,
	SQRT,
	POW
}

enum class ErrorCode {
	NONE,
	EXPECTED_VALUE,
	MALFORMED_NUM,
	UNK_IDENT,
	EXPECTED_PR_OR_COMMA,
	ZERO_DIV_OR_MOD,
	DOMAIN_ERROR,
	UNEXPECTED_TRAIL
}

enum class CalculatorMode {
	STANDARD,
	SCIENTIFIC,
	PROGRAMMER,
	GRAPHING,
	CURRENCY,
	UNIT_CONVERSION,
	HISTORY
}

fn is_whitespace(value: char) bool {
	return value == ' ' || value == 9 || value == 10 || value == 13
}

fn is_digit(value: char) bool {
	return value >= '0' && value <= '9'
}

fn is_letter(value: char) bool {
	return (value >= 'A' && value <= 'Z') || (value >= 'a' && value <= 'z')
}

fn is_identifier_char(value: char) bool {
	return is_letter(value) || is_digit(value) || value == '_'
}

fn is_integral(value: float) bool {
	if (value < -2147483648.0 || value >= 2147483648.0) {
		return false
	}
	return (float)((int)value) == value
}

fn peek_code(text: string, position: int) int {
	if (position < 0 || position >= xestring::strlen(text)) {
		return 0
	}
	return (int)(text[position])
}

proc skip_whitespace(text: string, position: int*) {
	var scanning: bool
	var length: int

	scanning = true
	length = xestring::strlen(text)

	while (scanning) {
		if (*position >= length) {
			scanning = false
		}
		else {
			if (is_whitespace(text[*position])) {
				*position += 1
			}
			else {
				scanning = false
			}
		}
	}
}

fn match_name(text: string, position: int*, expected: string) bool {
	var start: int
	var offset: int
	var text_length: int
	var expected_length: int

	start = *position
	offset = 0
	text_length = xestring::strlen(text)
	expected_length = xestring::strlen(expected)

	if (start + expected_length > text_length) {
		return false
	}

	while (offset < expected_length) {
		if ((int)(text[start + offset]) != (int)(expected[offset])) {
			return false
		}
		offset += 1
	}

	if (start + expected_length < text_length) {
		if (is_identifier_char(text[start + expected_length])) {
			return false
		}
	}

	*position = start + expected_length
	return true
}

proc set_error(error_code: int*, error_position: int*, code: int, position: int) {
	if (*error_code == 0) {
		*error_code = code
		*error_position = position
	}
}

fn read_operator_code(text: string, position: int) int {
	var code: int
	code = peek_code(text, position)

	switch (code) {
		case '+' { return 1 }
		case '-' { return 2 }
		case '*' {
			if (peek_code(text, position + 1) == '*') { return 6 }
			return 3
		}
		case '/' { return 4 }
		case '%' { return 5 }
	}

	return 0
}

fn operator_precedence(code: int) int {
	if (code == 1 || code == 2) {
		return 10
	}
	elseif (code == 3 || code == 4 || code == 5) {
		return 20
	}
	elseif (code == 6) {
		return 30
	}
	return 0
}

fn apply_function(function_code: int, first: float, second: float, degrees_mode: bool, error_code: int*, error_position: int*, function_position: int) float {
	var angle: float
	var result: float

	angle = first
	if (!degrees_mode) {
		angle = first * 180.0 / math::pi
	}

	if (function_code == FunctionCode.SIN) {
		return math::sin(angle)
	}
	elseif (function_code == FunctionCode.COS) {
		return math::cos(angle)
	}
	elseif (function_code == FunctionCode.TAN) {
		return math::tan(angle)
	}
	elseif (function_code == FunctionCode.ASIN || function_code == FunctionCode.ACOS) {
		if (first < -1.0 || first > 1.0) {
			call set_error(error_code, error_position, 6, function_position)
			return 0.0
		}

		if (function_code == FunctionCode.ASIN) {
			result = math::asin(first)
		}
		else {
			result = math::acos(first)
		}

		if (!degrees_mode) {
			result = result * math::pi / 180.0
		}
		return result
	}
	elseif (function_code == FunctionCode.ATAN) {
		result = math::atan(first)
		if (!degrees_mode) {
			result = result * math::pi / 180.0
		}
		return result
	}
	elseif (function_code == FunctionCode.SQRT) {
		if (first < 0.0) {
			call set_error(error_code, error_position, 6, function_position)
			return 0.0
		}
		return math::sqrt(first)
	}
	elseif (function_code == FunctionCode.POW) {
		if (first == 0.0 && second < 0.0) {
			call set_error(error_code, error_position, 6, function_position)
			return 0.0
		}
		if (first < 0.0 && !is_integral(second)) {
			call set_error(error_code, error_position, 6, function_position)
			return 0.0
		}
		return math::pow(first, second)
	}

	call set_error(error_code, error_position, 3, function_position)
	return 0.0
}

fn parse_expression(text: string, position: int*, minimum_precedence: int, degrees_mode: bool, error_code: int*, error_position: int*) float {
	var left: float
	var right: float
	var first_argument: float
	var second_argument: float
	var divisor: float
	var start: int
	var operator_position: int
	var current_code: int
	var operator_code: int
	var precedence: int
	var right_precedence: int
	var function_code: int
	var sign_code: int
	var has_digit: bool
	var has_decimal: bool
	var scanning_number: bool
	var scanning_identifier: bool
	var scanning_operators: bool
	var matched_constant: bool
	var postfix_percentage: bool
	var lookahead_position: int
	var lookahead_code: int

	call skip_whitespace(text, position)
	start = *position
	current_code = peek_code(text, *position)

	if (current_code == 0) {
		call set_error(error_code, error_position, 1, *position)
		return 0.0
	}

	if (current_code == '+' || current_code == '-') {
		sign_code = current_code
		*position += 1
		left = parse_expression(text, position, 25, degrees_mode, error_code, error_position)
		if (sign_code == '-') {
			left = -left
		}
	}
	elseif ((current_code >= '0' && current_code <= '9') || current_code == '.') {
		left = 0.0
		divisor = 1.0
		has_digit = false
		has_decimal = false
		scanning_number = true

		while (scanning_number) {
			current_code = peek_code(text, *position)
			if (current_code >= '0' && current_code <= '9') {
				has_digit = true
				if (has_decimal) {
					divisor *= 10.0
					left += (float)(current_code - '0') / divisor
				}
				else {
					left = left * 10.0 + (float)(current_code - '0')
				}
				*position += 1
			}
			elseif (current_code == '.') {
				if (has_decimal) {
					call set_error(error_code, error_position, 2, *position)
					return 0.0
				}
				has_decimal = true
				*position += 1
			}
			else {
				scanning_number = false
			}
		}

		if (!has_digit) {
			call set_error(error_code, error_position, 2, start)
			return 0.0
		}
	}
	elseif (current_code == '(') {
		*position += 1
		left = parse_expression(text, position, 0, degrees_mode, error_code, error_position)
		if (*error_code != 0) {
			return 0.0
		}
		call skip_whitespace(text, position)
		if (peek_code(text, *position) != ')') {
			call set_error(error_code, error_position, 4, *position)
			return 0.0
		}
		*position += 1
	}
	elseif (is_letter(text[*position])) {
		function_code = 0
		matched_constant = false

		if (match_name(text, position, "pi")) {
			left = math::pi
			matched_constant = true
		}
		elseif (match_name(text, position, "e")) {
			left = math::e
			matched_constant = true
		}
		elseif (match_name(text, position, "sin")) {
			function_code = FunctionCode.SIN
		}
		elseif (match_name(text, position, "cos")) {
			function_code = FunctionCode.COS
		}
		elseif (match_name(text, position, "tan")) {
			function_code = FunctionCode.TAN
		}
		elseif (match_name(text, position, "asin")) {
			function_code = FunctionCode.ASIN
		}
		elseif (match_name(text, position, "acos")) {
			function_code = FunctionCode.ACOS
		}
		elseif (match_name(text, position, "atan")) {
			function_code = FunctionCode.ATAN
		}
		elseif (match_name(text, position, "sqrt")) {
			function_code = FunctionCode.SQRT
		}
		elseif (match_name(text, position, "pow")) {
			function_code = FunctionCode.POW
		}
		else {
			scanning_identifier = true
			while (scanning_identifier) {
				if (peek_code(text, *position) == 0) {
					scanning_identifier = false
				}
				else {
					if (is_identifier_char(text[*position])) {
						*position += 1
					}
					else {
						scanning_identifier = false
					}
				}
			}
			call set_error(error_code, error_position, 3, start)
			return 0.0
		}

		if (!matched_constant) {
			call skip_whitespace(text, position)
			if (peek_code(text, *position) != '(') {
				call set_error(error_code, error_position, 4, *position)
				return 0.0
			}
			*position += 1

			first_argument = parse_expression(text, position, 0, degrees_mode, error_code, error_position)
			if (*error_code != 0) {
				return 0.0
			}

			second_argument = 0.0
			if (function_code == FunctionCode.POW) {
				call skip_whitespace(text, position)
				if (peek_code(text, *position) != ',') {
					call set_error(error_code, error_position, 4, *position)
					return 0.0
				}
				*position += 1
				second_argument = parse_expression(text, position, 0, degrees_mode, error_code, error_position)
				if (*error_code != 0) {
					return 0.0
				}
			}

			call skip_whitespace(text, position)
			if (peek_code(text, *position) != ')') {
				call set_error(error_code, error_position, 4, *position)
				return 0.0
			}
			*position += 1

			left = apply_function(function_code, first_argument, second_argument, degrees_mode, error_code, error_position, start)
		}
	}
	else {
		call set_error(error_code, error_position, 1, start)
		return 0.0
	}

	if (*error_code != 0) {
		return 0.0
	}

	scanning_operators = true
	while (scanning_operators) {
		call skip_whitespace(text, position)
		operator_position = *position
		postfix_percentage = false

		if (peek_code(text, *position) == 37) {
			lookahead_position = *position + 1
			while (lookahead_position < xestring::strlen(text) && is_whitespace(text[lookahead_position])) {
				lookahead_position += 1
			}
			lookahead_code = peek_code(text, lookahead_position)
			if (!((lookahead_code >= 48 && lookahead_code <= 57) || lookahead_code == 46 || lookahead_code == 40 || (lookahead_code >= 97 && lookahead_code <= 122))) {
				left /= 100.0
				*position += 1
				postfix_percentage = true
			}
		}

		if (!postfix_percentage) {
			operator_code = read_operator_code(text, *position)
			precedence = operator_precedence(operator_code)

			if (precedence == 0 || precedence < minimum_precedence) {
				scanning_operators = false
			}
			else {
				if (operator_code == 6) {
					*position += 2
					right_precedence = precedence
				}
				else {
					*position += 1
					right_precedence = precedence + 1
				}

				right = parse_expression(text, position, right_precedence, degrees_mode, error_code, error_position)
				if (*error_code != 0) {
					return 0.0
				}

				if (operator_code == 1) {
					left += right
				}
				elseif (operator_code == 2) {
					left -= right
				}
				elseif (operator_code == 3) {
					left *= right
				}
				elseif (operator_code == 4 || operator_code == 5) {
					if (right == 0.0) {
						call set_error(error_code, error_position, 5, operator_position)
						return 0.0
					}
					if (operator_code == 4) {
						left /= right
					}
					else {
						left %= right
					}
				}
				else {
					if (left == 0.0 && right < 0.0) {
						call set_error(error_code, error_position, 6, operator_position)
						return 0.0
					}
					if (left < 0.0 && !is_integral(right)) {
						call set_error(error_code, error_position, 6, operator_position)
						return 0.0
					}
					left = math::pow(left, right)
				}
			}
		}
	}

	return left
}

fn evaluate_expression(text: string, degrees_mode: bool, error_code: int*, error_position: int*) float {
	var result: float

	*error_code = 0
	*error_position = 0

	call skip_whitespace(text, error_position)
	if (*error_position >= xestring::strlen(text)) {
		call set_error(error_code, error_position, 1, *error_position)
		return 0.0
	}

	result = parse_expression(text, error_position, 0, degrees_mode, error_code, error_position)
	if (*error_code != 0) {
		return 0.0
	}

	call skip_whitespace(text, error_position)
	if (*error_position != xestring::strlen(text)) {
		call set_error(error_code, error_position, 7, *error_position)
		return 0.0
	}

	return result
}

proc print_calculator_error(error_code: int, error_position: int) {
	out << "Error at " << error_position + 1 << ": "

	if (error_code == ErrorCode.EXPECTED_VALUE) {
		out << "expected a value"
	}
	elseif (error_code == ErrorCode.MALFORMED_NUM) {
		out << "malformed number"
	}
	elseif (error_code == ErrorCode.UNK_IDENT) {
		out << "unknown identifier or function"
	}
	elseif (error_code == ErrorCode.EXPECTED_PR_OR_COMMA) {
		out << "expected '(', ')', or ','"
	}
	elseif (error_code == ErrorCode.ZERO_DIV_OR_MOD) {
		out << "division or modulo by zero"
	}
	elseif (error_code == ErrorCode.DOMAIN_ERROR) {
		out << "math domain error"
	}
	elseif (error_code == ErrorCode.UNEXPECTED_TRAIL) {
		out << "unexpected trailing input"
	}
	else {
		out << "unknown calculator error"
	}

	out << '\n'
}

proc print_calculator_result(value: float) {
	if (is_integral(value)) {
		out << (int)value
	}
	else {
		out << value
	}
	out << '\n'
}

# Layout helpers.
proc draw_calculator_status(x: int, y: int, text: string, result: float, error_code: int, error_position: int, dirty: bool) {
	if (xestring::strlen(text) > 0) {
		if (error_code != 0) {
			call graphics::draw_text_small(calculator_window, x, y, "Error at", graphics::COLOR_12)
			call graphics::draw_int_small(calculator_window, x + 34, y, error_position + 1, graphics::COLOR_12)
		}
		elseif (!dirty) {
			call graphics::draw_text_small(calculator_window, x, y, "=", graphics::COLOR_11)
			if (is_integral(result)) {
				call graphics::draw_int_small(calculator_window, x + 7, y, (int)result, graphics::WHITE)
			}
			else {
				call graphics::draw_float_small(calculator_window, x + 7, y, result, graphics::WHITE)
			}
		}
	}
}

proc clear_calculator_text(text: string) {
	if (xestring::strlen(text) > 0) {
		text[0] = '\0'
		call xestring::update_length(text)
	}
}

proc set_calculator_text(target: string, source: string) {
	call clear_calculator_text(target)
	call xestring::append(target, source)
}

# Input and interaction.
fn calculator_editor_key_supported(key: int) bool {
	if (key >= 48 && key <= 57) { return true }
	if (key == 32 || key == 37 || key == 40 || key == 41 || key == 42 || key == 43 || key == 44 || key == 45 || key == 46 || key == 47 || key == 94) { return true }
	if (key == 65 || key == 97 || key == 67 || key == 99 || key == 69 || key == 101 || key == 73 || key == 105 || key == 78 || key == 110 || key == 79 || key == 111 || key == 80 || key == 112 || key == 81 || key == 113 || key == 82 || key == 114 || key == 83 || key == 115 || key == 84 || key == 116 || key == 87 || key == 119) { return true }
	return key >= 1001 && key <= 1010
}

proc prepare_calculator_insert(text: string) {
	if (calculator_selected_all) {
		call clear_calculator_text(text)
		calculator_selected_all = false
	}
}

proc append_editor_key(text: string, key: int) {
	if (!calculator_editor_key_supported(key)) { return }
	call prepare_calculator_insert(text)
	if (key == 48) {
		call xestring::append(text, "0")
	}
	elseif (key == 49) {
		call xestring::append(text, "1")
	}
	elseif (key == 50) {
		call xestring::append(text, "2")
	}
	elseif (key == 51) {
		call xestring::append(text, "3")
	}
	elseif (key == 52) {
		call xestring::append(text, "4")
	}
	elseif (key == 53) {
		call xestring::append(text, "5")
	}
	elseif (key == 54) {
		call xestring::append(text, "6")
	}
	elseif (key == 55) {
		call xestring::append(text, "7")
	}
	elseif (key == 56) {
		call xestring::append(text, "8")
	}
	elseif (key == 57) {
		call xestring::append(text, "9")
	}
	elseif (key == 32) {
		call xestring::append(text, " ")
	}
	elseif (key == 37) {
		call xestring::append(text, "%")
	}
	elseif (key == 40) {
		call xestring::append(text, "(")
	}
	elseif (key == 41) {
		call xestring::append(text, ")")
	}
	elseif (key == 42) {
		call xestring::append(text, "*")
	}
	elseif (key == 43) {
		call xestring::append(text, "+")
	}
	elseif (key == 44) {
		call xestring::append(text, ",")
	}
	elseif (key == 45) {
		call xestring::append(text, "-")
	}
	elseif (key == 46) {
		call xestring::append(text, ".")
	}
	elseif (key == 47) {
		call xestring::append(text, "/")
	}
	elseif (key == 65 || key == 97) {
		call xestring::append(text, "a")
	}
	elseif (key == 67 || key == 99) {
		call xestring::append(text, "c")
	}
	elseif (key == 69 || key == 101) {
		call xestring::append(text, "e")
	}
	elseif (key == 73 || key == 105) {
		call xestring::append(text, "i")
	}
	elseif (key == 78 || key == 110) {
		call xestring::append(text, "n")
	}
	elseif (key == 79 || key == 111) {
		call xestring::append(text, "o")
	}
	elseif (key == 80 || key == 112) {
		call xestring::append(text, "p")
	}
	elseif (key == 81 || key == 113) {
		call xestring::append(text, "q")
	}
	elseif (key == 82 || key == 114) {
		call xestring::append(text, "r")
	}
	elseif (key == 83 || key == 115) {
		call xestring::append(text, "s")
	}
	elseif (key == 84 || key == 116) {
		call xestring::append(text, "t")
	}
	elseif (key == 87 || key == 119) {
		call xestring::append(text, "w")
	}
	elseif (key == 94) {
		call xestring::append(text, "**")
	}
	elseif (key == 1001) {
		call xestring::append(text, "sin(")
	}
	elseif (key == 1002) {
		call xestring::append(text, "cos(")
	}
	elseif (key == 1003) {
		call xestring::append(text, "tan(")
	}
	elseif (key == 1004) {
		call xestring::append(text, "asin(")
	}
	elseif (key == 1005) {
		call xestring::append(text, "acos(")
	}
	elseif (key == 1006) {
		call xestring::append(text, "atan(")
	}
	elseif (key == 1007) {
		call xestring::append(text, "sqrt(")
	}
	elseif (key == 1008) {
		call xestring::append(text, "pow(")
	}
	elseif (key == 1009) {
		call xestring::append(text, "pi")
	}
	elseif (key == 1010) {
		call xestring::append(text, "e")
	}
}

proc draw_editor_key(x: int, y: int, width: int, label: string, color: int, key: int, text: string, dirty: bool*, error: int*) {
	if (graphics::button_tone(calculator_window, x, y, width, 11, label, color)) {
		call append_editor_key(text, key)
		*dirty = true
		*error = 0
	}
}

proc draw_editor_key_sized(x: int, y: int, width: int, height: int, label: string, color: int, key: int, text: string, dirty: bool*, error: int*) {
	if (graphics::button_tone(calculator_window, x, y, width, height, label, color)) {
		call append_editor_key(text, key)
		*dirty = true
		*error = 0
	}
}

proc draw_editor_key_compact(x: int, y: int, width: int, label: string, color: int, key: int, text: string, dirty: bool*, error: int*) {
	if (graphics::button_tone(calculator_window, x, y, width, 9, label, color)) {
		call append_editor_key(text, key)
		*dirty = true
		*error = 0
	}
}

proc erase_last_editor_key(text: string) {
	var length: int
	if (calculator_selected_all) {
		call clear_calculator_text(text)
		calculator_selected_all = false
		return
	}
	length = xestring::strlen(text)
	if (length > 0) {
		text[length - 1] = '\0'
		call xestring::update_length(text)
	}
}

proc clear_editor(text: string) {
	call clear_calculator_text(text)
	calculator_selected_all = false
}

proc calculator_select_all() {
	calculator_selected_all = xestring::strlen(expression) > 0
}

proc calculator_copy_selection() {
	var shared_ok: bool
	if (calculator_selected_all) {
		call set_calculator_text(calculator_clipboard, expression)
		shared_ok = os::clipboard_write(calculator_clipboard)
	}
}

proc calculator_cut_selection() {
	if (calculator_selected_all) {
		call calculator_copy_selection()
		call clear_editor(expression)
		dirty = true
		error_code = 0
	}
}

proc calculator_paste_clipboard() {
	var shared_clipboard: string
	shared_clipboard = os::clipboard_read()
	if (xestring::strlen(shared_clipboard) > 0) {
		call set_calculator_text(calculator_clipboard, shared_clipboard)
	}
	if (xestring::strlen(calculator_clipboard) > 0) {
		call prepare_calculator_insert(expression)
		call xestring::append(expression, calculator_clipboard)
		calculator_selected_all = false
		dirty = true
		error_code = 0
	}
}

proc handle_calculator_control_shortcut(key: int) {
	if (key == 1 || key == 65 || key == 97) {
		call calculator_select_all()
	}
	elseif (key == 3 || key == 67 || key == 99) {
		call calculator_copy_selection()
	}
	elseif (key == 24 || key == 88 || key == 120) {
		call calculator_cut_selection()
	}
	elseif (key == 22 || key == 86 || key == 118) {
		call calculator_paste_clipboard()
	}
}

# Paint and replaceable asset hooks.
proc draw_expression_editor(x: int, y: int, width: int, text: string, error_code: int, error_position: int) {
	var length: int
	var start: int
	var index: int
	var draw_x: int
	var advance: int
	var used_width: int
	var available_width: int
	var scanning: bool

	length = xestring::strlen(text)
	available_width = width - 7
	if (available_width < 1) { available_width = 1 }
	start = length
	used_width = 0
	scanning = true
	while (scanning && start > 0) {
		advance = graphics::char_advance(text[start - 1], graphics::FONT_SMALL)
		if (used_width + advance > available_width) {
			scanning = false
		}
		else {
			used_width += advance
			start -= 1
		}
	}
	index = start
	draw_x = x + 3
	while (index < length) {
		if (error_code != 0 && index == error_position) {
			call graphics::draw_char_small(calculator_window, draw_x, y, text[index], graphics::COLOR_12)
		}
		elseif (calculator_selected_all) {
			call graphics::draw_char_small(calculator_window, draw_x, y, text[index], graphics::COLOR_14)
		}
		else {
			call graphics::draw_char_small(calculator_window, draw_x, y, text[index], graphics::WHITE)
		}
		draw_x += graphics::char_advance(text[index], graphics::FONT_SMALL)
		index += 1
	}
	if (draw_x < x + width - 2) {
		call graphics::draw_line(calculator_window, draw_x, y + 5, draw_x + 2, y + 5, graphics::COLOR_11)
	}
}

proc draw_shift_editor_key_sized(x: int, y: int, width: int, height: int, label: string, key: int, text: string, dirty: bool*, error: int*, shift_mode: bool*) {
	if (graphics::button_tone(calculator_window, x, y, width, height, label, graphics::COLOR_13)) {
		call append_editor_key(text, key)
		*dirty = true
		*error = 0
		*shift_mode = false
	}
}

proc evaluate_editor(text: string, degrees_mode: bool, result: float*, error_code: int*, error_position: int*) {
	*result = evaluate_expression(text, degrees_mode, error_code, error_position)
	if (*error_code == 0) {
		history_4 = history_3
		history_3 = history_2
		history_2 = history_1
		history_1 = *result
		if (history_count < 4) { history_count += 1 }
	}
}

proc draw_standard_keypad(x: int, y: int, width: int, height: int, text: string, dirty: bool*, error: int*, result: float*, error_position: int*, degrees_mode: bool) {
	var key_width: int
	var key_height: int
	var row_step: int
	key_width = (width - 6) / 4
	key_height = (height - 8) / 5
	if (key_height < 7) { key_height = 7 }
	row_step = key_height + 2
	call draw_editor_key_sized(x, y, key_width, key_height, "7", graphics::COLOR_5, 55, text, dirty, error)
	call draw_editor_key_sized(x + key_width + 2, y, key_width, key_height, "8", graphics::COLOR_5, 56, text, dirty, error)
	call draw_editor_key_sized(x + (key_width + 2) * 2, y, key_width, key_height, "9", graphics::COLOR_5, 57, text, dirty, error)
	call draw_editor_key_sized(x + (key_width + 2) * 3, y, key_width, key_height, "/", graphics::COLOR_3, 47, text, dirty, error)
	call draw_editor_key_sized(x, y + row_step, key_width, key_height, "4", graphics::COLOR_5, 52, text, dirty, error)
	call draw_editor_key_sized(x + key_width + 2, y + row_step, key_width, key_height, "5", graphics::COLOR_5, 53, text, dirty, error)
	call draw_editor_key_sized(x + (key_width + 2) * 2, y + row_step, key_width, key_height, "6", graphics::COLOR_5, 54, text, dirty, error)
	call draw_editor_key_sized(x + (key_width + 2) * 3, y + row_step, key_width, key_height, "*", graphics::COLOR_3, 42, text, dirty, error)
	call draw_editor_key_sized(x, y + row_step * 2, key_width, key_height, "1", graphics::COLOR_5, 49, text, dirty, error)
	call draw_editor_key_sized(x + key_width + 2, y + row_step * 2, key_width, key_height, "2", graphics::COLOR_5, 50, text, dirty, error)
	call draw_editor_key_sized(x + (key_width + 2) * 2, y + row_step * 2, key_width, key_height, "3", graphics::COLOR_5, 51, text, dirty, error)
	call draw_editor_key_sized(x + (key_width + 2) * 3, y + row_step * 2, key_width, key_height, "-", graphics::COLOR_3, 45, text, dirty, error)
	call draw_editor_key_sized(x, y + row_step * 3, key_width, key_height, "0", graphics::COLOR_5, 48, text, dirty, error)
	call draw_editor_key_sized(x + key_width + 2, y + row_step * 3, key_width, key_height, ".", graphics::COLOR_5, 46, text, dirty, error)
	call draw_editor_key_sized(x + (key_width + 2) * 2, y + row_step * 3, key_width, key_height, "%", graphics::COLOR_1, 37, text, dirty, error)
	call draw_editor_key_sized(x + (key_width + 2) * 3, y + row_step * 3, key_width, key_height, "+", graphics::COLOR_3, 43, text, dirty, error)
	if (graphics::button_tone(calculator_window, x, y + row_step * 4, key_width, key_height, "DEL", graphics::COLOR_4)) {
		call erase_last_editor_key(text)
		*error = 0
		*dirty = true
	}
	if (graphics::button_tone(calculator_window, x + key_width + 2, y + row_step * 4, key_width, key_height, "AC", graphics::COLOR_4)) {
		call clear_editor(text)
		*error = 0
		*dirty = true
	}
	if (graphics::button_tone(calculator_window, x + (key_width + 2) * 2, y + row_step * 4, key_width * 2 + 2, key_height, "=", graphics::COLOR_13)) {
		call evaluate_editor(text, degrees_mode, result, error, error_position)
		*dirty = false
	}
}

proc draw_scientific_keypad(x: int, y: int, width: int, height: int, text: string, dirty: bool*, error: int*, result: float*, error_position: int*, degrees_mode: bool*, shift_mode: bool*) {
	var key_width: int
	var key_height: int
	var row_step: int
	var equals_height: int
	var shift_color: int
	var angle_label: string
	key_width = (width - 8) / 5
	key_height = (height - 12) / 7
	if (key_height < 5) { key_height = 5 }
	row_step = key_height + 2
	equals_height = key_height * 2 + 2
	shift_color = graphics::COLOR_4
	if (*shift_mode) { shift_color = graphics::COLOR_13 }

	if (graphics::button_tone(calculator_window, x, y, key_width, key_height, "SHIFT", shift_color)) {
		*shift_mode = !*shift_mode
	}
	if (*shift_mode) {
		call draw_shift_editor_key_sized(x + key_width + 2, y, key_width, key_height, "asin", 1004, text, dirty, error, shift_mode)
		call draw_shift_editor_key_sized(x + (key_width + 2) * 2, y, key_width, key_height, "acos", 1005, text, dirty, error, shift_mode)
		call draw_shift_editor_key_sized(x + (key_width + 2) * 3, y, key_width, key_height, "atan", 1006, text, dirty, error, shift_mode)
		call draw_shift_editor_key_sized(x + (key_width + 2) * 4, y, key_width, key_height, "pow", 1008, text, dirty, error, shift_mode)
	}
	else {
		call draw_editor_key_sized(x + key_width + 2, y, key_width, key_height, "sin", graphics::COLOR_8, 1001, text, dirty, error)
		call draw_editor_key_sized(x + (key_width + 2) * 2, y, key_width, key_height, "cos", graphics::COLOR_8, 1002, text, dirty, error)
		call draw_editor_key_sized(x + (key_width + 2) * 3, y, key_width, key_height, "tan", graphics::COLOR_8, 1003, text, dirty, error)
		call draw_editor_key_sized(x + (key_width + 2) * 4, y, key_width, key_height, "sqrt", graphics::COLOR_8, 1007, text, dirty, error)
	}

	call draw_editor_key_sized(x, y + row_step, key_width, key_height, "**", graphics::COLOR_1, 94, text, dirty, error)
	call draw_editor_key_sized(x + key_width + 2, y + row_step, key_width, key_height, "pi", graphics::COLOR_1, 1009, text, dirty, error)
	call draw_editor_key_sized(x + (key_width + 2) * 2, y + row_step, key_width, key_height, "e", graphics::COLOR_1, 1010, text, dirty, error)
	call draw_editor_key_sized(x + (key_width + 2) * 3, y + row_step, key_width, key_height, "(", graphics::COLOR_1, 40, text, dirty, error)
	call draw_editor_key_sized(x + (key_width + 2) * 4, y + row_step, key_width, key_height, ")", graphics::COLOR_1, 41, text, dirty, error)

	call draw_editor_key_sized(x, y + row_step * 2, key_width, key_height, "%", graphics::COLOR_1, 37, text, dirty, error)
	call draw_editor_key_sized(x + key_width + 2, y + row_step * 2, key_width, key_height, ",", graphics::COLOR_1, 44, text, dirty, error)
	if (graphics::button_tone(calculator_window, x + (key_width + 2) * 2, y + row_step * 2, key_width, key_height, "DEL", graphics::COLOR_4)) {
		call erase_last_editor_key(text)
		*error = 0
		*dirty = true
	}
	if (graphics::button_tone(calculator_window, x + (key_width + 2) * 3, y + row_step * 2, key_width, key_height, "AC", graphics::COLOR_4)) {
		call clear_editor(text)
		*error = 0
		*dirty = true
		*shift_mode = false
	}
	angle_label = "RAD"
	if (*degrees_mode) { angle_label = "DEG" }
	if (graphics::button_tone(calculator_window, x + (key_width + 2) * 4, y + row_step * 2, key_width, key_height, angle_label, graphics::COLOR_1)) {
		*degrees_mode = !*degrees_mode
		if (xestring::strlen(text) > 0) {
			call evaluate_editor(text, *degrees_mode, result, error, error_position)
			*dirty = false
		}
		else {
			*error = 0
		}
	}

	call draw_editor_key_sized(x, y + row_step * 3, key_width, key_height, "7", graphics::COLOR_5, 55, text, dirty, error)
	call draw_editor_key_sized(x + key_width + 2, y + row_step * 3, key_width, key_height, "8", graphics::COLOR_5, 56, text, dirty, error)
	call draw_editor_key_sized(x + (key_width + 2) * 2, y + row_step * 3, key_width, key_height, "9", graphics::COLOR_5, 57, text, dirty, error)
	call draw_editor_key_sized(x + (key_width + 2) * 3, y + row_step * 3, key_width, key_height, "*", graphics::COLOR_3, 42, text, dirty, error)
	call draw_editor_key_sized(x + (key_width + 2) * 4, y + row_step * 3, key_width, key_height, "/", graphics::COLOR_3, 47, text, dirty, error)

	call draw_editor_key_sized(x, y + row_step * 4, key_width, key_height, "4", graphics::COLOR_5, 52, text, dirty, error)
	call draw_editor_key_sized(x + key_width + 2, y + row_step * 4, key_width, key_height, "5", graphics::COLOR_5, 53, text, dirty, error)
	call draw_editor_key_sized(x + (key_width + 2) * 2, y + row_step * 4, key_width, key_height, "6", graphics::COLOR_5, 54, text, dirty, error)
	call draw_editor_key_sized(x + (key_width + 2) * 3, y + row_step * 4, key_width, key_height, "+", graphics::COLOR_3, 43, text, dirty, error)
	call draw_editor_key_sized(x + (key_width + 2) * 4, y + row_step * 4, key_width, key_height, "-", graphics::COLOR_3, 45, text, dirty, error)

	call draw_editor_key_sized(x, y + row_step * 5, key_width, key_height, "1", graphics::COLOR_5, 49, text, dirty, error)
	call draw_editor_key_sized(x + key_width + 2, y + row_step * 5, key_width, key_height, "2", graphics::COLOR_5, 50, text, dirty, error)
	call draw_editor_key_sized(x + (key_width + 2) * 2, y + row_step * 5, key_width, key_height, "3", graphics::COLOR_5, 51, text, dirty, error)
	call draw_editor_key_sized(x + (key_width + 2) * 3, y + row_step * 5, key_width, key_height, "MOD", graphics::COLOR_3, 37, text, dirty, error)
	if (graphics::button_tone(calculator_window, x + (key_width + 2) * 4, y + row_step * 5, key_width, equals_height, "=", graphics::COLOR_13)) {
		call evaluate_editor(text, *degrees_mode, result, error, error_position)
		*dirty = false
		*shift_mode = false
	}
	call draw_editor_key_sized(x, y + row_step * 6, key_width * 2 + 2, key_height, "0", graphics::COLOR_5, 48, text, dirty, error)
	call draw_editor_key_sized(x + (key_width + 2) * 2, y + row_step * 6, key_width * 2 + 2, key_height, ".", graphics::COLOR_5, 46, text, dirty, error)
}

proc draw_compact_keypad(x: int, y: int, width: int, height: int, text: string, dirty: bool*, error: int*, result: float*, error_position: int*, degrees_mode: bool) {
	var key_width: int
	key_width = (width - 8) / 5
	if (height >= y + 9) {
		call draw_editor_key_compact(x, y + 12, key_width, "7", graphics::COLOR_5, 55, text, dirty, error)
		call draw_editor_key_compact(x + key_width + 2, y + 12, key_width, "8", graphics::COLOR_5, 56, text, dirty, error)
		call draw_editor_key_compact(x + (key_width + 2) * 2, y + 12, key_width, "9", graphics::COLOR_5, 57, text, dirty, error)
		call draw_editor_key_compact(x + (key_width + 2) * 3, y + 12, key_width, "/", graphics::COLOR_3, 47, text, dirty, error)
		if (graphics::button_tone(calculator_window, x + (key_width + 2) * 4, y + 12, key_width, 9, "DEL", graphics::COLOR_4)) {
			call erase_last_editor_key(text)
			*error = 0
			*dirty = true
		}
	}

	if (height >= y + 19) {
		call draw_editor_key_compact(x, y + 22, key_width, "4", graphics::COLOR_5, 52, text, dirty, error)
		call draw_editor_key_compact(x + key_width + 2, y + 22, key_width, "5", graphics::COLOR_5, 53, text, dirty, error)
		call draw_editor_key_compact(x + (key_width + 2) * 2, y + 22, key_width, "6", graphics::COLOR_5, 54, text, dirty, error)
		call draw_editor_key_compact(x + (key_width + 2) * 3, y + 22, key_width, "*", graphics::COLOR_3, 42, text, dirty, error)
		if (graphics::button_tone(calculator_window, x + (key_width + 2) * 4, y + 22, key_width, 9, "AC", graphics::COLOR_4)) {
			call clear_editor(text)
			*error = 0
			*dirty = true
		}
	}

	if (height >= y + 29) {
		call draw_editor_key_compact(x, y + 32, key_width, "1", graphics::COLOR_5, 49, text, dirty, error)
		call draw_editor_key_compact(x + key_width + 2, y + 32, key_width, "2", graphics::COLOR_5, 50, text, dirty, error)
		call draw_editor_key_compact(x + (key_width + 2) * 2, y + 32, key_width, "3", graphics::COLOR_5, 51, text, dirty, error)
		call draw_editor_key_compact(x + (key_width + 2) * 3, y + 32, key_width, "+", graphics::COLOR_3, 43, text, dirty, error)
		call draw_editor_key_compact(x + (key_width + 2) * 4, y + 32, key_width, "-", graphics::COLOR_3, 45, text, dirty, error)
	}

	if (height >= y + 39) {
		call draw_editor_key_compact(x, y + 42, key_width, "0", graphics::COLOR_5, 48, text, dirty, error)
		call draw_editor_key_compact(x + key_width + 2, y + 42, key_width, ".", graphics::COLOR_5, 46, text, dirty, error)
		call draw_editor_key_compact(x + (key_width + 2) * 2, y + 42, key_width, "%", graphics::COLOR_1, 37, text, dirty, error)
		call draw_editor_key_compact(x + (key_width + 2) * 3, y + 42, key_width, "(", graphics::COLOR_1, 40, text, dirty, error)
		if (graphics::button_tone(calculator_window, x + (key_width + 2) * 4, y + 42, key_width, 9, "=", graphics::COLOR_13)) {
			call evaluate_editor(text, degrees_mode, result, error, error_position)
			*dirty = false
		}
	}
}

fn hex_character(value: int) char {
	if (value < 10) { return (char)(48 + value) }
	return (char)(55 + value)
}

proc draw_programmer_number(x: int, y: int, value: int, base: int) {
	var divisor: int
	var digit: int
	var draw_x: int
	var started: bool
	if (value == -2147483647 - 1) {
		if (base == 10) { call graphics::draw_int(calculator_window, x, y, value, graphics::WHITE) }
		elseif (base == 16) { call graphics::draw_text(calculator_window, x, y, "-0x80000000", graphics::WHITE) }
		else { call graphics::draw_text(calculator_window, x, y, "-0b10000000000000000000000000000000", graphics::WHITE) }
		return
	}
	if (value < 0) {
		call graphics::draw_char(calculator_window, x, y, '-', graphics::COLOR_14)
		x += 6
		value = -value
	}
	if (base == 10) {
		call graphics::draw_int(calculator_window, x, y, value, graphics::WHITE)
	}
	elseif (base == 16) {
		call graphics::draw_text(calculator_window, x, y, "0x", graphics::COLOR_8)
		draw_x = x + 12
		divisor = 268435456
		started = false
		while (divisor > 0) {
			digit = (value / divisor) % 16
			if (digit != 0 || started || divisor == 1) {
				call graphics::draw_char(calculator_window, draw_x, y, hex_character(digit), graphics::WHITE)
				draw_x += 6
				started = true
			}
			divisor /= 16
		}
	}
	else {
		call graphics::draw_text(calculator_window, x, y, "0b", graphics::COLOR_8)
		draw_x = x + 12
		divisor = 1073741824
		started = false
		while (divisor > 0) {
			digit = (value / divisor) % 2
			if (digit != 0 || started || divisor == 1) {
				call graphics::draw_char(calculator_window, draw_x, y, (char)(48 + digit), graphics::WHITE)
				draw_x += 6
				started = true
			}
			divisor /= 2
		}
	}
}

fn programmer_number_width(value: int, base: int) int {
	var digits: int
	var divisor: int
	var started: bool
	var width: int
	if (value == -2147483647 - 1) {
		if (base == 10) { return 66 }
		if (base == 16) { return 66 }
		return 210
	}
	width = 0
	if (value < 0) {
		width = 6
		value = -value
	}
	if (base == 10) {
		digits = 1
		while (value >= 10) {
			value /= 10
			digits += 1
		}
		return width + digits * 6
	}
	width += 12
	if (base == 16) { divisor = 268435456 }
	else { divisor = 1073741824 }
	digits = 0
	started = false
	while (divisor > 0) {
		if ((value / divisor) % base != 0 || started || divisor == 1) {
			digits += 1
			started = true
		}
		divisor /= base
	}
	return width + digits * 6
}

proc draw_compact_programmer_view(x: int, y: int, width: int, result: float, base: int*) {
	var selector_width: int
	var selector_x: int
	var selected_color: int
	var number_width: int
	call graphics::draw_text_small(calculator_window, x + (width - 27) / 2, y, "Integer", graphics::COLOR_8)
	number_width = programmer_number_width((int)result, *base)
	call draw_programmer_number(x + (width - number_width) / 2, y + 7, (int)result, *base)
	selector_width = (width - 4) / 3
	selector_x = x + (width - (selector_width * 3 + 4)) / 2
	selected_color = graphics::COLOR_8
	if (*base == 10) { selected_color = graphics::COLOR_13 }
	if (graphics::button_flat(calculator_window, selector_x, y + 15, selector_width, 5, "DEC", selected_color)) { *base = 10 }
	selected_color = graphics::COLOR_8
	if (*base == 16) { selected_color = graphics::COLOR_13 }
	if (graphics::button_flat(calculator_window, selector_x + selector_width + 2, y + 15, selector_width, 5, "HEX", selected_color)) { *base = 16 }
	selected_color = graphics::COLOR_8
	if (*base == 2) { selected_color = graphics::COLOR_13 }
	if (graphics::button_flat(calculator_window, selector_x + (selector_width + 2) * 2, y + 15, selector_width, 5, "BIN", selected_color)) { *base = 2 }
}

proc draw_programmer_view(x: int, width: int, result: float, base: int*) {
	var selector_width: int
	var selector_x: int
	var selected_color: int
	var number_width: int
	call graphics::draw_text(calculator_window, x + (width - 89) / 2, 45, "Integer display", graphics::COLOR_8)
	selector_width = (width - 4) / 3
	selector_x = x + (width - (selector_width * 3 + 4)) / 2
	selected_color = graphics::COLOR_8
	if (*base == 10) { selected_color = graphics::COLOR_13 }
	if (graphics::button_flat(calculator_window, selector_x, 56, selector_width, 11, "DEC", selected_color)) { *base = 10 }
	selected_color = graphics::COLOR_8
	if (*base == 16) { selected_color = graphics::COLOR_13 }
	if (graphics::button_flat(calculator_window, selector_x + selector_width + 2, 56, selector_width, 11, "HEX", selected_color)) { *base = 16 }
	selected_color = graphics::COLOR_8
	if (*base == 2) { selected_color = graphics::COLOR_13 }
	if (graphics::button_flat(calculator_window, selector_x + (selector_width + 2) * 2, 56, selector_width, 11, "BIN", selected_color)) { *base = 2 }
	call graphics::fill_rect(calculator_window, x, 72, width, 24, graphics::COLOR_1)
	call graphics::draw_rect(calculator_window, x, 72, width, 24, graphics::COLOR_8)
	number_width = programmer_number_width((int)result, *base)
	call draw_programmer_number(x + (width - number_width) / 2, 81, (int)result, *base)
	call graphics::draw_text_small(calculator_window, x + (width - 131) / 2, 104, "Enter an integer expression above", graphics::COLOR_8)
}

proc draw_graph_view(x: int, width: int, function_id: int*) {
	var point: int
	var previous_y: int
	var current_y: int
	var angle: float
	var value: float
	var clipped: bool
	var previous_clipped: bool
	if (graphics::button(calculator_window, x, 42, 42, 9, "sin")) { *function_id = 0 }
	if (graphics::button(calculator_window, x + 45, 42, 42, 9, "cos")) { *function_id = 1 }
	if (graphics::button(calculator_window, x + 90, 42, 42, 9, "tan")) { *function_id = 2 }
	call graphics::fill_rect(calculator_window, x, 55, width, 84, graphics::COLOR_1)
	call graphics::draw_rect(calculator_window, x, 55, width, 84, graphics::COLOR_8)
	call graphics::draw_line(calculator_window, x + 2, 97, x + width - 3, 97, graphics::COLOR_8)
	point = 0
	previous_y = 97
	previous_clipped = false
	while (point < width - 5) {
		angle = (float)point * 360.0 / (float)(width - 5)
		if (*function_id == 0) { value = math::sin(angle) }
		elseif (*function_id == 1) { value = math::cos(angle) }
		clipped = false
		if (*function_id == 2) {
			value = math::tan(angle)
			if (value > 1.0) { value = 1.0; clipped = true }
			if (value < -1.0) { value = -1.0; clipped = true }
		}
		current_y = 97 - (int)(value * 36.0)
		if (point > 0 && !clipped && !previous_clipped) {
			call graphics::draw_line(calculator_window, x + point + 1, previous_y, x + point + 2, current_y, graphics::COLOR_11)
		}
		previous_y = current_y
		previous_clipped = clipped
		point += 1
	}
}

proc draw_compact_graph_view(x: int, y: int, width: int, height: int, function_id: int*) {
	var selector_width: int
	var graph_y: int
	var graph_height: int
	var point: int
	var previous_y: int
	var current_y: int
	var angle: float
	var value: float
	var clipped: bool
	var previous_clipped: bool
	selector_width = (width - 4) / 3
	if (graphics::button_flat(calculator_window, x, y, selector_width, 5, "sin", graphics::COLOR_8)) { *function_id = 0 }
	if (graphics::button_flat(calculator_window, x + selector_width + 2, y, selector_width, 5, "cos", graphics::COLOR_8)) { *function_id = 1 }
	if (graphics::button_flat(calculator_window, x + (selector_width + 2) * 2, y, selector_width, 5, "tan", graphics::COLOR_8)) { *function_id = 2 }
	graph_y = y + 6
	graph_height = height - 6
	if (graph_height >= 4) {
		call graphics::fill_rect(calculator_window, x, graph_y, width, graph_height, graphics::COLOR_1)
		point = 0
		previous_y = graph_y + graph_height / 2
		previous_clipped = false
		while (point < width - 3) {
			angle = (float)point * 360.0 / (float)(width - 3)
			if (*function_id == 0) { value = math::sin(angle) }
			elseif (*function_id == 1) { value = math::cos(angle) }
			clipped = false
			if (*function_id == 2) {
				value = math::tan(angle)
				if (value > 1.0) { value = 1.0; clipped = true }
				if (value < -1.0) { value = -1.0; clipped = true }
			}
			current_y = graph_y + graph_height / 2 - (int)(value * (float)(graph_height - 2) / 2.0)
			if (point > 0 && !clipped && !previous_clipped) {
				call graphics::draw_line(calculator_window, x + point, previous_y, x + point + 1, current_y, graphics::COLOR_11)
			}
			previous_y = current_y
			previous_clipped = clipped
			point += 1
		}
	}
}

fn draw_swap_button(x: int, y: int, width: int, height: int) bool {
	var clicked: bool
	var left: int
	var right: int
	var upper: int
	var lower: int
	clicked = graphics::button_flat(calculator_window, x, y, width, height, " ", graphics::COLOR_8)
	left = x + (width - 8) / 2
	right = left + 7
	upper = y + height / 2 - 2
	lower = y + height / 2 + 2
	call graphics::draw_line(calculator_window, left, upper, right, upper, graphics::WHITE)
	call graphics::set_pixel(calculator_window, right - 1, upper - 1, graphics::WHITE)
	call graphics::set_pixel(calculator_window, right - 1, upper + 1, graphics::WHITE)
	call graphics::draw_line(calculator_window, right, lower, left, lower, graphics::WHITE)
	call graphics::set_pixel(calculator_window, left + 1, lower - 1, graphics::WHITE)
	call graphics::set_pixel(calculator_window, left + 1, lower + 1, graphics::WHITE)
	return clicked
}

proc draw_vertical_arrow(x: int, y: int, direction: int, color: int) {
	if (direction < 0) {
		call graphics::set_pixel(calculator_window, x + 1, y, color)
		call graphics::set_pixel(calculator_window, x, y + 1, color)
		call graphics::set_pixel(calculator_window, x + 2, y + 1, color)
	}
	else {
		call graphics::set_pixel(calculator_window, x, y, color)
		call graphics::set_pixel(calculator_window, x + 2, y, color)
		call graphics::set_pixel(calculator_window, x + 1, y + 1, color)
	}
}

proc append_calculator_positive_int(target: string, value: int) {
	var divisor: int
	if (value < 0) { value = -value }
	divisor = 1
	while (value / divisor >= 10) {
		divisor *= 10
	}
	while (divisor > 0) {
		call xestring::append_char(target, (char)(48 + (value / divisor) % 10))
		divisor /= 10
	}
}

proc format_currency_number(target: string, value: float, decimal_count: int) {
	var magnitude: float
	var group: int
	var small_exponent: int
	var decimal_scale: int
	var rounded: int
	var whole: int
	var fraction: int
	var digit_divisor: int
	var digit_index: int

	call clear_calculator_text(target)
	if (value != value) {
		call xestring::append(target, "NaN")
		return
	}
	magnitude = value
	if (magnitude < 0.0) {
		call xestring::append(target, "-")
		magnitude = -magnitude
	}
	group = 0
	while (magnitude >= 999.995 && group < 12) {
		magnitude /= 1000.0
		group += 1
	}
	if (magnitude >= 1000.0) {
		call xestring::append(target, "MAX")
		return
	}
	small_exponent = 0
	if (magnitude > 0.0 && magnitude < 0.01) {
		while (magnitude < 1.0 && small_exponent < 38) {
			magnitude *= 10.0
			small_exponent += 1
		}
	}
	if (decimal_count < 0) { decimal_count = 0 }
	if (decimal_count > 2) { decimal_count = 2 }
	decimal_scale = 1
	digit_index = 0
	while (digit_index < decimal_count) {
		decimal_scale *= 10
		digit_index += 1
	}
	rounded = (int)(magnitude * (float)decimal_scale + 0.5)
	whole = rounded / decimal_scale
	fraction = rounded % decimal_scale
	call append_calculator_positive_int(target, whole)
	if (decimal_count > 0) {
		call xestring::append(target, ".")
		digit_divisor = decimal_scale / 10
		while (digit_divisor > 0) {
			call xestring::append_char(target, (char)(48 + (fraction / digit_divisor) % 10))
			digit_divisor /= 10
		}
	}
	if (small_exponent > 0) {
		call xestring::append(target, "e-")
		call append_calculator_positive_int(target, small_exponent)
	}
	elseif (group == 1) { call xestring::append(target, "K") }
	elseif (group == 2) { call xestring::append(target, "M") }
	elseif (group == 3) { call xestring::append(target, "B") }
	elseif (group == 4) { call xestring::append(target, "T") }
	elseif (group > 4) {
		call xestring::append(target, "e")
		call append_calculator_positive_int(target, group * 3)
	}
}

fn calculator_small_text_width(text: string) int {
	var index: int
	var result: int
	index = 0
	result = 0
	while (index < xestring::strlen(text)) {
		result += graphics::char_advance(text[index], graphics::FONT_SMALL)
		index += 1
	}
	return result
}

proc format_currency_marker(target: string, value: float) {
	var magnitude: float
	var group: int
	var small_exponent: int
	call clear_calculator_text(target)
	if (value != value) {
		call xestring::append(target, "?")
		return
	}
	magnitude = value
	if (magnitude < 0.0) {
		call xestring::append(target, "-")
		magnitude = -magnitude
	}
	group = 0
	while (magnitude >= 1000.0 && group < 12) {
		magnitude /= 1000.0
		group += 1
	}
	small_exponent = 0
	if (magnitude > 0.0 && magnitude < 0.01) {
		while (magnitude < 1.0 && small_exponent < 38) {
			magnitude *= 10.0
			small_exponent += 1
		}
	}
	if (group > 0) {
		call xestring::append(target, "e")
		call append_calculator_positive_int(target, group * 3)
	}
	elseif (small_exponent > 0) {
		call xestring::append(target, "e-")
		call append_calculator_positive_int(target, small_exponent)
	}
	else {
		call xestring::append(target, "#")
	}
}

proc fit_currency_number(target: string, value: float, width: int) {
	var text_width: int
	var marker_width: int
	if (width < 1) {
		call clear_calculator_text(target)
		return
	}
	call format_currency_number(target, value, 2)
	text_width = calculator_small_text_width(target)
	if (text_width > width) {
		call format_currency_number(target, value, 1)
		text_width = calculator_small_text_width(target)
	}
	if (text_width > width) {
		call format_currency_number(target, value, 0)
		text_width = calculator_small_text_width(target)
	}
	if (text_width > width) {
		call format_currency_marker(target, value)
		text_width = calculator_small_text_width(target)
	}
	if (text_width > width) {
		call clear_calculator_text(target)
		marker_width = graphics::char_advance('#', graphics::FONT_SMALL)
		if (value < 0.0 && graphics::char_advance('-', graphics::FONT_SMALL) <= width) {
			call xestring::append(target, "-")
		}
		elseif (marker_width <= width) {
			call xestring::append(target, "#")
		}
	}
}

proc draw_compact_currency_number(x: int, y: int, width: int, value: float, color: int) {
	var text_width: int
	var text_x: int
	if (width < 1) { return }
	call fit_currency_number(calculator_number_text, value, width)
	text_width = calculator_small_text_width(calculator_number_text)
	if (xestring::strlen(calculator_number_text) > 0 && text_width <= width) {
		text_x = x + (width - text_width) / 2
		call graphics::draw_text_small(calculator_window, text_x, y, calculator_number_text, color)
	}
}

fn draw_currency_selector(x: int, y: int, width: int, code: string, open: bool) bool {
	var clicked: bool
	var surface: int
	var foreground: int
	var label_width: int
	var direction: int
	surface = graphics::COLOR_8
	foreground = graphics::WHITE
	if (os::theme_mode == os::THEME_LIGHT) {
		surface = graphics::COLOR_7
		foreground = graphics::COLOR_1
	}
	clicked = graphics::button_flat(calculator_window, x, y, width, 7, " ", surface)
	label_width = calculator_small_text_width(code)
	call graphics::draw_text_small(calculator_window, x + (width - 7 - label_width) / 2, y + 1, code, foreground)
	direction = 1
	if (open) { direction = -1 }
	call draw_vertical_arrow(x + width - 5, y + 2, direction, foreground)
	return clicked
}

var currency_from_menu_open: bool
var currency_to_menu_open: bool
var currency_from_scroll: int
var currency_to_scroll: int
var currency_graph_progress: int
var currency_last_from: int
var currency_last_to: int
var currency_last_range: int
var calculator_animation_step: int

proc draw_currency_date(x: int, y: int, text: string, color: int) {
	var index: int
	var source_index: int
	var draw_x: int
	index = 0
	draw_x = x
	while (index < 5) {
		source_index = index + 5
		if (source_index < xestring::strlen(text)) {
			call graphics::draw_char_small(calculator_window, draw_x, y, text[source_index], color)
			draw_x += graphics::char_advance(text[source_index], graphics::FONT_SMALL)
		}
		index += 1
	}
}

fn calculator_pointer_inside(x: int, y: int, width: int, height: int) bool {
	var pointer_x: int
	var pointer_y: int
	pointer_x = graphics::pointer_x(calculator_window)
	pointer_y = graphics::pointer_y(calculator_window)
	return pointer_x >= x && pointer_x < x + width && pointer_y >= y && pointer_y < y + height
}

proc apply_currency_scroll_delta(scroll: int*, delta: int, maximum_scroll: int) {
	if (maximum_scroll < 0) { maximum_scroll = 0 }
	if (*scroll < 0) { *scroll = 0 }
	if (*scroll > maximum_scroll) { *scroll = maximum_scroll }
	while (delta > 0 && *scroll > 0) {
		*scroll -= 1
		delta -= 1
	}
	while (delta < 0 && *scroll < maximum_scroll) {
		*scroll += 1
		delta += 1
	}
}

proc apply_mode_page_scroll(page: int*, delta: int) {
	if (delta > 0) { *page = 0 }
	elseif (delta < 0) { *page = 1 }
}

proc draw_currency_dropdown(x: int, y: int, width: int, height: int, selected: int*, scroll: int*, open: bool*) {
	var count: int
	var visible_rows: int
	var row: int
	var item: int
	var surface: int
	var foreground: int
	var clicked: bool
	var dropdown_height: int
	count = currency::count()
	visible_rows = (height - 12) / 6
	if (visible_rows < 1) { visible_rows = 1 }
	if (visible_rows > 6) { visible_rows = 6 }
	if (*scroll > count - visible_rows) { *scroll = count - visible_rows }
	if (*scroll < 0) { *scroll = 0 }
	dropdown_height = 12 + visible_rows * 6
	if (!mode_menu_open && calculator_pointer_inside(x, y, width, dropdown_height)) {
		call apply_currency_scroll_delta(scroll, graphics::scroll_delta(), count - visible_rows)
	}
	surface = graphics::COLOR_8
	foreground = graphics::WHITE
	if (os::theme_mode == os::THEME_LIGHT) {
		surface = graphics::COLOR_7
		foreground = graphics::COLOR_1
	}
	clicked = graphics::button_flat(calculator_window, x, y, width, dropdown_height, "", surface)
	if (graphics::button_flat(calculator_window, x + 1, y + 1, width - 2, 5, " ", surface)) {
		if (*scroll > 0) { *scroll -= 1 }
	}
	call draw_vertical_arrow(x + width / 2 - 1, y + 1, -1, foreground)
	row = 0
	while (row < visible_rows) {
		item = *scroll + row
		if (item < count) {
			if (graphics::button_flat(calculator_window, x + 1, y + 7 + row * 6, width - 2, 5, currency::code(item), surface)) {
				*selected = item
				*open = false
			}
		}
		row += 1
	}
	if (graphics::button_flat(calculator_window, x + 1, y + 7 + visible_rows * 6, width - 2, 5, " ", surface)) {
		if (*scroll < count - visible_rows) { *scroll += 1 }
	}
	call draw_vertical_arrow(x + width / 2 - 1, y + 7 + visible_rows * 6, 1, foreground)
}

proc draw_currency_view(x: int, y: int, width: int, height: int, result: float, from_id: int*, to_id: int*, range_id: int*) {
	var selector_width: int
	var selector_x: int
	var selector_group_width: int
	var range_width: int
	var range_x: int
	var range_group_width: int
	var count: int
	var status: int
	var rate: float
	var converted: float
	var amount: float
	var swap_clicked: bool
	var range_color: int
	var graph_y: int
	var graph_height: int
	var point_count: int
	var point_index: int
	var previous_x: int
	var previous_y: int
	var point_x: int
	var point_y: int
	var point_value: float
	var minimum: float
	var maximum: float
	var padding: float
	var loaded: bool
	var plot_bottom: int
	var grid_x: int
	var grid_index: int
	var date_index: int
	var shade_y: int
	var shade_color: int
	var visible_points: int
	var trend_color: int
	var trend_direction: int
	var first_value: float
	var last_value: float
	var change: float
	var pointer_x: int
	var pointer_y: int
	var hover_index: int
	var hover_x: int
	var hover_y: int
	var hover_span: int
	var hover_numerator: int
	var hover_remainder: int
	var hover_next_index: int
	var hover_value: float
	var menu_height: int
	var date_x: int
	var hover_label_x: int
	var hover_label_y: int
	var hover_label_width: int
	var value_width: int
	var value_x: int
	var rate_width: int

	count = currency::count()
	selector_width = (width - 16) / 2
	selector_group_width = selector_width * 2 + 16
	selector_x = x + (width - selector_group_width) / 2
	if (draw_currency_selector(selector_x, y, selector_width, currency::code(*from_id), currency_from_menu_open)) {
		currency_from_menu_open = !currency_from_menu_open
		currency_to_menu_open = false
	}
	swap_clicked = false
	if (!currency_from_menu_open && !currency_to_menu_open) {
		swap_clicked = draw_swap_button(selector_x + selector_width + 2, y, 12, 7)
		if (swap_clicked) {
			count = *from_id
			*from_id = *to_id
			*to_id = count
		}
	}
	else {
		swap_clicked = draw_swap_button(selector_x + selector_width + 2, y, 12, 7)
	}
	if (draw_currency_selector(selector_x + selector_width + 16, y, selector_width, currency::code(*to_id), currency_to_menu_open)) {
		currency_to_menu_open = !currency_to_menu_open
		currency_from_menu_open = false
	}

	range_width = (width - 5) / 6
	range_group_width = range_width * 6 + 5
	range_x = x + (width - range_group_width) / 2
	range_color = graphics::COLOR_8
	if (*range_id == 0) { range_color = graphics::COLOR_13 }
	if (!currency_from_menu_open && !currency_to_menu_open && graphics::button_flat(calculator_window, range_x, y + 9, range_width, 6, "1d", range_color)) { *range_id = 0 }
	range_color = graphics::COLOR_8
	if (*range_id == 1) { range_color = graphics::COLOR_13 }
	if (!currency_from_menu_open && !currency_to_menu_open && graphics::button_flat(calculator_window, range_x + range_width + 1, y + 9, range_width, 6, "5d", range_color)) { *range_id = 1 }
	range_color = graphics::COLOR_8
	if (*range_id == 2) { range_color = graphics::COLOR_13 }
	if (!currency_from_menu_open && !currency_to_menu_open && graphics::button_flat(calculator_window, range_x + (range_width + 1) * 2, y + 9, range_width, 6, "1w", range_color)) { *range_id = 2 }
	range_color = graphics::COLOR_8
	if (*range_id == 3) { range_color = graphics::COLOR_13 }
	if (!currency_from_menu_open && !currency_to_menu_open && graphics::button_flat(calculator_window, range_x + (range_width + 1) * 3, y + 9, range_width, 6, "1m", range_color)) { *range_id = 3 }
	range_color = graphics::COLOR_8
	if (*range_id == 4) { range_color = graphics::COLOR_13 }
	if (!currency_from_menu_open && !currency_to_menu_open && graphics::button_flat(calculator_window, range_x + (range_width + 1) * 4, y + 9, range_width, 6, "YTD", range_color)) { *range_id = 4 }
	range_color = graphics::COLOR_8
	if (*range_id == 5) { range_color = graphics::COLOR_13 }
	if (!currency_from_menu_open && !currency_to_menu_open && graphics::button_flat(calculator_window, range_x + (range_width + 1) * 5, y + 9, range_width, 6, "ALL", range_color)) { *range_id = 5 }
	if (currency_from_menu_open || currency_to_menu_open) {
		call graphics::fill_rect(calculator_window, x, y + 9, width, 6, graphics::COLOR_1)
	}

	if (*from_id != currency_last_from || *to_id != currency_last_to || *range_id != currency_last_range) {
		currency_last_from = *from_id
		currency_last_to = *to_id
		currency_last_range = *range_id
		currency_graph_progress = 0
	}
	if (currency_graph_progress < 100) {
		currency_graph_progress += calculator_animation_step
		if (currency_graph_progress > 100) { currency_graph_progress = 100 }
	}

	loaded = currency::load(*from_id, *to_id, *range_id)
	status = currency::status()
	if (status == currency::STATUS_READY) {
		rate = currency::rate()
		amount = result
		if (xestring::strlen(expression) == 0) { amount = 1.0 }
		converted = amount * rate
		value_width = (width - 8) / 2
		value_x = x + (width - (value_width * 2 + 8)) / 2
		call draw_compact_currency_number(value_x, y + 17, value_width, amount, graphics::COLOR_7)
		call graphics::draw_text_small(calculator_window, value_x + value_width + 2, y + 17, "=", graphics::COLOR_11)
		call draw_compact_currency_number(value_x + value_width + 8, y + 17, value_width, converted, graphics::WHITE)
		call graphics::draw_text_small(calculator_window, x, y + 23, "Rate", graphics::COLOR_8)
		if (width >= 100) {
			rate_width = width - 70
		}
		else {
			rate_width = width - 20
		}
		call draw_compact_currency_number(x + 18, y + 23, rate_width, rate, graphics::COLOR_14)

		graph_y = y + 30
		graph_height = height - 31
		if (graph_height >= 16) {
			call graphics::fill_rect(calculator_window, x, graph_y, width, graph_height, graphics::COLOR_1)
			point_count = currency::point_count()
			if (point_count > 1) {
				plot_bottom = graph_y + graph_height - 8
				minimum = currency::point(0)
				maximum = minimum
				point_index = 1
				while (point_index < point_count) {
					point_value = currency::point(point_index)
					if (point_value < minimum) { minimum = point_value }
					if (point_value > maximum) { maximum = point_value }
					point_index += 1
				}
				padding = (maximum - minimum) * 0.08
				if (padding < 0.0) { padding = -padding }
				if (padding < 0.0001) {
					padding = minimum * 0.0001
					if (padding < 0.0) { padding = -padding }
					if (padding < 0.0001) { padding = 0.0001 }
				}
				minimum -= padding
				maximum += padding
				first_value = currency::point(0)
				last_value = currency::point(point_count - 1)
				change = last_value - first_value
				trend_color = graphics::COLOR_7
				shade_color = graphics::COLOR_8
				trend_direction = 0
				if (change > padding / 10.0) { trend_color = graphics::COLOR_10; shade_color = graphics::COLOR_2; trend_direction = -1 }
				elseif (change < -padding / 10.0) { trend_color = graphics::COLOR_12; shade_color = graphics::COLOR_4; trend_direction = 1 }
				if (trend_direction == 0) {
					call graphics::draw_line(calculator_window, x + width - 5, y + 25, x + width - 3, y + 25, trend_color)
				}
				else {
					call draw_vertical_arrow(x + width - 5, y + 23, trend_direction, trend_color)
				}
				pointer_x = graphics::pointer_x(calculator_window)
				pointer_y = graphics::pointer_y(calculator_window)
				if (width >= 100 && pointer_x >= x + width - 7 && pointer_x < x + width && pointer_y >= y + 21 && pointer_y < y + 29) {
					if (change > padding / 10.0) {
						call graphics::draw_text_small(calculator_window, x + width - 48, y + 23, "Appreciating", trend_color)
					}
					elseif (change < -padding / 10.0) {
						call graphics::draw_text_small(calculator_window, x + width - 48, y + 23, "Depreciating", trend_color)
					}
					else {
						call graphics::draw_text_small(calculator_window, x + width - 32, y + 23, "Stable", trend_color)
					}
				}
				grid_index = 0
				while (grid_index < 3) {
					grid_x = x + 2 + grid_index * (width - 5) / 2
					call graphics::draw_line(calculator_window, grid_x, graph_y + 1, grid_x, plot_bottom, graphics::COLOR_8)
					date_index = grid_index * (point_count - 1) / 2
					date_x = grid_x - 9
					if (date_x < x + 2) { date_x = x + 2 }
					if (date_x > x + width - 22) { date_x = x + width - 22 }
					call draw_currency_date(date_x, plot_bottom + 2, currency::point_date(date_index), graphics::COLOR_7)
					grid_index += 1
				}
				visible_points = 1 + (point_count - 1) * currency_graph_progress / 100
				point_index = 0
				while (point_index < visible_points) {
					point_value = currency::point(point_index)
					point_x = x + 2 + point_index * (width - 5) / (point_count - 1)
					point_y = plot_bottom - (int)((point_value - minimum) * (float)(plot_bottom - graph_y - 2) / (maximum - minimum))
					point_y = plot_bottom - (plot_bottom - point_y) * currency_graph_progress / 100
					shade_y = point_y + 2
					while (shade_y < plot_bottom) {
						call graphics::set_pixel(calculator_window, point_x, shade_y, shade_color)
						shade_y += 4
					}
					if (point_index > 0) {
						call graphics::draw_line(calculator_window, previous_x, previous_y, point_x, point_y, trend_color)
					}
					previous_x = point_x
					previous_y = point_y
					point_index += 1
				}
				if (!currency_from_menu_open && !currency_to_menu_open && pointer_x >= x + 2 && pointer_x <= x + width - 3 && pointer_y >= graph_y && pointer_y <= plot_bottom) {
					hover_x = pointer_x
					hover_span = width - 5
					hover_numerator = (hover_x - x - 2) * (point_count - 1)
					hover_index = hover_numerator / hover_span
					hover_remainder = hover_numerator % hover_span
					if (hover_index < 0) { hover_index = 0 }
					if (hover_index >= point_count) { hover_index = point_count - 1 }
					hover_next_index = hover_index + 1
					if (hover_next_index >= point_count) { hover_next_index = point_count - 1 }
					hover_value = currency::point(hover_index)
					if (hover_next_index != hover_index) {
						hover_value += (currency::point(hover_next_index) - hover_value) * (float)hover_remainder / (float)hover_span
					}
					if (hover_remainder * 2 >= hover_span && hover_next_index != hover_index) { hover_index = hover_next_index }
					hover_y = graph_y + 1
					while (hover_y <= plot_bottom) {
						call graphics::set_pixel(calculator_window, hover_x, hover_y, graphics::WHITE)
						hover_y += 3
					}
					hover_label_width = 74
					if (hover_label_width > width - 4) { hover_label_width = width - 4 }
					hover_label_x = hover_x - hover_label_width / 2
					if (hover_label_x < x + 2) { hover_label_x = x + 2 }
					if (hover_label_x + hover_label_width > x + width - 2) { hover_label_x = x + width - hover_label_width - 2 }
					hover_label_y = pointer_y - 9
					if (hover_label_y < graph_y + 1) { hover_label_y = pointer_y + 3 }
					if (hover_label_y > plot_bottom - 7) { hover_label_y = plot_bottom - 7 }
					call graphics::fill_rect(calculator_window, hover_label_x, hover_label_y, hover_label_width, 7, graphics::COLOR_8)
					call draw_currency_date(hover_label_x + 2, hover_label_y + 1, currency::point_date(hover_index), graphics::WHITE)
					call draw_compact_currency_number(hover_label_x + 24, hover_label_y + 1, hover_label_width - 26, hover_value, graphics::WHITE)
				}
			}
		}
	}
	elseif (status == currency::STATUS_ERROR) {
		call graphics::draw_text_small(calculator_window, x, y + 19, "Rates unavailable - check connection", graphics::COLOR_12)
	}
	else {
		call graphics::draw_text_small(calculator_window, x, y + 19, "Loading rate snapshot...", graphics::COLOR_8)
	}
	menu_height = height - 8
	if (menu_height > 48) { menu_height = 48 }
	if (currency_from_menu_open) {
		call draw_currency_dropdown(selector_x, y + 8, selector_width, menu_height, from_id, &currency_from_scroll, &currency_from_menu_open)
	}
	elseif (currency_to_menu_open) {
		call draw_currency_dropdown(selector_x + selector_width + 16, y + 8, selector_width, menu_height, to_id, &currency_to_scroll, &currency_to_menu_open)
	}
}

proc draw_unit_view(x: int, y: int, width: int, result: float, pair: int*, swapped: bool*) {
	var converted: float
	var selector_width: int
	var selector_x: int
	var value_width: int
	var value_x: int
	var swap_clicked: bool
	var left_label: string
	var right_label: string
	selector_width = (width - 16) / 2

	if (*pair == 0) {
		left_label = "km"
		right_label = "mi"
		converted = result * 0.621371
	}
	elseif (*pair == 1) {
		left_label = "C"
		right_label = "F"
		converted = result * 9.0 / 5.0 + 32.0
	}
	elseif (*pair == 2) {
		left_label = "kg"
		right_label = "lb"
		converted = result * 2.204622
	}
	elseif (*pair == 3) {
		left_label = "m"
		right_label = "ft"
		converted = result * 3.280840
	}
	elseif (*pair == 4) {
		left_label = "L"
		right_label = "gal"
		converted = result * 0.264172
	}
	else {
		left_label = "cm"
		right_label = "in"
		converted = result / 2.54
	}

	if (*swapped) {
		left_label = right_label
		if (*pair == 0) { right_label = "km"; converted = result / 0.621371 }
		elseif (*pair == 1) { right_label = "C"; converted = (result - 32.0) * 5.0 / 9.0 }
		elseif (*pair == 2) { right_label = "kg"; converted = result / 2.204622 }
		elseif (*pair == 3) { right_label = "m"; converted = result / 3.280840 }
		elseif (*pair == 4) { right_label = "L"; converted = result / 0.264172 }
		else { right_label = "cm"; converted = result * 2.54 }
	}

	selector_x = x + (width - (selector_width * 2 + 16)) / 2
	if (graphics::button_flat(calculator_window, selector_x, y, selector_width, 7, left_label, graphics::COLOR_8)) {
		*pair += 1
		if (*pair >= 6) { *pair = 0 }
		*swapped = false
	}
	swap_clicked = draw_swap_button(selector_x + selector_width + 2, y, 12, 7)
	if (swap_clicked) { *swapped = !*swapped }
	if (graphics::button_flat(calculator_window, selector_x + selector_width + 16, y, selector_width, 7, right_label, graphics::COLOR_8)) {
		*pair += 1
		if (*pair >= 6) { *pair = 0 }
		*swapped = false
	}
	call graphics::fill_rect(calculator_window, x, y + 10, width, 20, graphics::COLOR_1)
	value_width = (width - 8) / 2
	value_x = x + (width - (value_width * 2 + 8)) / 2
	call draw_compact_currency_number(value_x, y + 14, value_width, result, graphics::COLOR_7)
	call graphics::draw_text_small(calculator_window, value_x + value_width + 2, y + 14, "=", graphics::COLOR_11)
	call draw_compact_currency_number(value_x + value_width + 8, y + 14, value_width, converted, graphics::WHITE)
}

proc draw_history_view(x: int, width: int) {
	call graphics::draw_text(calculator_window, x, 45, "Recent results", graphics::COLOR_8)
	call graphics::fill_rect(calculator_window, x, 56, width, 62, graphics::COLOR_1)
	call graphics::draw_rect(calculator_window, x, 56, width, 62, graphics::COLOR_8)
	if (history_count == 0) {
		call graphics::draw_text(calculator_window, x + 5, 64, "No calculations yet", graphics::COLOR_7)
	}
	if (history_count >= 1) {
		call draw_compact_currency_number(x + 5, 64, width - 10, history_1, graphics::WHITE)
	}
	if (history_count >= 2) {
		call draw_compact_currency_number(x + 5, 76, width - 10, history_2, graphics::COLOR_7)
	}
	if (history_count >= 3) {
		call draw_compact_currency_number(x + 5, 88, width - 10, history_3, graphics::COLOR_7)
	}
	if (history_count >= 4) {
		call draw_compact_currency_number(x + 5, 100, width - 10, history_4, graphics::COLOR_7)
	}
}

proc draw_history_compact(x: int, y: int) {
	if (history_count == 0) {
		call graphics::draw_text_small(calculator_window, x, y, "No calculations yet", graphics::COLOR_7)
	}
	if (history_count >= 1) {
		call graphics::draw_float_small(calculator_window, x, y, history_1, graphics::WHITE)
	}
	if (history_count >= 2) {
		call graphics::draw_float_small(calculator_window, x, y + 6, history_2, graphics::COLOR_7)
	}
	if (history_count >= 3) {
		call graphics::draw_float_small(calculator_window, x, y + 12, history_3, graphics::COLOR_7)
	}
	if (history_count >= 4) {
		call graphics::draw_float_small(calculator_window, x, y + 18, history_4, graphics::COLOR_7)
	}
}

fn ease_mode_menu(value: int) int {
	return value * (200 - value) / 100
}

proc draw_mode_switch(x: int, width: int, height: int, mode: int*, menu_open: bool*, progress: int*, page: int*) {
	var clicked: bool
	var menu_eased: int
	var menu_height: int
	var button_width: int
	var button_x: int
	var menu_block_clicked: bool
	var menu_surface: int
	var mode_label: string
	var arrow_direction: int
	var mode_foreground: int
	if (width < 1 || height < 1) { return }
	if (*menu_open && *progress < 100) {
		*progress += calculator_animation_step
		if (*progress > 100) { *progress = 100 }
	}
	elseif (!*menu_open && *progress > 0) {
		*progress -= calculator_animation_step
		if (*progress < 0) { *progress = 0 }
	}
	menu_eased = ease_mode_menu(*progress)
	menu_height = 7 + 39 * menu_eased / 100
	if (menu_height > height - 14) { menu_height = height - 14 }
	if (menu_height < 5) { menu_height = 5 }
	button_width = 88
	if (button_width > width - 26) { button_width = width - 26 }
	if (button_width < 20) { button_width = width }
	button_x = x + (width - button_width) / 2
	clicked = false
	menu_surface = graphics::COLOR_8
	mode_foreground = graphics::WHITE
	if (os::theme_mode == os::THEME_LIGHT) {
		menu_surface = graphics::COLOR_7
		mode_foreground = graphics::COLOR_1
	}
	if (*mode == 0) { mode_label = "Standard" }
	elseif (*mode == 1) { mode_label = "Scientific" }
	elseif (*mode == 2) { mode_label = "Programmer" }
	elseif (*mode == 3) { mode_label = "Graphing" }
	elseif (*mode == 4) { mode_label = "Currency" }
	elseif (*mode == 5) { mode_label = "Unit conversion" }
	else { mode_label = "History" }
	if (button_width < 58) {
		if (*mode == 0) { mode_label = "STD" }
		elseif (*mode == 1) { mode_label = "SCI" }
		elseif (*mode == 2) { mode_label = "PROG" }
		elseif (*mode == 3) { mode_label = "GRAPH" }
		elseif (*mode == 4) { mode_label = "CURR" }
		elseif (*mode == 5) { mode_label = "UNIT" }
		else { mode_label = "HIST" }
	}
	clicked = graphics::button_flat(calculator_window, button_x, 4, button_width, 9, mode_label, menu_surface)
	arrow_direction = 1
	if (*menu_open) { arrow_direction = -1 }
	call draw_vertical_arrow(button_x + button_width - 5, 7, arrow_direction, mode_foreground)
	if (clicked) {
		*menu_open = !*menu_open
		if (*menu_open) {
			currency_from_menu_open = false
			currency_to_menu_open = false
			if (*mode >= 4) { *page = 1 }
			else { *page = 0 }
		}
	}
	if (*progress > 0) {
		menu_block_clicked = graphics::button_flat(calculator_window, button_x, 14, button_width, menu_height, "", menu_surface)
		if (*menu_open && *progress == 100 && calculator_pointer_inside(button_x, 14, button_width, menu_height)) {
			call apply_mode_page_scroll(page, graphics::scroll_delta())
		}
		if (*menu_open && *progress == 100 && *page == 0) {
			if (menu_height >= 9) {
				if (graphics::button_flat(calculator_window, button_x + 3, 16, button_width - 6, 7, "Standard", menu_surface)) { *mode = 0; *menu_open = false }
			}
			if (menu_height >= 17) {
				if (graphics::button_flat(calculator_window, button_x + 3, 24, button_width - 6, 7, "Scientific", menu_surface)) { *mode = 1; *menu_open = false }
			}
			if (menu_height >= 25) {
				if (graphics::button_flat(calculator_window, button_x + 3, 32, button_width - 6, 7, "Programmer", menu_surface)) { *mode = 2; *menu_open = false }
			}
			if (menu_height >= 33) {
				if (graphics::button_flat(calculator_window, button_x + 3, 40, button_width - 6, 7, "Graphing", menu_surface)) { *mode = 3; *menu_open = false }
			}
			if (menu_height >= 41) {
				if (graphics::button_flat(calculator_window, button_x + 3, 48, button_width - 6, 7, "More", menu_surface)) { *page = 1 }
			}
		}
		elseif (*menu_open && *progress == 100) {
			if (menu_height >= 9) {
				if (graphics::button_flat(calculator_window, button_x + 3, 16, button_width - 6, 7, "Currency", menu_surface)) { *mode = 4; *menu_open = false }
			}
			if (menu_height >= 17) {
				if (graphics::button_flat(calculator_window, button_x + 3, 24, button_width - 6, 7, "Unit conversion", menu_surface)) { *mode = 5; *menu_open = false }
			}
			if (menu_height >= 25) {
				if (graphics::button_flat(calculator_window, button_x + 3, 32, button_width - 6, 7, "History", menu_surface)) { *mode = 6; *menu_open = false }
			}
			if (menu_height >= 33) {
				if (graphics::button_flat(calculator_window, button_x + 3, 40, button_width - 6, 7, "Back", menu_surface)) { *page = 0 }
			}
		}
	}
}

# Application driver.
# Edit these values to change the expression, angle mode, or UI mode.
var expression: string
var degrees_mode: bool
var graphical_mode: bool
var error_code: int
var error_position: int
var result: float
var content_width: int
var content_height: int
var panel_width: int
var panel_x: int
var keypad_x: int
var display_height: int
var editor_y: int
var status_y: int
var key: int
var dirty: bool
var shift_mode: bool
var calculator_mode: int
var mode_menu_open: bool
var mode_menu_progress: int
var mode_menu_page: int
var programmer_base: int
var graph_function: int
var currency_from: int
var currency_to: int
var currency_range: int
var unit_pair: int
var unit_swapped: bool
var history_count: int
var history_1: float
var history_2: float
var history_3: float
var history_4: float
var previous_ticks: int
var current_ticks: int
var delta_ms: int

expression = ""
calculator_clipboard = ""
calculator_selected_all = false
calculator_number_text = ""
degrees_mode = true
graphical_mode = true
dirty = false
shift_mode = false
calculator_mode = CalculatorMode.STANDARD
mode_menu_open = false
mode_menu_progress = 0
mode_menu_page = 0
programmer_base = 10
graph_function = 0
currency_from = 0
currency_to = 1
currency_range = currency::RANGE_1M
currency_from_menu_open = false
currency_to_menu_open = false
currency_from_scroll = 0
currency_to_scroll = 0
currency_graph_progress = 0
currency_last_from = -1
currency_last_to = -1
currency_last_range = -1
calculator_animation_step = 8
unit_pair = 0
unit_swapped = false
history_count = 0

result = 0.0
error_code = 0
error_position = 0
if (xestring::strlen(expression) > 0) {
	result = evaluate_expression(expression, degrees_mode, &error_code, &error_position)
	if (error_code == 0) {
		call print_calculator_result(result)
		history_1 = result
		history_count = 1
		dirty = false
	}
	else {
		call print_calculator_error(error_code, error_position)
	}
}

if (graphical_mode) {
	calculator_window.x = 112
	calculator_window.y = 58
	calculator_window.width = APP_DEFAULT_WIDTH
	calculator_window.height = APP_DEFAULT_HEIGHT
	calculator_window.title = APP_TITLE
	calculator_window.ui_scale = 1
	calculator_window.state = graphics::WINDOW_NORMAL
	previous_ticks = os::ticks()

	while (calculator_window.state != graphics::WINDOW_CLOSED) {
		current_ticks = os::ticks()
		delta_ms = current_ticks - previous_ticks
		if (delta_ms < 1) { delta_ms = 1 }
		if (delta_ms > 50) { delta_ms = 50 }
		previous_ticks = current_ticks
		calculator_animation_step = delta_ms * 100 / 220
		if (calculator_animation_step < 2) { calculator_animation_step = 2 }
		if (calculator_animation_step > 24) { calculator_animation_step = 24 }
		call graphics::begin_draw(calculator_window)

		if (!calculator_window.is_minimized()) {
			content_width = graphics::content_width(calculator_window)
			content_height = graphics::content_height(calculator_window)

			key = graphics::read_key()
			while (key != 0) {
				if ((graphics::modifiers() & graphics::MOD_CTRL) != 0) {
					call handle_calculator_control_shortcut(key)
				}
				elseif (key == graphics::KEY_BACKSPACE) {
					call erase_last_editor_key(expression)
					error_code = 0
					dirty = true
				}
				elseif (key == graphics::KEY_ENTER || key == 61) {
					call evaluate_editor(expression, degrees_mode, &result, &error_code, &error_position)
					dirty = false
				}
				elseif (key == graphics::KEY_ESCAPE) {
					call clear_editor(expression)
					error_code = 0
					dirty = true
					shift_mode = false
				}
				else {
					if (calculator_editor_key_supported(key)) {
						call append_editor_key(expression, key)
						error_code = 0
						dirty = true
					}
				}
				key = graphics::read_key()
			}

			panel_width = content_width - 8
			if (panel_width < 1) { panel_width = 1 }
			if (panel_width > 360) { panel_width = 360 }
			panel_x = (content_width - panel_width) / 2
			display_height = 34
			editor_y = 15
			status_y = 27
			if (content_width < 150 || content_height < 148) {
				display_height = 23
				editor_y = 14
				status_y = 20
			}

			call graphics::fill_rect(calculator_window, panel_x, 4, panel_width, display_height, graphics::COLOR_5)
			call graphics::draw_rect(calculator_window, panel_x, 4, panel_width, display_height, graphics::COLOR_13)
			if (panel_width >= 140) {
				if (shift_mode && calculator_mode == CalculatorMode.SCIENTIFIC) {
					call graphics::draw_text(calculator_window, panel_x + 6, 6, "SHIFT", graphics::COLOR_14)
				}
				elseif (dirty) {
					call graphics::draw_text(calculator_window, panel_x + 6, 6, "EDIT", graphics::COLOR_8)
				}
				if (degrees_mode) {
					call graphics::draw_text(calculator_window, panel_x + panel_width - 22, 6, "DEG", graphics::COLOR_14)
				}
				else {
					call graphics::draw_text(calculator_window, panel_x + panel_width - 22, 6, "RAD", graphics::COLOR_14)
				}
			}
			call draw_expression_editor(panel_x, editor_y, panel_width, expression, error_code, error_position)
			call draw_calculator_status(panel_x + 4, status_y, expression, result, error_code, error_position, dirty)

			if (content_width < 90 || content_height < 52) {
				# The display remains keyboard-operable at the absolute window minimum.
			}
			elseif (content_width < 150 || content_height < 108) {
				keypad_x = panel_x + 3
				if (calculator_mode == CalculatorMode.STANDARD || calculator_mode == CalculatorMode.SCIENTIFIC) {
					call draw_compact_keypad(keypad_x, 27, panel_width - 6, content_height, expression, &dirty, &error_code, &result, &error_position, degrees_mode)
				}
				elseif (calculator_mode == CalculatorMode.PROGRAMMER) {
					call draw_compact_programmer_view(keypad_x, 29, panel_width - 6, result, &programmer_base)
				}
				elseif (calculator_mode == CalculatorMode.GRAPHING) {
					call draw_compact_graph_view(keypad_x, 28, panel_width - 6, content_height - 29, &graph_function)
				}
				elseif (calculator_mode == CalculatorMode.CURRENCY) {
					call draw_currency_view(keypad_x, 28, panel_width - 6, content_height - 29, result, &currency_from, &currency_to, &currency_range)
				}
				elseif (calculator_mode == CalculatorMode.UNIT_CONVERSION) {
					call draw_unit_view(keypad_x, 28, panel_width - 6, result, &unit_pair, &unit_swapped)
				}
				else {
					call draw_history_compact(keypad_x, 29)
				}
			}
			else {
				keypad_x = panel_x + 4
				if (calculator_mode == CalculatorMode.STANDARD) {
					call draw_standard_keypad(keypad_x, 42, panel_width - 8, content_height - 46, expression, &dirty, &error_code, &result, &error_position, degrees_mode)
				}
				elseif (calculator_mode == CalculatorMode.SCIENTIFIC) {
					call draw_scientific_keypad(keypad_x, 42, panel_width - 8, content_height - 46, expression, &dirty, &error_code, &result, &error_position, &degrees_mode, &shift_mode)
				}
				elseif (calculator_mode == CalculatorMode.PROGRAMMER) {
					call draw_programmer_view(keypad_x, panel_width - 8, result, &programmer_base)
				}
				elseif (calculator_mode == CalculatorMode.GRAPHING) {
					call draw_graph_view(keypad_x, panel_width - 8, &graph_function)
				}
				elseif (calculator_mode == CalculatorMode.CURRENCY) {
					call draw_currency_view(keypad_x, 42, panel_width - 8, content_height - 46, result, &currency_from, &currency_to, &currency_range)
				}
				elseif (calculator_mode == CalculatorMode.UNIT_CONVERSION) {
					call draw_unit_view(keypad_x, 42, panel_width - 8, result, &unit_pair, &unit_swapped)
				}
				else {
					call draw_history_view(keypad_x, panel_width - 8)
				}
			}
			call draw_mode_switch(panel_x + 2, panel_width - 4, content_height, &calculator_mode, &mode_menu_open, &mode_menu_progress, &mode_menu_page)
		}

		call graphics::update(calculator_window)
	}
}
