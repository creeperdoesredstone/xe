var drop_path_active: bool
var drop_path_target: string
var shell_button_hovered: bool
var zoom_controls_hovered: bool
var marquee_active: bool
var marquee_mode: int
var marquee_start_x: int
var marquee_start_y: int
var marquee_current_x: int
var marquee_current_y: int
