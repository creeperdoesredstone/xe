var visual_force_opaque: bool
var view_roll: int

# Placeholder visual tokens. Future asset work only needs to replace the five
# draw_placeholder_* procedures below; filesystem and interaction code stays
# unchanged.
var visual_surface: int
var visual_outline: int
var visual_accent: int
var visual_shell: int
var visual_highlight: int
var projected_x: int
var projected_y: int
var projection_tilt_cos: float
var projection_roll_cos: float
var projection_roll_sin: float

fn transition_ease(progress: int) int {
	if (progress < 0) { progress = 0 }
	if (progress > 100) { progress = 100 }
	return progress * progress * (300 - 2 * progress) / 10000
}

fn placeholder_pixel_visible(x: int, y: int) bool {
	# Fade complete shapes in a few palette-safe temporal steps. Spatial masks
	# produced moving rows/scanlines while the camera zoomed.
	return visual_force_opaque || visual_fade >= 20
}

fn placeholder_faded_color(color: int) int {
	if (visual_force_opaque || visual_fade >= 75) { return color }
	if (visual_fade < 20) { return graphics::COLOR_0 }
	if (visual_fade < 45) { return visual_surface }
	if (color == visual_highlight) { return visual_outline }
	if (color == visual_accent || color == visual_outline) { return visual_shell }
	return color
}

proc draw_placeholder_pixel(x: int, y: int, color: int) {
	if (placeholder_pixel_visible(x, y)) {
		call graphics::set_pixel(explorer_window, x, y, placeholder_faded_color(color))
	}
}

proc draw_placeholder_circle(x: int, y: int, radius: int, color: int) {
	if (placeholder_pixel_visible(x + radius, y)) {
		call graphics::draw_circle(explorer_window, x, y, radius, placeholder_faded_color(color))
	}
}

proc prepare_orbit_projection(shell_tilt: int, roll: int) {
	projection_tilt_cos = math::cos((float)shell_tilt)
	projection_roll_cos = math::cos((float)roll)
	projection_roll_sin = math::sin((float)roll)
}

proc orbit_project(radius: int, angle: float) {
	var plane_x: float
	var plane_y: float
	plane_x = math::cos(angle) * (float)radius
	plane_y = math::sin(angle) * (float)radius * projection_tilt_cos
	projected_x = (int)(plane_x * projection_roll_cos - plane_y * projection_roll_sin)
	projected_y = (int)(plane_x * projection_roll_sin + plane_y * projection_roll_cos)
}

proc refresh_explorer_style() {
	visual_surface = graphics::COLOR_8
	visual_outline = graphics::COLOR_7
	visual_accent = graphics::COLOR_10
	visual_shell = graphics::COLOR_8
	visual_highlight = graphics::WHITE
	if (os::theme_mode == os::THEME_LIGHT) {
		visual_surface = graphics::COLOR_1
		visual_outline = graphics::COLOR_8
		visual_shell = graphics::COLOR_7
	}
}

proc draw_placeholder_orb(x: int, y: int, radius: int) {
	var inner_half: int
	inner_half = radius * 7 / 10
	if (inner_half < 1) { inner_half = 1 }
	if (placeholder_pixel_visible(x, y)) {
		call graphics::fill_rect(explorer_window, x - inner_half, y - inner_half, inner_half * 2 + 1, inner_half * 2 + 1, placeholder_faded_color(visual_surface))
	}
	call draw_placeholder_circle(x, y, radius, visual_outline)
	call draw_placeholder_pixel(x - radius / 2, y - radius / 2, visual_highlight)
}

proc draw_placeholder_nucleus(x: int, y: int, radius: int) {
	var nucleus_angle: float
	var orbit_radius: int
	var orbit_x: int
	var orbit_y: int
	call draw_placeholder_orb(x, y, radius)
	call draw_placeholder_circle(x, y, radius - 2, visual_accent)
	nucleus_angle = (float)(nucleus_phase * 360 / 1200)
	orbit_radius = radius + 3
	orbit_x = (int)(math::cos(nucleus_angle) * (float)orbit_radius)
	orbit_y = (int)(math::sin(nucleus_angle) * (float)orbit_radius)
	call draw_placeholder_pixel(x + orbit_x, y + orbit_y, visual_accent)
	call draw_placeholder_pixel(x - orbit_x, y - orbit_y, visual_shell)
}

proc draw_placeholder_folder(x: int, y: int, radius: int) {
	call draw_placeholder_orb(x, y, radius)
	call draw_placeholder_circle(x, y, radius - 2, visual_accent)
	call draw_placeholder_pixel(x - radius - 2, y, visual_accent)
	call draw_placeholder_pixel(x + radius + 2, y, visual_accent)
}

proc draw_placeholder_file(x: int, y: int, radius: int) {
	if (visual_force_opaque || placeholder_pixel_visible(x, y)) {
		call graphics::fill_rect(explorer_window, x - radius, y - radius - 1, radius * 2 + 1, radius * 2 + 3, placeholder_faded_color(visual_surface))
		call graphics::draw_rect(explorer_window, x - radius, y - radius - 1, radius * 2 + 1, radius * 2 + 3, placeholder_faded_color(visual_outline))
		call graphics::set_pixel(explorer_window, x + radius, y - radius - 1, graphics::COLOR_0)
		call graphics::set_pixel(explorer_window, x + radius - 1, y - radius - 1, placeholder_faded_color(visual_accent))
		call graphics::set_pixel(explorer_window, x + radius, y - radius, placeholder_faded_color(visual_accent))
	}
}

proc draw_placeholder_shell(center_x: int, center_y: int, radius: int, shell_tilt: int, roll: int) {
	var point: int
	var shell_x: int
	var shell_y: int
	var cosine: float
	var sine: float
	var next_cosine: float
	var step_cosine: float
	var step_sine: float
	var plane_x: float
	var plane_y: float
	cosine = 1.0
	sine = 0.0
	step_cosine = math::cos(18.0)
	step_sine = math::sin(18.0)
	point = 0
	while (point < 20) {
		plane_x = cosine * (float)radius
		plane_y = sine * (float)radius * projection_tilt_cos
		shell_x = center_x + (int)(plane_x * projection_roll_cos - plane_y * projection_roll_sin)
		shell_y = center_y + (int)(plane_x * projection_roll_sin + plane_y * projection_roll_cos)
		call draw_placeholder_pixel(shell_x, shell_y, visual_shell)
		next_cosine = cosine * step_cosine - sine * step_sine
		sine = sine * step_cosine + cosine * step_sine
		cosine = next_cosine
		point += 1
	}
}

proc draw_placeholder_drag_handle(x: int, y: int, color: int) {
	call graphics::set_pixel(explorer_window, x - 2, y, color)
	call graphics::set_pixel(explorer_window, x, y, color)
	call graphics::set_pixel(explorer_window, x + 2, y, color)
}

proc draw_explorer_chevron(x: int, y: int, opened: bool, color: int) {
	if (opened) {
		call graphics::draw_line(explorer_window, x, y, x + 2, y + 2, color)
		call graphics::draw_line(explorer_window, x + 2, y + 2, x + 4, y, color)
	}
	else {
		call graphics::draw_line(explorer_window, x, y, x + 2, y + 2, color)
		call graphics::draw_line(explorer_window, x + 2, y + 2, x, y + 4, color)
	}
}

proc explorer_clear(target: string) {
	if (xestring::strlen(target) > 0) {
		target[0] = '\0'
		call xestring::update_length(target)
	}
}

fn explorer_strings_equal(left: string, right: string) bool {
	var index: int
	if (xestring::strlen(left) != xestring::strlen(right)) { return false }
	index = 0
	while (index < xestring::strlen(left)) {
		if ((int)(left[index]) != (int)(right[index])) { return false }
		index += 1
	}
	return true
}

proc explorer_set(target: string, value: string) {
	call explorer_clear(target)
	call xestring::append(target, value)
}

proc explorer_backspace(target: string) {
	var length: int
	length = xestring::strlen(target)
	if (length > 0) {
		target[length - 1] = '\0'
		call xestring::update_length(target)
	}
}

fn explorer_rename_selection_begin() int {
	if (rename_selection_start < rename_selection_end) { return rename_selection_start }
	return rename_selection_end
}

fn explorer_rename_selection_finish() int {
	if (rename_selection_start > rename_selection_end) { return rename_selection_start }
	return rename_selection_end
}

fn explorer_rename_has_selection() bool {
	return rename_selection_start != rename_selection_end
}

proc explorer_clear_rename_selection() {
	rename_selection_start = rename_cursor
	rename_selection_end = rename_cursor
	rename_select_all = false
}

proc explorer_select_all_rename_text() {
	rename_selection_start = 0
	rename_selection_end = xestring::strlen(rename_text)
	rename_cursor = rename_selection_end
	rename_select_all = rename_selection_end > 0
}

proc explorer_replace_rename_selection(value: string) {
	var begin_index: int
	var finish_index: int
	var index: int
	begin_index = explorer_rename_selection_begin()
	finish_index = explorer_rename_selection_finish()
	call explorer_clear(rename_scratch)
	index = 0
	while (index < begin_index && index < xestring::strlen(rename_text)) {
		call xestring::append_char(rename_scratch, rename_text[index])
		index += 1
	}
	call xestring::append(rename_scratch, value)
	index = finish_index
	while (index < xestring::strlen(rename_text)) {
		call xestring::append_char(rename_scratch, rename_text[index])
		index += 1
	}
	call explorer_set(rename_text, rename_scratch)
	rename_cursor = begin_index + xestring::strlen(value)
	call explorer_clear_rename_selection()
}

proc explorer_insert_rename_character(value: char) {
	call explorer_clear(rename_insert)
	call xestring::append_char(rename_insert, value)
	call explorer_replace_rename_selection(rename_insert)
}

proc explorer_copy_rename_selection() {
	var index: int
	if (!explorer_rename_has_selection()) { return }
	call explorer_clear(rename_clipboard)
	index = explorer_rename_selection_begin()
	while (index < explorer_rename_selection_finish()) {
		call xestring::append_char(rename_clipboard, rename_text[index])
		index += 1
	}
}

proc explorer_cut_rename_selection() {
	if (!explorer_rename_has_selection()) { return }
	call explorer_copy_rename_selection()
	call explorer_replace_rename_selection("")
}

proc explorer_paste_rename_selection() {
	var index: int
	var code: int
	index = 0
	while (index < xestring::strlen(rename_clipboard)) {
		code = (int)(rename_clipboard[index])
		if (code < 32 || code == 47 || code == 92) { return }
		index += 1
	}
	if (xestring::strlen(rename_text) - (explorer_rename_selection_finish() - explorer_rename_selection_begin()) + xestring::strlen(rename_clipboard) <= 64) {
		call explorer_replace_rename_selection(rename_clipboard)
	}
}

proc cancel_rename() {
	rename_open = false
	rename_select_all = false
	call explorer_clear_rename_selection()
	call explorer_set(status_text, "Rename cancelled")
}

proc handle_rename_key(value: int) {
	var control_down: bool
	control_down = (graphics::modifiers() & graphics::MOD_CTRL) != 0
	if (control_down) {
		if (value == 1 || value == 65 || value == 97) {
			call explorer_select_all_rename_text()
		}
		elseif (value == 3 || value == 67 || value == 99) {
			call explorer_copy_rename_selection()
		}
		elseif (value == 24 || value == 88 || value == 120) {
			call explorer_cut_rename_selection()
		}
		elseif (value == 22 || value == 86 || value == 118) {
			call explorer_paste_rename_selection()
		}
		return
	}
	if (value == graphics::KEY_ESCAPE) {
		call cancel_rename()
		return
	}
	if (value == graphics::KEY_LEFT) {
		if (explorer_rename_has_selection()) { rename_cursor = explorer_rename_selection_begin() }
		elseif (rename_cursor > 0) { rename_cursor -= 1 }
		call explorer_clear_rename_selection()
		return
	}
	if (value == graphics::KEY_RIGHT) {
		if (explorer_rename_has_selection()) { rename_cursor = explorer_rename_selection_finish() }
		elseif (rename_cursor < xestring::strlen(rename_text)) { rename_cursor += 1 }
		call explorer_clear_rename_selection()
		return
	}
	if (value == graphics::KEY_BACKSPACE) {
		if (explorer_rename_has_selection()) {
			call explorer_replace_rename_selection("")
		}
		elseif (rename_cursor > 0) {
			rename_selection_start = rename_cursor - 1
			rename_selection_end = rename_cursor
			call explorer_replace_rename_selection("")
		}
		return
	}
	if (value == graphics::KEY_DELETE) {
		if (explorer_rename_has_selection()) {
			call explorer_replace_rename_selection("")
		}
		elseif (rename_cursor < xestring::strlen(rename_text)) {
			rename_selection_start = rename_cursor
			rename_selection_end = rename_cursor + 1
			call explorer_replace_rename_selection("")
		}
		return
	}
	if (value >= 32 && value <= 126 && value != 47 && value != 92 && xestring::strlen(rename_text) - (explorer_rename_selection_finish() - explorer_rename_selection_begin()) < 64) {
		call explorer_insert_rename_character((char)value)
	}
}

fn explorer_name_is_valid(name: string) bool {
	var index: int
	var code: int
	if (xestring::strlen(name) == 0 || explorer_strings_equal(name, ".") || explorer_strings_equal(name, "..")) { return false }
	index = 0
	while (index < xestring::strlen(name)) {
		code = (int)(name[index])
		if (code < 32 || code == 47 || code == 92) { return false }
		index += 1
	}
	return true
}

fn explorer_modal_open() bool {
	return context_open || rename_open || delete_confirm || viewer_open || transition_progress > 0
}

proc draw_explorer_text_clipped(x: int, y: int, text: string, maximum_chars: int, color: int) {
	var index: int
	index = 0
	while (index < xestring::strlen(text) && index < maximum_chars) {
		call graphics::draw_char_small(explorer_window, x + index * 4, y, text[index], color)
		index += 1
	}
}

fn explorer_join_path(parent: string, child: string) string {
	if (explorer_strings_equal(parent, ".")) { return child }
	return xestring::concat(xestring::concat(parent, "/"), child)
}

fn explorer_path_depth(path: string) int {
	var index: int
	var depth: int
	if (explorer_strings_equal(path, ".")) { return 0 }
	index = 0
	depth = 1
	while (index < xestring::strlen(path)) {
		if ((int)(path[index]) == 47) { depth += 1 }
		index += 1
	}
	return depth
}

fn explorer_parent_path(path: string) string {
	var result: string
	var index: int
	result = ""
	call explorer_clear(result)
	index = xestring::strlen(path) - 1
	while (index >= 0 && (int)(path[index]) != 47) { index -= 1 }
	if (index < 0) {
		call xestring::append(result, ".")
		return result
	}
	var copy_index: int
	copy_index = 0
	while (copy_index < index) {
		call xestring::append_char(result, path[copy_index])
		copy_index += 1
	}
	if (xestring::strlen(result) == 0) {
		call xestring::append(result, ".")
	}
	return result
}

fn explorer_path_prefix(path: string, length: int) string {
	var result: string
	var index: int
	result = ""
	call explorer_clear(result)
	index = 0
	while (index < length && index < xestring::strlen(path)) {
		call xestring::append_char(result, path[index])
		index += 1
	}
	if (xestring::strlen(result) == 0) {
		call xestring::append(result, ".")
	}
	return result
}

fn explorer_descendant_name(path: string, ancestor: string) string {
	var result: string
	var index: int
	result = ""
	call explorer_clear(result)
	if (explorer_strings_equal(ancestor, ".")) { index = 0 }
	else { index = xestring::strlen(ancestor) + 1 }
	while (index < xestring::strlen(path) && (int)(path[index]) != 47) {
		call xestring::append_char(result, path[index])
		index += 1
	}
	return result
}

fn find_entry_named(name: string) int {
	var index: int
	index = 0
	while (index < cached_entry_count) {
		if (explorer_strings_equal(entry_name_cache[index], name)) { return index }
		index += 1
	}
	return -1
}

proc explorer_append_positive_int(target: string, value: int) {
	if (value >= 10) {
		call explorer_append_positive_int(target, value / 10)
	}
	call xestring::append_char(target, (char)(48 + value % 10))
}

fn explorer_unique_template_name(is_directory: bool) string {
	var candidate: string
	var suffix: int
	candidate = ""
	suffix = 0
	call explorer_clear(candidate)
	call xestring::append(candidate, "untitled")
	if (!is_directory) {
		call xestring::append(candidate, ".xe")
	}
	while (os::path_exists(explorer_join_path(current_path, candidate))) {
		suffix += 1
		call explorer_clear(candidate)
		call xestring::append(candidate, "untitled (")
		call explorer_append_positive_int(candidate, suffix)
		call xestring::append(candidate, ")")
		if (!is_directory) {
			call xestring::append(candidate, ".xe")
		}
	}
	return candidate
}

fn explorer_unique_child_name(parent: string, original: string, is_directory: bool) string {
	var candidate: string
	var stem: string
	var extension: string
	var suffix: int
	var index: int
	var dot: int
	candidate = ""
	stem = ""
	extension = ""
	dot = -1
	if (!is_directory) {
		index = 0
		while (index < xestring::strlen(original)) {
			if ((int)(original[index]) == 46) { dot = index }
			index += 1
		}
		if (dot == 0) { dot = -1 }
	}
	index = 0
	while (index < xestring::strlen(original)) {
		if (dot >= 0 && index >= dot) {
			call xestring::append_char(extension, original[index])
		}
		else {
			call xestring::append_char(stem, original[index])
		}
		index += 1
	}
	call explorer_set(candidate, original)
	suffix = 0
	while (os::path_exists(explorer_join_path(parent, candidate))) {
		suffix += 1
		call explorer_clear(candidate)
		call xestring::append(candidate, stem)
		call xestring::append(candidate, " (")
		call explorer_append_positive_int(candidate, suffix)
		call xestring::append(candidate, ")")
		call xestring::append(candidate, extension)
	}
	return candidate
}

proc clear_entry_selection() {
	var index: int
	index = 0
	while (index < 64) {
		entry_selected[index] = 0
		index += 1
	}
	selected_entry = -1
}

fn selected_entry_count() int {
	var index: int
	var count: int
	index = 0
	count = 0
	while (index < cached_entry_count) {
		if (entry_selected[index] != 0) { count += 1 }
		index += 1
	}
	return count
}

proc update_selection_status() {
	var count: int
	count = selected_entry_count()
	call explorer_clear(status_text)
	call explorer_append_positive_int(status_text, count)
	if (count == 1) { call xestring::append(status_text, " item selected") }
	else { call xestring::append(status_text, " items selected") }
}

proc select_only_entry(index: int) {
	call clear_entry_selection()
	if (index >= 0 && index < cached_entry_count) {
		entry_selected[index] = 1
		selected_entry = index
		selection_anchor = index
	}
}

proc toggle_entry_selection(index: int) {
	if (index < 0 || index >= cached_entry_count) { return }
	if (entry_selected[index] != 0) {
		entry_selected[index] = 0
		if (selected_entry == index) { selected_entry = -1 }
	}
	else {
		entry_selected[index] = 1
		selected_entry = index
	}
	selection_anchor = index
}

proc select_entry_range(index: int) {
	var first: int
	var finish: int
	var cursor: int
	if (index < 0 || index >= cached_entry_count) { return }
	if (selection_anchor < 0 || selection_anchor >= cached_entry_count) {
		call select_only_entry(index)
		return
	}
	first = selection_anchor
	finish = index
	if (first > finish) {
		cursor = first
		first = finish
		finish = cursor
	}
	call clear_entry_selection()
	cursor = first
	while (cursor <= finish) {
		entry_selected[cursor] = 1
		cursor += 1
	}
	selected_entry = index
}

proc select_clicked_entry(index: int) {
	var modifiers: int
	modifiers = graphics::modifiers()
	if ((modifiers & graphics::MOD_CTRL) != 0) {
		call toggle_entry_selection(index)
	}
	elseif ((modifiers & graphics::MOD_SHIFT) != 0) {
		call select_entry_range(index)
	}
	else {
		call select_only_entry(index)
	}
	call update_selection_status()
}

proc finish_marquee_selection() {
	var left: int
	var right: int
	var top: int
	var bottom: int
	var index: int
	var hit_count: int
	left = marquee_start_x
	right = marquee_current_x
	if (left > right) { index = left; left = right; right = index }
	top = marquee_start_y
	bottom = marquee_current_y
	if (top > bottom) { index = top; top = bottom; bottom = index }
	hit_count = 0
	index = 0
	while (index < cached_entry_count) {
		if (entry_render_x[index] >= left && entry_render_x[index] <= right && entry_render_y[index] >= top && entry_render_y[index] <= bottom) {
			if (marquee_mode == 1) {
				if (entry_selected[index] != 0) { entry_selected[index] = 0 }
				else { entry_selected[index] = 1; selected_entry = index }
			}
			else {
				entry_selected[index] = 1
				selected_entry = index
			}
			selection_anchor = index
			hit_count += 1
		}
		index += 1
	}
	if (hit_count > 0) { call update_selection_status() }
}

proc draw_selection_marquee() {
	var left: int
	var right: int
	var top: int
	var bottom: int
	var temporary: int
	left = marquee_start_x
	right = marquee_current_x
	if (left > right) { temporary = left; left = right; right = temporary }
	top = marquee_start_y
	bottom = marquee_current_y
	if (top > bottom) { temporary = top; top = bottom; bottom = temporary }
	call graphics::draw_rect(explorer_window, left, top, right - left + 1, bottom - top + 1, visual_highlight)
}

proc adjust_explorer_zoom(delta: int) {
	camera_zoom_target += delta
	if (camera_zoom_target < 65) { camera_zoom_target = 65 }
	if (camera_zoom_target > 150) { camera_zoom_target = 150 }
}

fn shell_population(shell: int, entry_count: int) int {
	var index: int
	var count: int
	index = 0
	count = 0
	while (index < entry_count && index < 64) {
		if (entry_shell[index] == shell) { count += 1 }
		index += 1
	}
	return count
}

proc rebuild_shell_layout() {
	var shell: int
	var index: int
	shell = 0
	while (shell < 8) {
		shell_population_cache[shell] = 0
		shell += 1
	}
	index = 0
	while (index < cached_entry_count) {
		shell = entry_shell[index]
		if (shell < 0) { shell = 0; entry_shell[index] = 0 }
		if (shell >= shell_count) { shell = shell_count - 1; entry_shell[index] = shell }
		entry_position_cache[index] = shell_population_cache[shell]
		shell_population_cache[shell] += 1
		index += 1
	}
}

proc compact_energy_shells(entry_count: int) {
	var shell: int
	var index: int
	shell = 0
	while (shell < shell_count) {
		if (shell_population(shell, entry_count) == 0 && shell_count > 1) {
			index = 0
			while (index < entry_count && index < 64) {
				if (entry_shell[index] > shell) { entry_shell[index] -= 1 }
				index += 1
			}
			shell_count -= 1
		}
		else { shell += 1 }
	}
	call rebuild_shell_layout()
}

proc begin_slot_animation_all() {
	var index: int
	index = 0
	while (index < cached_entry_count) {
		entry_slot_start_x[index] = entry_render_x[index]
		entry_slot_start_y[index] = entry_render_y[index]
		entry_slot_progress[index] = 0
		index += 1
	}
}

proc begin_slot_animation_for_shell(target_shell: int) {
	var index: int
	index = 0
	while (index < cached_entry_count) {
		if (entry_shell[index] == target_shell) {
			entry_slot_start_x[index] = entry_render_x[index]
			entry_slot_start_y[index] = entry_render_y[index]
			entry_slot_progress[index] = 0
		}
		index += 1
	}
}

proc reset_energy_shells() {
	var count: int
	var index: int
	count = os::entry_count(current_path)
	if (count > 64) { count = 64 }
	cached_entry_count = count
	shell_capacity = 8
	if (count >= 48) {
		shell_capacity = (count + 8) / 8
		if (shell_capacity > 8) { shell_capacity = 8 }
	}
	if (explorer_strings_equal(current_path, ".")) {
		call explorer_set(cached_parent_path, ".")
	}
	else {
		call explorer_set(cached_parent_path, explorer_parent_path(current_path))
	}
	index = 0
	while (index < count) {
		entry_name_cache[index] = os::entry_name(current_path, index)
		if (os::entry_is_directory(current_path, index)) { entry_directory_cache[index] = 1 }
		else { entry_directory_cache[index] = 0 }
		entry_shell[index] = index / shell_capacity
		entry_slot_progress[index] = 100
		index += 1
	}
	shell_count = (count + shell_capacity - 1) / shell_capacity
	if (shell_count < 1) { shell_count = 1 }
	if (shell_count > 8) { shell_count = 8 }
	call rebuild_shell_layout()
	call clear_entry_selection()
	selection_anchor = -1
}

proc move_entry_into_folder(source_index: int, folder_index: int) {
	var source_name: string
	var folder_name: string
	var source_path: string
	var folder_path: string
	var destination_name: string
	if (source_index < 0 || folder_index < 0 || source_index == folder_index) {
		return
	}
	if (source_index >= cached_entry_count || folder_index >= cached_entry_count) {
		return
	}
	if (entry_directory_cache[folder_index] == 0) {
		return
	}
	source_name = entry_name_cache[source_index]
	folder_name = entry_name_cache[folder_index]
	source_path = explorer_join_path(current_path, source_name)
	folder_path = explorer_join_path(current_path, folder_name)
	destination_name = explorer_unique_child_name(folder_path, source_name, entry_directory_cache[source_index] != 0)
	operation_ok = os::rename(source_path, explorer_join_path(folder_path, destination_name))
	if (operation_ok) {
		call explorer_set(status_text, xestring::concat("Moved into ", folder_name))
		call reset_energy_shells()
		selected_entry = -1
	}
	else {
		call explorer_set(status_text, "Move failed")
	}
}

proc move_entry_to_path(source_index: int, destination_path: string) {
	var source_name: string
	var source_path: string
	var destination_name: string
	if (source_index < 0 || source_index >= cached_entry_count) {
		return
	}
	if (explorer_strings_equal(current_path, destination_path)) {
		return
	}
	source_name = entry_name_cache[source_index]
	source_path = explorer_join_path(current_path, source_name)
	destination_name = explorer_unique_child_name(destination_path, source_name, entry_directory_cache[source_index] != 0)
	operation_ok = os::rename(source_path, explorer_join_path(destination_path, destination_name))
	if (operation_ok) {
		call explorer_set(status_text, xestring::concat("Moved to ", destination_path))
		call reset_energy_shells()
		selected_entry = -1
	}
	else {
		call explorer_set(status_text, "Move failed")
	}
}

proc begin_folder_transition(index: int, direction: int) {
	var destination: string
	transition_entry = index
	transition_direction = direction
	transition_committed = false
	transition_hops = 1
	call explorer_clear(transition_destination)
	call explorer_clear(transition_target_name)
	if (direction > 0 && index >= 0 && index < cached_entry_count) {
		call xestring::append(transition_target_name, entry_name_cache[index])
		destination = explorer_join_path(current_path, transition_target_name)
		call xestring::append(transition_destination, destination)
	}
	else {
		destination = explorer_parent_path(current_path)
		call xestring::append(transition_destination, destination)
		call xestring::append(transition_target_name, explorer_descendant_name(current_path, destination))
	}
	transition_progress = 1
}

proc begin_path_transition(destination: string) {
	var current_depth: int
	var destination_depth: int
	if (explorer_strings_equal(current_path, destination)) {
		return
	}
	transition_entry = -1
	transition_direction = -1
	transition_committed = false
	call explorer_set(transition_destination, destination)
	call explorer_set(transition_target_name, explorer_descendant_name(current_path, destination))
	current_depth = explorer_path_depth(current_path)
	destination_depth = explorer_path_depth(destination)
	transition_hops = current_depth - destination_depth
	if (transition_hops < 1) { transition_hops = 1 }
	transition_focus_x = 0
	transition_focus_y = 0
	transition_progress = 1
}

proc commit_folder_transition() {
	if (transition_direction > 0) {
		call explorer_set(current_path, transition_destination)
		call explorer_set(status_text, "Opened folder")
	}
	else {
		call explorer_set(current_path, transition_destination)
		if (explorer_strings_equal(current_path, ".")) {
			call explorer_set(status_text, "root")
		}
		else {
			call explorer_set(status_text, "Parent directory")
		}
	}
	call reset_energy_shells()
	selected_entry = -1
	last_click_entry = -1
	if (transition_direction < 0) { transition_entry = find_entry_named(transition_target_name) }
	else { transition_entry = -1 }
	transition_committed = true
}

proc open_file_viewer(index: int) {
	var path: string
	if (index < 0 || index >= cached_entry_count) {
		return
	}
	if (entry_directory_cache[index] != 0) {
		return
	}
	path = explorer_join_path(current_path, entry_name_cache[index])
	call explorer_set(viewer_name, entry_name_cache[index])
	viewer_file = os::open_read(path)
	call explorer_set(viewer_content, os::read(viewer_file))
	call os::close(path)
	viewer_scroll = 0
	viewer_layout_width = -1
	viewer_open = true
	context_open = false
	call explorer_set(status_text, "Viewing file")
}

proc begin_rename(index: int) {
	if (index < 0 || index >= cached_entry_count) {
		return
	}
	context_entry = index
	call explorer_set(rename_text, entry_name_cache[index])
	rename_anchor_x = context_x
	rename_anchor_y = context_y
	rename_cursor = xestring::strlen(rename_text)
	call explorer_select_all_rename_text()
	rename_first_char = 0
	rename_pointer_guard = 2
	rename_open = true
	context_open = false
}

proc commit_rename() {
	var old_name: string
	var old_path: string
	var final_name: string
	var new_path: string
	final_name = ""
	if (context_entry < 0 || context_entry >= cached_entry_count) {
		rename_open = false
		rename_select_all = false
		call explorer_clear_rename_selection()
		return
	}
	old_name = entry_name_cache[context_entry]
	old_path = explorer_join_path(current_path, old_name)
	if (!explorer_name_is_valid(rename_text)) {
		call explorer_set(status_text, "Enter a valid name")
		return
	}
	if (explorer_strings_equal(rename_text, old_name)) {
		call explorer_set(final_name, old_name)
	}
	else {
		final_name = explorer_unique_child_name(current_path, rename_text, entry_directory_cache[context_entry] != 0)
	}
	new_path = explorer_join_path(current_path, final_name)
	if (explorer_strings_equal(final_name, old_name) || os::rename(old_path, new_path)) {
		if (explorer_strings_equal(final_name, rename_text)) {
			call explorer_set(status_text, "Renamed")
		}
		else {
			call explorer_set(status_text, xestring::concat("Renamed to ", final_name))
		}
		call reset_energy_shells()
		selected_entry = -1
		rename_open = false
		rename_select_all = false
		call explorer_clear_rename_selection()
	}
	else {
		call explorer_set(status_text, "Rename failed")
	}
}

proc confirm_context_delete() {
	var target_path: string
	if (context_entry < 0 || context_entry >= cached_entry_count) {
		delete_confirm = false
		return
	}
	target_path = explorer_join_path(current_path, entry_name_cache[context_entry])
	operation_ok = os::delete(target_path)
	if (operation_ok) {
		call explorer_set(status_text, "Moved to Trash")
		call reset_energy_shells()
		selected_entry = -1
	}
	else {
		call explorer_set(status_text, "Delete failed")
	}
	delete_confirm = false
}

proc draw_breadcrumbs(x: int, y: int, area_width: int) {
	var index: int
	var start: int
	var segment: string
	var destination: string
	var cursor_x: int
	var path_length: int
	var segment_width: int
	var pointer_x: int
	var pointer_y: int
	var drop_color: int
	var dragging_path: bool
	segment = ""
	cursor_x = x
	pointer_x = graphics::pointer_x(explorer_window)
	pointer_y = graphics::pointer_y(explorer_window)
	dragging_path = drag_entry >= 0 && drag_moved
	if (dragging_path) {
		drop_color = visual_surface
		if (!explorer_strings_equal(current_path, ".") && pointer_x >= cursor_x && pointer_x < cursor_x + 14 && pointer_y >= y && pointer_y < y + 9) {
			drop_color = visual_accent
			drop_path_active = true
			call explorer_set(drop_path_target, ".")
		}
		call graphics::fill_rect(explorer_window, cursor_x, y, 14, 9, drop_color)
		call graphics::draw_text(explorer_window, cursor_x + 4, y + 1, "/", visual_outline)
	}
	elseif (!explorer_modal_open()) {
		if (graphics::button_flat(explorer_window, cursor_x, y, 14, 9, "/", graphics::COLOR_8)) {
			if (!explorer_strings_equal(current_path, ".")) {
				call begin_path_transition(".")
			}
			return
		}
	}
	else {
		call graphics::fill_rect(explorer_window, cursor_x, y, 14, 9, visual_surface)
		call graphics::draw_text(explorer_window, cursor_x + 4, y + 1, "/", visual_outline)
	}
	cursor_x += 16
	if (!explorer_strings_equal(current_path, ".")) {
		path_length = xestring::strlen(current_path)
		index = 0
		start = 0
		while (index <= path_length && cursor_x < x + area_width - 20) {
			if (index == path_length || (int)(current_path[index]) == 47) {
				call explorer_clear(segment)
				while (start < index) {
					call xestring::append_char(segment, current_path[start])
					start += 1
				}
				segment_width = xestring::strlen(segment) * 6 + 8
				if (dragging_path) {
					drop_color = visual_surface
					if (index < path_length && pointer_x >= cursor_x && pointer_x < cursor_x + segment_width && pointer_y >= y && pointer_y < y + 9) {
						destination = explorer_path_prefix(current_path, index)
						drop_color = visual_accent
						drop_path_active = true
						call explorer_set(drop_path_target, destination)
					}
					call graphics::fill_rect(explorer_window, cursor_x, y, segment_width, 9, drop_color)
					call graphics::draw_text(explorer_window, cursor_x + 4, y + 1, segment, visual_outline)
				}
				elseif (!explorer_modal_open()) {
					if (graphics::button_flat(explorer_window, cursor_x, y, segment_width, 9, segment, graphics::COLOR_8)) {
						if (index < path_length) {
							destination = explorer_path_prefix(current_path, index)
							call begin_path_transition(destination)
						}
						return
					}
				}
				else {
					call graphics::fill_rect(explorer_window, cursor_x, y, segment_width, 9, visual_surface)
					call graphics::draw_text(explorer_window, cursor_x + 4, y + 1, segment, visual_outline)
				}
				cursor_x += segment_width + 2
				start = index + 1
			}
			index += 1
		}
	}
}

fn viewer_row_height(font_size: int) int {
	if (font_size <= graphics::FONT_SMALL) { return 6 }
	if (font_size >= graphics::FONT_LARGE) { return 16 }
	return 8
}

fn viewer_font_size(content_width: int, content_height: int) int {
	if (content_width < 88 || content_height < 32) { return graphics::FONT_SMALL }
	return graphics::FONT_NORMAL
}

fn viewer_tab_advance(column: int, font_size: int) int {
	var tab_width: int
	tab_width = graphics::char_advance(' ', font_size) * 4
	if (tab_width < 1) { tab_width = 4 }
	return tab_width - column % tab_width
}

fn viewer_word_end(start: int) int {
	var index: int
	var code: int
	index = start
	while (index < xestring::strlen(viewer_content)) {
		code = (int)(viewer_content[index])
		if (code == 9 || code == 10 || code == 13 || code == 32) { return index }
		index += 1
	}
	return index
}

fn viewer_word_width(start: int, finish: int, font_size: int) int {
	var index: int
	var result: int
	var code: int
	index = start
	result = 0
	while (index < finish) {
		code = (int)(viewer_content[index])
		if (code >= 32 && code <= 126) {
			result += graphics::char_advance(viewer_content[index], font_size)
		}
		index += 1
	}
	return result
}

fn viewer_line_count(content_width: int, font_size: int) int {
	var index: int
	var column: int
	var lines: int
	var code: int
	var finish: int
	var word_width: int
	var advance: int
	if (content_width < 1) { content_width = 1 }
	index = 0
	column = 0
	lines = 1
	while (index < xestring::strlen(viewer_content)) {
		code = (int)(viewer_content[index])
		if (code == 10) {
			lines += 1
			column = 0
			index += 1
		}
		elseif (code == 13) { index += 1 }
		elseif (code == 9 || code == 32) {
			if (code == 9) { advance = viewer_tab_advance(column, font_size) }
			else { advance = graphics::char_advance(' ', font_size) }
			column += advance
			index += 1
		}
		else {
			finish = viewer_word_end(index)
			word_width = viewer_word_width(index, finish, font_size)
			if (word_width > content_width) {
				# Keep ordinary words intact. An unbreakable token wider than the
				# entire viewport uses an emergency character wrap so none of its
				# content is silently discarded.
				if (column > 0) {
					lines += 1
					column = 0
				}
				while (index < finish) {
					advance = graphics::char_advance(viewer_content[index], font_size)
					if (column > 0 && column + advance > content_width) {
						lines += 1
						column = 0
					}
					column += advance
					index += 1
				}
			}
			else {
				if (column > 0 && column + word_width > content_width) {
					lines += 1
					column = 0
				}
				column += word_width
				index = finish
			}
		}
	}
	return lines
}

proc draw_viewer_content(x: int, y: int, content_width: int, content_height: int, font_size: int) {
	var index: int
	var column: int
	var line: int
	var visible_line: int
	var maximum_lines: int
	var code: int
	var finish: int
	var word_width: int
	var advance: int
	var row_height: int
	row_height = viewer_row_height(font_size)
	maximum_lines = content_height / row_height
	if (maximum_lines < 1) { maximum_lines = 1 }
	if (xestring::strlen(viewer_content) == 0) {
		index = 0
		column = 0
		while (index < xestring::strlen("Empty file")) {
			call graphics::draw_char_styled(explorer_window, x + column, y, "Empty file"[index], graphics::WHITE, font_size, 0)
			column += graphics::char_advance("Empty file"[index], font_size)
			index += 1
		}
		return
	}
	index = 0
	column = 0
	line = 0
	while (index < xestring::strlen(viewer_content) && line < viewer_scroll + maximum_lines) {
		code = (int)(viewer_content[index])
		if (code == 10) {
			line += 1
			column = 0
			index += 1
		}
		elseif (code == 13) { index += 1 }
		elseif (code == 9 || code == 32) {
			if (code == 9) { advance = viewer_tab_advance(column, font_size) }
			else { advance = graphics::char_advance(' ', font_size) }
			column += advance
			index += 1
		}
		else {
			finish = viewer_word_end(index)
			word_width = viewer_word_width(index, finish, font_size)
			if (word_width > content_width) {
				if (column > 0) {
					line += 1
					column = 0
				}
				while (index < finish) {
					advance = graphics::char_advance(viewer_content[index], font_size)
					if (column > 0 && column + advance > content_width) {
						line += 1
						column = 0
					}
					if (line >= viewer_scroll && line < viewer_scroll + maximum_lines && column + advance <= content_width) {
						visible_line = line - viewer_scroll
						call graphics::draw_char_styled(explorer_window, x + column, y + visible_line * row_height, viewer_content[index], graphics::WHITE, font_size, 0)
					}
					column += advance
					index += 1
				}
			}
			else {
				if (column > 0 && column + word_width > content_width) {
					line += 1
					column = 0
				}
				while (index < finish) {
					code = (int)(viewer_content[index])
					if (code >= 32 && code <= 126) {
						advance = graphics::char_advance(viewer_content[index], font_size)
						if (line >= viewer_scroll && line < viewer_scroll + maximum_lines && column + advance <= content_width) {
							visible_line = line - viewer_scroll
							call graphics::draw_char_styled(explorer_window, x + column, y + visible_line * row_height, viewer_content[index], graphics::WHITE, font_size, 0)
						}
						column += advance
					}
					index += 1
				}
			}
		}
	}
}

proc draw_file_viewer() {
	var panel_x: int
	var panel_y: int
	var panel_width: int
	var panel_height: int
	var body_height: int
	var content_width: int
	var font_size: int
	var maximum_lines: int
	var maximum_scroll: int
	panel_x = 4
	panel_y = 4
	panel_width = width - 8
	panel_height = height - 8
	if (panel_width < 40) { panel_width = 40 }
	if (panel_height < 34) { panel_height = 34 }
	call graphics::fill_rect(explorer_window, panel_x, panel_y, panel_width, panel_height, visual_surface)
	call graphics::draw_rect(explorer_window, panel_x, panel_y, panel_width, panel_height, visual_accent)
	call draw_explorer_text_clipped(panel_x + 4, panel_y + 2, viewer_name, (panel_width - 108) / 4, visual_highlight)
	if (graphics::button_flat(explorer_window, panel_x + panel_width - 36, panel_y + 1, 34, 8, "Close", visual_surface)) {
		viewer_open = false
		return
	}
	body_height = panel_height - 15
	content_width = panel_width - 8
	font_size = viewer_font_size(content_width, body_height)
	maximum_lines = body_height / viewer_row_height(font_size)
	if (viewer_layout_width != content_width || viewer_layout_font != font_size) {
		viewer_layout_width = content_width
		viewer_layout_font = font_size
		viewer_layout_lines = viewer_line_count(content_width, font_size)
	}
	maximum_scroll = viewer_layout_lines - maximum_lines
	if (maximum_scroll < 0) { maximum_scroll = 0 }
	if (viewer_scroll > maximum_scroll) { viewer_scroll = maximum_scroll }
	if (panel_width >= 108) {
		if (graphics::button_flat(explorer_window, panel_x + panel_width - 100, panel_y + 1, 26, 8, "Up", visual_surface) && viewer_scroll > 0) {
			viewer_scroll -= 1
		}
		if (graphics::button_flat(explorer_window, panel_x + panel_width - 72, panel_y + 1, 34, 8, "Down", visual_surface) && viewer_scroll < maximum_scroll) {
			viewer_scroll += 1
		}
	}
	call draw_viewer_content(panel_x + 4, panel_y + 12, content_width, body_height, font_size)
}

proc draw_context_menu() {
	var menu_width: int
	var menu_height: int
	var inside: bool
	menu_width = 68
	menu_height = 29
	if (menu_width > width - 4) { menu_width = width - 4 }
	if (context_x + menu_width > width - 2) { context_x = width - menu_width - 2 }
	if (context_y + menu_height > height - 2) { context_y = height - menu_height - 2 }
	if (context_x < 2) { context_x = 2 }
	if (context_y < 2) { context_y = 2 }
	inside = graphics::pointer_x(explorer_window) >= context_x && graphics::pointer_x(explorer_window) < context_x + menu_width && graphics::pointer_y(explorer_window) >= context_y && graphics::pointer_y(explorer_window) < context_y + menu_height
	if (graphics::mouse_pressed() && !inside) {
		context_open = false
		return
	}
	call graphics::fill_rect(explorer_window, context_x, context_y, menu_width, menu_height, visual_surface)
	call graphics::draw_text_small(explorer_window, context_x + 3, context_y + 2, "Actions", visual_outline)
	if (graphics::button_flat(explorer_window, context_x + menu_width - 10, context_y + 1, 8, 7, "x", visual_surface)) {
		context_open = false
		return
	}
	if (graphics::button_flat(explorer_window, context_x + 2, context_y + 10, menu_width - 4, 8, "Rename", visual_surface)) {
		call begin_rename(context_entry)
		return
	}
	if (graphics::button_flat(explorer_window, context_x + 2, context_y + 19, menu_width - 4, 8, "Delete", graphics::COLOR_4)) {
		delete_confirm = true
		context_open = false
	}
}

proc draw_inline_rename() {
	var field_width: int
	var field_x: int
	var field_y: int
	var button_width: int
	var visible_chars: int
	var first_char: int
	var index: int
	var draw_index: int
	var selection_begin: int
	var selection_finish: int
	var caret_column: int
	var caret_x: int
	var pointer_x: int
	var pointer_y: int
	var pointer_in_field: bool
	var pointer_in_popup: bool
	field_width = 148
	if (field_width > width - 8) { field_width = width - 8 }
	if (field_width < 40) { field_width = 40 }
	field_x = rename_anchor_x - field_width / 2
	field_y = rename_anchor_y + 9
	if (field_x < 3) { field_x = 3 }
	if (field_x + field_width > width - 3) { field_x = width - field_width - 3 }
	if (field_y + 22 > height - 3) { field_y = rename_anchor_y - 27 }
	if (field_y < 3) { field_y = 3 }
	pointer_x = graphics::pointer_x(explorer_window)
	pointer_y = graphics::pointer_y(explorer_window)
	visible_chars = (field_width - 6) / 4
	if (visible_chars < 1) { visible_chars = 1 }
	first_char = 0
	if (rename_cursor >= visible_chars) { first_char = rename_cursor - visible_chars + 1 }
	selection_begin = explorer_rename_selection_begin()
	selection_finish = explorer_rename_selection_finish()
	if (selection_begin == 0 && selection_finish == xestring::strlen(rename_text)) { first_char = 0 }
	rename_first_char = first_char
	pointer_in_field = pointer_x >= field_x && pointer_x < field_x + field_width && pointer_y >= field_y && pointer_y < field_y + 10
	pointer_in_popup = pointer_x >= field_x && pointer_x < field_x + field_width && pointer_y >= field_y && pointer_y < field_y + 20
	if (rename_pointer_guard == 0 && graphics::mouse_pressed()) {
		if (pointer_in_field) {
			rename_cursor = rename_first_char + (pointer_x - field_x) / 4
			if (rename_cursor < 0) { rename_cursor = 0 }
			if (rename_cursor > xestring::strlen(rename_text)) { rename_cursor = xestring::strlen(rename_text) }
			call explorer_clear_rename_selection()
		}
		elseif (!pointer_in_popup) {
			call cancel_rename()
			return
		}
	}
	call graphics::fill_rect(explorer_window, field_x, field_y, field_width, 10, visual_surface)
	call graphics::draw_rect(explorer_window, field_x, field_y, field_width, 10, visual_accent)
	index = first_char
	draw_index = 0
	while (index < xestring::strlen(rename_text) && draw_index < visible_chars) {
		if (index >= selection_begin && index < selection_finish) {
			call graphics::fill_rect(explorer_window, field_x + 2 + draw_index * 4, field_y + 2, 4, 6, graphics::COLOR_5)
		}
		call graphics::draw_char_small(explorer_window, field_x + 2 + draw_index * 4, field_y + 2, rename_text[index], graphics::WHITE)
		index += 1
		draw_index += 1
	}
	if ((current_ticks / 450) % 2 == 0) {
		caret_column = rename_cursor - first_char
		if (caret_column < 0) { caret_column = 0 }
		if (caret_column > visible_chars) { caret_column = visible_chars }
		caret_x = field_x + 2 + caret_column * 4
		if (caret_x > field_x + field_width - 3) { caret_x = field_x + field_width - 3 }
		call graphics::draw_line(explorer_window, caret_x, field_y + 2, caret_x, field_y + 7, visual_highlight)
	}
	button_width = (field_width - 2) / 2
	if (graphics::button_flat(explorer_window, field_x, field_y + 11, button_width, 9, "Rename", visual_accent)) {
		call commit_rename()
	}
	if (graphics::button_flat(explorer_window, field_x + button_width + 2, field_y + 11, button_width, 9, "Cancel", visual_surface)) {
		call cancel_rename()
	}
}

proc draw_delete_dialog() {
	var panel_width: int
	var panel_x: int
	var panel_y: int
	panel_width = 156
	if (panel_width > width - 8) { panel_width = width - 8 }
	panel_x = (width - panel_width) / 2
	panel_y = height / 2 - 19
	if (panel_y < 3) { panel_y = 3 }
	call graphics::fill_rect(explorer_window, panel_x, panel_y, panel_width, 38, visual_surface)
	call graphics::draw_rect(explorer_window, panel_x, panel_y, panel_width, 38, visual_accent)
	call graphics::draw_text_small(explorer_window, panel_x + 4, panel_y + 5, "Move this item to Trash?", visual_highlight)
	if (graphics::button_flat(explorer_window, panel_x + 4, panel_y + 23, (panel_width - 12) / 2, 10, "Delete", graphics::COLOR_4)) {
		call confirm_context_delete()
	}
	if (graphics::button_flat(explorer_window, panel_x + 8 + (panel_width - 12) / 2, panel_y + 23, (panel_width - 12) / 2, 10, "Cancel", visual_surface)) {
		delete_confirm = false
	}
}

proc draw_explorer_sidebar(x: int, y: int, max_height: int) {
	var surface: int
	var panel_height: int
	var danger_color: int
	var pointer_x: int
	var pointer_y: int
	var interactive: bool
	surface = graphics::COLOR_8
	if (os::theme_mode == os::THEME_LIGHT) { surface = graphics::COLOR_1 }
	panel_height = 62 * sidebar_progress / 100
	if (panel_height < 9) { panel_height = 9 }
	if (panel_height > max_height) { panel_height = max_height }
	call graphics::fill_rect(explorer_window, x, y, sidebar_width, panel_height, surface)
	interactive = !explorer_modal_open()
	if (sidebar_open) {
		if (interactive && graphics::button_flat(explorer_window, x, y, 14, 9, " ", surface)) { sidebar_open = false }
		call draw_explorer_chevron(x + 5, y + 3, true, visual_outline)
	}
	else {
		if (interactive && graphics::button_flat(explorer_window, x, y, 14, 9, " ", surface)) { sidebar_open = true }
		call draw_explorer_chevron(x + 5, y + 2, false, visual_outline)
	}
	if (sidebar_progress >= 70 && max_height >= 48) {
		call draw_explorer_text_clipped(x + 18, y + 2, "Create (Drag)", (sidebar_width - 20) / 4, visual_outline)
		if (interactive) {
			operation_ok = graphics::button_flat(explorer_window, x + 3, y + 12, sidebar_width - 6, 10, "New file", surface)
			operation_ok = graphics::button_flat(explorer_window, x + 3, y + 23, sidebar_width - 6, 10, "New folder", surface)
		}
		else {
			call graphics::fill_rect(explorer_window, x + 3, y + 12, sidebar_width - 6, 10, surface)
			call graphics::fill_rect(explorer_window, x + 3, y + 23, sidebar_width - 6, 10, surface)
			call draw_explorer_text_clipped(x + 8, y + 14, "New file", (sidebar_width - 12) / 4, visual_outline)
			call draw_explorer_text_clipped(x + 8, y + 25, "New folder", (sidebar_width - 12) / 4, visual_outline)
		}
		pointer_x = graphics::pointer_x(explorer_window)
		pointer_y = graphics::pointer_y(explorer_window)
		if (interactive && graphics::mouse_pressed() && pointer_x >= x + 3 && pointer_x < x + sidebar_width - 3 && pointer_y >= y + 12 && pointer_y < y + 22) {
			drag_template = 1
		}
		if (interactive && graphics::mouse_pressed() && pointer_x >= x + 3 && pointer_x < x + sidebar_width - 3 && pointer_y >= y + 23 && pointer_y < y + 33) {
			drag_template = 2
		}
		danger_color = surface
		if (drag_entry >= 0 && graphics::pointer_x(explorer_window) >= x + 3 && graphics::pointer_x(explorer_window) < x + sidebar_width - 3 && graphics::pointer_y(explorer_window) >= y + 38 && graphics::pointer_y(explorer_window) < y + 48) { danger_color = graphics::COLOR_4 }
		call graphics::fill_rect(explorer_window, x + 3, y + 38, sidebar_width - 6, 10, danger_color)
		call draw_explorer_text_clipped(x + 8, y + 40, "Trash (Drag)", (sidebar_width - 12) / 4, visual_outline)
		if (sidebar_progress >= 90 && max_height >= 61) {
			call graphics::draw_text_small(explorer_window, x + 3, y + 53, "Orbit", visual_outline)
			if (interactive) {
				orbit_speed_setting = graphics::slider(explorer_window, x + 26, y + 51, sidebar_width - 29, orbit_speed_setting, 8, 56)
			}
		}
	}
}

proc draw_file_atom(x: int, y: int, area_width: int, area_height: int) {
	var count: int
	var index: int
	var shell: int
	var position: int
	var population: int
	var angle: float
	var radius: int
	var atom_x: int
	var atom_y: int
	var node_radius: int
	var center_x: int
	var center_y: int
	var pointer_x: int
	var pointer_y: int
	var dx: int
	var dy: int
	var distance_squared: int
	var target_shell: int
	var shell_button_color: int
	var outer_radius: int
	var shell_gap: int
	var transition_scale: int
	var center_radius: int
	var base_center_radius: int
	var hit_radius: int
	var candidate_name: string
	var shell_distance: int
	var best_distance: int
	var closest_shell: int
	var shell_button_x: int
	var shell_button_y: int
	var label_entry: int
	var interaction_allowed: bool
	var viewport_center_x: int
	var viewport_center_y: int
	var eased_progress: int
	var phase_progress: int
	var scene_visibility: int
	var focus_shell: int
	var focus_position: int
	var focus_population: int
	var focus_angle: float
	var focus_radius: int
	var plane_x: float
	var plane_y: float
	var tilt_cosine: float
	var projected_distance: int
	var drop_target_shell: int
	var created_entry: int
	var add_radius: int
	var add_size: int
	var render_scale: int
	var name_chars: int
	var name_width: int
	var label_full_chars: int
	var label_center_x: int
	var label_center_y: int
	var name_x: int
	var name_y: int
	var name_color: int
	var all_shells_full: bool
	var zoom_minus_x: int
	var zoom_plus_x: int
	var zoom_y: int
	var modifiers: int
	var selection_index: int
	var selection_move_count: int
	var label_dx: int
	var label_dy: int
	var label_length: float
	var label_unit_x: float
	var label_unit_y: float
	var label_abs_unit_x: float
	var label_abs_unit_y: float
	var label_half_width: float
	var label_half_height: float
	var label_clearance: float
	var label_candidate_distance: float
	var label_cross: float
	var label_radicand: float
	var label_center_distance: float
	var usable_width: int
	var slot_eased_progress: int
	count = cached_entry_count
	call prepare_orbit_projection(tilt, view_roll)
	usable_width = area_width - sidebar_width
	viewport_center_x = x + (area_width + sidebar_width) / 2
	viewport_center_y = y + area_height / 2
	center_x = viewport_center_x
	center_y = viewport_center_y
	atom_center_x = center_x
	atom_center_y = center_y
	pointer_x = graphics::pointer_x(explorer_window)
	pointer_y = graphics::pointer_y(explorer_window)
	hovered_entry = -1
	hovered_shell = -1
	drop_folder_entry = -1
	label_entry = selected_entry
	zoom_controls_hovered = false
	interaction_allowed = !context_open && !rename_open && !delete_confirm && !viewer_open && transition_progress == 0
	if (usable_width < 108 || area_height < 94) {
		drag_entry = -1
		drag_template = 0
		rotating = false
		center_radius = area_width / 8
		if (center_radius > area_height / 4) { center_radius = area_height / 4 }
		if (center_radius < 3) { center_radius = 3 }
		if (center_radius > 7) { center_radius = 7 }
		call draw_placeholder_nucleus(center_x, center_y, center_radius)
		call graphics::draw_int_small(explorer_window, center_x - 2, center_y - 2, count, graphics::WHITE)
		return
	}
	transition_scale = 100
	scene_visibility = 100
	if (transition_progress > 0) {
		if (!transition_committed) {
			phase_progress = transition_progress
			if (phase_progress > 100) { phase_progress = 100 }
			eased_progress = transition_ease(phase_progress)
			scene_visibility = 100 - eased_progress
			if (transition_direction > 0) {
				transition_scale = 100 + eased_progress * 200 / 100
				center_x = viewport_center_x - transition_focus_x * transition_scale * eased_progress / 10000
				center_y = viewport_center_y - transition_focus_y * transition_scale * eased_progress / 10000
			}
			else {
				transition_scale = 100 - eased_progress * 15 / 100
				center_x = viewport_center_x
				center_y = viewport_center_y
			}
		}
		else {
			phase_progress = transition_progress - 100
			if (phase_progress < 0) { phase_progress = 0 }
			if (phase_progress > 100) { phase_progress = 100 }
			eased_progress = transition_ease(phase_progress)
			scene_visibility = eased_progress
			if (transition_direction > 0) {
				transition_scale = 85 + eased_progress * 15 / 100
				center_x = viewport_center_x
				center_y = viewport_center_y
			}
			else {
				transition_scale = 300 - eased_progress * 200 / 100
				if (transition_entry >= 0 && transition_entry < count) {
					focus_shell = entry_shell[transition_entry]
					if (focus_shell >= shell_count) { focus_shell = shell_count - 1 }
					focus_population = shell_population_cache[focus_shell]
					focus_position = entry_position_cache[transition_entry]
					outer_radius = (area_height - 34) / 2
					if (outer_radius > (usable_width - 48) / 2) { outer_radius = (usable_width - 48) / 2 }
					if (outer_radius < 30) { outer_radius = 30 }
					shell_gap = 0
					if (shell_count > 1) { shell_gap = (outer_radius - 30) / (shell_count - 1) }
					focus_radius = 30 + focus_shell * shell_gap
					focus_angle = (float)(rotation + shell_phase[focus_shell] + focus_position * 360 / focus_population + focus_shell * 17)
					call orbit_project(focus_radius, focus_angle)
					transition_focus_x = projected_x
					transition_focus_y = projected_y
				}
				center_x = viewport_center_x - transition_focus_x * transition_scale * (100 - eased_progress) / 10000
				center_y = viewport_center_y - transition_focus_y * transition_scale * (100 - eased_progress) / 10000
			}
		}
	}
	if (transition_scale < 85) { transition_scale = 85 }
	if (transition_scale > 300) { transition_scale = 300 }
	render_scale = transition_scale * camera_zoom / 100
	if (render_scale < 55) { render_scale = 55 }
	if (render_scale > 450) { render_scale = 450 }
	atom_center_x = center_x
	atom_center_y = center_y
	base_center_radius = 8 + area_height / 28
	if (base_center_radius < 11) { base_center_radius = 11 }
	if (base_center_radius > 20) { base_center_radius = 20 }
	center_radius = base_center_radius * render_scale / 100
	visual_fade = scene_visibility
	visual_force_opaque = transition_progress > 0 && ((transition_direction > 0 && transition_committed) || (transition_direction < 0 && !transition_committed))
	call draw_placeholder_nucleus(center_x, center_y, center_radius)
	visual_force_opaque = false
	outer_radius = (area_height - 34) / 2
	if (outer_radius > (usable_width - 48) / 2) { outer_radius = (usable_width - 48) / 2 }
	if (outer_radius < 30) { outer_radius = 30 }
	shell_gap = 0
	if (shell_count > 1) { shell_gap = (outer_radius - 30) / (shell_count - 1) }
	shell = 0
	while (shell < shell_count && transition_scale >= 24) {
		radius = (30 + shell * shell_gap) * render_scale / 100
		call draw_placeholder_shell(center_x, center_y, radius, tilt, view_roll)
		shell += 1
	}
	all_shells_full = true
	shell = 0
	while (shell < shell_count) {
		if (shell_population_cache[shell] < shell_capacity) { all_shells_full = false }
		shell += 1
	}
	shell_button_hovered = false
	if (shell_count < 8 && transition_progress == 0) {
		add_radius = (30 + (shell_count - 1) * shell_gap) * render_scale / 100 + 13
		call orbit_project(add_radius, 35.0)
		shell_button_x = center_x + projected_x
		shell_button_y = center_y + projected_y
		dx = pointer_x - shell_button_x
		dy = pointer_y - shell_button_y
		shell_button_hovered = dx * dx + dy * dy <= 81
	}
	if (area_width >= 48 && transition_progress == 0) {
		zoom_minus_x = x + area_width - 25
		zoom_plus_x = x + area_width - 13
		zoom_y = y + 2
		zoom_controls_hovered = pointer_x >= zoom_minus_x - 1 && pointer_x < zoom_plus_x + 11 && pointer_y >= zoom_y - 1 && pointer_y < zoom_y + 10
	}
	index = 0
	while (index < count) {
		shell = entry_shell[index]
		if (shell >= shell_count) { shell = shell_count - 1; entry_shell[index] = shell }
		population = shell_population_cache[shell]
		position = entry_position_cache[index]
		angle = (float)(rotation + shell_phase[shell] + position * 360 / population + shell * 17)
		radius = (30 + shell * shell_gap) * render_scale / 100
		call orbit_project(radius, angle)
		atom_x = center_x + projected_x
		atom_y = center_y + projected_y
		if (transition_progress > 0 && transition_direction > 0 && !transition_committed && transition_entry == index) {
			atom_x = viewport_center_x + transition_focus_x * transition_scale * (100 - eased_progress) / 10000
			atom_y = viewport_center_y + transition_focus_y * transition_scale * (100 - eased_progress) / 10000
		}
		elseif (transition_progress > 0 && transition_direction < 0 && transition_committed && transition_entry == index) {
			atom_x = viewport_center_x + transition_focus_x * transition_scale * eased_progress / 10000
			atom_y = viewport_center_y + transition_focus_y * transition_scale * eased_progress / 10000
		}
		if (transition_progress == 0 && entry_slot_progress[index] < 100) {
			entry_slot_progress[index] += animation_step * 2
			if (entry_slot_progress[index] > 100) { entry_slot_progress[index] = 100 }
			slot_eased_progress = transition_ease(entry_slot_progress[index])
			atom_x = entry_slot_start_x[index] + (atom_x - entry_slot_start_x[index]) * slot_eased_progress / 100
			atom_y = entry_slot_start_y[index] + (atom_y - entry_slot_start_y[index]) * slot_eased_progress / 100
		}
		entry_render_x[index] = atom_x
		entry_render_y[index] = atom_y
		node_radius = (2 + outer_radius / 48) * render_scale / 100
		if (node_radius < 2) { node_radius = 2 }
		if (transition_progress == 0 && node_radius > 6) { node_radius = 6 }
		elseif (transition_progress > 0 && node_radius > 12) { node_radius = 12 }
		if (drag_entry != index && transition_scale >= 24) {
			visual_force_opaque = transition_progress > 0 && ((!transition_committed && transition_direction > 0 && transition_entry == index) || (transition_committed && transition_direction < 0 && transition_entry == index))
			if (entry_directory_cache[index] != 0) {
				call draw_placeholder_folder(atom_x, atom_y, node_radius + 1)
			}
			else {
				call draw_placeholder_file(atom_x, atom_y, node_radius)
			}
			if (entry_selected[index] != 0) {
				call graphics::draw_circle(explorer_window, atom_x, atom_y, node_radius + 4, visual_accent)
			}
			visual_force_opaque = false
		}
		dx = pointer_x - atom_x
		dy = pointer_y - atom_y
		distance_squared = dx * dx + dy * dy
		hit_radius = node_radius + 10
		if (distance_squared < hit_radius * hit_radius && pointer_x > x + sidebar_width && !shell_button_hovered && !zoom_controls_hovered && (drag_entry != index || !drag_moved)) {
			hovered_entry = index
			hovered_shell = shell
			if (drag_entry >= 0 && drag_moved && drag_entry != index && entry_directory_cache[index] != 0) {
				drop_folder_entry = index
				call graphics::draw_circle(explorer_window, atom_x, atom_y, node_radius + 6, graphics::COLOR_14)
			}
			if (drag_entry < 0) {
				call draw_placeholder_drag_handle(atom_x, atom_y + node_radius + 5, visual_highlight)
			}
			if (interaction_allowed && graphics::mouse_pressed() && transition_progress == 0) {
				drag_entry = index
				drag_start_x = pointer_x
				drag_start_y = pointer_y
				drag_moved = false
			}
		}
		if (transition_progress == 0 && drag_entry != index) {
			label_full_chars = xestring::strlen(entry_name_cache[index])
			if (label_full_chars > (area_width - sidebar_width - 8) / 4) { label_full_chars = (area_width - sidebar_width - 8) / 4 }
			if (label_full_chars < 1) { label_full_chars = 1 }
			name_chars = 4
			if (name_chars > label_full_chars) { name_chars = label_full_chars }
			name_color = visual_shell
			if (camera_zoom >= 125) {
				name_chars = label_full_chars
				name_color = visual_outline
			}
			if (hovered_entry == index || entry_selected[index] != 0) {
				name_chars = label_full_chars
				name_color = visual_highlight
			}
			name_width = name_chars * 4
			label_dx = atom_x - center_x
			label_dy = atom_y - center_y
			label_length = math::sqrt((float)(label_dx * label_dx + label_dy * label_dy))
			if (label_length < 1.0) {
				label_dx = 0
				label_dy = -1
				label_length = 1.0
			}
			label_unit_x = (float)label_dx / label_length
			label_unit_y = (float)label_dy / label_length
			label_abs_unit_x = label_unit_x
			label_abs_unit_y = label_unit_y
			if (label_abs_unit_x < 0.0) { label_abs_unit_x = -label_abs_unit_x }
			if (label_abs_unit_y < 0.0) { label_abs_unit_y = -label_abs_unit_y }
			label_half_width = (float)name_width / 2.0
			label_half_height = 2.5
			label_clearance = (float)(node_radius + 3)
			label_center_distance = 0.0
			if (label_abs_unit_x > 0.001) {
				label_candidate_distance = (label_clearance + label_half_width) / label_abs_unit_x
				if (label_abs_unit_y * label_candidate_distance <= label_half_height) { label_center_distance = label_candidate_distance }
			}
			if (label_center_distance < 0.001 && label_abs_unit_y > 0.001) {
				label_candidate_distance = (label_clearance + label_half_height) / label_abs_unit_y
				if (label_abs_unit_x * label_candidate_distance <= label_half_width) { label_center_distance = label_candidate_distance }
			}
			if (label_center_distance < 0.001) {
				label_cross = label_abs_unit_y * label_half_width - label_abs_unit_x * label_half_height
				label_radicand = label_clearance * label_clearance - label_cross * label_cross
				if (label_radicand < 0.0) { label_radicand = 0.0 }
				label_center_distance = label_abs_unit_x * label_half_width + label_abs_unit_y * label_half_height + math::sqrt(label_radicand)
			}
			if (label_unit_x >= 0.0) { label_center_x = atom_x + (int)(label_unit_x * label_center_distance + 0.5) }
			else { label_center_x = atom_x + (int)(label_unit_x * label_center_distance - 0.5) }
			if (label_unit_y >= 0.0) { label_center_y = atom_y + (int)(label_unit_y * label_center_distance + 0.5) }
			else { label_center_y = atom_y + (int)(label_unit_y * label_center_distance - 0.5) }
			name_x = label_center_x - name_width / 2
			name_y = label_center_y - 2
			call draw_explorer_text_clipped(name_x, name_y, entry_name_cache[index], name_chars, name_color)
		}
		index += 1
	}
	visual_fade = 100
	dx = pointer_x - center_x
	dy = pointer_y - center_y
	plane_x = (float)dx * math::cos((float)view_roll) + (float)dy * math::sin((float)view_roll)
	plane_y = (float)(-dx) * math::sin((float)view_roll) + (float)dy * math::cos((float)view_roll)
	tilt_cosine = math::cos((float)tilt)
	if (tilt_cosine < 0.25 && tilt_cosine > -0.25) {
		if (tilt_cosine < 0) { tilt_cosine = -0.25 }
		else { tilt_cosine = 0.25 }
	}
	plane_y /= tilt_cosine
	projected_distance = (int)(math::sqrt(plane_x * plane_x + plane_y * plane_y) * 100.0 / (float)render_scale)
	closest_shell = 0
	best_distance = projected_distance - 30
	if (best_distance < 0) { best_distance = -best_distance }
	shell = 1
	while (shell < shell_count) {
		shell_distance = projected_distance - (30 + shell * shell_gap)
		if (shell_distance < 0) { shell_distance = -shell_distance }
		if (shell_distance < best_distance) {
			best_distance = shell_distance
			closest_shell = shell
		}
		shell += 1
	}
	drop_target_shell = closest_shell
	if (best_distance > 11 && projected_distance > base_center_radius + 7) { drop_target_shell = -1 }
	if (hovered_shell < 0 && best_distance <= 17 && projected_distance > base_center_radius + 4 && pointer_x > x + sidebar_width) {
		hovered_shell = closest_shell
	}
	if (interaction_allowed && graphics::right_mouse_pressed() && hovered_entry >= 0) {
		context_entry = hovered_entry
		if (entry_selected[hovered_entry] == 0) { call select_only_entry(hovered_entry) }
		else { selected_entry = hovered_entry }
		context_x = pointer_x
		context_y = pointer_y
		context_open = true
		last_click_entry = -1
	}
	if (drag_entry >= 0 && graphics::mouse_down()) {
		dx = pointer_x - drag_start_x
		dy = pointer_y - drag_start_y
		if (dx * dx + dy * dy > 9) { drag_moved = true }
		if (entry_directory_cache[drag_entry] != 0) {
			call draw_placeholder_folder(pointer_x, pointer_y, 5)
		}
		else {
			call draw_placeholder_file(pointer_x, pointer_y, 3)
		}
	}
	if (drag_entry >= 0 && graphics::mouse_released()) {
		if (!drag_moved) {
			modifiers = graphics::modifiers()
			if (modifiers == 0 && last_click_entry == drag_entry && current_ticks - last_click_ticks <= 450) {
				if (entry_directory_cache[drag_entry] != 0) {
					transition_focus_x = entry_render_x[drag_entry] - atom_center_x
					transition_focus_y = entry_render_y[drag_entry] - atom_center_y
					call begin_folder_transition(drag_entry, 1)
				}
				else { call open_file_viewer(drag_entry) }
				last_click_entry = -1
			}
			else {
				call select_clicked_entry(drag_entry)
				if (modifiers == 0) {
					last_click_entry = drag_entry
					last_click_ticks = current_ticks
				}
				else { last_click_entry = -1 }
			}
		}
		elseif (pointer_x >= x + 3 && pointer_x < x + sidebar_width - 3 && pointer_y >= y + 38 && pointer_y < y + 48 && sidebar_progress >= 70) {
			operation_ok = os::delete(explorer_join_path(current_path, entry_name_cache[drag_entry]))
			call explorer_set(status_text, "Moved to Trash")
			if (operation_ok) {
				call reset_energy_shells()
				selected_entry = -1
			}
		}
		elseif (drag_moved && drop_path_active) {
			call move_entry_to_path(drag_entry, drop_path_target)
		}
		elseif (drag_moved && drop_folder_entry >= 0) {
			call move_entry_into_folder(drag_entry, drop_folder_entry)
		}
		elseif (drag_moved) {
			target_shell = drop_target_shell
			selection_move_count = 0
			if (target_shell >= 0 && entry_selected[drag_entry] != 0) {
				selection_index = 0
				while (selection_index < count) {
					if (entry_selected[selection_index] != 0 && entry_shell[selection_index] != target_shell) { selection_move_count += 1 }
					selection_index += 1
				}
			}
			elseif (target_shell >= 0 && entry_shell[drag_entry] != target_shell) { selection_move_count = 1 }
			if (target_shell >= 0 && shell_population_cache[target_shell] + selection_move_count <= shell_capacity) {
				if (selection_move_count > 0) { call begin_slot_animation_all() }
				if (entry_selected[drag_entry] != 0) {
					selection_index = 0
					while (selection_index < count) {
						if (entry_selected[selection_index] != 0) { entry_shell[selection_index] = target_shell }
						selection_index += 1
					}
				}
				else { entry_shell[drag_entry] = target_shell }
				call compact_energy_shells(count)
			}
			elseif (target_shell >= 0) { full_hint = 100 }
		}
		if (drag_moved) {
			last_click_entry = -1
			last_click_ticks = -1000
		}
		drag_entry = -1
	}
	if (drag_template > 0 && graphics::mouse_down()) {
		if (drag_template == 1) {
			call draw_placeholder_file(pointer_x, pointer_y, 3)
		}
		else {
			call draw_placeholder_folder(pointer_x, pointer_y, 5)
		}
	}
	if (drag_template > 0 && graphics::mouse_released()) {
		target_shell = drop_target_shell
		if (target_shell >= 0 && shell_population_cache[target_shell] < shell_capacity) {
			candidate_name = explorer_unique_template_name(drag_template == 2)
			if (drag_template == 1) { operation_ok = os::make_file(explorer_join_path(current_path, candidate_name)) }
			else { operation_ok = os::make_directory(explorer_join_path(current_path, candidate_name)) }
			if (operation_ok) {
				call explorer_set(status_text, xestring::concat("Added ", candidate_name))
				call begin_slot_animation_for_shell(target_shell)
				created_entry = cached_entry_count
				entry_name_cache[created_entry] = candidate_name
				if (drag_template == 2) { entry_directory_cache[created_entry] = 1 }
				else { entry_directory_cache[created_entry] = 0 }
				entry_shell[created_entry] = target_shell
				entry_slot_start_x[created_entry] = pointer_x
				entry_slot_start_y[created_entry] = pointer_y
				entry_slot_progress[created_entry] = 0
				cached_entry_count += 1
				call rebuild_shell_layout()
			}
			else {
				call explorer_set(status_text, "Could not create item")
			}
		}
		elseif (target_shell >= 0) { full_hint = 100 }
		drag_template = 0
	}
	if (shell_count < 8 && transition_progress == 0) {
		add_size = 2
		shell_button_color = visual_outline
		if (all_shells_full || full_hint > 0) {
			add_size = 3
			shell_button_color = visual_highlight
		}
		if ((shell_button_hovered && all_shells_full) || full_hint > 0) {
			add_size = 4
		}
		call graphics::draw_line(explorer_window, shell_button_x - add_size, shell_button_y, shell_button_x + add_size, shell_button_y, shell_button_color)
		call graphics::draw_line(explorer_window, shell_button_x, shell_button_y - add_size, shell_button_x, shell_button_y + add_size, shell_button_color)
		if (interaction_allowed && shell_button_hovered && graphics::mouse_pressed()) {
			if (all_shells_full) {
				call begin_slot_animation_all()
				shell_count += 1
				full_hint = 0
				call explorer_set(status_text, "Empty shell added; drag an item onto it")
			}
			else { call explorer_set(status_text, "Fill the current shells before adding one") }
		}
	}
	if (area_width >= 48 && transition_progress == 0) {
		if (interaction_allowed) {
			if (graphics::button_flat(explorer_window, zoom_minus_x, zoom_y, 10, 8, "-", visual_surface)) { call adjust_explorer_zoom(-15) }
			if (graphics::button_flat(explorer_window, zoom_plus_x, zoom_y, 10, 8, "+", visual_surface)) { call adjust_explorer_zoom(15) }
		}
		else {
			call graphics::fill_rect(explorer_window, zoom_minus_x, zoom_y, 10, 8, visual_surface)
			call graphics::fill_rect(explorer_window, zoom_plus_x, zoom_y, 10, 8, visual_surface)
			call graphics::draw_text_small(explorer_window, zoom_minus_x + 3, zoom_y + 1, "-", visual_outline)
			call graphics::draw_text_small(explorer_window, zoom_plus_x + 3, zoom_y + 1, "+", visual_outline)
		}
	}
	if (full_hint > 0) {
		full_hint -= animation_step
		if (full_hint < 0) { full_hint = 0 }
	}
}

current_path = "."
status_text = "root"
cached_entry_count = 0
cached_parent_path = ""
sidebar_open = false
sidebar_progress = 0
shell_count = 1
paused_shell = -1
hovered_shell = -1
nucleus_phase = 0
animation_shell = 0
orbit_speed_setting = 32
while (animation_shell < 8) {
	shell_phase[animation_shell] = animation_shell * 23
	shell_accumulator[animation_shell] = 0
	shell_speed[animation_shell] = 32
	animation_shell += 1
}
rotation = 0
tilt = 25
rotating = false
hovered_entry = -1
selected_entry = -1
selection_anchor = -1
drag_entry = -1
drag_template = 0
drag_moved = false
transition_progress = 0
transition_entry = -1
transition_focus_x = 0
transition_focus_y = 0
transition_committed = false
transition_destination = ""
transition_target_name = ""
transition_hops = 1
transition_step = 1
shell_capacity = 8
last_click_entry = -1
last_click_ticks = -1000
context_open = false
context_entry = -1
rename_open = false
rename_text = ""
rename_scratch = ""
rename_insert = ""
rename_clipboard = ""
rename_select_all = false
rename_cursor = 0
rename_selection_start = 0
rename_selection_end = 0
rename_first_char = 0
rename_pointer_guard = 0
rename_anchor_x = 0
rename_anchor_y = 0
delete_confirm = false
viewer_open = false
viewer_name = ""
viewer_content = ""
viewer_scroll = 0
viewer_layout_width = -1
viewer_layout_font = graphics::FONT_NORMAL
viewer_layout_lines = 1
call refresh_explorer_style()
call reset_energy_shells()
shell_button_hovered = false
zoom_controls_hovered = false
marquee_active = false
marquee_mode = 0
marquee_start_x = 0
marquee_start_y = 0
marquee_current_x = 0
marquee_current_y = 0
camera_zoom = 100
camera_zoom_target = 100
zoom_difference = 0
zoom_step = 0
scroll_steps = 0
drop_path_active = false
drop_path_target = ""
visual_fade = 100
visual_force_opaque = false
view_roll = -12

explorer_window.x = 66
explorer_window.y = 44
explorer_window.width = 300
explorer_window.height = 220
explorer_window.title = "Xenon File Explorer"
explorer_window.ui_scale = 1
explorer_window.state = graphics::WINDOW_NORMAL
previous_ticks = os::ticks()

while (explorer_window.state != graphics::WINDOW_CLOSED) {
	current_ticks = os::ticks()
	delta_ms = current_ticks - previous_ticks
	if (delta_ms < 1) { delta_ms = 1 }
	if (delta_ms > 50) { delta_ms = 50 }
	previous_ticks = current_ticks
	if (rename_pointer_guard > 0) { rename_pointer_guard -= 1 }
	animation_step = delta_ms * 100 / 220
	if (animation_step < 1) { animation_step = 1 }
	if (animation_step > 24) { animation_step = 24 }
	if (sidebar_open && sidebar_progress < 100) { sidebar_progress += animation_step }
	elseif (!sidebar_open && sidebar_progress > 0) { sidebar_progress -= animation_step }
	if (sidebar_progress > 100) { sidebar_progress = 100 }
	if (sidebar_progress < 0) { sidebar_progress = 0 }
	sidebar_width = 14 + 70 * sidebar_progress / 100
	zoom_difference = camera_zoom_target - camera_zoom
	if (zoom_difference != 0) {
		zoom_step = zoom_difference * animation_step / 100
		if (zoom_step == 0 && zoom_difference > 0) { zoom_step = 1 }
		elseif (zoom_step == 0) { zoom_step = -1 }
		camera_zoom += zoom_step
		if (zoom_difference > 0 && camera_zoom > camera_zoom_target) { camera_zoom = camera_zoom_target }
		elseif (zoom_difference < 0 && camera_zoom < camera_zoom_target) { camera_zoom = camera_zoom_target }
	}
	paused_shell = hovered_shell
	hover_pause_allowed = !rotating && !marquee_active && drag_entry < 0 && drag_template == 0 && transition_progress == 0 && !context_open && !rename_open && !delete_confirm && !viewer_open
	if (!hover_pause_allowed) { paused_shell = -1 }
	if (transition_progress == 0) {
		orbit_ease = animation_step * 2
		if (orbit_ease > 40) { orbit_ease = 40 }
		animation_shell = 0
		while (animation_shell < 8) {
			orbit_speed_target = orbit_speed_setting
			if (animation_shell == paused_shell && hovered_entry >= 0 && entry_shell[hovered_entry] == animation_shell) {
				shell_speed[animation_shell] = 0
				shell_accumulator[animation_shell] = 0
			}
			else {
				if (animation_shell == paused_shell) {
					orbit_speed_target = orbit_speed_setting / 8
					if (orbit_speed_target < 2) { orbit_speed_target = 2 }
				}
				orbit_speed_difference = orbit_speed_target - shell_speed[animation_shell]
				orbit_speed_step = orbit_speed_difference * orbit_ease / 100
				if (orbit_speed_step == 0 && orbit_speed_difference > 0) { orbit_speed_step = 1 }
				elseif (orbit_speed_step == 0 && orbit_speed_difference < 0) { orbit_speed_step = -1 }
				shell_speed[animation_shell] += orbit_speed_step
				if (orbit_speed_difference > 0 && shell_speed[animation_shell] > orbit_speed_target) { shell_speed[animation_shell] = orbit_speed_target }
				elseif (orbit_speed_difference < 0 && shell_speed[animation_shell] < orbit_speed_target) { shell_speed[animation_shell] = orbit_speed_target }
			}
			shell_accumulator[animation_shell] += delta_ms * shell_speed[animation_shell]
			shell_phase[animation_shell] = (shell_phase[animation_shell] + shell_accumulator[animation_shell] / 1000) % 360
			shell_accumulator[animation_shell] %= 1000
			animation_shell += 1
		}
		nucleus_phase = (nucleus_phase + delta_ms) % 1200
	}
	if (transition_progress > 0) {
		transition_step = animation_step * (100 + (transition_hops - 1) * 35) / 100
		if (transition_step < 1) { transition_step = 1 }
		if (transition_step > animation_step * 3) { transition_step = animation_step * 3 }
		transition_progress += transition_step
		if (!transition_committed && transition_progress > 100) { transition_progress = 100 }
		if (transition_committed && transition_progress >= 200) {
			transition_progress = 0
			transition_entry = -1
			transition_committed = false
			transition_focus_x = 0
			transition_focus_y = 0
		}
	}

	call graphics::begin_draw(explorer_window)
	if (!explorer_window.is_minimized()) {
		call refresh_explorer_style()
		width = graphics::content_width(explorer_window)
		height = graphics::content_height(explorer_window)
		scroll_steps = graphics::scroll_delta()
		if (scroll_steps != 0) {
			if (viewer_open) {
				viewer_scroll -= scroll_steps
				if (viewer_scroll < 0) { viewer_scroll = 0 }
			}
			elseif (!context_open && !rename_open && !delete_confirm && transition_progress == 0 && graphics::pointer_x(explorer_window) > sidebar_width + 4 && graphics::pointer_y(explorer_window) > 12 && graphics::pointer_y(explorer_window) < height - 10) {
				call adjust_explorer_zoom(scroll_steps * 10)
			}
		}
		call graphics::fill_rect(explorer_window, 0, 0, width, height, graphics::COLOR_0)
		if (width < 104 || height < 72) {
			call draw_file_atom(2, 3, width - 4, height - 6)
		}
		else {
			drop_path_active = false
			if (drag_entry >= 0 && drag_moved && !explorer_strings_equal(current_path, ".")) {
				if (graphics::pointer_x(explorer_window) >= 3 && graphics::pointer_x(explorer_window) < 35 && graphics::pointer_y(explorer_window) >= 2 && graphics::pointer_y(explorer_window) < 11) {
					call graphics::fill_rect(explorer_window, 3, 2, 32, 9, visual_accent)
					drop_path_active = true
					call explorer_set(drop_path_target, cached_parent_path)
				}
				else {
					call graphics::fill_rect(explorer_window, 3, 2, 32, 9, visual_surface)
				}
				call graphics::draw_text(explorer_window, 7, 3, "Back", visual_outline)
			}
			elseif (!explorer_modal_open() && !explorer_strings_equal(current_path, ".")) {
				if (graphics::button_flat(explorer_window, 3, 2, 32, 9, "Back", visual_surface)) {
					call begin_path_transition(explorer_parent_path(current_path))
				}
			}
			else {
				call graphics::fill_rect(explorer_window, 3, 2, 32, 9, visual_surface)
				call graphics::draw_text(explorer_window, 7, 3, "Back", visual_outline)
			}
			call draw_breadcrumbs(37, 2, width - 40)
			call draw_file_atom(3, 12, width - 6, height - 24)
			call draw_explorer_sidebar(3, 12, height - 24)
			if (marquee_active) { call draw_selection_marquee() }
			call draw_explorer_text_clipped(3, height - 9, status_text, (width - 6) / 4, graphics::COLOR_7)
		}

		if (width >= 104 && height >= 72 && graphics::mouse_pressed() && hovered_entry < 0 && drag_entry < 0 && drag_template == 0 && !shell_button_hovered && !zoom_controls_hovered && transition_progress == 0 && !context_open && !rename_open && !delete_confirm && !viewer_open && graphics::pointer_y(explorer_window) > 12 && graphics::pointer_x(explorer_window) > sidebar_width + 4) {
			if ((graphics::modifiers() & graphics::MOD_CTRL) != 0 || (graphics::modifiers() & graphics::MOD_SHIFT) != 0) {
				marquee_active = true
				marquee_mode = 2
				if ((graphics::modifiers() & graphics::MOD_CTRL) != 0) { marquee_mode = 1 }
				marquee_start_x = graphics::pointer_x(explorer_window)
				marquee_start_y = graphics::pointer_y(explorer_window)
				marquee_current_x = marquee_start_x
				marquee_current_y = marquee_start_y
				rotating = false
			}
			else {
				rotating = true
				call clear_entry_selection()
				selection_anchor = -1
				call update_selection_status()
			}
			last_click_entry = -1
			last_pointer_x = graphics::pointer_x(explorer_window)
			last_pointer_y = graphics::pointer_y(explorer_window)
		}
		if (marquee_active && graphics::mouse_down()) {
			marquee_current_x = graphics::pointer_x(explorer_window)
			marquee_current_y = graphics::pointer_y(explorer_window)
		}
		if (rotating && graphics::mouse_down()) {
			rotation += (graphics::pointer_x(explorer_window) - last_pointer_x) * 2
			tilt += graphics::pointer_y(explorer_window) - last_pointer_y
			if (tilt > 70) { tilt = 70 }
			if (tilt < -70) { tilt = -70 }
			last_pointer_x = graphics::pointer_x(explorer_window)
			last_pointer_y = graphics::pointer_y(explorer_window)
		}
		if (graphics::mouse_released()) {
			if (marquee_active) {
				marquee_current_x = graphics::pointer_x(explorer_window)
				marquee_current_y = graphics::pointer_y(explorer_window)
				call finish_marquee_selection()
				marquee_active = false
			}
			rotating = false
		}
		if (viewer_open) {
			call draw_file_viewer()
		}
		elseif (context_open) {
			call draw_context_menu()
		}
		elseif (rename_open) {
			call draw_inline_rename()
		}
		elseif (delete_confirm) {
			call draw_delete_dialog()
		}

		key = graphics::read_key()
		while (key != 0) {
			if (rename_open) {
				if (key == graphics::KEY_ENTER) { call commit_rename() }
				else { call handle_rename_key(key) }
			}
			elseif (viewer_open) {
				if (key == graphics::KEY_ESCAPE) { viewer_open = false }
				elseif (key == graphics::KEY_UP && viewer_scroll > 0) { viewer_scroll -= 1 }
				elseif (key == graphics::KEY_DOWN) { viewer_scroll += 1 }
			}
			elseif (context_open && key == graphics::KEY_ESCAPE) { context_open = false }
			elseif (delete_confirm && key == graphics::KEY_ESCAPE) { delete_confirm = false }
			elseif (key == 43 || key == 61) { call adjust_explorer_zoom(15) }
			elseif (key == 45) { call adjust_explorer_zoom(-15) }
			key = graphics::read_key()
		}
	}
	call graphics::update(explorer_window)
	if (transition_progress >= 100 && !transition_committed) {
		call commit_folder_transition()
	}
	call os::sleep(16)
}
