			orbit_stream_dirty = true
			orbit_scene_static_dirty = true
		}
	}
	if (!orbit_native_drawn) {
		call prepare_shell_slot_projection()
		shell = 0
		while (shell < shell_count && transition_scale >= 24) {
			call draw_placeholder_shell(center_x, center_y, shell_render_radius[shell], tilt, view_roll)
			shell += 1
		}
		if (slot_animation_active) { slot_animation_active = false }
		index = 0
		while (index < count) {
			shell = entry_shell[index]
			if (shell >= shell_count) { shell = shell_count - 1; entry_shell[index] = shell }
			position = entry_position_cache[index]
			radius = shell_render_radius[shell]
			call orbit_project_components(radius, shell_slot_cosine[shell * 8 + position], shell_slot_sine[shell * 8 + position])
			target_depth = projected_depth
			entry_render_depth[index] = target_depth
			if (transition_progress > 0 && transition_entry == index) { entry_render_depth[index] = 1 }
			atom_x = center_x + projected_x
			atom_y = center_y + projected_y
			if (transition_progress > 0 && transition_direction > 0 && !transition_committed && transition_entry == index) {
				atom_x = viewport_center_x + transition_focus_x * transition_scale * (100 - eased_progress) / 10000
				atom_y = viewport_center_y + transition_focus_y * transition_scale * (100 - eased_progress) / 10000
			}
			elseif (transition_progress > 0 && transition_direction < 0 && transition_committed && transition_entry == index) {
				atom_x = viewport_center_x + transition_focus_x * transition_scale * eased_progress / 10000
				atom_y = viewport_center_y + transition_focus_y * transition_scale * eased_progress / 10000
			}
			if (transition_progress == 0 && entry_slot_progress[index] < 100) {
				slot_duration = entry_slot_duration[index]
				if (slot_duration < 1) { slot_duration = 220 }
				entry_slot_elapsed[index] += delta_ms
				if (entry_slot_elapsed[index] >= slot_duration) {
					entry_slot_elapsed[index] = slot_duration
					entry_slot_progress[index] = 100
				}
				else { entry_slot_progress[index] = entry_slot_elapsed[index] * 100 / slot_duration }
				slot_eased_progress = slot_ease(entry_slot_progress[index])
				atom_x = entry_slot_start_x[index] + (atom_x - entry_slot_start_x[index]) * slot_eased_progress / 100
				atom_y = entry_slot_start_y[index] + (atom_y - entry_slot_start_y[index]) * slot_eased_progress / 100
				entry_render_depth[index] = entry_slot_start_depth[index] + (target_depth - entry_slot_start_depth[index]) * slot_eased_progress / 100
				if (entry_slot_progress[index] < 100) { slot_animation_active = true }
			}
			entry_render_x[index] = atom_x
			entry_render_y[index] = atom_y
			entry_node_radius[index] = node_radius
			index += 1
		}
		# Hit-test the completed projection so drawing calls cannot leave a
		# half-updated target set while the pointer is held.
		pointer_in_scene = pointer_x > x && pointer_x < x + area_width && pointer_y >= y && pointer_y < y + area_height
		if (explorer_pointer_in_sidebar_panel(x, y, area_height) || zoom_controls_hovered) { pointer_in_scene = false }
		dx = pointer_x - atom_center_x
		dy = pointer_y - atom_center_y
		if (dx < 0) { dx = -dx }
		if (dy < 0) { dy = -dy }
		outside_nucleus = false
		if (dx > atom_center_radius || dy > atom_center_radius) { outside_nucleus = true }
		elseif (dx * dx + dy * dy > atom_center_radius * atom_center_radius) { outside_nucleus = true }
		nearest_entry_distance_squared = 2147483647
		nearest_folder_distance_squared = 2147483647
		index = 0
		while (index < cached_entry_count) {
			dy = pointer_y - entry_render_y[index]
			dx = pointer_x - entry_render_x[index]
			distance_squared = dx * dx + dy * dy
			hit_radius = entry_node_radius[index] + 18
			if (hit_radius < 20) { hit_radius = 20 }
			if (!drag_moved && distance_squared <= hit_radius * hit_radius && distance_squared < nearest_entry_distance_squared && pointer_in_scene && outside_nucleus) {
				nearest_entry_distance_squared = distance_squared
				hovered_entry = index
				hovered_shell = entry_shell[index]
			}
			if (pointer_in_scene && outside_nucleus && drag_entry >= 0 && drag_moved) {
				if (index != drag_entry && entry_directory_cache[index] != 0) {
					if (entry_selected[drag_entry] == 0 || entry_selected[index] == 0) {
						folder_drop_hit_radius = entry_node_radius[index] + 18
						if (distance_squared <= folder_drop_hit_radius * folder_drop_hit_radius && distance_squared < nearest_folder_distance_squared) {
							nearest_folder_distance_squared = distance_squared
							drop_folder_entry = index
