# Paint and replaceable asset hooks.
# Placeholder visual tokens. Future asset work only needs to replace the five
# draw_placeholder_* procedures below; filesystem and interaction code stays
# unchanged.
var visual_surface: int
var visual_outline: int
var visual_accent: int
var visual_shell: int
var visual_highlight: int
var projected_x: int
var projected_y: int
var projected_depth: int
var projection_tilt_cos: float
var projection_roll_cos: float
var projection_roll_sin: float
var projection_rotation_cos: float
var projection_rotation_sin: float
var projection_depth_scale: float
var nucleus_highlight_x: int
var nucleus_highlight_y: int
var nucleus_highlight_ready: bool

fn transition_ease(progress: int) int {
	if (progress < 0) { progress = 0 }
	if (progress > 100) { progress = 100 }
	return progress * progress * (300 - 2 * progress) / 10000
}

fn slot_ease(progress: int) int {
	var t: float
	if (progress < 0) { progress = 0 }
	if (progress > 100) { progress = 100 }
	t = (float)progress / 100.0
	return (int)(t * t * t * (t * (t * 6.0 - 15.0) + 10.0) * 100.0)
}

fn insertion_slot_duration(population: int) int {
	var duration: int
	if (population <= 1) { return 220 }
	duration = 400 - (population - 2) * 30
	if (duration < 220) { duration = 220 }
	return duration
}

fn adaptive_shell_gap(radius_limit: int, active_shells: int) int {
	var fitted_gap: int
	if (active_shells <= 1) { return 0 }
	fitted_gap = (radius_limit - ATOM_INNER_SHELL_RADIUS) / (active_shells - 1)
	if (fitted_gap > ATOM_IDEAL_SHELL_GAP) { fitted_gap = ATOM_IDEAL_SHELL_GAP }
	if (fitted_gap < ATOM_MINIMUM_SHELL_GAP) { fitted_gap = ATOM_MINIMUM_SHELL_GAP }
	return fitted_gap
}

fn placeholder_pixel_visible(x: int, y: int) bool {
	# Fade complete shapes in a few palette-safe temporal steps. Spatial masks
	# produced moving rows/scanlines while the camera zoomed.
	return visual_force_opaque || visual_fade >= 20
}

fn placeholder_faded_color(color: int) int {
	if (visual_force_opaque || visual_fade >= 75) { return color }
	if (visual_fade < 20) { return graphics::COLOR_0 }
	if (visual_fade < 45) { return visual_surface }
	if (color == visual_highlight) { return visual_outline }
	if (color == visual_accent || color == visual_outline) { return visual_shell }
	return color
}

proc draw_placeholder_pixel(x: int, y: int, color: int) {
	if (placeholder_pixel_visible(x, y)) {
		call graphics::set_pixel(explorer_window, x, y, placeholder_faded_color(color))
	}
}

proc draw_placeholder_circle(x: int, y: int, radius: int, color: int) {
	if (placeholder_pixel_visible(x + radius, y)) {
		call graphics::draw_circle(explorer_window, x, y, radius, placeholder_faded_color(color))
	}
}

proc prepare_orbit_projection(shell_tilt: int, roll: int, orientation: int) {
	projection_tilt_cos = math::cos((float)shell_tilt)
	projection_roll_cos = math::cos((float)roll)
	projection_roll_sin = math::sin((float)roll)
	projection_rotation_cos = math::cos((float)orientation)
	projection_rotation_sin = math::sin((float)orientation)
	# The projected ellipse is identical for +tilt and -tilt because cosine is
	# even. Depth therefore uses the same unsigned tilt magnitude; otherwise a
	# vertical drag through zero visually keeps the same ellipse but swaps its
	# foreground and background.
	projection_depth_scale = math::sin((float)shell_tilt)
	if (projection_depth_scale < 0.0) { projection_depth_scale = -projection_depth_scale }
}

proc orbit_project_components(radius: int, cosine: float, sine: float) {
	var plane_x: float
	var plane_y: float
	plane_x = cosine * (float)radius
	plane_y = sine * (float)radius * projection_tilt_cos
	projected_x = (int)(plane_x * projection_roll_cos - plane_y * projection_roll_sin)
	projected_y = (int)(plane_x * projection_roll_sin + plane_y * projection_roll_cos)
	projected_depth = (int)(sine * (float)radius * projection_depth_scale * 100.0)
}

proc orbit_project(radius: int, angle: float) {
	call orbit_project_components(radius, math::cos(angle), math::sin(angle))
}

proc orbit_project_rotation_offset(radius: int, offset_cosine: float, offset_sine: float) {
	var cosine: float
	var sine: float
	cosine = projection_rotation_cos * offset_cosine - projection_rotation_sin * offset_sine
	sine = projection_rotation_sin * offset_cosine + projection_rotation_cos * offset_sine
	call orbit_project_components(radius, cosine, sine)
}

proc refresh_explorer_style() {
	var theme_mode: int
	theme_mode = os::theme_mode
	if (theme_mode != visual_theme_mode) {
		visual_theme_mode = theme_mode
		visual_surface = graphics::COLOR_8
		visual_outline = graphics::COLOR_7
		visual_accent = graphics::COLOR_10
		visual_shell = graphics::COLOR_8
		visual_highlight = graphics::WHITE
		if (theme_mode == os::THEME_LIGHT) {
			visual_surface = graphics::COLOR_1
			visual_outline = graphics::COLOR_8
			visual_shell = graphics::COLOR_7
		}
		orbit_scene_static_dirty = true
	}
}

proc draw_placeholder_orb(x: int, y: int, radius: int) {
	var inner_half: int
	inner_half = radius * 7 / 10
	if (inner_half < 1) { inner_half = 1 }
	if (placeholder_pixel_visible(x, y)) {
		call graphics::fill_circle(explorer_window, x, y, inner_half, placeholder_faded_color(visual_surface))
	}
	call draw_placeholder_circle(x, y, radius, visual_outline)
	call draw_placeholder_pixel(x - radius / 2, y - radius / 2, visual_highlight)
}

proc draw_placeholder_filled_circle(x: int, y: int, radius: int, color: int) {
	if (placeholder_pixel_visible(x, y)) {
		call graphics::fill_circle(explorer_window, x, y, radius, placeholder_faded_color(color))
	}
}

proc draw_placeholder_nucleus(x: int, y: int, radius: int) {
	call draw_placeholder_filled_circle(x, y, radius, visual_surface)
	call draw_placeholder_circle(x, y, radius, visual_outline)
	call draw_placeholder_circle(x, y, radius - 2, visual_accent)
	if (!nucleus_highlight_ready) {
		nucleus_highlight_x = x - radius / 2
		nucleus_highlight_y = y - radius / 2
		nucleus_highlight_ready = true
	}
	call draw_placeholder_pixel(nucleus_highlight_x, nucleus_highlight_y, visual_highlight)
}

proc advance_view_orientation_step(elapsed_ms: int) {
	var maximum_step: int
	orientation_ease = elapsed_ms * 100 / 90
	if (orientation_ease < 1) { orientation_ease = 1 }
	if (orientation_ease > 55) { orientation_ease = 55 }
	maximum_step = elapsed_ms * 240 / 1000
	if (maximum_step < 1) { maximum_step = 1 }
	orientation_difference = rotation_target - rotation
	if (orientation_difference > 180) { orientation_difference -= 360 }
	elseif (orientation_difference < -180) { orientation_difference += 360 }
	if (orientation_difference != 0) {
		orientation_step = orientation_difference * orientation_ease / 100
		if (orientation_step == 0 && orientation_difference > 0) { orientation_step = 1 }
		elseif (orientation_step == 0) { orientation_step = -1 }
		if (orientation_step > maximum_step) { orientation_step = maximum_step }
		elseif (orientation_step < -maximum_step) { orientation_step = -maximum_step }
		rotation = (rotation + orientation_step) % 360
		if (rotation < 0) { rotation += 360 }
	}
	orientation_difference = tilt_target - tilt
	if (orientation_difference != 0) {
		orientation_step = orientation_difference * orientation_ease / 100
		if (orientation_step == 0 && orientation_difference > 0) { orientation_step = 1 }
		elseif (orientation_step == 0) { orientation_step = -1 }
		if (orientation_step > maximum_step) { orientation_step = maximum_step }
		elseif (orientation_step < -maximum_step) { orientation_step = -maximum_step }
		tilt += orientation_step
		if (tilt > 70) { tilt = 70 }
		if (tilt < -70) { tilt = -70 }
	}
}

proc update_view_orientation(elapsed_ms: int) {
	if (elapsed_ms <= 0) { return }
	orientation_time_accumulator += elapsed_ms
	while (orientation_time_accumulator >= ORIENTATION_UPDATE_MS) {
		call advance_view_orientation_step(ORIENTATION_UPDATE_MS)
		orientation_time_accumulator -= ORIENTATION_UPDATE_MS
	}
	if (rotation == rotation_target && tilt == tilt_target) { orientation_time_accumulator = 0 }
}

proc draw_placeholder_folder(x: int, y: int, radius: int, child_count: int, orbit_phase: int) {
	var dot_count: int
	var dot: int
	var dot_angle: float
	var dot_radius: int
	var dot_x: int
	var dot_y: int
	var cosine: float
	var sine: float
	var next_cosine: float
	var step_cosine: float
	var step_sine: float
	# The normal-size placeholder is the exact result of the primitive operations
	# below, packed into one indexed sprite syscall. Zoom and fades retain the
	# scalable primitive path.
	if (radius == 4 && (visual_force_opaque || visual_fade >= 75)) {
		if (visual_surface == graphics::COLOR_1) {
			call graphics::draw_icon(explorer_window, x - 4, y - 4, 9, 9, "...888....88...88..8FAAA18.8.A111A.88.A111A.88.A111A.8.81AAA18..88...88....888...")
		}
		else {
			call graphics::draw_icon(explorer_window, x - 4, y - 4, 9, 9, "...777....77...77..7FAAA87.7.A888A.77.A888A.77.A888A.7.78AAA87..77...77....777...")
		}
	}
	else {
		call draw_placeholder_orb(x, y, radius)
		call draw_placeholder_circle(x, y, radius - 2, visual_accent)
	}
	dot_count = child_count
	if (dot_count < 0) { dot_count = 0 }
	if (dot_count > 8) { dot_count = 8 }
	dot_radius = radius + 3
	dot = 0
	if (dot_count > 0) {
		dot_angle = (float)orbit_phase
		cosine = math::cos(dot_angle)
		sine = math::sin(dot_angle)
		step_cosine = math::cos(360.0 / (float)dot_count)
		step_sine = math::sin(360.0 / (float)dot_count)
	}
	while (dot < dot_count) {
		dot_x = x + (int)(cosine * (float)dot_radius)
		dot_y = y + (int)(sine * (float)dot_radius)
		call draw_placeholder_pixel(dot_x, dot_y, visual_accent)
		next_cosine = cosine * step_cosine - sine * step_sine
		sine = sine * step_cosine + cosine * step_sine
		cosine = next_cosine
		dot += 1
	}
}

proc draw_placeholder_file(x: int, y: int, radius: int) {
	if (radius == 3 && (visual_force_opaque || visual_fade >= 75)) {
		if (visual_surface == graphics::COLOR_1) {
			call graphics::draw_icon(explorer_window, x - 3, y - 4, 7, 9, "88888A0811111A8111118811111881111188111118811111881111188888888")
		}
		else {
			call graphics::draw_icon(explorer_window, x - 3, y - 4, 7, 9, "77777A0788888A7888887788888778888877888887788888778888877777777")
		}
	}
	elseif (visual_force_opaque || placeholder_pixel_visible(x, y)) {
		call graphics::fill_rect(explorer_window, x - radius, y - radius - 1, radius * 2 + 1, radius * 2 + 3, placeholder_faded_color(visual_surface))
		call graphics::draw_rect(explorer_window, x - radius, y - radius - 1, radius * 2 + 1, radius * 2 + 3, placeholder_faded_color(visual_outline))
		call graphics::set_pixel(explorer_window, x + radius, y - radius - 1, graphics::COLOR_0)
		call graphics::set_pixel(explorer_window, x + radius - 1, y - radius - 1, placeholder_faded_color(visual_accent))
		call graphics::set_pixel(explorer_window, x + radius, y - radius, placeholder_faded_color(visual_accent))
	}
}

proc draw_placeholder_shell(center_x: int, center_y: int, radius: int, shell_tilt: int, roll: int) {
	var point: int
	var shell_x: int
	var shell_y: int
	var cosine: float
	var sine: float
	var next_cosine: float
	var step_cosine: float
	var step_sine: float
	var plane_x: float
	var plane_y: float
	cosine = projection_rotation_cos
	sine = projection_rotation_sin
	step_cosine = 0.95105652
	step_sine = 0.3090170
	point = 0
	while (point < 20) {
		plane_x = cosine * (float)radius
		plane_y = sine * (float)radius * projection_tilt_cos
		shell_x = center_x + (int)(plane_x * projection_roll_cos - plane_y * projection_roll_sin)
		shell_y = center_y + (int)(plane_x * projection_roll_sin + plane_y * projection_roll_cos)
		call draw_placeholder_pixel(shell_x, shell_y, visual_shell)
		next_cosine = cosine * step_cosine - sine * step_sine
		sine = sine * step_cosine + cosine * step_sine
		cosine = next_cosine
		point += 1
	}
}

proc draw_placeholder_drag_handle(x: int, y: int, color: int) {
	call graphics::set_pixel(explorer_window, x - 2, y, color)
	call graphics::set_pixel(explorer_window, x, y, color)
	call graphics::set_pixel(explorer_window, x + 2, y, color)
}

proc draw_explorer_chevron(x: int, y: int, opened: bool, color: int) {
	if (opened) {
		call graphics::draw_line(explorer_window, x, y, x + 2, y + 2, color)
		call graphics::draw_line(explorer_window, x + 2, y + 2, x + 4, y, color)
	}
	else {
		call graphics::draw_line(explorer_window, x, y, x + 2, y + 2, color)
		call graphics::draw_line(explorer_window, x + 2, y + 2, x, y + 4, color)
	}
}

proc draw_explorer_control_glyph(x: int, y: int, plus: bool, color: int) {
	call graphics::fill_rect(explorer_window, x + 3, y + 4, 5, 1, color)
	if (plus) { call graphics::fill_rect(explorer_window, x + 5, y + 2, 1, 5, color) }
}

fn explorer_sidebar_panel_height(max_height: int) int {
	var panel_height: int
	panel_height = 62 * sidebar_progress / 100
	if (panel_height < 9) { panel_height = 9 }
	if (panel_height > max_height) { panel_height = max_height }
	return panel_height
}

fn explorer_pointer_in_sidebar_panel(x: int, y: int, max_height: int) bool {
	var panel_height: int
	panel_height = explorer_sidebar_panel_height(max_height)
	return frame_pointer_x >= x && frame_pointer_x < x + sidebar_width && frame_pointer_y >= y && frame_pointer_y < y + panel_height
}

proc explorer_clear(target: string) {
	if (xestring::strlen(target) > 0) {
		target[0] = '\0'
		call xestring::update_length(target)
	}
}

fn explorer_strings_equal(left: string, right: string) bool {
	var index: int
	if (xestring::strlen(left) != xestring::strlen(right)) { return false }
	index = 0
	while (index < xestring::strlen(left)) {
		if ((int)(left[index]) != (int)(right[index])) { return false }
		index += 1
	}
	return true
}

proc explorer_set(target: string, value: string) {
	call explorer_clear(target)
	call xestring::append(target, value)
}

proc set_explorer_status(value: string) {
	call explorer_set(status_text, value)
	status_revision += 1
}

proc initialize_entry_name_cache() {
	var index: int
	index = 0
	while (index < 64) {
		entry_name_cache[index] = xestring::concat("", "")
		entry_label_short_cache[index] = xestring::concat("", "")
		index += 1
	}
}

proc initialize_breadcrumb_cache() {
	var index: int
	index = 0
	while (index < BREADCRUMB_CACHE_LIMIT) {
		breadcrumb_label[index] = xestring::concat("", "")
		breadcrumb_destination[index] = xestring::concat("", "")
		index += 1
	}
}

proc initialize_viewer_row_cache() {
	var index: int
	index = 0
	while (index < MAX_FILE_VIEWERS * VIEWER_CACHE_ROWS) {
		viewer_row_cache[index] = xestring::concat("", "")
		index += 1
	}
}

fn viewer_cache_index(row: int) int {
	return viewer_active_slot * VIEWER_CACHE_ROWS + row
}

proc clear_viewer_row_cache() {
	var index: int
	index = 0
	while (index < viewer_row_cache_lines[viewer_active_slot]) {
		call explorer_clear(viewer_row_cache[viewer_cache_index(index)])
		index += 1
	}
	viewer_row_cache_lines[viewer_active_slot] = 0
	viewer_text_cache_valid[viewer_active_slot] = false
	viewer_text_cache_fallback[viewer_active_slot] = false
}

proc clear_cached_entry_record(index: int) {
	if (index < 0 || index >= 64) { return }
	call explorer_clear(entry_name_cache[index])
	call explorer_clear(entry_label_short_cache[index])
	entry_shell[index] = 0
	entry_depth_order[index] = index
	entry_label_short_width[index] = 0
	entry_label_full_width[index] = 0
	entry_name_length[index] = 0
	entry_directory_cache[index] = 0
	entry_child_count_cache[index] = 0
	entry_position_cache[index] = 0
	entry_selected[index] = 0
	entry_delete_mark[index] = 0
	entry_preserved_angle[index] = 0
}

proc invalidate_published_orbit_scene() {
	orbit_command_stream[graphics::COMMAND_HEADER_MAGIC_OFFSET] = 0
	orbit_stream_words = 0
	orbit_stream_result = 0
	orbit_stream_dirty = true
	orbit_scene_static_dirty = true
	depth_order_count = -1
}

fn explorer_rename_selection_begin() int {
	if (rename_selection_start < rename_selection_end) { return rename_selection_start }
	return rename_selection_end
}

fn explorer_rename_selection_finish() int {
	if (rename_selection_start > rename_selection_end) { return rename_selection_start }
	return rename_selection_end
}

fn explorer_rename_has_selection() bool {
	return rename_selection_start != rename_selection_end
}

proc explorer_clear_rename_selection() {
	rename_selection_start = rename_cursor
	rename_selection_end = rename_cursor
	rename_select_all = false
}

proc explorer_select_all_rename_text() {
	rename_selection_start = 0
	rename_selection_end = xestring::strlen(rename_text)
	rename_cursor = rename_selection_end
	rename_select_all = rename_selection_end > 0
}

proc explorer_replace_rename_selection(value: string) {
	var begin_index: int
	var finish_index: int
	var index: int
	begin_index = explorer_rename_selection_begin()
	finish_index = explorer_rename_selection_finish()
	call explorer_clear(rename_scratch)
	index = 0
	while (index < begin_index && index < xestring::strlen(rename_text)) {
		call xestring::append_char(rename_scratch, rename_text[index])
		index += 1
	}
	call xestring::append(rename_scratch, value)
	index = finish_index
	while (index < xestring::strlen(rename_text)) {
		call xestring::append_char(rename_scratch, rename_text[index])
		index += 1
	}
	call explorer_set(rename_text, rename_scratch)
	rename_cursor = begin_index + xestring::strlen(value)
	call explorer_clear_rename_selection()
}

proc explorer_insert_rename_character(value: char) {
	call explorer_clear(rename_insert)
	call xestring::append_char(rename_insert, value)
	call explorer_replace_rename_selection(rename_insert)
}

fn explorer_rename_fragment_is_valid(value: string) bool {
	var index: int
	var code: int
	index = 0
	while (index < xestring::strlen(value)) {
		code = (int)(value[index])
		if (code < 32 || code == 47 || code == 92) { return false }
		index += 1
	}
	return true
}

proc explorer_copy_rename_selection() {
	var index: int
	var shared_ok: bool
	if (!explorer_rename_has_selection()) { return }
	call explorer_clear(rename_clipboard)
	index = explorer_rename_selection_begin()
	while (index < explorer_rename_selection_finish()) {
		call xestring::append_char(rename_clipboard, rename_text[index])
		index += 1
	}
	shared_ok = os::clipboard_write(rename_clipboard)
}

proc explorer_cut_rename_selection() {
	if (!explorer_rename_has_selection()) { return }
	call explorer_copy_rename_selection()
	call explorer_replace_rename_selection("")
}

proc explorer_paste_rename_selection() {
	var shared_clipboard: string
	shared_clipboard = os::clipboard_read()
	if (xestring::strlen(shared_clipboard) > 0 && xestring::strlen(shared_clipboard) <= 64 && explorer_rename_fragment_is_valid(shared_clipboard)) {
		call explorer_set(rename_clipboard, shared_clipboard)
	}
	if (explorer_rename_fragment_is_valid(rename_clipboard) && xestring::strlen(rename_text) - (explorer_rename_selection_finish() - explorer_rename_selection_begin()) + xestring::strlen(rename_clipboard) <= 64) {
		call explorer_replace_rename_selection(rename_clipboard)
	}
}

proc cancel_rename() {
	rename_open = false
	rename_select_all = false
	call explorer_clear_rename_selection()
	call set_explorer_status("Rename cancelled")
}

# Input and interaction.
proc handle_rename_key(value: int) {
	var control_down: bool
	control_down = (graphics::modifiers() & graphics::MOD_CTRL) != 0
	if (control_down) {
		if (value == 1 || value == 65 || value == 97) {
			call explorer_select_all_rename_text()
		}
		elseif (value == 3 || value == 67 || value == 99) {
			call explorer_copy_rename_selection()
		}
		elseif (value == 24 || value == 88 || value == 120) {
			call explorer_cut_rename_selection()
		}
		elseif (value == 22 || value == 86 || value == 118) {
			call explorer_paste_rename_selection()
		}
		return
	}
	if (value == graphics::KEY_ESCAPE) {
		call cancel_rename()
		return
	}
	if (value == graphics::KEY_LEFT) {
		if (explorer_rename_has_selection()) { rename_cursor = explorer_rename_selection_begin() }
		elseif (rename_cursor > 0) { rename_cursor -= 1 }
		call explorer_clear_rename_selection()
		return
	}
	if (value == graphics::KEY_RIGHT) {
		if (explorer_rename_has_selection()) { rename_cursor = explorer_rename_selection_finish() }
		elseif (rename_cursor < xestring::strlen(rename_text)) { rename_cursor += 1 }
		call explorer_clear_rename_selection()
		return
	}
	if (value == graphics::KEY_BACKSPACE) {
		if (explorer_rename_has_selection()) {
			call explorer_replace_rename_selection("")
		}
		elseif (rename_cursor > 0) {
			rename_selection_start = rename_cursor - 1
			rename_selection_end = rename_cursor
			call explorer_replace_rename_selection("")
		}
		return
	}
	if (value == graphics::KEY_DELETE) {
		if (explorer_rename_has_selection()) {
			call explorer_replace_rename_selection("")
		}
		elseif (rename_cursor < xestring::strlen(rename_text)) {
			rename_selection_start = rename_cursor
			rename_selection_end = rename_cursor + 1
			call explorer_replace_rename_selection("")
		}
		return
	}
	if (value >= 32 && value <= 126 && value != 47 && value != 92 && xestring::strlen(rename_text) - (explorer_rename_selection_finish() - explorer_rename_selection_begin()) < 64) {
		call explorer_insert_rename_character((char)value)
	}
}

fn explorer_name_is_valid(name: string) bool {
	var index: int
	var code: int
	if (xestring::strlen(name) == 0 || explorer_strings_equal(name, ".") || explorer_strings_equal(name, "..")) { return false }
	index = 0
	while (index < xestring::strlen(name)) {
		code = (int)(name[index])
		if (code < 32 || code == 47 || code == 92) { return false }
		index += 1
	}
	return true
}

proc capture_viewer_window_state() {
	if (viewer_active_slot == 0) { viewer_current_state = viewer_window.state }
	elseif (viewer_active_slot == 1) { viewer_current_state = viewer_window_2.state }
	else { viewer_current_state = viewer_window_3.state }
}

fn viewer_window_is_minimized() bool {
	if (viewer_active_slot == 0) { return viewer_window.is_minimized() }
	if (viewer_active_slot == 1) { return viewer_window_2.is_minimized() }
	return viewer_window_3.is_minimized()
}

proc begin_viewer_window_draw() {
	if (viewer_active_slot == 0) { call graphics::begin_draw(viewer_window) }
	elseif (viewer_active_slot == 1) { call graphics::begin_draw(viewer_window_2) }
	else { call graphics::begin_draw(viewer_window_3) }
}

proc update_viewer_window() {
	if (viewer_active_slot == 0) { call graphics::update(viewer_window) }
	elseif (viewer_active_slot == 1) { call graphics::update(viewer_window_2) }
	else { call graphics::update(viewer_window_3) }
}

proc close_viewer_window() {
	if (viewer_active_slot == 0) {
		if (viewer_window._handle != 0 && viewer_window.state != graphics::WINDOW_CLOSED) { viewer_window.close() }
	}
	elseif (viewer_active_slot == 1) {
		if (viewer_window_2._handle != 0 && viewer_window_2.state != graphics::WINDOW_CLOSED) { viewer_window_2.close() }
	}
	else {
		if (viewer_window_3._handle != 0 && viewer_window_3.state != graphics::WINDOW_CLOSED) { viewer_window_3.close() }
	}
}

proc reset_viewer_window_descriptor() {
	if (viewer_active_slot == 0) {
		viewer_window._handle = 0
		viewer_window.state = graphics::WINDOW_CLOSED
	}
	elseif (viewer_active_slot == 1) {
		viewer_window_2._handle = 0
		viewer_window_2.state = graphics::WINDOW_CLOSED
	}
	else {
		viewer_window_3._handle = 0
		viewer_window_3.state = graphics::WINDOW_CLOSED
	}
}

proc configure_viewer_window() {
	var viewer_x: int
	var viewer_y: int
	viewer_x = explorer_window.x + 24 + viewer_active_slot * 10
	viewer_y = explorer_window.y + 18 + viewer_active_slot * 8
	if (viewer_active_slot == 0) {
		viewer_window._handle = 0
		viewer_window.x = viewer_x
		viewer_window.y = viewer_y
		viewer_window.width = 250
		viewer_window.height = 170
		viewer_window.title = viewer_name[viewer_active_slot]
		viewer_window.ui_scale = 1
		viewer_window.state = graphics::WINDOW_NORMAL
	}
	elseif (viewer_active_slot == 1) {
		viewer_window_2._handle = 0
		viewer_window_2.x = viewer_x
		viewer_window_2.y = viewer_y
		viewer_window_2.width = 250
		viewer_window_2.height = 170
		viewer_window_2.title = viewer_name[viewer_active_slot]
		viewer_window_2.ui_scale = 1
		viewer_window_2.state = graphics::WINDOW_NORMAL
	}
	else {
		viewer_window_3._handle = 0
		viewer_window_3.x = viewer_x
		viewer_window_3.y = viewer_y
		viewer_window_3.width = 250
		viewer_window_3.height = 170
		viewer_window_3.title = viewer_name[viewer_active_slot]
		viewer_window_3.ui_scale = 1
		viewer_window_3.state = graphics::WINDOW_NORMAL
	}
}

fn viewer_content_width() int {
	if (viewer_active_slot == 0) { return graphics::content_width(viewer_window) }
	if (viewer_active_slot == 1) { return graphics::content_width(viewer_window_2) }
	return graphics::content_width(viewer_window_3)
}

fn viewer_content_height() int {
	if (viewer_active_slot == 0) { return graphics::content_height(viewer_window) }
	if (viewer_active_slot == 1) { return graphics::content_height(viewer_window_2) }
	return graphics::content_height(viewer_window_3)
}

proc fill_viewer_rect(x: int, y: int, width: int, height: int, color: int) {
	if (viewer_active_slot == 0) { call graphics::fill_rect(viewer_window, x, y, width, height, color) }
	elseif (viewer_active_slot == 1) { call graphics::fill_rect(viewer_window_2, x, y, width, height, color) }
	else { call graphics::fill_rect(viewer_window_3, x, y, width, height, color) }
}

fn explorer_modal_open() bool {
	return context_open || rename_open || delete_confirm || transition_progress > 0
}

# Layout helpers.
proc refresh_explorer_toolbar_geometry() {
	var available_width: int
	toolbar_breadcrumb_x = EXPLORER_TOOLBAR_SIDE_PADDING + 34
	toolbar_zoom_plus_x = width - EXPLORER_TOOLBAR_SIDE_PADDING - EXPLORER_TOOLBAR_CONTROL_WIDTH
	toolbar_zoom_minus_x = toolbar_zoom_plus_x - EXPLORER_TOOLBAR_GAP - EXPLORER_TOOLBAR_CONTROL_WIDTH
	available_width = toolbar_zoom_minus_x - EXPLORER_TOOLBAR_GAP - toolbar_breadcrumb_x
	toolbar_status_width = available_width / 2
	if (toolbar_status_width > EXPLORER_TOOLBAR_STATUS_MAX_WIDTH) { toolbar_status_width = EXPLORER_TOOLBAR_STATUS_MAX_WIDTH }
	if (toolbar_status_width < 1) { toolbar_status_width = 1 }
	toolbar_status_x = toolbar_zoom_minus_x - EXPLORER_TOOLBAR_GAP - toolbar_status_width
	toolbar_breadcrumb_width = toolbar_status_x - EXPLORER_TOOLBAR_GAP - toolbar_breadcrumb_x
	if (toolbar_breadcrumb_width < 1) { toolbar_breadcrumb_width = 1 }
	zoom_controls_hovered = false
	if (transition_progress == 0 && frame_pointer_x >= toolbar_zoom_minus_x && frame_pointer_x < toolbar_zoom_plus_x + EXPLORER_TOOLBAR_CONTROL_WIDTH) {
		if (frame_pointer_y >= EXPLORER_TOOLBAR_Y && frame_pointer_y < EXPLORER_TOOLBAR_Y + EXPLORER_TOOLBAR_CONTROL_HEIGHT) {
			zoom_controls_hovered = true
		}
	}
}

fn explorer_char_advance(value: char, font_size: int) int {
	var advance: int
	advance = graphics::char_advance(value, font_size)
	if (advance < 1) { advance = 1 }
	return advance
}

fn explorer_text_width_clipped(text: string, maximum_chars: int, font_size: int) int {
	var index: int
	var result: int
	index = 0
	result = 0
	while (index < xestring::strlen(text) && index < maximum_chars) {
		result += explorer_char_advance(text[index], font_size)
		index += 1
	}
	if (result > 0) { result -= 1 }
	return result
}

proc draw_explorer_text_standard(x: int, y: int, text: string, font_size: int, color: int) {
	if (font_size == graphics::FONT_SMALL) {
		call graphics::draw_text_small(explorer_window, x, y, text, color)
	}
	else { call graphics::draw_text(explorer_window, x, y, text, color) }
}

proc draw_explorer_char_standard(x: int, y: int, value: char, font_size: int, color: int) {
	call graphics::draw_char_styled(explorer_window, x, y, value, color, font_size, 0)
}

proc draw_viewer_text_standard(x: int, y: int, text: string, font_size: int, color: int) {
	if (font_size == graphics::FONT_SMALL) {
		if (viewer_active_slot == 0) { call graphics::draw_text_small(viewer_window, x, y, text, color) }
		elseif (viewer_active_slot == 1) { call graphics::draw_text_small(viewer_window_2, x, y, text, color) }
		else { call graphics::draw_text_small(viewer_window_3, x, y, text, color) }
	}
	else {
		if (viewer_active_slot == 0) { call graphics::draw_text(viewer_window, x, y, text, color) }
		elseif (viewer_active_slot == 1) { call graphics::draw_text(viewer_window_2, x, y, text, color) }
		else { call graphics::draw_text(viewer_window_3, x, y, text, color) }
	}
}

proc draw_viewer_char_standard(x: int, y: int, value: char, font_size: int, color: int) {
	if (viewer_active_slot == 0) { call graphics::draw_char_styled(viewer_window, x, y, value, color, font_size, 0) }
	elseif (viewer_active_slot == 1) { call graphics::draw_char_styled(viewer_window_2, x, y, value, color, font_size, 0) }
	else { call graphics::draw_char_styled(viewer_window_3, x, y, value, color, font_size, 0) }
}

fn viewer_flat_button_aligned(x: int, y: int, width: int, height: int, label: string, surface: int, foreground: int) bool {
	var clicked: bool
	var text_width: int
	var text_x: int
	if (viewer_active_slot == 0) { clicked = graphics::button_flat(viewer_window, x, y, width, height, " ", surface) }
	elseif (viewer_active_slot == 1) { clicked = graphics::button_flat(viewer_window_2, x, y, width, height, " ", surface) }
	else { clicked = graphics::button_flat(viewer_window_3, x, y, width, height, " ", surface) }
	text_width = explorer_text_width_clipped(label, xestring::strlen(label), graphics::FONT_NORMAL)
	text_x = x + (width - text_width) / 2
	if (text_x < x + 1) { text_x = x + 1 }
	call draw_viewer_text_standard(text_x, y + (height - 7) / 2, label, graphics::FONT_NORMAL, foreground)
	return clicked
}

proc draw_explorer_text_prefix(x: int, y: int, text: string, visible_chars: int, font_size: int, color: int) {
	var index: int
	call explorer_clear(clipped_text_buffer)
	index = 0
	while (index < xestring::strlen(text) && index < visible_chars) {
		call xestring::append_char(clipped_text_buffer, text[index])
		index += 1
	}
	call draw_explorer_text_standard(x, y, clipped_text_buffer, font_size, color)
}

proc draw_explorer_text_clipped(x: int, y: int, text: string, area_width: int, color: int) {
	var visible_chars: int
	var text_width: int
	visible_chars = xestring::strlen(text)
	text_width = explorer_text_width_clipped(text, visible_chars, graphics::FONT_NORMAL)
	while (visible_chars > 0 && text_width > area_width) {
		visible_chars -= 1
		if (visible_chars == 0) { text_width = 0 }
		else { text_width -= explorer_char_advance(text[visible_chars], graphics::FONT_NORMAL) }
	}
	if (visible_chars == xestring::strlen(text)) {
		call draw_explorer_text_standard(x, y, text, graphics::FONT_NORMAL, color)
		return
	}
	call draw_explorer_text_prefix(x, y, text, visible_chars, graphics::FONT_NORMAL, color)
}

proc refresh_explorer_status_layout(area_width: int) {
	var index: int
	var suffix_chars: int
	var suffix_width: int
	var candidate_width: int
	if (status_layout_revision == status_revision && status_layout_area_width == area_width) { return }
	status_layout_visible_chars = xestring::strlen(status_text)
	status_layout_text_width = explorer_text_width_clipped(status_text, status_layout_visible_chars, graphics::FONT_NORMAL)
	suffix_chars = 0
	suffix_width = 0
	if (status_layout_text_width > area_width) {
		suffix_chars = 3
		suffix_width = explorer_text_width_clipped("...", suffix_chars, graphics::FONT_NORMAL)
		while (suffix_chars > 0 && suffix_width > area_width) {
			suffix_chars -= 1
			suffix_width = explorer_text_width_clipped("...", suffix_chars, graphics::FONT_NORMAL)
		}
		candidate_width = status_layout_text_width
		if (suffix_chars > 0) { candidate_width += 1 + suffix_width }
		while (status_layout_visible_chars > 0 && candidate_width > area_width) {
			status_layout_visible_chars -= 1
			if (status_layout_visible_chars == 0) { status_layout_text_width = 0 }
			else { status_layout_text_width -= explorer_char_advance(status_text[status_layout_visible_chars], graphics::FONT_NORMAL) }
			candidate_width = status_layout_text_width
			if (status_layout_visible_chars > 0 && suffix_chars > 0) { candidate_width += 1 + suffix_width }
			elseif (suffix_chars > 0) { candidate_width = suffix_width }
		}
	}
	call explorer_clear(status_visible_text)
	index = 0
	while (index < status_layout_visible_chars) {
		call xestring::append_char(status_visible_text, status_text[index])
		index += 1
	}
	index = 0
	while (index < suffix_chars) {
		call xestring::append_char(status_visible_text, '.')
		index += 1
	}
	status_layout_text_width = explorer_text_width_clipped(status_visible_text, xestring::strlen(status_visible_text), graphics::FONT_NORMAL)
	status_layout_revision = status_revision
	status_layout_area_width = area_width
}

proc draw_explorer_status_right_clipped(x: int, y: int, area_width: int, color: int) {
	call refresh_explorer_status_layout(area_width)
	call draw_explorer_text_standard(x + area_width - status_layout_text_width, y, status_visible_text, graphics::FONT_NORMAL, color)
}

proc draw_explorer_action_status(x: int, y: int, area_width: int) {
	if (area_width < 1) { return }
	call draw_explorer_status_right_clipped(x, y + (EXPLORER_TOOLBAR_HEIGHT - 7) / 2, area_width, visual_outline)
}

proc draw_explorer_text_centered(x: int, y: int, area_width: int, text: string, font_size: int, color: int) {
	var visible_chars: int
	var text_width: int
	var text_x: int
	visible_chars = xestring::strlen(text)
	text_width = explorer_text_width_clipped(text, visible_chars, font_size)
	while (visible_chars > 0 && text_width > area_width - 2) {
		visible_chars -= 1
		if (visible_chars == 0) { text_width = 0 }
		else { text_width -= explorer_char_advance(text[visible_chars], font_size) }
	}
	text_x = x + (area_width - text_width) / 2
	if (text_x < x + 1) { text_x = x + 1 }
	if (visible_chars == xestring::strlen(text)) {
		call draw_explorer_text_standard(text_x, y, text, font_size, color)
		return
	}
	call draw_explorer_text_prefix(text_x, y, text, visible_chars, font_size, color)
}

proc draw_explorer_fixed_label_centered(x: int, y: int, area_width: int, text: string, text_width: int, color: int) {
	call draw_explorer_text_standard(x + (area_width - text_width) / 2, y, text, graphics::FONT_NORMAL, color)
}

fn explorer_control_text_color() int {
	if (visual_theme_mode == os::THEME_LIGHT) { return graphics::COLOR_0 }
	return graphics::WHITE
}

fn explorer_flat_button_aligned(x: int, y: int, width: int, height: int, label: string, surface: int, foreground: int) bool {
	var clicked: bool
	clicked = graphics::button_flat(explorer_window, x, y, width, height, " ", surface)
	call draw_explorer_text_centered(x, y + (height - 7) / 2, width, label, graphics::FONT_NORMAL, foreground)
	return clicked
}

fn explorer_fixed_label_button(x: int, y: int, width: int, height: int, label: string, label_width: int, surface: int, foreground: int) bool {
	var clicked: bool
	clicked = graphics::button_flat(explorer_window, x, y, width, height, " ", surface)
	call draw_explorer_fixed_label_centered(x, y + (height - 7) / 2, width, label, label_width, foreground)
	return clicked
}

proc refresh_entry_label_cache(index: int) {
	var character: int
	var length: int
	var advance: int
	call explorer_clear(entry_label_short_cache[index])
	entry_label_short_width[index] = 0
	entry_label_full_width[index] = 0
	length = xestring::strlen(entry_name_cache[index])
	entry_name_length[index] = length
	character = 0
	while (character < length) {
		advance = explorer_char_advance(entry_name_cache[index][character], graphics::FONT_NORMAL)
		entry_label_full_width[index] += advance
		if (character < 4) {
			call xestring::append_char(entry_label_short_cache[index], entry_name_cache[index][character])
			entry_label_short_width[index] += advance
		}
		character += 1
	}
	if (entry_label_full_width[index] > 0) { entry_label_full_width[index] -= 1 }
	if (entry_label_short_width[index] > 0) { entry_label_short_width[index] -= 1 }
}

fn explorer_join_path(parent: string, child: string) string {
	if (explorer_strings_equal(parent, ".")) { return child }
	return xestring::concat(xestring::concat(parent, "/"), child)
}

fn explorer_path_depth(path: string) int {
	var index: int
	var depth: int
	if (explorer_strings_equal(path, ".")) { return 0 }
	index = 0
	depth = 1
	while (index < xestring::strlen(path)) {
		if ((int)(path[index]) == 47) { depth += 1 }
		index += 1
	}
	return depth
}

fn explorer_parent_path(path: string) string {
	var result: string
	var index: int
	result = ""
	call explorer_clear(result)
	index = xestring::strlen(path) - 1
	while (index >= 0 && (int)(path[index]) != 47) { index -= 1 }
	if (index < 0) {
		call xestring::append(result, ".")
		return result
	}
	var copy_index: int
	copy_index = 0
	while (copy_index < index) {
		call xestring::append_char(result, path[copy_index])
		copy_index += 1
	}
	if (xestring::strlen(result) == 0) {
		call xestring::append(result, ".")
	}
	return result
}

fn explorer_path_prefix(path: string, length: int) string {
	var result: string
	var index: int
	result = ""
	call explorer_clear(result)
	index = 0
	while (index < length && index < xestring::strlen(path)) {
		call xestring::append_char(result, path[index])
		index += 1
	}
	if (xestring::strlen(result) == 0) {
		call xestring::append(result, ".")
	}
	return result
}

fn explorer_descendant_name(path: string, ancestor: string) string {
	var result: string
	var index: int
	result = ""
	call explorer_clear(result)
	if (explorer_strings_equal(ancestor, ".")) { index = 0 }
	else { index = xestring::strlen(ancestor) + 1 }
	while (index < xestring::strlen(path) && (int)(path[index]) != 47) {
		call xestring::append_char(result, path[index])
		index += 1
	}
	return result
}

fn find_entry_named(name: string) int {
	var index: int
	index = 0
	while (index < cached_entry_count) {
		if (explorer_strings_equal(entry_name_cache[index], name)) { return index }
		index += 1
	}
	return -1
}

fn filesystem_entry_index(name: string) int {
	var index: int
	var count: int
	count = os::entry_count(current_path)
	if (count > 64) { count = 64 }
	index = 0
	while (index < count) {
		if (explorer_strings_equal(os::entry_name(current_path, index), name)) { return index }
		index += 1
	}
	return -1
}

proc remap_swapped_entry_indices(left: int, right: int) {
	if (selected_entry == left) { selected_entry = right }
	elseif (selected_entry == right) { selected_entry = left }
	if (selection_anchor == left) { selection_anchor = right }
	elseif (selection_anchor == right) { selection_anchor = left }
	if (drag_entry == left) { drag_entry = right }
	elseif (drag_entry == right) { drag_entry = left }
	if (hovered_entry == left) { hovered_entry = right }
	elseif (hovered_entry == right) { hovered_entry = left }
	if (drop_folder_entry == left) { drop_folder_entry = right }
	elseif (drop_folder_entry == right) { drop_folder_entry = left }
	if (context_entry == left) { context_entry = right }
	elseif (context_entry == right) { context_entry = left }
	if (transition_entry == left) { transition_entry = right }
	elseif (transition_entry == right) { transition_entry = left }
	if (last_click_entry == left) { last_click_entry = right }
	elseif (last_click_entry == right) { last_click_entry = left }
}

proc swap_cached_entry_records(left: int, right: int) {
	var temporary: int
	var temporary_name: string
	var temporary_label: string
	if (left == right || left < 0 || right < 0 || left >= cached_entry_count || right >= cached_entry_count) { return }
	temporary_name = ""
	temporary_label = ""
	call explorer_set(temporary_name, entry_name_cache[left])
	call explorer_set(entry_name_cache[left], entry_name_cache[right])
	call explorer_set(entry_name_cache[right], temporary_name)
	call explorer_set(temporary_label, entry_label_short_cache[left])
	call explorer_set(entry_label_short_cache[left], entry_label_short_cache[right])
	call explorer_set(entry_label_short_cache[right], temporary_label)
	temporary = entry_shell[left]; entry_shell[left] = entry_shell[right]; entry_shell[right] = temporary
	temporary = entry_render_x[left]; entry_render_x[left] = entry_render_x[right]; entry_render_x[right] = temporary
	temporary = entry_render_y[left]; entry_render_y[left] = entry_render_y[right]; entry_render_y[right] = temporary
	temporary = entry_render_depth[left]; entry_render_depth[left] = entry_render_depth[right]; entry_render_depth[right] = temporary
	temporary = entry_node_radius[left]; entry_node_radius[left] = entry_node_radius[right]; entry_node_radius[right] = temporary
	temporary = entry_slot_start_x[left]; entry_slot_start_x[left] = entry_slot_start_x[right]; entry_slot_start_x[right] = temporary
	temporary = entry_slot_start_y[left]; entry_slot_start_y[left] = entry_slot_start_y[right]; entry_slot_start_y[right] = temporary
	temporary = entry_slot_start_depth[left]; entry_slot_start_depth[left] = entry_slot_start_depth[right]; entry_slot_start_depth[right] = temporary
	temporary = entry_slot_progress[left]; entry_slot_progress[left] = entry_slot_progress[right]; entry_slot_progress[right] = temporary
	temporary = entry_slot_elapsed[left]; entry_slot_elapsed[left] = entry_slot_elapsed[right]; entry_slot_elapsed[right] = temporary
	temporary = entry_slot_duration[left]; entry_slot_duration[left] = entry_slot_duration[right]; entry_slot_duration[right] = temporary
	temporary = entry_label_short_width[left]; entry_label_short_width[left] = entry_label_short_width[right]; entry_label_short_width[right] = temporary
	temporary = entry_label_full_width[left]; entry_label_full_width[left] = entry_label_full_width[right]; entry_label_full_width[right] = temporary
	temporary = entry_name_length[left]; entry_name_length[left] = entry_name_length[right]; entry_name_length[right] = temporary
	temporary = entry_directory_cache[left]; entry_directory_cache[left] = entry_directory_cache[right]; entry_directory_cache[right] = temporary
	temporary = entry_child_count_cache[left]; entry_child_count_cache[left] = entry_child_count_cache[right]; entry_child_count_cache[right] = temporary
	temporary = entry_position_cache[left]; entry_position_cache[left] = entry_position_cache[right]; entry_position_cache[right] = temporary
	temporary = entry_selected[left]; entry_selected[left] = entry_selected[right]; entry_selected[right] = temporary
	temporary = entry_delete_mark[left]; entry_delete_mark[left] = entry_delete_mark[right]; entry_delete_mark[right] = temporary
	temporary = entry_preserved_angle[left]; entry_preserved_angle[left] = entry_preserved_angle[right]; entry_preserved_angle[right] = temporary
	call remap_swapped_entry_indices(left, right)
	depth_order_count = -1
	orbit_stream_dirty = true
}

proc explorer_append_positive_int(target: string, value: int) {
	if (value >= 10) {
		call explorer_append_positive_int(target, value / 10)
	}
	call xestring::append_char(target, (char)(48 + value % 10))
}

fn explorer_unique_template_name(is_directory: bool) string {
	var candidate: string
	var suffix: int
	candidate = ""
	suffix = 0
	call explorer_clear(candidate)
	call xestring::append(candidate, "untitled")
	if (!is_directory) {
		call xestring::append(candidate, ".xe")
	}
	while (os::path_exists(explorer_join_path(current_path, candidate))) {
		suffix += 1
		call explorer_clear(candidate)
		call xestring::append(candidate, "untitled (")
		call explorer_append_positive_int(candidate, suffix)
		call xestring::append(candidate, ")")
		if (!is_directory) {
			call xestring::append(candidate, ".xe")
		}
	}
	return candidate
}

fn explorer_unique_child_name(parent: string, original: string, is_directory: bool) string {
	var candidate: string
	var stem: string
	var extension: string
	var suffix: int
	var index: int
	var dot: int
	candidate = ""
	stem = ""
	extension = ""
	dot = -1
	if (!is_directory) {
		index = 0
		while (index < xestring::strlen(original)) {
			if ((int)(original[index]) == 46) { dot = index }
			index += 1
		}
		if (dot == 0) { dot = -1 }
	}
	index = 0
	while (index < xestring::strlen(original)) {
		if (dot >= 0 && index >= dot) {
			call xestring::append_char(extension, original[index])
		}
		else {
			call xestring::append_char(stem, original[index])
		}
		index += 1
	}
	call explorer_set(candidate, original)
	suffix = 0
	while (os::path_exists(explorer_join_path(parent, candidate))) {
		suffix += 1
		call explorer_clear(candidate)
		call xestring::append(candidate, stem)
		call xestring::append(candidate, " (")
		call explorer_append_positive_int(candidate, suffix)
		call xestring::append(candidate, ")")
		call xestring::append(candidate, extension)
	}
	return candidate
}

proc clear_entry_selection() {
	var index: int
	index = 0
	while (index < 64) {
		entry_selected[index] = 0
		index += 1
	}
	selected_entry = -1
}

fn selected_entry_count() int {
	var index: int
	var count: int
	index = 0
	count = 0
	while (index < cached_entry_count) {
		if (entry_selected[index] != 0) { count += 1 }
		index += 1
	}
	return count
}

fn first_selected_entry() int {
	var index: int
	index = 0
	while (index < cached_entry_count) {
		if (entry_selected[index] != 0) { return index }
		index += 1
	}
	return -1
}

fn dragged_entry_in_group(index: int) bool {
	if (drag_entry < 0 || index < 0 || index >= cached_entry_count) { return false }
	if (entry_selected[drag_entry] != 0) { return entry_selected[index] != 0 }
	return index == drag_entry
}

proc update_selection_status() {
	var count: int
	count = selected_entry_count()
	call explorer_clear(status_text)
	call explorer_append_positive_int(status_text, count)
	if (count == 1) { call xestring::append(status_text, " item selected") }
	else { call xestring::append(status_text, " items selected") }
	status_revision += 1
}

proc select_only_entry(index: int) {
	call clear_entry_selection()
	if (index >= 0 && index < cached_entry_count) {
		entry_selected[index] = 1
		selected_entry = index
		selection_anchor = index
	}
}

proc toggle_entry_selection(index: int) {
	if (index < 0 || index >= cached_entry_count) { return }
	if (entry_selected[index] != 0) {
		entry_selected[index] = 0
		if (selected_entry == index) { selected_entry = first_selected_entry() }
	}
	else {
		entry_selected[index] = 1
		selected_entry = index
	}
	selection_anchor = index
}

proc select_clicked_entry(index: int) {
	if ((input_modifiers & graphics::MOD_CTRL) != 0 || (input_modifiers & graphics::MOD_SHIFT) != 0) {
		call toggle_entry_selection(index)
	}
	else {
		call select_only_entry(index)
	}
	call update_selection_status()
}

fn entry_pointer_capture_ready(index: int, interactive: bool) bool {
	var dx: int
	var dy: int
	if (index < 0 || index >= cached_entry_count) { return false }
	if (!interactive || drag_entry >= 0 || drag_template > 0) { return false }
	if (rotating || marquee_active) { return false }
	if (frame_mouse_pressed) { return true }
	if (!frame_mouse_down) { return false }
	if (!canvas_press_pending) { return true }
	dx = frame_pointer_x - canvas_press_x
	dy = frame_pointer_y - canvas_press_y
	return dx * dx + dy * dy <= POINTER_MOVE_THRESHOLD_SQUARED
}

fn entry_pointer_capture_candidate(current: int, previous: int) int {
	var dx: int
	var dy: int
	var hit_radius: int
	if (current >= 0 && current < cached_entry_count) { return current }
	if (previous < 0 || previous >= cached_entry_count) { return -1 }
	dx = frame_pointer_x - entry_render_x[previous]
	dy = frame_pointer_y - entry_render_y[previous]
	hit_radius = entry_node_radius[previous] + 20
	if (hit_radius < 22) { hit_radius = 22 }
	if (dx * dx + dy * dy <= hit_radius * hit_radius) { return previous }
	return -1
}

proc begin_entry_pointer_capture(index: int) {
	canvas_press_pending = false
	drag_open_on_release = last_click_entry == index && last_click_age_ms <= DOUBLE_CLICK_WINDOW_MS && input_modifiers == 0
	drag_entry = index
	drag_start_x = frame_pointer_x
	drag_start_y = frame_pointer_y
	drag_moved = false
}

proc clear_entry_drag() {
	drag_entry = -1
	drag_moved = false
	drag_open_on_release = false
}

proc finish_marquee_selection() {
	var left: int
	var right: int
	var top: int
	var bottom: int
	var index: int
	var hit_count: int
	left = marquee_start_x
	right = marquee_current_x
	if (left > right) { index = left; left = right; right = index }
	top = marquee_start_y
	bottom = marquee_current_y
	if (top > bottom) { index = top; top = bottom; bottom = index }
	hit_count = 0
	index = 0
	while (index < cached_entry_count) {
		if (entry_render_x[index] >= left && entry_render_x[index] <= right && entry_render_y[index] >= top && entry_render_y[index] <= bottom) {
			entry_selected[index] = 1
			selected_entry = index
			selection_anchor = index
			hit_count += 1
		}
		index += 1
	}
	if (hit_count > 0) {
		selected_entry = first_selected_entry()
		call update_selection_status()
	}
}

proc draw_selection_marquee() {
	var left: int
	var right: int
	var top: int
	var bottom: int
	var temporary: int
	left = marquee_start_x
	right = marquee_current_x
	if (left > right) { temporary = left; left = right; right = temporary }
	top = marquee_start_y
	bottom = marquee_current_y
	if (top > bottom) { temporary = top; top = bottom; bottom = temporary }
	call graphics::draw_rect(explorer_window, left, top, right - left + 1, bottom - top + 1, visual_highlight)
}

proc adjust_explorer_zoom(delta: int) {
	camera_zoom_target += delta
	if (camera_zoom_target < 65) { camera_zoom_target = 65 }
	if (camera_zoom_target > 150) { camera_zoom_target = 150 }
}

proc draw_explorer_toolbar_controls() {
	var interaction_allowed: bool
	interaction_allowed = !explorer_modal_open()
	if (transition_progress == 0) {
		if (interaction_allowed && (zoom_controls_hovered || frame_mouse_down || frame_mouse_released)) {
			if (graphics::button_flat(explorer_window, toolbar_zoom_minus_x, EXPLORER_TOOLBAR_Y, EXPLORER_TOOLBAR_CONTROL_WIDTH, EXPLORER_TOOLBAR_CONTROL_HEIGHT, " ", visual_surface)) { call adjust_explorer_zoom(-15) }
			if (graphics::button_flat(explorer_window, toolbar_zoom_plus_x, EXPLORER_TOOLBAR_Y, EXPLORER_TOOLBAR_CONTROL_WIDTH, EXPLORER_TOOLBAR_CONTROL_HEIGHT, " ", visual_surface)) { call adjust_explorer_zoom(15) }
			call draw_explorer_control_glyph(toolbar_zoom_minus_x, EXPLORER_TOOLBAR_Y, false, graphics::WHITE)
			call draw_explorer_control_glyph(toolbar_zoom_plus_x, EXPLORER_TOOLBAR_Y, true, graphics::WHITE)
		}
		elseif (interaction_allowed) {
			call graphics::fill_rect(explorer_window, toolbar_zoom_minus_x, EXPLORER_TOOLBAR_Y, EXPLORER_TOOLBAR_CONTROL_WIDTH, EXPLORER_TOOLBAR_CONTROL_HEIGHT, visual_surface)
			call graphics::fill_rect(explorer_window, toolbar_zoom_plus_x, EXPLORER_TOOLBAR_Y, EXPLORER_TOOLBAR_CONTROL_WIDTH, EXPLORER_TOOLBAR_CONTROL_HEIGHT, visual_surface)
			call draw_explorer_control_glyph(toolbar_zoom_minus_x, EXPLORER_TOOLBAR_Y, false, graphics::WHITE)
			call draw_explorer_control_glyph(toolbar_zoom_plus_x, EXPLORER_TOOLBAR_Y, true, graphics::WHITE)
		}
		else {
			call graphics::fill_rect(explorer_window, toolbar_zoom_minus_x, EXPLORER_TOOLBAR_Y, EXPLORER_TOOLBAR_CONTROL_WIDTH, EXPLORER_TOOLBAR_CONTROL_HEIGHT, visual_surface)
			call graphics::fill_rect(explorer_window, toolbar_zoom_plus_x, EXPLORER_TOOLBAR_Y, EXPLORER_TOOLBAR_CONTROL_WIDTH, EXPLORER_TOOLBAR_CONTROL_HEIGHT, visual_surface)
			call draw_explorer_control_glyph(toolbar_zoom_minus_x, EXPLORER_TOOLBAR_Y, false, visual_outline)
			call draw_explorer_control_glyph(toolbar_zoom_plus_x, EXPLORER_TOOLBAR_Y, true, visual_outline)
		}
	}
	call draw_explorer_action_status(toolbar_status_x, EXPLORER_TOOLBAR_Y, toolbar_status_width)
}

fn shell_population(shell: int, entry_count: int) int {
	var index: int
	var count: int
	index = 0
	count = 0
	while (index < entry_count && index < 64) {
		if (entry_shell[index] == shell) { count += 1 }
		index += 1
	}
	return count
}

fn shell_slot_divisor(shell: int, population: int) int {
	if (population < 1) { return 1 }
	return population
}

proc prepare_shell_slot_projection() {
	var shell: int
	var position: int
	var population: int
	var divisor: int
	var cache_index: int
	var angle: float
	var cosine: float
	var sine: float
	var next_cosine: float
	var step_cosine: float
	var step_sine: float
	shell = 0
	while (shell < shell_count) {
		population = shell_population_cache[shell]
		divisor = shell_slot_divisor(shell, population)
		angle = (float)(rotation + shell_phase[shell] + shell * 17)
		cosine = math::cos(angle)
		sine = math::sin(angle)
		step_cosine = math::cos(360.0 / (float)divisor)
		step_sine = math::sin(360.0 / (float)divisor)
		position = 0
		while (position < population) {
			cache_index = shell * 8 + position
			shell_slot_cosine[cache_index] = cosine
			shell_slot_sine[cache_index] = sine
			next_cosine = cosine * step_cosine - sine * step_sine
			sine = sine * step_cosine + cosine * step_sine
			cosine = next_cosine
			position += 1
		}
		shell += 1
	}
}

proc update_incremental_depth_order(count: int) {
	var index: int
	var order_position: int
	var order_entry: int
	var order_previous: int
	if (depth_order_count != count) {
		index = 0
		while (index < count) {
			entry_depth_order[index] = index
			index += 1
		}
		depth_order_count = count
	}
	index = 1
	while (index < count) {
		order_entry = entry_depth_order[index]
		order_position = index
		while (order_position > 0 && entry_render_depth[order_entry] < entry_render_depth[entry_depth_order[order_position - 1]]) {
			order_previous = entry_depth_order[order_position - 1]
			entry_depth_order[order_position] = order_previous
			order_position -= 1
		}
		entry_depth_order[order_position] = order_entry
		index += 1
	}
}

proc rebuild_shell_layout() {
	var shell: int
	var index: int
	shell = 0
	while (shell < 8) {
		shell_population_cache[shell] = 0
		shell += 1
	}
	index = 0
	while (index < cached_entry_count) {
		shell = entry_shell[index]
		if (shell < 0) { shell = 0; entry_shell[index] = 0 }
		if (shell >= shell_count) { shell = shell_count - 1; entry_shell[index] = shell }
		entry_position_cache[index] = shell_population_cache[shell]
		shell_population_cache[shell] += 1
		index += 1
	}
	orbit_all_shells_full = true
	shell = 0
	while (shell < shell_count) {
		if (shell_population_cache[shell] < shell_capacity) { orbit_all_shells_full = false }
		shell += 1
	}
	orbit_stream_dirty = true
	orbit_scene_static_dirty = true
}

fn newest_empty_shell() int {
	var shell: int
	shell = shell_count - 1
	if (shell > 0 && shell_population_cache[shell] == 0) { return shell }
	return -1
}

fn center_drop_shell(fallback_shell: int) int {
	var shell: int
	shell = newest_empty_shell()
	if (shell >= 0) { return shell }
	return fallback_shell
}

proc compact_energy_shells(entry_count: int) {
	var shell: int
	var index: int
	var shift: int
	shell = 0
	while (shell < shell_count) {
		if (shell_population(shell, entry_count) == 0 && shell_count > 1) {
			index = 0
			while (index < entry_count && index < 64) {
				if (entry_shell[index] > shell) { entry_shell[index] -= 1 }
				index += 1
			}
			shift = shell
			while (shift < shell_count - 1) {
				shell_phase[shift] = shell_phase[shift + 1]
				shell_accumulator[shift] = shell_accumulator[shift + 1]
				shell_speed[shift] = shell_speed[shift + 1]
				shell_incremental_layout[shift] = shell_incremental_layout[shift + 1]
				shell_layout_radius_x100[shift] = shell_layout_radius_x100[shift + 1]
				shell_base_radius[shift] = shell_base_radius[shift + 1]
				shell_render_radius[shift] = shell_render_radius[shift + 1]
				shift += 1
			}
			shell_count -= 1
			shell_phase[shell_count] = shell_count * 23
			shell_accumulator[shell_count] = 0
			shell_speed[shell_count] = orbit_speed_setting
			shell_incremental_layout[shell_count] = 0
			shell_layout_radius_x100[shell_count] = 0
			shell_base_radius[shell_count] = 0
			shell_render_radius[shell_count] = 0
		}
		else { shell += 1 }
	}
	call rebuild_shell_layout()
}

proc begin_slot_animation_all() {
	var index: int
	slot_animation_active = true
	index = 0
	while (index < cached_entry_count) {
		entry_slot_start_x[index] = entry_render_x[index]
		entry_slot_start_y[index] = entry_render_y[index]
		entry_slot_start_depth[index] = entry_render_depth[index]
		entry_slot_progress[index] = 0
		entry_slot_elapsed[index] = 0
		entry_slot_duration[index] = 220
		index += 1
	}
}

proc align_shell_entry_to_angle(target_shell: int, target_entry: int, target_angle: float) {
	var divisor: int
	var phase: int
	if (target_shell < 0 || target_shell >= shell_count || target_entry < 0 || target_entry >= cached_entry_count) { return }
	divisor = shell_slot_divisor(target_shell, shell_population_cache[target_shell])
	phase = (int)target_angle - rotation - entry_position_cache[target_entry] * 360 / divisor - target_shell * 17
	while (phase < 0) { phase += 360 }
	while (phase >= 360) { phase -= 360 }
	shell_phase[target_shell] = phase
	orbit_phase_stream_dirty = true
	shell_accumulator[target_shell] = 0
	shell_speed[target_shell] = 0
	shell_speed_easing_active = true
}

proc begin_slot_animation_for_shell(target_shell: int, duration: int) {
	var index: int
	slot_animation_active = true
	index = 0
	while (index < cached_entry_count) {
		if (entry_shell[index] == target_shell) {
			entry_slot_start_x[index] = entry_render_x[index]
			entry_slot_start_y[index] = entry_render_y[index]
			entry_slot_start_depth[index] = entry_render_depth[index]
			entry_slot_progress[index] = 0
			entry_slot_elapsed[index] = 0
			entry_slot_duration[index] = duration
		}
		index += 1
	}
}

proc reset_energy_shells() {
	var count: int
	var index: int
	var shell: int
	var entry_path: string
	var previous_count: int
	last_click_entry = -1
	last_click_age_ms = DOUBLE_CLICK_WINDOW_MS + 1
	drag_open_on_release = false
	shell_speed_easing_active = true
	previous_count = cached_entry_count
	call invalidate_published_orbit_scene()
	count = os::entry_count(current_path)
	if (count > 64) { count = 64 }
	shell = 0
	while (shell < 8) {
		shell_incremental_layout[shell] = 0
		shell += 1
	}
	shell_capacity = 8
	if (count >= 48) {
		shell_capacity = (count + 8) / 8
		if (shell_capacity > 8) { shell_capacity = 8 }
	}
	current_path_is_root = explorer_strings_equal(current_path, ".")
	if (current_path_is_root) {
		call explorer_set(cached_parent_path, ".")
	}
	else {
		call explorer_set(cached_parent_path, explorer_parent_path(current_path))
	}
	index = 0
	while (index < count) {
		call explorer_set(entry_name_cache[index], os::entry_name(current_path, index))
		call refresh_entry_label_cache(index)
		if (os::entry_is_directory(current_path, index)) {
			entry_directory_cache[index] = 1
			entry_path = explorer_join_path(current_path, entry_name_cache[index])
			entry_child_count_cache[index] = os::entry_count(entry_path)
			if (entry_child_count_cache[index] < 0) { entry_child_count_cache[index] = 0 }
		}
		else {
			entry_directory_cache[index] = 0
			entry_child_count_cache[index] = 0
		}
		entry_shell[index] = index / shell_capacity
		entry_slot_progress[index] = 100
		entry_slot_elapsed[index] = 220
		entry_slot_duration[index] = 220
		entry_slot_start_depth[index] = 0
		entry_delete_mark[index] = 0
		index += 1
	}
	while (index < previous_count) {
		call clear_cached_entry_record(index)
		index += 1
	}
	cached_entry_count = count
	shell_count = (count + shell_capacity - 1) / shell_capacity
	if (shell_count < 1) { shell_count = 1 }
	if (shell_count > 8) { shell_count = 8 }
	if (count == 0) { shell_incremental_layout[0] = 1 }
	call rebuild_shell_layout()
	call clear_entry_selection()
	selection_anchor = -1
	slot_animation_active = false
	cached_revision = os::revision()
}

fn cache_created_entry(name: string, is_directory: bool, target_shell: int, start_x: int, start_y: int, start_depth: int, duration: int) int {
	var created: int
	var canonical: int
	if (cached_entry_count >= 64) { return -1 }
	call invalidate_published_orbit_scene()
	created = cached_entry_count
	call explorer_set(entry_name_cache[created], name)
	call refresh_entry_label_cache(created)
	if (is_directory) { entry_directory_cache[created] = 1 }
	else { entry_directory_cache[created] = 0 }
	entry_child_count_cache[created] = 0
	entry_shell[created] = target_shell
	entry_render_x[created] = start_x
	entry_render_y[created] = start_y
	entry_render_depth[created] = start_depth
	entry_node_radius[created] = 0
	entry_slot_start_x[created] = start_x
	entry_slot_start_y[created] = start_y
	entry_slot_start_depth[created] = start_depth
	entry_slot_progress[created] = 0
	entry_slot_elapsed[created] = 0
	entry_slot_duration[created] = duration
	entry_selected[created] = 0
	entry_delete_mark[created] = 0
	entry_preserved_angle[created] = 0
	cached_entry_count += 1
	canonical = filesystem_entry_index(name)
	if (canonical < 0 || canonical >= cached_entry_count) {
		call reset_energy_shells()
		return find_entry_named(name)
	}
	while (created > canonical) {
		call swap_cached_entry_records(created, created - 1)
		created -= 1
	}
	cached_revision = os::revision()
	call rebuild_shell_layout()
	return created
}

proc begin_folder_transition(index: int, direction: int) {
	var destination: string
	transition_entry = index
	transition_direction = direction
	transition_committed = false
	transition_hops = 1
	call explorer_clear(transition_destination)
	call explorer_clear(transition_target_name)
	if (direction > 0 && index >= 0 && index < cached_entry_count) {
		call xestring::append(transition_target_name, entry_name_cache[index])
		destination = explorer_join_path(current_path, transition_target_name)
		call xestring::append(transition_destination, destination)
	}
	else {
		destination = explorer_parent_path(current_path)
		call xestring::append(transition_destination, destination)
		call xestring::append(transition_target_name, explorer_descendant_name(current_path, destination))
	}
	transition_progress = 1
}

proc begin_path_transition(destination: string) {
	var current_depth: int
	var destination_depth: int
	if (explorer_strings_equal(current_path, destination)) {
		return
	}
	transition_entry = -1
	transition_direction = -1
	transition_committed = false
	call explorer_set(transition_destination, destination)
	call explorer_set(transition_target_name, explorer_descendant_name(current_path, destination))
	current_depth = explorer_path_depth(current_path)
	destination_depth = explorer_path_depth(destination)
	transition_hops = current_depth - destination_depth
	if (transition_hops < 1) { transition_hops = 1 }
	transition_focus_x = 0
	transition_focus_y = 0
	transition_progress = 1
}

proc commit_folder_transition() {
	if (transition_direction > 0) {
		call explorer_set(current_path, transition_destination)
	}
	else {
		call explorer_set(current_path, transition_destination)
	}
	current_path_revision += 1
	call reset_energy_shells()
	if (transition_direction > 0) {
		call set_explorer_status("Opened folder")
	}
	else {
		if (explorer_strings_equal(current_path, ".")) {
			call set_explorer_status("root")
		}
		else {
			call set_explorer_status("Parent directory")
		}
	}
	selected_entry = -1
	last_click_entry = -1
	if (transition_direction < 0) { transition_entry = find_entry_named(transition_target_name) }
	else { transition_entry = -1 }
	transition_committed = true
}

proc refresh_file_viewer_open_state() {
	viewer_open = viewer_is_open[0] || viewer_is_open[1] || viewer_is_open[2]
}

fn available_file_viewer_slot() int {
	var slot: int
	slot = 0
	while (slot < MAX_FILE_VIEWERS) {
		if (!viewer_is_open[slot]) { return slot }
		slot += 1
	}
	return -1
}

proc release_file_viewer() {
	viewer_is_open[viewer_active_slot] = false
	viewer_close_requested = false
	call reset_viewer_window_descriptor()
	call explorer_clear(viewer_name[viewer_active_slot])
	call explorer_clear(viewer_content[viewer_active_slot])
	viewer_scroll[viewer_active_slot] = 0
	viewer_layout_width[viewer_active_slot] = -1
	viewer_layout_font[viewer_active_slot] = graphics::FONT_NORMAL
	viewer_layout_lines[viewer_active_slot] = 1
	viewer_seek_index[viewer_active_slot] = 0
	viewer_seek_line[viewer_active_slot] = 0
	call clear_viewer_row_cache()
	call refresh_file_viewer_open_state()
}

proc close_file_viewer() {
	call close_viewer_window()
	call release_file_viewer()
}

proc request_file_viewer_close() {
	viewer_close_requested = true
}

proc open_file_viewer(index: int) {
	var path: string
	var slot: int
	if (index < 0 || index >= cached_entry_count) {
		return
	}
	if (entry_directory_cache[index] != 0) {
		return
	}
	slot = available_file_viewer_slot()
	if (slot < 0) {
		call set_explorer_status("3 file windows open")
		return
	}
	viewer_active_slot = slot
	path = explorer_join_path(current_path, entry_name_cache[index])
	call explorer_set(viewer_name[viewer_active_slot], entry_name_cache[index])
	viewer_file = os::open_read(path)
	call explorer_set(viewer_content[viewer_active_slot], os::read(viewer_file))
	call os::close(path)
	viewer_scroll[viewer_active_slot] = 0
	viewer_layout_width[viewer_active_slot] = -1
	viewer_seek_index[viewer_active_slot] = 0
	viewer_seek_line[viewer_active_slot] = 0
	viewer_text_cache_valid[viewer_active_slot] = false
	call configure_viewer_window()
	viewer_is_open[viewer_active_slot] = true
	call refresh_file_viewer_open_state()
	viewer_close_requested = false
	context_open = false
	call set_explorer_status("Viewing file")
}

proc begin_rename(index: int) {
	if (index < 0 || index >= cached_entry_count) {
		return
	}
	context_entry = index
	call explorer_set(rename_text, entry_name_cache[index])
	rename_anchor_x = context_x
	rename_anchor_y = context_y
	rename_cursor = xestring::strlen(rename_text)
	call explorer_select_all_rename_text()
	rename_first_char = 0
	rename_pointer_guard = 2
	rename_open = true
	context_open = false
}

proc commit_rename() {
	var old_name: string
	var old_path: string
	var final_name: string
	var new_path: string
	final_name = ""
	if (context_entry < 0 || context_entry >= cached_entry_count) {
		rename_open = false
		rename_select_all = false
		call explorer_clear_rename_selection()
		return
	}
	old_name = entry_name_cache[context_entry]
	old_path = explorer_join_path(current_path, old_name)
	if (!explorer_name_is_valid(rename_text)) {
		call set_explorer_status("Enter a valid name")
		return
	}
	if (explorer_strings_equal(rename_text, old_name)) {
		call explorer_set(final_name, old_name)
	}
	else {
		final_name = explorer_unique_child_name(current_path, rename_text, entry_directory_cache[context_entry] != 0)
	}
	new_path = explorer_join_path(current_path, final_name)
	if (explorer_strings_equal(final_name, old_name) || os::rename(old_path, new_path)) {
		if (explorer_strings_equal(final_name, rename_text)) {
			call set_explorer_status("Renamed")
		}
		else {
			call set_explorer_status(xestring::concat("Renamed to ", final_name))
		}
		call reset_energy_shells()
		selected_entry = -1
		rename_open = false
		rename_select_all = false
		call explorer_clear_rename_selection()
	}
	else {
		call set_explorer_status("Rename failed")
	}
}

proc refresh_compacted_entry_metadata() {
	var actual_count: int
	var index: int
	var source: int
	var expected_name: string
	var entry_path: string
	call invalidate_published_orbit_scene()
	actual_count = os::entry_count(current_path)
	if (actual_count > 64) { actual_count = 64 }
	if (actual_count != cached_entry_count) {
		call reset_energy_shells()
		context_entry = -1
		return
	}
	index = 0
	while (index < cached_entry_count) {
		expected_name = os::entry_name(current_path, index)
		if (!explorer_strings_equal(entry_name_cache[index], expected_name)) {
			source = index + 1
			while (source < cached_entry_count && !explorer_strings_equal(entry_name_cache[source], expected_name)) { source += 1 }
			if (source >= cached_entry_count) {
				call reset_energy_shells()
				context_entry = -1
				return
			}
			while (source > index) {
				call swap_cached_entry_records(source, source - 1)
				source -= 1
			}
		}
		call refresh_entry_label_cache(index)
		if (os::entry_is_directory(current_path, index)) {
			entry_directory_cache[index] = 1
			entry_path = explorer_join_path(current_path, entry_name_cache[index])
			entry_child_count_cache[index] = os::entry_count(entry_path)
			if (entry_child_count_cache[index] < 0) { entry_child_count_cache[index] = 0 }
		}
		else {
			entry_directory_cache[index] = 0
			entry_child_count_cache[index] = 0
		}
		index += 1
	}
	cached_revision = os::revision()
	orbit_stream_dirty = true
}

proc rebuild_orbit_command_stream() {
	var command: int
	var shell_table: int
	var item_table: int
	var record: int
	var shell: int
	var index: int
	command = graphics::COMMAND_HEADER_WORDS
	shell_table = command + graphics::COMMAND_ORBIT_WORDS
	item_table = shell_table + shell_count * graphics::COMMAND_ORBIT_SHELL_WORDS
	orbit_stream_words = item_table + cached_entry_count * graphics::COMMAND_ORBIT_ITEM_WORDS
	orbit_command_stream[graphics::COMMAND_HEADER_MAGIC_OFFSET] = graphics::COMMAND_MAGIC
	orbit_command_stream[graphics::COMMAND_HEADER_VERSION_OFFSET] = graphics::COMMAND_VERSION
	orbit_command_stream[graphics::COMMAND_HEADER_TOTAL_WORDS_OFFSET] = orbit_stream_words
	orbit_command_stream[graphics::COMMAND_HEADER_COUNT_OFFSET] = 1
	orbit_command_stream[graphics::COMMAND_HEADER_FIRST_OFFSET] = command
	orbit_command_stream[graphics::COMMAND_HEADER_RESERVED_OFFSET] = 0
	orbit_command_stream[graphics::COMMAND_HEADER_RESERVED_OFFSET + 1] = 0
	orbit_command_stream[graphics::COMMAND_HEADER_RESERVED_OFFSET + 2] = 0
	orbit_command_stream[command + graphics::COMMAND_ORBIT_OPCODE_OFFSET] = graphics::COMMAND_ORBIT_SCENE
	orbit_command_stream[command + graphics::COMMAND_ORBIT_WORDS_OFFSET] = graphics::COMMAND_ORBIT_WORDS
	orbit_command_stream[command + graphics::COMMAND_ORBIT_ENTRY_COUNT_OFFSET] = cached_entry_count
	orbit_command_stream[command + graphics::COMMAND_ORBIT_SHELL_COUNT_OFFSET] = shell_count
	orbit_command_stream[command + graphics::COMMAND_ORBIT_ITEM_TABLE_OFFSET] = item_table
	orbit_command_stream[command + graphics::COMMAND_ORBIT_ITEM_STRIDE_OFFSET] = graphics::COMMAND_ORBIT_ITEM_WORDS
	orbit_command_stream[command + graphics::COMMAND_ORBIT_SHELL_TABLE_OFFSET] = shell_table
	orbit_command_stream[command + graphics::COMMAND_ORBIT_SHELL_STRIDE_OFFSET] = graphics::COMMAND_ORBIT_SHELL_WORDS
	orbit_command_stream[command + graphics::COMMAND_ORBIT_FLAGS_OFFSET] = graphics::COMMAND_ORBIT_DRAW_LABELS
	orbit_command_stream[command + graphics::COMMAND_ORBIT_SHELL_POINTS_OFFSET] = 20
	shell = 0
	while (shell < shell_count) {
		record = shell_table + shell * graphics::COMMAND_ORBIT_SHELL_WORDS
		orbit_command_stream[record + graphics::COMMAND_ORBIT_SHELL_PHASE_OFFSET] = shell_phase[shell]
		orbit_command_stream[record + graphics::COMMAND_ORBIT_SHELL_POPULATION_OFFSET] = shell_population_cache[shell]
		shell += 1
	}
	index = 0
	while (index < cached_entry_count) {
		record = item_table + index * graphics::COMMAND_ORBIT_ITEM_WORDS
		orbit_command_stream[record + graphics::COMMAND_ORBIT_ITEM_SHELL_OFFSET] = entry_shell[index]
		orbit_command_stream[record + graphics::COMMAND_ORBIT_ITEM_POSITION_OFFSET] = entry_position_cache[index]
		orbit_command_stream[record + graphics::COMMAND_ORBIT_ITEM_DIRECTORY_OFFSET] = entry_directory_cache[index]
		orbit_command_stream[record + graphics::COMMAND_ORBIT_ITEM_CHILD_COUNT_OFFSET] = entry_child_count_cache[index]
		orbit_command_stream[record + graphics::COMMAND_ORBIT_ITEM_NAME_OFFSET] = index
		orbit_command_stream[record + graphics::COMMAND_ORBIT_ITEM_SHORT_NAME_OFFSET] = index
		index += 1
	}
	orbit_stream_dirty = false
	orbit_scene_static_dirty = true
	orbit_phase_stream_dirty = false
}

proc prepare_entry_removal() {
	var index: int
	var shell: int
	var population: int
	index = 0
	while (index < cached_entry_count) {
		shell = entry_shell[index]
		population = shell_population_cache[shell]
		if (population < 1) { population = 1 }
		entry_preserved_angle[index] = shell_phase[shell] + entry_position_cache[index] * 360 / population + shell * 17
		while (entry_preserved_angle[index] < 0) { entry_preserved_angle[index] += 360 }
		while (entry_preserved_angle[index] >= 360) { entry_preserved_angle[index] -= 360 }
		entry_delete_mark[index] = 0
		index += 1
	}
}

proc capture_deletion_ghost(index: int) {
	var ghost: int
	var shell: int
	if (deletion_ghost_count >= 64) { return }
	ghost = deletion_ghost_count
	shell = entry_shell[index]
	deletion_ghost_x[ghost] = entry_render_x[index]
	deletion_ghost_y[ghost] = entry_render_y[index]
	deletion_ghost_depth[ghost] = entry_render_depth[index]
	deletion_ghost_radius[ghost] = entry_node_radius[index]
	deletion_ghost_directory[ghost] = entry_directory_cache[index]
	deletion_ghost_child_count[ghost] = entry_child_count_cache[index]
	deletion_ghost_phase[ghost] = rotation + shell_phase[shell] + index * 31
	deletion_ghost_accumulator[ghost] = 0
	deletion_ghost_speed[ghost] = shell_speed[shell]
	deletion_ghost_age[ghost] = 0
	deletion_ghost_count += 1
}

proc compact_removed_entries(preserve_shells: bool) {
	var read_index: int
	var write_index: int
	var previous_count: int
	var shell: int
	var anchor: int
	var population: int
	var phase: int
	previous_count = cached_entry_count
	call invalidate_published_orbit_scene()
	read_index = 0
	write_index = 0
	while (read_index < cached_entry_count) {
		if (entry_delete_mark[read_index] == 0) {
			if (write_index != read_index) {
				call explorer_set(entry_name_cache[write_index], entry_name_cache[read_index])
			}
			entry_directory_cache[write_index] = entry_directory_cache[read_index]
			entry_child_count_cache[write_index] = entry_child_count_cache[read_index]
			entry_shell[write_index] = entry_shell[read_index]
			entry_preserved_angle[write_index] = entry_preserved_angle[read_index]
			entry_render_x[write_index] = entry_render_x[read_index]
			entry_render_y[write_index] = entry_render_y[read_index]
			entry_render_depth[write_index] = entry_render_depth[read_index]
			entry_node_radius[write_index] = entry_node_radius[read_index]
			entry_slot_start_x[write_index] = entry_render_x[read_index]
			entry_slot_start_y[write_index] = entry_render_y[read_index]
			entry_slot_start_depth[write_index] = entry_render_depth[read_index]
			entry_slot_progress[write_index] = 0
			entry_slot_elapsed[write_index] = 0
			entry_slot_duration[write_index] = 220
			entry_selected[write_index] = 0
			entry_delete_mark[write_index] = 0
			write_index += 1
		}
		read_index += 1
	}
	read_index = write_index
	while (read_index < previous_count) {
		call clear_cached_entry_record(read_index)
		read_index += 1
	}
	cached_entry_count = write_index
	slot_animation_active = cached_entry_count > 0
	if (preserve_shells) { call rebuild_shell_layout() }
	else { call compact_energy_shells(cached_entry_count) }
	shell = 0
	while (shell < 8) {
		removal_shell_anchor[shell] = -1
		shell += 1
	}
	read_index = 0
	while (read_index < cached_entry_count) {
		shell = entry_shell[read_index]
		if (removal_shell_anchor[shell] < 0) { removal_shell_anchor[shell] = read_index }
		read_index += 1
	}
	shell = 0
	while (shell < shell_count) {
		anchor = removal_shell_anchor[shell]
		population = shell_population_cache[shell]
		if (anchor >= 0 && population > 0) {
			phase = entry_preserved_angle[anchor] - entry_position_cache[anchor] * 360 / population - shell * 17
			while (phase < 0) { phase += 360 }
			while (phase >= 360) { phase -= 360 }
			shell_phase[shell] = phase
		}
		shell += 1
	}
	read_index = 0
	while (read_index < cached_entry_count) {
		shell = entry_shell[read_index]
		entry_slot_duration[read_index] = insertion_slot_duration(shell_population_cache[shell])
		read_index += 1
	}
	call refresh_compacted_entry_metadata()
	call clear_entry_selection()
	selected_entry = -1
	selection_anchor = -1
	last_click_entry = -1
	hovered_entry = -1
	drop_folder_entry = -1
	call clear_entry_drag()
}

proc compact_deleted_entries() {
	call compact_removed_entries(false)
}

proc compact_moved_entries() {
	call compact_removed_entries(true)
}

proc move_dragged_entries_into_folder(folder_index: int) {
	var index: int
	var moved_count: int
	var failed_count: int
	var folder_name: string
	var folder_path: string
	var source_name: string
	var source_path: string
	var destination_name: string
	if (drag_entry < 0 || drag_entry >= cached_entry_count || folder_index < 0 || folder_index >= cached_entry_count) { return }
	if (entry_directory_cache[folder_index] == 0 || dragged_entry_in_group(folder_index)) { return }
	folder_name = xestring::concat("", entry_name_cache[folder_index])
	folder_path = explorer_join_path(current_path, folder_name)
	call prepare_entry_removal()
	index = 0
	moved_count = 0
	failed_count = 0
	while (index < cached_entry_count) {
		if (dragged_entry_in_group(index)) {
			source_name = entry_name_cache[index]
			source_path = explorer_join_path(current_path, source_name)
			destination_name = explorer_unique_child_name(folder_path, source_name, entry_directory_cache[index] != 0)
			operation_ok = os::rename(source_path, explorer_join_path(folder_path, destination_name))
			if (operation_ok) {
				entry_delete_mark[index] = 1
				moved_count += 1
			}
			else { failed_count += 1 }
		}
		index += 1
	}
	if (moved_count > 0) {
		call compact_moved_entries()
		if (failed_count > 0) { call set_explorer_status("Some items were not moved") }
		else { call set_explorer_status(xestring::concat("Moved into ", folder_name)) }
	}
	else { call set_explorer_status("Move failed") }
}

proc move_dragged_entries_to_path(destination_path: string) {
	var index: int
	var moved_count: int
	var failed_count: int
	var source_name: string
	var source_path: string
	var destination_name: string
	if (drag_entry < 0 || drag_entry >= cached_entry_count) { return }
	if (explorer_strings_equal(current_path, destination_path)) { return }
	call prepare_entry_removal()
	index = 0
	moved_count = 0
	failed_count = 0
	while (index < cached_entry_count) {
		if (dragged_entry_in_group(index)) {
			source_name = entry_name_cache[index]
			source_path = explorer_join_path(current_path, source_name)
			destination_name = explorer_unique_child_name(destination_path, source_name, entry_directory_cache[index] != 0)
			operation_ok = os::rename(source_path, explorer_join_path(destination_path, destination_name))
			if (operation_ok) {
				entry_delete_mark[index] = 1
				moved_count += 1
			}
			else { failed_count += 1 }
		}
		index += 1
	}
	if (moved_count > 0) {
		call compact_moved_entries()
		if (failed_count > 0) { call set_explorer_status("Some items were not moved") }
		else { call set_explorer_status(xestring::concat("Moved to ", destination_path)) }
	}
	else { call set_explorer_status("Move failed") }
}

proc confirm_context_delete() {
	var index: int
	var deleted_count: int
	var failed_count: int
	var use_selection: bool
	var target_path: string
	call refresh_compacted_entry_metadata()
	if (context_entry < 0 || context_entry >= cached_entry_count) {
		delete_confirm = false
		return
	}
	use_selection = entry_selected[context_entry] != 0 && selected_entry_count() > 0
	call prepare_entry_removal()
	index = 0
	deleted_count = 0
	failed_count = 0
	while (index < cached_entry_count) {
		if ((use_selection && entry_selected[index] != 0) || (!use_selection && index == context_entry)) {
			target_path = explorer_join_path(current_path, entry_name_cache[index])
			operation_ok = os::delete(target_path)
			if (operation_ok) {
				entry_delete_mark[index] = 1
				call capture_deletion_ghost(index)
				deleted_count += 1
			}
			else { failed_count += 1 }
		}
		index += 1
	}
	if (deleted_count > 0) {
		call compact_deleted_entries()
		if (failed_count > 0) { call set_explorer_status("Some items were not deleted") }
		elseif (deleted_count == 1) { call set_explorer_status("Moved to Trash") }
		else { call set_explorer_status("Moved items to Trash") }
	}
	else {
		call set_explorer_status("Delete failed")
	}
	delete_confirm = false
	context_open = false
	context_entry = -1
}

proc delete_dragged_entries() {
	context_entry = drag_entry
	call confirm_context_delete()
}

proc refresh_breadcrumb_layout(area_width: int) {
	var index: int
	var start: int
	var copy_index: int
	var path_length: int
	var cursor_offset: int
	var remaining_width: int
	var visible_chars: int
	if (breadcrumb_layout_revision == current_path_revision && breadcrumb_layout_width == area_width) { return }
	breadcrumb_count = 0
	cursor_offset = 16
	path_length = xestring::strlen(current_path)
	index = 0
	start = 0
	while (!current_path_is_root && index <= path_length && cursor_offset < area_width - 20 && breadcrumb_count < BREADCRUMB_CACHE_LIMIT) {
		if (index == path_length || (int)(current_path[index]) == 47) {
			breadcrumb_label_width[breadcrumb_count] = 0
			copy_index = start
			while (copy_index < index) {
				breadcrumb_label_width[breadcrumb_count] += explorer_char_advance(current_path[copy_index], graphics::FONT_NORMAL)
				copy_index += 1
			}
			if (breadcrumb_label_width[breadcrumb_count] > 0) { breadcrumb_label_width[breadcrumb_count] -= 1 }
			breadcrumb_segment_width[breadcrumb_count] = breadcrumb_label_width[breadcrumb_count] + 8
			remaining_width = area_width - cursor_offset
			if (breadcrumb_segment_width[breadcrumb_count] > remaining_width) { breadcrumb_segment_width[breadcrumb_count] = remaining_width }
			visible_chars = index - start
			while (visible_chars > 0 && breadcrumb_label_width[breadcrumb_count] > breadcrumb_segment_width[breadcrumb_count] - 2) {
				visible_chars -= 1
				if (visible_chars == 0) { breadcrumb_label_width[breadcrumb_count] = 0 }
				else { breadcrumb_label_width[breadcrumb_count] -= explorer_char_advance(current_path[start + visible_chars], graphics::FONT_NORMAL) }
			}
			call explorer_clear(breadcrumb_label[breadcrumb_count])
			copy_index = 0
			while (copy_index < visible_chars) {
				call xestring::append_char(breadcrumb_label[breadcrumb_count], current_path[start + copy_index])
				copy_index += 1
			}
			call explorer_clear(breadcrumb_destination[breadcrumb_count])
			if (index < path_length) {
				breadcrumb_is_parent[breadcrumb_count] = 1
				copy_index = 0
				while (copy_index < index) {
					call xestring::append_char(breadcrumb_destination[breadcrumb_count], current_path[copy_index])
					copy_index += 1
				}
			}
			else { breadcrumb_is_parent[breadcrumb_count] = 0 }
			cursor_offset += breadcrumb_segment_width[breadcrumb_count] + 2
			breadcrumb_count += 1
			start = index + 1
		}
		index += 1
	}
	breadcrumb_layout_revision = current_path_revision
	breadcrumb_layout_width = area_width
}

proc draw_breadcrumbs(x: int, y: int, area_width: int) {
	var index: int
	var cursor_x: int
	var segment_width: int
	var pointer_x: int
	var pointer_y: int
	var drop_color: int
	var text_color: int
	var dragging_path: bool
	var modal_open: bool
	var pointer_hot: bool
	var button_hot: bool
	var button_clicked: bool
	call refresh_breadcrumb_layout(area_width)
	cursor_x = x
	pointer_x = frame_pointer_x
	pointer_y = frame_pointer_y
	modal_open = explorer_modal_open()
	text_color = explorer_control_text_color()
	button_hot = frame_mouse_down || frame_mouse_released || (pointer_x >= cursor_x && pointer_x < cursor_x + 14 && pointer_y >= y && pointer_y < y + 9)
	dragging_path = drag_entry >= 0 && drag_moved
	if (dragging_path) {
		drop_color = visual_surface
		if (!current_path_is_root && pointer_x >= cursor_x && pointer_x < cursor_x + 14 && pointer_y >= y && pointer_y < y + 9) {
			drop_color = visual_accent
			drop_path_active = true
			call explorer_set(drop_path_target, ".")
		}
		call graphics::fill_rect(explorer_window, cursor_x, y, 14, 9, drop_color)
		call draw_explorer_fixed_label_centered(cursor_x, y + 1, 14, "/", path_separator_width, visual_outline)
	}
	elseif (!modal_open) {
		if (button_hot) {
			button_clicked = explorer_fixed_label_button(cursor_x, y, 14, 9, "/", path_separator_width, graphics::COLOR_8, text_color)
			if (button_clicked) {
				if (!current_path_is_root) { call begin_path_transition(".") }
				return
			}
		}
		else {
			call graphics::fill_rect(explorer_window, cursor_x, y, 14, 9, graphics::COLOR_8)
			call draw_explorer_fixed_label_centered(cursor_x, y + 1, 14, "/", path_separator_width, text_color)
		}
	}
	else {
		call graphics::fill_rect(explorer_window, cursor_x, y, 14, 9, visual_surface)
		call draw_explorer_fixed_label_centered(cursor_x, y + 1, 14, "/", path_separator_width, visual_outline)
	}
	cursor_x += 16
	index = 0
	while (index < breadcrumb_count) {
		segment_width = breadcrumb_segment_width[index]
		pointer_hot = pointer_x >= cursor_x && pointer_x < cursor_x + segment_width && pointer_y >= y && pointer_y < y + 9
		button_hot = frame_mouse_down || frame_mouse_released || pointer_hot
		if (dragging_path) {
			drop_color = visual_surface
			if (breadcrumb_is_parent[index] != 0 && pointer_hot) {
				drop_color = visual_accent
				drop_path_active = true
				call explorer_set(drop_path_target, breadcrumb_destination[index])
			}
			call graphics::fill_rect(explorer_window, cursor_x, y, segment_width, 9, drop_color)
			call draw_explorer_fixed_label_centered(cursor_x, y + 1, segment_width, breadcrumb_label[index], breadcrumb_label_width[index], visual_outline)
		}
		elseif (!modal_open && button_hot) {
			button_clicked = explorer_fixed_label_button(cursor_x, y, segment_width, 9, breadcrumb_label[index], breadcrumb_label_width[index], graphics::COLOR_8, text_color)
			if (button_clicked) {
				if (breadcrumb_is_parent[index] != 0) { call begin_path_transition(breadcrumb_destination[index]) }
				return
			}
		}
		elseif (!modal_open) {
			call graphics::fill_rect(explorer_window, cursor_x, y, segment_width, 9, graphics::COLOR_8)
			call draw_explorer_fixed_label_centered(cursor_x, y + 1, segment_width, breadcrumb_label[index], breadcrumb_label_width[index], text_color)
		}
		else {
			call graphics::fill_rect(explorer_window, cursor_x, y, segment_width, 9, visual_surface)
			call draw_explorer_fixed_label_centered(cursor_x, y + 1, segment_width, breadcrumb_label[index], breadcrumb_label_width[index], visual_outline)
		}
		cursor_x += segment_width + 2
		index += 1
	}
}

fn viewer_row_height(font_size: int) int {
	if (font_size >= graphics::FONT_LARGE) { return 16 }
	return 8
}

fn viewer_font_size(content_width: int, content_height: int) int {
	return graphics::FONT_NORMAL
}

fn viewer_tab_advance(column: int, font_size: int) int {
	var tab_width: int
	tab_width = graphics::char_advance(' ', font_size) * 4
	if (tab_width < 1) { tab_width = 4 }
	return tab_width - column % tab_width
}

fn viewer_word_end(start: int) int {
	var index: int
	var code: int
	index = start
	while (index < xestring::strlen(viewer_content[viewer_active_slot])) {
		code = (int)(viewer_content[viewer_active_slot][index])
		if (code == 9 || code == 10 || code == 13 || code == 32) { return index }
		index += 1
	}
	return index
}

fn viewer_word_width(start: int, finish: int, font_size: int) int {
	var index: int
	var result: int
	var code: int
	index = start
	result = 0
	while (index < finish) {
		code = (int)(viewer_content[viewer_active_slot][index])
		if (code >= 32 && code <= 126) {
			result += graphics::char_advance(viewer_content[viewer_active_slot][index], font_size)
		}
		index += 1
	}
	return result
}

fn viewer_line_count(content_width: int, font_size: int) int {
	var index: int
	var column: int
	var lines: int
	var code: int
	var finish: int
	var word_width: int
	var advance: int
	if (content_width < 1) { content_width = 1 }
	index = 0
	column = 0
	lines = 1
	while (index < xestring::strlen(viewer_content[viewer_active_slot])) {
		code = (int)(viewer_content[viewer_active_slot][index])
		if (code == 10) {
			lines += 1
			column = 0
			index += 1
		}
		elseif (code == 13) { index += 1 }
		elseif (code == 9 || code == 32) {
			if (code == 9) { advance = viewer_tab_advance(column, font_size) }
			else { advance = graphics::char_advance(' ', font_size) }
			column += advance
			index += 1
		}
		else {
			finish = viewer_word_end(index)
			word_width = viewer_word_width(index, finish, font_size)
			if (word_width > content_width) {
				# Keep ordinary words intact. An unbreakable token wider than the
				# entire viewport uses an emergency character wrap so none of its
				# content is silently discarded.
				if (column > 0) {
					lines += 1
					column = 0
				}
				while (index < finish) {
					advance = graphics::char_advance(viewer_content[viewer_active_slot][index], font_size)
					if (column > 0 && column + advance > content_width) {
						lines += 1
						column = 0
					}
					column += advance
					index += 1
				}
			}
			else {
				if (column > 0 && column + word_width > content_width) {
					lines += 1
					column = 0
				}
				column += word_width
				index = finish
			}
		}
	}
	return lines
}

proc viewer_seek_to_line(target_line: int, content_width: int, font_size: int) {
	var index: int
	var line: int
	var column: int
	var code: int
	var finish: int
	var word_width: int
	var advance: int
	if (target_line < 0) { target_line = 0 }
	if (content_width < 1) { content_width = 1 }
	if (target_line < viewer_seek_line[viewer_active_slot]) {
		viewer_seek_index[viewer_active_slot] = 0
		viewer_seek_line[viewer_active_slot] = 0
	}
	index = viewer_seek_index[viewer_active_slot]
	line = viewer_seek_line[viewer_active_slot]
	column = 0
	while (index < xestring::strlen(viewer_content[viewer_active_slot]) && line < target_line) {
		code = (int)(viewer_content[viewer_active_slot][index])
		if (code == 10) {
			line += 1
			column = 0
			index += 1
		}
		elseif (code == 13) { index += 1 }
		elseif (code == 9 || code == 32) {
			if (code == 9) { advance = viewer_tab_advance(column, font_size) }
			else { advance = graphics::char_advance(' ', font_size) }
			column += advance
			index += 1
		}
		else {
			finish = viewer_word_end(index)
			word_width = viewer_word_width(index, finish, font_size)
			if (word_width > content_width) {
				if (column > 0) {
					line += 1
					column = 0
				}
				while (index < finish && line < target_line) {
					advance = graphics::char_advance(viewer_content[viewer_active_slot][index], font_size)
					if (column > 0 && column + advance > content_width) {
						line += 1
						column = 0
					}
					if (line < target_line) {
						column += advance
						index += 1
					}
				}
			}
			else {
				if (column > 0 && column + word_width > content_width) {
					line += 1
					column = 0
				}
				if (line < target_line) {
					column += word_width
					index = finish
				}
			}
		}
	}
	viewer_seek_index[viewer_active_slot] = index
	viewer_seek_line[viewer_active_slot] = line
}

proc draw_viewer_content(x: int, y: int, content_width: int, content_height: int, font_size: int) {
	var index: int
	var column: int
	var line: int
	var visible_line: int
	var maximum_lines: int
	var code: int
	var finish: int
	var word_width: int
	var advance: int
	var row_height: int
	var space_advance: int
	var gap_spaces: int
	row_height = viewer_row_height(font_size)
	maximum_lines = content_height / row_height
	if (maximum_lines < 1) { maximum_lines = 1 }
	if (maximum_lines > 64) { maximum_lines = 64 }
	viewer_text_cache_building[viewer_active_slot] = !viewer_text_cache_valid[viewer_active_slot] || viewer_text_cache_scroll[viewer_active_slot] != viewer_scroll[viewer_active_slot] || viewer_text_cache_maximum_lines[viewer_active_slot] != maximum_lines
	if (!viewer_text_cache_building[viewer_active_slot] && !viewer_text_cache_fallback[viewer_active_slot]) {
		index = 0
		while (index < viewer_row_cache_lines[viewer_active_slot]) {
			if (xestring::strlen(viewer_row_cache[viewer_cache_index(index)]) > 0) {
				call draw_viewer_text_standard(x, y + index * row_height, viewer_row_cache[viewer_cache_index(index)], font_size, graphics::WHITE)
			}
			index += 1
		}
		return
	}
	if (viewer_text_cache_building[viewer_active_slot]) {
		index = 0
		while (index < viewer_row_cache_lines[viewer_active_slot] || index < maximum_lines) {
			call explorer_clear(viewer_row_cache[viewer_cache_index(index)])
			index += 1
		}
		viewer_row_cache_lines[viewer_active_slot] = maximum_lines
		viewer_text_cache_fallback[viewer_active_slot] = false
		viewer_text_cache_scroll[viewer_active_slot] = viewer_scroll[viewer_active_slot]
		viewer_text_cache_maximum_lines[viewer_active_slot] = maximum_lines
	}
	if (xestring::strlen(viewer_content[viewer_active_slot]) == 0) {
		if (viewer_text_cache_building[viewer_active_slot]) { call explorer_set(viewer_row_cache[viewer_cache_index(0)], "(Empty file.)") }
		viewer_text_cache_valid[viewer_active_slot] = true
		call draw_viewer_text_standard(x, y, viewer_row_cache[viewer_cache_index(0)], font_size, graphics::WHITE)
		return
	}
	call viewer_seek_to_line(viewer_scroll[viewer_active_slot], content_width, font_size)
	index = viewer_seek_index[viewer_active_slot]
	column = 0
	line = viewer_seek_line[viewer_active_slot]
	while (index < xestring::strlen(viewer_content[viewer_active_slot]) && line < viewer_scroll[viewer_active_slot] + maximum_lines) {
		code = (int)(viewer_content[viewer_active_slot][index])
		if (code == 10) {
			line += 1
			column = 0
			index += 1
		}
		elseif (code == 13) { index += 1 }
		elseif (code == 9 || code == ' ') {
			if (code == 9) { advance = viewer_tab_advance(column, font_size) }
			else { advance = graphics::char_advance(' ', font_size) }
			if (viewer_text_cache_building[viewer_active_slot] && !viewer_text_cache_fallback[viewer_active_slot] && column + advance <= content_width) {
				if (code == 32) { call xestring::append_char(viewer_row_cache[viewer_cache_index(line - viewer_scroll[viewer_active_slot])], ' ') }
				else {
					space_advance = graphics::char_advance(' ', font_size)
					if (space_advance < 1 || advance % space_advance != 0) {
						viewer_text_cache_fallback[viewer_active_slot] = true
					}
					else {
						gap_spaces = advance / space_advance
						while (gap_spaces > 0) {
							call xestring::append_char(viewer_row_cache[viewer_cache_index(line - viewer_scroll[viewer_active_slot])], ' ')
							gap_spaces -= 1
						}
					}
				}
			}
			column += advance
			index += 1
		}
		else {
			finish = viewer_word_end(index)
			word_width = viewer_word_width(index, finish, font_size)
			if (word_width > content_width) {
				if (column > 0) {
					line += 1
					column = 0
				}
				while (index < finish) {
					advance = graphics::char_advance(viewer_content[viewer_active_slot][index], font_size)
					if (column > 0 && column + advance > content_width) {
						line += 1
						column = 0
					}
					if (line >= viewer_scroll[viewer_active_slot] && line < viewer_scroll[viewer_active_slot] + maximum_lines && column + advance <= content_width) {
						visible_line = line - viewer_scroll[viewer_active_slot]
						call draw_viewer_char_standard(x + column, y + visible_line * row_height, viewer_content[viewer_active_slot][index], font_size, graphics::WHITE)
						if (viewer_text_cache_building[viewer_active_slot] && !viewer_text_cache_fallback[viewer_active_slot]) { call xestring::append_char(viewer_row_cache[viewer_cache_index(visible_line)], viewer_content[viewer_active_slot][index]) }
					}
					column += advance
					index += 1
				}
			}
			else {
				if (column > 0 && column + word_width > content_width) {
					line += 1
					column = 0
				}
				while (index < finish) {
					code = (int)(viewer_content[viewer_active_slot][index])
					if (code >= 32 && code <= 126) {
						advance = graphics::char_advance(viewer_content[viewer_active_slot][index], font_size)
						if (line >= viewer_scroll[viewer_active_slot] && line < viewer_scroll[viewer_active_slot] + maximum_lines && column + advance <= content_width) {
							visible_line = line - viewer_scroll[viewer_active_slot]
							call draw_viewer_char_standard(x + column, y + visible_line * row_height, viewer_content[viewer_active_slot][index], font_size, graphics::WHITE)
							if (viewer_text_cache_building[viewer_active_slot] && !viewer_text_cache_fallback[viewer_active_slot]) { call xestring::append_char(viewer_row_cache[viewer_cache_index(visible_line)], viewer_content[viewer_active_slot][index]) }
						}
						column += advance
					}
					index += 1
				}
			}
		}
	}
	if (viewer_text_cache_building[viewer_active_slot]) { viewer_text_cache_valid[viewer_active_slot] = true }
}

proc draw_file_viewer() {
	var panel_width: int
	var panel_height: int
	var content_y: int
	var body_height: int
	var content_width: int
	var font_size: int
	var maximum_lines: int
	var maximum_scroll: int
	panel_width = viewer_width[viewer_active_slot]
	panel_height = viewer_height[viewer_active_slot]
	if (panel_width < 1) { panel_width = 1 }
	if (panel_height < 1) { panel_height = 1 }
	call fill_viewer_rect(0, 0, panel_width, panel_height, visual_surface)
	content_y = 3
	if (panel_width >= 72 && panel_height >= 12) {
		if (viewer_flat_button_aligned(panel_width - 70, 1, 26, 8, "Up", visual_surface, explorer_control_text_color()) && viewer_scroll[viewer_active_slot] > 0) {
			viewer_scroll[viewer_active_slot] -= 1
		}
		if (viewer_flat_button_aligned(panel_width - 42, 1, 40, 8, "Down", visual_surface, explorer_control_text_color())) {
			viewer_scroll[viewer_active_slot] += 1
		}
		content_y = 12
	}
	body_height = panel_height - content_y - 3
	content_width = panel_width - 8
	if (body_height < 1) { body_height = 1 }
	if (content_width < 1) { content_width = 1 }
	font_size = viewer_font_size(content_width, body_height)
	maximum_lines = body_height / viewer_row_height(font_size)
	if (maximum_lines < 1) { maximum_lines = 1 }
	if (viewer_layout_width[viewer_active_slot] != content_width || viewer_layout_font[viewer_active_slot] != font_size) {
		viewer_layout_width[viewer_active_slot] = content_width
		viewer_layout_font[viewer_active_slot] = font_size
		viewer_layout_lines[viewer_active_slot] = viewer_line_count(content_width, font_size)
		viewer_seek_index[viewer_active_slot] = 0
		viewer_seek_line[viewer_active_slot] = 0
		viewer_text_cache_valid[viewer_active_slot] = false
	}
	maximum_scroll = viewer_layout_lines[viewer_active_slot] - maximum_lines
	if (maximum_scroll < 0) { maximum_scroll = 0 }
	if (viewer_scroll[viewer_active_slot] > maximum_scroll) { viewer_scroll[viewer_active_slot] = maximum_scroll }
	call draw_viewer_content(4, content_y, content_width, body_height, font_size)
}

proc dismiss_context_menu_outside_press() {
	var menu_width: int
	var menu_height: int
	if (!context_open || !frame_mouse_pressed) { return }
	menu_width = 68
	menu_height = 20
	if (selected_entry_count() == 1) { menu_height += 9 }
	if (menu_width > width - 4) { menu_width = width - 4 }
	if (context_x + menu_width > width - 2) { context_x = width - menu_width - 2 }
	if (context_y + menu_height > height - 2) { context_y = height - menu_height - 2 }
	if (context_x < 2) { context_x = 2 }
	if (context_y < 2) { context_y = 2 }
	if (frame_pointer_x < context_x || frame_pointer_x >= context_x + menu_width || frame_pointer_y < context_y || frame_pointer_y >= context_y + menu_height) {
		context_open = false
	}
}

proc draw_context_menu() {
	var menu_width: int
	var menu_height: int
	var inside: bool
	var single_file: bool
	
	single_file = selected_entry_count() == 1
	menu_width = 68
	menu_height = 20 + (int)single_file * 9
	if (menu_width > width - 4) { menu_width = width - 4 }
	if (context_x + menu_width > width - 2) { context_x = width - menu_width - 2 }
	if (context_y + menu_height > height - 2) { context_y = height - menu_height - 2 }
	if (context_x < 2) { context_x = 2 }
	if (context_y < 2) { context_y = 2 }
	inside = frame_pointer_x >= context_x && frame_pointer_x < context_x + menu_width && frame_pointer_y >= context_y && frame_pointer_y < context_y + menu_height
	if (frame_mouse_pressed && !inside) {
		context_open = false
		return
	}
	call graphics::fill_rect(explorer_window, context_x, context_y, menu_width, menu_height, visual_surface)
	call draw_explorer_text_standard(context_x + 3, context_y + 2, "Actions", graphics::FONT_NORMAL, visual_outline)
	if (explorer_flat_button_aligned(context_x + menu_width - 10, context_y + 1, 8, 7, "x", visual_surface, explorer_control_text_color())) {
		context_open = false
		return
	}
	if (single_file) {
		if (explorer_flat_button_aligned(context_x + 2, context_y + 10, menu_width - 4, 8, "Rename", visual_surface, explorer_control_text_color())) {
			call begin_rename(context_entry)
			return
		}
	}
	else {
		call graphics::fill_rect(explorer_window, context_x + 2, context_y + 10, menu_width - 4, 8, visual_surface)
		call draw_explorer_text_centered(context_x + 2, context_y + 10, menu_width - 4, "Rename", graphics::FONT_NORMAL, visual_shell)
	}
	if (explorer_flat_button_aligned(context_x + 2, context_y + 10 + (int)single_file * 9, menu_width - 4, 8, "Delete", graphics::COLOR_4, graphics::WHITE)) {
		if ((graphics::modifiers() & graphics::MOD_SHIFT) != 0) {
			call confirm_context_delete()
		}
		else {
			delete_confirm = true
			context_open = false
		}
	}
}

proc draw_inline_rename() {
	var field_width: int
	var field_x: int
	var field_y: int
	var button_width: int
	var first_char: int
	var index: int
	var selection_begin: int
	var selection_finish: int
	var caret_x: int
	var draw_x: int
	var character_width: int
	var text_area_width: int
	var text_width_to_cursor: int
	var pointer_cursor_found: bool
	var drawing_text: bool
	var pointer_x: int
	var pointer_y: int
	var pointer_in_field: bool
	var pointer_in_popup: bool
	field_width = 148
	if (field_width > width - 8) { field_width = width - 8 }
	if (field_width < 40) { field_width = 40 }
	field_x = rename_anchor_x - field_width / 2
	field_y = rename_anchor_y + 9
	if (field_x < 3) { field_x = 3 }
	if (field_x + field_width > width - 3) { field_x = width - field_width - 3 }
	if (field_y + 22 > height - 3) { field_y = rename_anchor_y - 27 }
	if (field_y < 3) { field_y = 3 }
	pointer_x = frame_pointer_x
	pointer_y = frame_pointer_y
	text_area_width = field_width - 4
	first_char = 0
	text_width_to_cursor = 0
	index = 0
	while (index < rename_cursor && index < xestring::strlen(rename_text)) {
		text_width_to_cursor += explorer_char_advance(rename_text[index], graphics::FONT_NORMAL)
		index += 1
	}
	while (first_char < rename_cursor && text_width_to_cursor > text_area_width) {
		text_width_to_cursor -= explorer_char_advance(rename_text[first_char], graphics::FONT_NORMAL)
		first_char += 1
	}
	selection_begin = explorer_rename_selection_begin()
	selection_finish = explorer_rename_selection_finish()
	if (selection_begin == 0 && selection_finish == xestring::strlen(rename_text)) { first_char = 0 }
	rename_first_char = first_char
	pointer_in_field = pointer_x >= field_x && pointer_x < field_x + field_width && pointer_y >= field_y && pointer_y < field_y + 10
	pointer_in_popup = pointer_x >= field_x && pointer_x < field_x + field_width && pointer_y >= field_y && pointer_y < field_y + 20
	if (rename_pointer_guard == 0 && frame_mouse_pressed) {
		if (pointer_in_field) {
			rename_cursor = rename_first_char
			draw_x = field_x + 2
			pointer_cursor_found = false
			while (rename_cursor < xestring::strlen(rename_text) && draw_x < field_x + field_width - 2 && !pointer_cursor_found) {
				character_width = explorer_char_advance(rename_text[rename_cursor], graphics::FONT_NORMAL)
				if (pointer_x < draw_x + character_width / 2) { pointer_cursor_found = true }
				else {
					draw_x += character_width
					rename_cursor += 1
				}
			}
			call explorer_clear_rename_selection()
		}
		elseif (!pointer_in_popup) {
			call cancel_rename()
			return
		}
	}
	call graphics::fill_rect(explorer_window, field_x, field_y, field_width, 10, visual_surface)
	call graphics::draw_rect(explorer_window, field_x, field_y, field_width, 10, visual_accent)
	index = first_char
	draw_x = field_x + 2
	drawing_text = true
	while (index < xestring::strlen(rename_text) && draw_x < field_x + field_width - 2 && drawing_text) {
		character_width = explorer_char_advance(rename_text[index], graphics::FONT_NORMAL)
		if (draw_x + character_width > field_x + field_width - 1) { drawing_text = false }
		else {
			if (index >= selection_begin && index < selection_finish) {
				call graphics::fill_rect(explorer_window, draw_x, field_y + 2, character_width, 7, graphics::COLOR_5)
			}
			call draw_explorer_char_standard(draw_x, field_y + 2, rename_text[index], graphics::FONT_NORMAL, graphics::WHITE)
			draw_x += character_width
			index += 1
		}
	}
	if ((current_ticks / 450) % 2 == 0) {
		caret_x = field_x + 2
		index = first_char
		while (index < rename_cursor && index < xestring::strlen(rename_text) && caret_x < field_x + field_width - 3) {
			caret_x += explorer_char_advance(rename_text[index], graphics::FONT_NORMAL)
			index += 1
		}
		if (caret_x > field_x + field_width - 3) { caret_x = field_x + field_width - 3 }
		call graphics::draw_line(explorer_window, caret_x, field_y + 2, caret_x, field_y + 7, visual_highlight)
	}
	button_width = (field_width - 2) / 2
	if (explorer_flat_button_aligned(field_x, field_y + 11, button_width, 9, "Rename", visual_accent, explorer_control_text_color())) {
		call commit_rename()
	}
	if (explorer_flat_button_aligned(field_x + button_width + 2, field_y + 11, button_width, 9, "Cancel", visual_surface, explorer_control_text_color())) {
		call cancel_rename()
	}
}

proc draw_delete_dialog() {
	var panel_width: int
	var panel_x: int
	var panel_y: int
	panel_width = 156
	if (panel_width > width - 8) { panel_width = width - 8 }
	panel_x = (width - panel_width) / 2
	panel_y = height / 2 - 19
	if (panel_y < 3) { panel_y = 3 }
	call graphics::fill_rect(explorer_window, panel_x, panel_y, panel_width, 38, visual_surface)
	call graphics::draw_rect(explorer_window, panel_x, panel_y, panel_width, 38, visual_accent)
	if (selected_entry_count() > 1) {
		call draw_explorer_text_centered(panel_x + 4, panel_y + 5, panel_width - 8, "Move selected items to Trash?", graphics::FONT_NORMAL, visual_highlight)
	}
	else {
		call draw_explorer_text_centered(panel_x + 4, panel_y + 5, panel_width - 8, "Move this item to Trash?", graphics::FONT_NORMAL, visual_highlight)
	}
	if (explorer_flat_button_aligned(panel_x + 4, panel_y + 23, (panel_width - 12) / 2, 10, "Delete", graphics::COLOR_4, graphics::WHITE)) {
		call confirm_context_delete()
	}
	if (explorer_flat_button_aligned(panel_x + 8 + (panel_width - 12) / 2, panel_y + 23, (panel_width - 12) / 2, 10, "Cancel", visual_surface, explorer_control_text_color())) {
		delete_confirm = false
	}
}

proc draw_explorer_sidebar(x: int, y: int, max_height: int) {
	var surface: int
	var panel_height: int
	var danger_color: int
	var danger_text_color: int
	var button_color: int
	var pointer_x: int
	var pointer_y: int
	var interactive: bool
	var valid_drag: bool
	var button_hot: bool
	surface = graphics::COLOR_8
	if (visual_theme_mode == os::THEME_LIGHT) { surface = graphics::COLOR_1 }
	panel_height = explorer_sidebar_panel_height(max_height)
	call graphics::fill_rect(explorer_window, x, y, sidebar_width, panel_height, surface)
	interactive = !explorer_modal_open()
	pointer_x = frame_pointer_x
	pointer_y = frame_pointer_y
	button_hot = frame_mouse_down || frame_mouse_released
	if (pointer_x >= x) {
		if (pointer_x < x + 14) {
			if (pointer_y >= y) {
				if (pointer_y < y + 9) { button_hot = true }
			}
		}
	}
	if (sidebar_open) {
		if (interactive && button_hot) {
			if (graphics::button_flat(explorer_window, x, y, 14, 9, " ", surface)) { sidebar_open = false }
		}
		call draw_explorer_chevron(x + 5, y + 3, true, visual_outline)
	}
	else {
		if (interactive && button_hot) {
			if (graphics::button_flat(explorer_window, x, y, 14, 9, " ", surface)) { sidebar_open = true }
		}
		call draw_explorer_chevron(x + 5, y + 2, false, visual_outline)
	}
	if (sidebar_progress >= 70 && max_height >= 48) {
		call draw_explorer_text_clipped(x + 18, y + 2, "Create (Drag)", sidebar_width - 20, visual_outline)
		button_color = surface
		if (interactive && drag_entry < 0 && drag_template == 0 && pointer_x >= x + 3 && pointer_x < x + sidebar_width - 3 && pointer_y >= y + 12 && pointer_y < y + 22) { button_color = visual_shell }
		call graphics::fill_rect(explorer_window, x + 3, y + 12, sidebar_width - 6, 10, button_color)
		call draw_explorer_text_centered(x + 3, y + 13, sidebar_width - 6, "New file", graphics::FONT_NORMAL, visual_outline)
		button_color = surface
		if (interactive && drag_entry < 0 && drag_template == 0 && pointer_x >= x + 3 && pointer_x < x + sidebar_width - 3 && pointer_y >= y + 23 && pointer_y < y + 33) { button_color = visual_shell }
		call graphics::fill_rect(explorer_window, x + 3, y + 23, sidebar_width - 6, 10, button_color)
		call draw_explorer_text_centered(x + 3, y + 24, sidebar_width - 6, "New folder", graphics::FONT_NORMAL, visual_outline)
		if (interactive && frame_mouse_pressed && pointer_x >= x + 3 && pointer_x < x + sidebar_width - 3 && pointer_y >= y + 12 && pointer_y < y + 22) {
			drag_template = 1
		}
		if (interactive && frame_mouse_pressed && pointer_x >= x + 3 && pointer_x < x + sidebar_width - 3 && pointer_y >= y + 23 && pointer_y < y + 33) {
			drag_template = 2
		}
		valid_drag = false
		if (drag_entry >= 0) {
			if (drag_moved) { valid_drag = frame_mouse_down }
		}
		danger_color = surface
		danger_text_color = visual_outline
		if (valid_drag && pointer_x >= x + 3 && pointer_x < x + sidebar_width - 3 && pointer_y >= y + 38 && pointer_y < y + 48) {
			danger_color = graphics::COLOR_4
			danger_text_color = visual_highlight
		}
		call graphics::fill_rect(explorer_window, x + 3, y + 38, sidebar_width - 6, 10, danger_color)
		call draw_explorer_text_centered(x + 3, y + 39, sidebar_width - 6, "Trash (Drag)", graphics::FONT_NORMAL, danger_text_color)
		if (sidebar_progress >= 90 && max_height >= 61) {
			call draw_explorer_text_standard(x + 3, y + 53, "Orbit", graphics::FONT_NORMAL, visual_outline)
			if (interactive) {
				orbit_speed_setting = graphics::slider(explorer_window, x + 26, y + 51, sidebar_width - 29, orbit_speed_setting, 8, 56)
			}
		}
	}
}

proc draw_explorer_drag_overlay() {
	var pointer_x: int
	var pointer_y: int
	pointer_x = frame_pointer_x
	pointer_y = frame_pointer_y
	visual_force_opaque = true
	if (drag_entry >= 0) {
		if (frame_mouse_down) {
			if (entry_directory_cache[drag_entry] != 0) {
				call draw_placeholder_folder(pointer_x, pointer_y, 5, entry_child_count_cache[drag_entry], rotation + shell_phase[entry_shell[drag_entry]] + drag_entry * 31)
			}
			else { call draw_placeholder_file(pointer_x, pointer_y, 3) }
			if (entry_selected[drag_entry] != 0 && selected_entry_count() > 1) {
				call graphics::draw_int_small(explorer_window, pointer_x + 7, pointer_y - 8, selected_entry_count(), visual_highlight)
			}
		}
	}
	elseif (drag_template > 0) {
		if (frame_mouse_down) {
			if (drag_template == 1) { call draw_placeholder_file(pointer_x, pointer_y, 3) }
			else { call draw_placeholder_folder(pointer_x, pointer_y, 5, 0, nucleus_phase * 360 / 1200) }
		}
	}
	visual_force_opaque = false
}

proc draw_cached_orbit_entry(index: int, center_x: int, center_y: int, area_width: int, transition_scale: int) {
	var atom_x: int
	var atom_y: int
	var node_radius: int
	var label_full_chars: int
	var name_chars: int
	var name_width: int
	var name_color: int
	var label_dx: int
	var label_dy: int
	var label_center_x: int
	var label_center_y: int
	var name_x: int
	var name_y: int
	var label_text: string
	var label_abs_x: int
	var label_abs_y: int
	var label_norm: int
	var label_offset: int
	var clip_label: bool
	atom_x = entry_render_x[index]
	atom_y = entry_render_y[index]
	node_radius = entry_node_radius[index]
	if (drag_entry != index && (!drag_moved || !dragged_entry_in_group(index)) && transition_scale >= 24) {
		visual_force_opaque = transition_progress > 0 && ((!transition_committed && transition_direction > 0 && transition_entry == index) || (transition_committed && transition_direction < 0 && transition_entry == index))
		if (entry_directory_cache[index] != 0) {
			call draw_placeholder_folder(atom_x, atom_y, node_radius + 1, entry_child_count_cache[index], rotation + shell_phase[entry_shell[index]] + index * 31)
		}
		else {
			call draw_placeholder_file(atom_x, atom_y, node_radius)
		}
		if (entry_selected[index] != 0) {
			call graphics::draw_circle(explorer_window, atom_x, atom_y, node_radius + 4, visual_accent)
		}
		visual_force_opaque = false
	}
	if (hovered_entry == index) {
		if (drag_entry >= 0 && drag_moved && !dragged_entry_in_group(index) && entry_directory_cache[index] != 0) {
			call graphics::draw_circle(explorer_window, atom_x, atom_y, node_radius + 6, graphics::COLOR_14)
		}
		if (drag_entry < 0) {
			call draw_placeholder_drag_handle(atom_x, atom_y + node_radius + 5, visual_highlight)
		}
	}
	if (transition_progress == 0 && drag_entry != index && (!drag_moved || !dragged_entry_in_group(index))) {
		label_full_chars = entry_name_length[index]
		clip_label = false
		name_color = visual_shell
		label_text = entry_label_short_cache[index]
		name_width = entry_label_short_width[index]
		if (camera_zoom >= 125) {
			name_color = visual_outline
			label_text = entry_name_cache[index]
			name_width = entry_label_full_width[index]
			name_chars = (area_width - 8) / 6
			if (name_chars < 1) { name_chars = 1 }
			if (label_full_chars > name_chars) {
				clip_label = true
				name_width = explorer_text_width_clipped(label_text, name_chars, graphics::FONT_NORMAL)
			}
		}
		if (hovered_entry == index || entry_selected[index] != 0) {
			name_color = visual_highlight
			label_text = entry_name_cache[index]
			name_width = entry_label_full_width[index]
			name_chars = (area_width - 8) / 6
			if (name_chars < 1) { name_chars = 1 }
			if (label_full_chars > name_chars) {
				clip_label = true
				name_width = explorer_text_width_clipped(label_text, name_chars, graphics::FONT_NORMAL)
			}
		}
		if (name_width < 1) { name_width = 1 }
		label_dx = atom_x - center_x
		label_dy = atom_y - center_y
		label_abs_x = label_dx
		label_abs_y = label_dy
		if (label_abs_x < 0) { label_abs_x = -label_abs_x }
		if (label_abs_y < 0) { label_abs_y = -label_abs_y }
		if (label_abs_x > label_abs_y) { label_norm = label_abs_x + label_abs_y * 3 / 8 }
		else { label_norm = label_abs_y + label_abs_x * 3 / 8 }
		if (label_norm < 1) {
			label_dx = 0
			label_dy = -1
			label_norm = 1
		}
		label_offset = node_radius + 4 + (label_abs_x * name_width / 2 + label_abs_y * 3) / label_norm
		label_center_x = atom_x + label_dx * label_offset / label_norm
		label_center_y = atom_y + label_dy * label_offset / label_norm
		name_x = label_center_x - name_width / 2
		name_y = label_center_y - 3
		if (clip_label) {
			call draw_explorer_text_prefix(name_x, name_y, label_text, name_chars, graphics::FONT_NORMAL, name_color)
		}
		else { call draw_explorer_text_standard(name_x, name_y, label_text, graphics::FONT_NORMAL, name_color) }
	}
}

proc update_deletion_ghosts(elapsed: int) {
	var read_index: int
	var write_index: int
	read_index = 0
	write_index = 0
	while (read_index < deletion_ghost_count) {
		deletion_ghost_age[read_index] += elapsed
		deletion_ghost_accumulator[read_index] += elapsed * deletion_ghost_speed[read_index]
		deletion_ghost_phase[read_index] = (deletion_ghost_phase[read_index] + deletion_ghost_accumulator[read_index] / 1000) % 360
		deletion_ghost_accumulator[read_index] %= 1000
		if (deletion_ghost_age[read_index] < deletion_ghost_duration) {
			deletion_ghost_x[write_index] = deletion_ghost_x[read_index]
			deletion_ghost_y[write_index] = deletion_ghost_y[read_index]
			deletion_ghost_depth[write_index] = deletion_ghost_depth[read_index]
			deletion_ghost_radius[write_index] = deletion_ghost_radius[read_index]
			deletion_ghost_directory[write_index] = deletion_ghost_directory[read_index]
			deletion_ghost_child_count[write_index] = deletion_ghost_child_count[read_index]
			deletion_ghost_phase[write_index] = deletion_ghost_phase[read_index]
			deletion_ghost_accumulator[write_index] = deletion_ghost_accumulator[read_index]
			deletion_ghost_speed[write_index] = deletion_ghost_speed[read_index]
			deletion_ghost_age[write_index] = deletion_ghost_age[read_index]
			write_index += 1
		}
		read_index += 1
	}
	deletion_ghost_count = write_index
}

proc draw_deletion_ghosts(front: bool, center_x: int, center_y: int) {
	var ghost: int
	var progress: int
	var eased: int
	var ghost_x: int
	var ghost_y: int
	var ghost_radius: int
	var saved_fade: int
	saved_fade = visual_fade
	ghost = 0
	while (ghost < deletion_ghost_count) {
		if ((front && deletion_ghost_depth[ghost] >= 0) || (!front && deletion_ghost_depth[ghost] < 0)) {
			progress = deletion_ghost_age[ghost] * 100 / deletion_ghost_duration
			if (progress > 100) { progress = 100 }
			eased = slot_ease(progress)
			ghost_x = deletion_ghost_x[ghost] + (center_x - deletion_ghost_x[ghost]) * eased / 500
			ghost_y = deletion_ghost_y[ghost] + (center_y - deletion_ghost_y[ghost]) * eased / 500
			ghost_radius = deletion_ghost_radius[ghost] * (100 - eased) / 100
			visual_fade = saved_fade * (100 - eased) / 100
			if (ghost_radius > 0) {
				if (deletion_ghost_directory[ghost] != 0) {
					call draw_placeholder_folder(ghost_x, ghost_y, ghost_radius + 1, deletion_ghost_child_count[ghost], deletion_ghost_phase[ghost])
				}
				else { call draw_placeholder_file(ghost_x, ghost_y, ghost_radius) }
			}
		}
		ghost += 1
	}
	visual_fade = saved_fade
}

proc draw_file_atom(x: int, y: int, area_width: int, area_height: int) {
	var count: int
	var index: int
	var shell: int
	var position: int
	var radius: int
	var atom_x: int
	var atom_y: int
	var node_radius: int
	var center_x: int
	var center_y: int
	var pointer_x: int
	var pointer_y: int
	var dx: int
	var dy: int
	var distance_squared: int
	var target_shell: int
	var shell_button_color: int
	var outer_radius: int
	var radius_limit: int
	var shell_gap: int
	var transition_scale: int
	var center_radius: int
	var base_center_radius: int
	var hit_radius: int
	var candidate_name: string
	var shell_distance: int
	var best_distance: int
	var closest_shell: int
	var shell_button_x: int
	var shell_button_y: int
	var interaction_allowed: bool
	var viewport_center_x: int
	var viewport_center_y: int
	var eased_progress: int
	var phase_progress: int
	var scene_visibility: int
	var focus_shell: int
	var focus_position: int
	var focus_population: int
	var focus_angle: float
	var focus_radius: int
	var plane_x: float
	var plane_y: float
	var tilt_cosine: float
	var projected_distance: int
	var drop_target_shell: int
	var created_entry: int
	var render_scale: int
	var all_shells_full: bool
	var add_radius: int
	var add_size: int
	var modifiers: int
	var selection_index: int
	var selection_move_count: int
	var usable_width: int
	var slot_eased_progress: int
	var slot_duration: int
	var slot_divisor: int
	var drop_angle: float
	var target_was_empty: bool
	var actual_target_shell: int
	var target_depth: int
	var drop_depth: int
	var order_entry: int
	var native_candidate: bool
	var command: int
	var shell_table: int
	var target_radius: int
	var radius_difference: int
	var radius_step: int
	var radius_tick: int
	var pointer_in_scene: bool
	var folder_drop_hit_radius: int
	var nearest_entry_distance_squared: int
	var nearest_folder_distance_squared: int
	var shell_button_hit_radius: int
	var outside_nucleus: bool
	var capture_entry: int
	count = cached_entry_count
	if (count > 0 && entry_shell[0] == 0 && shell_population_cache[0] == 0) { call rebuild_shell_layout() }
	if (projection_cache_tilt != tilt || projection_cache_roll != view_roll) {
		call prepare_orbit_projection(tilt, view_roll, rotation)
		projection_cache_tilt = tilt
		projection_cache_roll = view_roll
		projection_cache_rotation = rotation
	}
	usable_width = area_width
	viewport_center_x = x + area_width / 2
	viewport_center_y = y + area_height / 2
	center_x = viewport_center_x
	center_y = viewport_center_y
	atom_center_x = center_x
	atom_center_y = center_y
	pointer_x = frame_pointer_x
	pointer_y = frame_pointer_y
	capture_entry = hovered_entry
	hovered_entry = -1
	hovered_shell = -1
	drop_folder_entry = -1
	nearest_entry_distance_squared = 2147483647
	nearest_folder_distance_squared = 2147483647
	interaction_allowed = !explorer_modal_open()
	radius_limit = (area_height - 34) / 2
	if (radius_limit > (usable_width - 48) / 2) { radius_limit = (usable_width - 48) / 2 }
	if (usable_width < 108 || area_height < 94 || radius_limit < ATOM_INNER_SHELL_RADIUS + (shell_count - 1) * ATOM_MINIMUM_SHELL_GAP) {
		call clear_entry_drag()
		drag_template = 0
		rotating = false
		canvas_press_pending = false
		center_radius = area_width / 8
		if (center_radius > area_height / 4) { center_radius = area_height / 4 }
		if (center_radius < 3) { center_radius = 3 }
		if (center_radius > 7) { center_radius = 7 }
		call draw_placeholder_nucleus(center_x, center_y, center_radius)
		call graphics::draw_int_small(explorer_window, center_x - 2, center_y - 2, count, graphics::WHITE)
		return
	}
	transition_scale = 100
	scene_visibility = 100
	if (transition_progress > 0) {
		if (!transition_committed) {
			phase_progress = transition_progress
			if (phase_progress > 100) { phase_progress = 100 }
			eased_progress = transition_ease(phase_progress)
			scene_visibility = 100 - eased_progress
			if (transition_direction > 0) {
				transition_scale = 100 + eased_progress * 200 / 100
				center_x = viewport_center_x - transition_focus_x * transition_scale * eased_progress / 10000
				center_y = viewport_center_y - transition_focus_y * transition_scale * eased_progress / 10000
			}
			else {
				transition_scale = 100 - eased_progress * 15 / 100
				center_x = viewport_center_x
				center_y = viewport_center_y
			}
		}
		else {
			phase_progress = transition_progress - 100
			if (phase_progress < 0) { phase_progress = 0 }
			if (phase_progress > 100) { phase_progress = 100 }
			eased_progress = transition_ease(phase_progress)
			scene_visibility = eased_progress
			if (transition_direction > 0) {
				transition_scale = 85 + eased_progress * 15 / 100
				center_x = viewport_center_x
				center_y = viewport_center_y
			}
			else {
				transition_scale = 300 - eased_progress * 200 / 100
				if (transition_entry >= 0 && transition_entry < count) {
					focus_shell = entry_shell[transition_entry]
					if (focus_shell >= shell_count) { focus_shell = shell_count - 1 }
					focus_population = shell_population_cache[focus_shell]
					focus_position = entry_position_cache[transition_entry]
					radius_limit = (area_height - 34) / 2
					if (radius_limit > (usable_width - 48) / 2) { radius_limit = (usable_width - 48) / 2 }
					if (radius_limit < ATOM_INNER_SHELL_RADIUS) { radius_limit = ATOM_INNER_SHELL_RADIUS }
					shell_gap = adaptive_shell_gap(radius_limit, shell_count)
					outer_radius = ATOM_INNER_SHELL_RADIUS + (shell_count - 1) * shell_gap
					focus_radius = shell_base_radius[focus_shell]
					if (focus_radius < ATOM_INNER_SHELL_RADIUS) { focus_radius = ATOM_INNER_SHELL_RADIUS + focus_shell * shell_gap }
					slot_divisor = shell_slot_divisor(focus_shell, focus_population)
					focus_angle = (float)(rotation + shell_phase[focus_shell] + focus_position * 360 / slot_divisor + focus_shell * 17)
					call orbit_project(focus_radius, focus_angle)
					transition_focus_x = projected_x
					transition_focus_y = projected_y
				}
				center_x = viewport_center_x - transition_focus_x * transition_scale * (100 - eased_progress) / 10000
				center_y = viewport_center_y - transition_focus_y * transition_scale * (100 - eased_progress) / 10000
			}
		}
	}
	if (transition_scale < 85) { transition_scale = 85 }
	if (transition_scale > 300) { transition_scale = 300 }
	render_scale = transition_scale * camera_zoom / 100
	if (render_scale < 55) { render_scale = 55 }
	if (render_scale > 450) { render_scale = 450 }
	atom_center_x = center_x
	atom_center_y = center_y
	base_center_radius = 8 + area_height / 28
	if (base_center_radius < 11) { base_center_radius = 11 }
	if (base_center_radius > 20) { base_center_radius = 20 }
	center_radius = base_center_radius * render_scale / 100
	atom_center_radius = center_radius
	if (!nucleus_highlight_ready || !rotating) {
		nucleus_highlight_x = center_x - center_radius / 2
		nucleus_highlight_y = center_y - center_radius / 2
		nucleus_highlight_ready = true
	}
	visual_fade = scene_visibility
	radius_limit = (area_height - 34) / 2
	if (radius_limit > (usable_width - 48) / 2) { radius_limit = (usable_width - 48) / 2 }
	if (radius_limit < ATOM_INNER_SHELL_RADIUS) { radius_limit = ATOM_INNER_SHELL_RADIUS }
	shell_gap = adaptive_shell_gap(radius_limit, shell_count)
	outer_radius = ATOM_INNER_SHELL_RADIUS + (shell_count - 1) * shell_gap
	shell_layout_animating = false
	if (orbit_scene_static_dirty || transition_progress > 0) {
		if (transition_progress > 0) { orbit_scene_static_dirty = true }
		shell = 0
		while (shell < shell_count && transition_scale >= 24) {
			target_radius = (ATOM_INNER_SHELL_RADIUS + shell * shell_gap) * 100
			if (shell_layout_radius_x100[shell] <= 0) { shell_layout_radius_x100[shell] = target_radius }
			radius_difference = target_radius - shell_layout_radius_x100[shell]
			if (radius_difference != 0) {
				orbit_scene_static_dirty = true
				radius_tick = 0
				while (radius_tick < frame_steps && radius_difference != 0) {
					radius_step = radius_difference * MILLISECONDS_PER_SECOND / (FIXED_UPDATE_HZ * 140)
					if (radius_step == 0 && radius_difference > 0) { radius_step = 1 }
					elseif (radius_step == 0) { radius_step = -1 }
					shell_layout_radius_x100[shell] += radius_step
					if (radius_difference > 0 && shell_layout_radius_x100[shell] > target_radius) { shell_layout_radius_x100[shell] = target_radius }
					elseif (radius_difference < 0 && shell_layout_radius_x100[shell] < target_radius) { shell_layout_radius_x100[shell] = target_radius }
					radius_difference = target_radius - shell_layout_radius_x100[shell]
					radius_tick += 1
				}
				if (shell_layout_radius_x100[shell] != target_radius) { shell_layout_animating = true }
			}
			shell_base_radius[shell] = (shell_layout_radius_x100[shell] + 50) / 100
			radius = shell_base_radius[shell] * render_scale / 100
			shell_render_radius[shell] = radius
			shell += 1
		}
	}
	# All entries share a visual radius at a given viewport scale.
	node_radius = (2 + outer_radius / 48) * render_scale / 100
	if (node_radius < 2) { node_radius = 2 }
	if (transition_progress == 0 && node_radius > 6) { node_radius = 6 }
	elseif (transition_progress > 0 && node_radius > 12) { node_radius = 12 }
	all_shells_full = orbit_all_shells_full
	shell_button_hovered = false
	if (shell_count < 8 && transition_progress == 0) {
		add_radius = shell_render_radius[shell_count - 1] + 13
		if (shell_add_follows_rotation) { call orbit_project_rotation_offset(add_radius, 0.8191520, 0.5735764) }
		else { call orbit_project(add_radius, 35.0) }
		shell_button_x = center_x + projected_x
		shell_button_y = center_y + projected_y
		shell_button_hit_radius = 3
		if (all_shells_full) { shell_button_hit_radius = 6 }
		elseif ((drag_entry >= 0 || drag_template > 0) && shell_population_cache[shell_count - 1] < shell_capacity) { shell_button_hit_radius = 5 }
		dx = pointer_x - shell_button_x
		dy = pointer_y - shell_button_y
		shell_button_hovered = dx * dx + dy * dy <= shell_button_hit_radius * shell_button_hit_radius
	}
	pointer_in_scene = false
	if (pointer_x > x) {
		if (pointer_x < x + area_width) {
			if (pointer_y >= y) {
				if (pointer_y < y + area_height) {
					if (!explorer_pointer_in_sidebar_panel(x, y, area_height) && !zoom_controls_hovered) { pointer_in_scene = true }
				}
			}
		}
	}
	dx = pointer_x - center_x
	dy = pointer_y - center_y
	if (dx < 0) { dx = -dx }
	if (dy < 0) { dy = -dy }
	outside_nucleus = false
	if (dx > center_radius || dy > center_radius) { outside_nucleus = true }
	elseif (dx * dx + dy * dy > center_radius * center_radius) { outside_nucleus = true }
	orbit_native_drawn = false
	native_candidate = transition_progress == 0 && !slot_animation_active && !shell_layout_animating && deletion_ghost_count == 0 && drag_entry < 0 && drag_template == 0 && camera_zoom == camera_zoom_target && visual_fade >= 100
	if (native_candidate) {
		if (orbit_stream_dirty) { call rebuild_orbit_command_stream() }
		command = graphics::COMMAND_HEADER_WORDS
		shell_table = command + graphics::COMMAND_ORBIT_WORDS
		if (orbit_scene_static_dirty) {
			orbit_command_stream[command + graphics::COMMAND_ORBIT_SCENE_X_OFFSET] = x
			orbit_command_stream[command + graphics::COMMAND_ORBIT_SCENE_Y_OFFSET] = y
			orbit_command_stream[command + graphics::COMMAND_ORBIT_CENTER_X_OFFSET] = center_x
			orbit_command_stream[command + graphics::COMMAND_ORBIT_CENTER_Y_OFFSET] = center_y
			orbit_command_stream[command + graphics::COMMAND_ORBIT_AREA_WIDTH_OFFSET] = area_width
			orbit_command_stream[command + graphics::COMMAND_ORBIT_AREA_HEIGHT_OFFSET] = area_height
			orbit_command_stream[command + graphics::COMMAND_ORBIT_SIDEBAR_WIDTH_OFFSET] = 0
			orbit_command_stream[command + graphics::COMMAND_ORBIT_RENDER_SCALE_OFFSET] = render_scale
			orbit_command_stream[command + graphics::COMMAND_ORBIT_OUTER_RADIUS_OFFSET] = outer_radius
			orbit_command_stream[command + graphics::COMMAND_ORBIT_SHELL_GAP_OFFSET] = shell_gap
			orbit_command_stream[command + graphics::COMMAND_ORBIT_CENTER_RADIUS_OFFSET] = center_radius
			orbit_command_stream[command + graphics::COMMAND_ORBIT_NODE_RADIUS_OFFSET] = node_radius
			orbit_command_stream[command + graphics::COMMAND_ORBIT_ROLL_OFFSET] = view_roll
			orbit_command_stream[command + graphics::COMMAND_ORBIT_SURFACE_OFFSET] = visual_surface
			orbit_command_stream[command + graphics::COMMAND_ORBIT_OUTLINE_OFFSET] = visual_outline
			orbit_command_stream[command + graphics::COMMAND_ORBIT_ACCENT_OFFSET] = visual_accent
			orbit_command_stream[command + graphics::COMMAND_ORBIT_SHELL_COLOR_OFFSET] = visual_shell
			orbit_command_stream[command + graphics::COMMAND_ORBIT_HIGHLIGHT_OFFSET] = visual_highlight
			orbit_command_stream[command + graphics::COMMAND_ORBIT_CAMERA_ZOOM_OFFSET] = camera_zoom
			orbit_command_stream[command + graphics::COMMAND_ORBIT_LABEL_LIMIT_OFFSET] = (area_width - 8) / 6
			orbit_scene_static_dirty = false
		}
		orbit_command_stream[command + graphics::COMMAND_ORBIT_TILT_OFFSET] = tilt
		orbit_command_stream[command + graphics::COMMAND_ORBIT_ROTATION_OFFSET] = rotation
		orbit_command_stream[command + graphics::COMMAND_ORBIT_POINTER_X_OFFSET] = pointer_x
		orbit_command_stream[command + graphics::COMMAND_ORBIT_POINTER_Y_OFFSET] = pointer_y
		if (shell_button_hovered) { orbit_command_stream[command + graphics::COMMAND_ORBIT_SHELL_HOVER_OFFSET] = 1 }
		else { orbit_command_stream[command + graphics::COMMAND_ORBIT_SHELL_HOVER_OFFSET] = 0 }
		if (zoom_controls_hovered) { orbit_command_stream[command + graphics::COMMAND_ORBIT_ZOOM_HOVER_OFFSET] = 1 }
		else { orbit_command_stream[command + graphics::COMMAND_ORBIT_ZOOM_HOVER_OFFSET] = 0 }
		orbit_command_stream[command + graphics::COMMAND_ORBIT_FLAGS_OFFSET] = graphics::COMMAND_ORBIT_DRAW_LABELS
		if (orbit_phase_stream_dirty) {
			shell = 0
			while (shell < shell_count) {
