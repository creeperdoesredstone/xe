		index = 0
		while (index < count) {
			order_entry = entry_depth_order[index]
			if (entry_render_depth[order_entry] >= 0) { call draw_cached_orbit_entry(order_entry, center_x, center_y, area_width, transition_scale) }
			index += 1
		}
		call draw_deletion_ghosts(true, center_x, center_y)
	}
	# The fallback nucleus is the scene's final focal layer. The native batch
	# applies the same ordering internally.
	if (!orbit_native_drawn) {
		visual_force_opaque = transition_progress > 0 && ((transition_direction > 0 && transition_committed) || (transition_direction < 0 && !transition_committed))
		call draw_placeholder_nucleus(center_x, center_y, center_radius)
		visual_force_opaque = false
	}
	visual_fade = 100
	if (drag_entry >= 0 || drag_template > 0 || !orbit_native_drawn) {
		dx = pointer_x - center_x
		dy = pointer_y - center_y
		plane_x = (float)dx
		plane_y = (float)dy
		plane_x = (float)dx * math::cos((float)view_roll) + (float)dy * math::sin((float)view_roll)
		plane_y = (float)(-dx) * math::sin((float)view_roll) + (float)dy * math::cos((float)view_roll)
		tilt_cosine = math::cos((float)tilt)
		if (tilt_cosine < 0.25 && tilt_cosine > -0.25) {
			if (tilt_cosine < 0) { tilt_cosine = -0.25 }
			else { tilt_cosine = 0.25 }
		}
		plane_y /= tilt_cosine
		drop_angle = 0.0
		if (plane_x > 0.001 || plane_x < -0.001) {
			drop_angle = math::atan(plane_y / plane_x)
			if (plane_x < 0.0) { drop_angle += 180.0 }
		}
		elseif (plane_y > 0.0) { drop_angle = 90.0 }
		elseif (plane_y < 0.0) { drop_angle = 270.0 }
		if (drop_angle < 0.0) { drop_angle += 360.0 }
		projected_distance = (int)(math::sqrt(plane_x * plane_x + plane_y * plane_y) * 100.0 / (float)render_scale)
		closest_shell = 0
		best_distance = projected_distance - shell_base_radius[0]
		if (best_distance < 0) { best_distance = -best_distance }
		shell = 1
		while (shell < shell_count) {
			shell_distance = projected_distance - shell_base_radius[shell]
			if (shell_distance < 0) { shell_distance = -shell_distance }
			if (shell_distance < best_distance) {
				best_distance = shell_distance
				closest_shell = shell
			}
			shell += 1
		}
		drop_target_shell = closest_shell
		if (projected_distance <= base_center_radius + 7) { drop_target_shell = center_drop_shell(closest_shell) }
		elseif (best_distance > 11 && (drag_template == 0 || !pointer_in_scene)) { drop_target_shell = -1 }
		if (shell_button_hovered && (drag_entry >= 0 || drag_template > 0) && shell_count > 1 && shell_population_cache[shell_count - 1] < shell_capacity) {
			drop_target_shell = shell_count - 1
		}
		if (hovered_shell < 0 && best_distance <= 17 && projected_distance > base_center_radius + 4 && pointer_in_scene) {
			hovered_shell = closest_shell
		}
	}
	# Scratch exposes wheel/key hats portably but does not expose right mouse
	# state. A stationary half-second primary hold is therefore the canonical
	# context gesture; desktop right-click remains as a fast equivalent.
	if (interaction_allowed) {
		if (hovered_entry >= 0) {
			if (frame_mouse_pressed) {
				context_hold_entry = hovered_entry
				context_hold_started = current_ticks
				context_hold_x = pointer_x
				context_hold_y = pointer_y
				context_hold_triggered = false
			}
		}
	}
	if (context_hold_entry >= 0) {
		if (frame_mouse_down) {
			dx = pointer_x - context_hold_x
			dy = pointer_y - context_hold_y
			if (dx * dx + dy * dy > 9 || drag_moved) { context_hold_entry = -1 }
			elseif (!context_hold_triggered && current_ticks - context_hold_started >= 500) {
				context_entry = context_hold_entry
				if (entry_selected[context_entry] == 0) {
					call select_only_entry(context_entry)
					call update_selection_status()
				}
				else { selected_entry = context_entry }
				context_x = pointer_x
				context_y = pointer_y
				context_open = true
				context_hold_triggered = true
				call clear_entry_drag()
				last_click_entry = -1
			}
		}
	}
	if (interaction_allowed) {
		if (frame_right_mouse_pressed) {
			if (hovered_entry >= 0 || (selected_entry_count() > 0 && pointer_in_scene)) {
				if (hovered_entry >= 0) {
					context_entry = hovered_entry
					if (entry_selected[hovered_entry] == 0) {
						call select_only_entry(hovered_entry)
						call update_selection_status()
					}
					else { selected_entry = hovered_entry }
				}
				else {
					context_entry = first_selected_entry()
					selected_entry = context_entry
				}
				if (context_entry >= 0) {
					context_x = pointer_x
					context_y = pointer_y
					context_open = true
					last_click_entry = -1
				}
			}
		}
	}
	if (drag_entry >= 0) {
		if (frame_mouse_down) {
			dx = pointer_x - drag_start_x
			dy = pointer_y - drag_start_y
			if (dx * dx + dy * dy > 9) {
				drag_moved = true
				drag_open_on_release = false
			}
		}
	}
	if (drag_entry >= 0 && frame_mouse_released) {
		if (!drag_moved) {
			modifiers = input_modifiers
			if (modifiers == 0 && drag_open_on_release && last_click_entry == drag_entry) {
				if (entry_directory_cache[drag_entry] != 0) {
					transition_focus_x = entry_render_x[drag_entry] - atom_center_x
					transition_focus_y = entry_render_y[drag_entry] - atom_center_y
					call begin_folder_transition(drag_entry, 1)
				}
				else { call open_file_viewer(drag_entry) }
				last_click_entry = -1
			}
			else {
				call select_clicked_entry(drag_entry)
				if (modifiers == 0) {
					last_click_entry = drag_entry
					last_click_age_ms = 0
				}
				else { last_click_entry = -1 }
			}
		}
		elseif (pointer_x >= x + 3 && pointer_x < x + sidebar_width - 3 && pointer_y >= y + 38 && pointer_y < y + 48 && sidebar_progress >= 70) {
			call delete_dragged_entries()
		}
		elseif (drag_moved && drop_path_active) {
			call move_dragged_entries_to_path(drop_path_target)
		}
		elseif (drag_moved && drop_folder_entry >= 0) {
			call move_dragged_entries_into_folder(drop_folder_entry)
		}
		elseif (drag_moved) {
			target_shell = drop_target_shell
			selection_move_count = 0
			if (target_shell >= 0 && entry_selected[drag_entry] != 0) {
				selection_index = 0
				while (selection_index < count) {
					if (entry_selected[selection_index] != 0 && entry_shell[selection_index] != target_shell) { selection_move_count += 1 }
					selection_index += 1
				}
			}
			elseif (target_shell >= 0 && entry_shell[drag_entry] != target_shell) { selection_move_count = 1 }
			target_was_empty = target_shell >= 0 && shell_population_cache[target_shell] == 0 && selection_move_count > 0
			if (target_shell >= 0 && shell_population_cache[target_shell] + selection_move_count <= shell_capacity) {
				if (selection_move_count > 0) { call begin_slot_animation_all() }
				if (target_was_empty) { shell_incremental_layout[target_shell] = 1 }
				if (entry_selected[drag_entry] != 0) {
					selection_index = 0
					while (selection_index < count) {
						if (entry_selected[selection_index] != 0) { entry_shell[selection_index] = target_shell }
						selection_index += 1
					}
				}
				else { entry_shell[drag_entry] = target_shell }
				call compact_energy_shells(count)
				if (target_was_empty) {
					actual_target_shell = entry_shell[drag_entry]
					entry_slot_start_x[drag_entry] = pointer_x
					entry_slot_start_y[drag_entry] = pointer_y
					call orbit_project(shell_render_radius[actual_target_shell], drop_angle)
					entry_slot_start_depth[drag_entry] = projected_depth
					entry_slot_progress[drag_entry] = 0
					entry_slot_elapsed[drag_entry] = 0
					call align_shell_entry_to_angle(actual_target_shell, drag_entry, drop_angle)
				}
			}
			elseif (target_shell >= 0) { full_hint = 100 }
		}
		if (drag_moved) {
			last_click_entry = -1
			last_click_age_ms = DOUBLE_CLICK_WINDOW_MS + 1
		}
		call clear_entry_drag()
	}
	if (frame_mouse_released) {
		context_hold_entry = -1
		context_hold_triggered = false
	}
	if (drag_template > 0 && frame_mouse_released) {
		target_shell = drop_target_shell
		target_was_empty = target_shell >= 0 && shell_population_cache[target_shell] == 0
		if (target_shell >= 0 && shell_population_cache[target_shell] < shell_capacity) {
			candidate_name = explorer_unique_template_name(drag_template == 2)
			if (drag_template == 1) { operation_ok = os::make_file(explorer_join_path(current_path, candidate_name)) }
			else { operation_ok = os::make_directory(explorer_join_path(current_path, candidate_name)) }
			if (operation_ok) {
				call set_explorer_status(xestring::concat("Added ", candidate_name))
				slot_duration = insertion_slot_duration(shell_population_cache[target_shell] + 1)
				call begin_slot_animation_for_shell(target_shell, slot_duration)
				if (target_was_empty) { shell_incremental_layout[target_shell] = 1 }
				call orbit_project(shell_render_radius[target_shell], drop_angle)
				drop_depth = projected_depth
				created_entry = cache_created_entry(candidate_name, drag_template == 2, target_shell, pointer_x, pointer_y, drop_depth, slot_duration)
				if (target_was_empty && created_entry >= 0) { call align_shell_entry_to_angle(target_shell, created_entry, drop_angle) }
			}
			else {
				call set_explorer_status("Could not create item")
			}
		}
		elseif (target_shell >= 0) { full_hint = 100 }
		drag_template = 0
	}
	if (shell_count < 8 && transition_progress == 0) {
		add_size = 2
		shell_button_color = visual_outline
		if (all_shells_full || full_hint > 0) {
			add_size = 3
			shell_button_color = visual_highlight
		}
		if ((shell_button_hovered && all_shells_full) || full_hint > 0) { add_size = 4 }
		if (shell_button_hovered && (drag_entry >= 0 || drag_template > 0) && shell_population_cache[shell_count - 1] < shell_capacity) {
			add_size = 3
			shell_button_color = visual_highlight
		}
		call graphics::fill_rect(explorer_window, shell_button_x - add_size, shell_button_y, add_size * 2 + 1, 1, shell_button_color)
		call graphics::fill_rect(explorer_window, shell_button_x, shell_button_y - add_size, 1, add_size * 2 + 1, shell_button_color)
		if (interaction_allowed && shell_button_hovered && frame_mouse_pressed) {
			if (all_shells_full) {
				call begin_slot_animation_all()
				shell_incremental_layout[shell_count] = 1
				shell_accumulator[shell_count] = 0
				shell_speed[shell_count] = 0
				shell_layout_radius_x100[shell_count] = 0
				shell_base_radius[shell_count] = 0
				shell_render_radius[shell_count] = 0
				shell_count += 1
				shell_speed_easing_active = true
				orbit_stream_dirty = true
				orbit_scene_static_dirty = true
				orbit_all_shells_full = false
				full_hint = 0
				call set_explorer_status("Shell added - drag here")
			}
			else { call set_explorer_status("Fill shell") }
		}
	}
	if (full_hint > 0) {
		full_hint -= animation_step
		if (full_hint < 0) { full_hint = 0 }
	}
}

proc accumulate_frame_time(elapsed_ms: int) {
	delta_ms = elapsed_ms
	if (delta_ms < 0) { delta_ms = 0 }
	if (delta_ms > MAX_FRAME_DELTA_MS) { delta_ms = MAX_FRAME_DELTA_MS }
	fixed_update_accumulator += delta_ms * FIXED_UPDATE_HZ
	frame_steps = fixed_update_accumulator / MILLISECONDS_PER_SECOND
	fixed_update_accumulator %= MILLISECONDS_PER_SECOND
}

proc update_explorer_clock() {
	current_ticks = os::ticks()
	call accumulate_frame_time(current_ticks - previous_ticks)
	previous_ticks = current_ticks
	if (last_click_age_ms <= DOUBLE_CLICK_WINDOW_MS) { last_click_age_ms += delta_ms }
	if (cached_revision != os::revision() && !rotating && !marquee_active && drag_entry < 0 && drag_template == 0 && transition_progress == 0 && !explorer_modal_open()) {
		call refresh_compacted_entry_metadata()
	}
	if (deletion_ghost_count > 0) { call update_deletion_ghosts(delta_ms) }
	if (rename_pointer_guard > 0) { rename_pointer_guard -= 1 }
	animation_step = frame_steps * 7
}

proc update_explorer_view_animation() {
	if (!rotating) {
		if (sidebar_open) {
			if (sidebar_progress < 100) { sidebar_progress += animation_step }
		}
		elseif (sidebar_progress > 0) { sidebar_progress -= animation_step }
	}
	if (sidebar_progress > 100) { sidebar_progress = 100 }
	if (sidebar_progress < 0) { sidebar_progress = 0 }
	zoom_difference = camera_zoom_target - camera_zoom
	if (zoom_difference != 0 && !rotating) {
		orbit_scene_static_dirty = true
		zoom_step = zoom_difference * animation_step / 100
		if (zoom_step == 0 && zoom_difference > 0) { zoom_step = 1 }
		elseif (zoom_step == 0) { zoom_step = -1 }
		camera_zoom += zoom_step
		if (zoom_difference > 0 && camera_zoom > camera_zoom_target) { camera_zoom = camera_zoom_target }
		elseif (zoom_difference < 0 && camera_zoom < camera_zoom_target) { camera_zoom = camera_zoom_target }
	}
}

proc refresh_explorer_animated_layout() {
	next_sidebar_width = 14 + 70 * sidebar_progress / 100
	sidebar_width = next_sidebar_width
}

proc update_explorer_orbits() {
	var pause_dx: int
	var pause_dy: int
	var pause_radius: int
	interaction_pauses_orbits = rotating || marquee_active || (drag_entry >= 0 && drag_moved) || drag_template > 0
	paused_shell = hovered_shell
	hover_pause_allowed = !rotating && !marquee_active && drag_entry < 0 && drag_template == 0 && transition_progress == 0 && !explorer_modal_open()
	if (!hover_pause_allowed) { paused_shell = -1 }
	pause_has_entry = false
	if (paused_shell >= 0 && hovered_entry >= 0 && entry_shell[hovered_entry] == paused_shell) {
		pause_dx = frame_pointer_x - entry_render_x[hovered_entry]
		pause_dy = frame_pointer_y - entry_render_y[hovered_entry]
		pause_radius = entry_node_radius[hovered_entry] + 7
		if (pause_dx * pause_dx + pause_dy * pause_dy <= pause_radius * pause_radius) { pause_has_entry = true }
		else { paused_shell = -1 }
	}
	if (paused_shell != last_paused_shell || pause_has_entry != last_pause_has_entry || orbit_speed_setting != last_orbit_speed_setting || interaction_pauses_orbits != last_interaction_pauses_orbits) {
		shell_speed_easing_active = true
		last_paused_shell = paused_shell
		last_pause_has_entry = pause_has_entry
		last_orbit_speed_setting = orbit_speed_setting
		last_interaction_pauses_orbits = interaction_pauses_orbits
	}
	if (transition_progress == 0) {
		if (shell_speed_easing_active) {
			shell_speed_easing_active = false
			orbit_ease = animation_step * 2
			if (orbit_ease > 40) { orbit_ease = 40 }
			animation_shell = 0
			while (animation_shell < 8) {
				orbit_speed_target = orbit_speed_setting
				if (interaction_pauses_orbits) { orbit_speed_target = 0 }
				elseif (animation_shell == paused_shell) {
					orbit_speed_target = orbit_speed_setting / 8
					if (orbit_speed_target < 2) { orbit_speed_target = 2 }
					if (pause_has_entry) {
						orbit_speed_target = 0
						shell_speed[animation_shell] = 0
					}
				}
				if (interaction_pauses_orbits) { shell_speed[animation_shell] = 0 }
				elseif (shell_speed[animation_shell] != orbit_speed_target) {
					orbit_speed_difference = orbit_speed_target - shell_speed[animation_shell]
					orbit_speed_step = orbit_speed_difference * orbit_ease / 100
					if (orbit_speed_step == 0 && orbit_speed_difference > 0) { orbit_speed_step = 1 }
					elseif (orbit_speed_step == 0 && orbit_speed_difference < 0) { orbit_speed_step = -1 }
					shell_speed[animation_shell] += orbit_speed_step
					if (orbit_speed_difference > 0 && shell_speed[animation_shell] > orbit_speed_target) { shell_speed[animation_shell] = orbit_speed_target }
					elseif (orbit_speed_difference < 0 && shell_speed[animation_shell] < orbit_speed_target) { shell_speed[animation_shell] = orbit_speed_target }
					if (shell_speed[animation_shell] != orbit_speed_target) { shell_speed_easing_active = true }
				}
				animation_shell += 1
			}
		}
	}
}

proc advance_explorer_orbit_motion(elapsed_ms: int, transition_active: bool) {
	if (!transition_active) {
		animation_shell = 0
		while (animation_shell < shell_count) {
			shell_accumulator[animation_shell] += elapsed_ms * shell_speed[animation_shell]
			if (shell_accumulator[animation_shell] >= 1000) {
				shell_phase[animation_shell] = (shell_phase[animation_shell] + shell_accumulator[animation_shell] / 1000) % 360
				shell_accumulator[animation_shell] %= 1000
				orbit_phase_stream_dirty = true
			}
			animation_shell += 1
		}
		nucleus_phase = (nucleus_phase + elapsed_ms) % 1200
	}
	if (paused_shell >= 0) {
		rotation_target = rotation
		tilt_target = tilt
	}
	elseif (rotation != rotation_target || tilt != tilt_target) { call update_view_orientation(elapsed_ms) }
}

proc update_explorer_transition() {
	if (transition_progress <= 0) { return }
	transition_step = animation_step * (100 + (transition_hops - 1) * 35) / 100
	if (transition_step < 1) { transition_step = 1 }
	if (transition_step > animation_step * 3) { transition_step = animation_step * 3 }
	transition_progress += transition_step
	if (!transition_committed && transition_progress > 100) { transition_progress = 100 }
	if (transition_committed && transition_progress >= 200) {
		transition_progress = 0
		transition_entry = -1
		transition_committed = false
		transition_focus_x = 0
		transition_focus_y = 0
	}
}

proc update_explorer_animation() {
	var frame_step: int
	var transition_active: bool
	call update_explorer_clock()
	transition_active = transition_progress > 0
	frame_step = 0
	while (frame_step < frame_steps) {
		animation_step = 7
		call update_explorer_view_animation()
		call update_explorer_orbits()
		call update_explorer_transition()
		frame_step += 1
	}
	animation_step = frame_steps * 7
	call advance_explorer_orbit_motion(delta_ms, transition_active)
	call refresh_explorer_animated_layout()
}

proc capture_explorer_input() {
	call refresh_explorer_style()
	next_width = graphics::content_width(explorer_window)
	next_height = graphics::content_height(explorer_window)
	if (next_width != width || next_height != height) { orbit_scene_static_dirty = true }
	width = next_width
	height = next_height
	frame_pointer_x = graphics::pointer_x(explorer_window)
	frame_pointer_y = graphics::pointer_y(explorer_window)
	frame_mouse_pressed = graphics::mouse_pressed()
	frame_mouse_down = graphics::mouse_down()
	frame_mouse_released = graphics::mouse_released()
	frame_right_mouse_pressed = graphics::right_mouse_pressed()
	scroll_steps = graphics::scroll_delta()
	input_modifiers = graphics::modifiers()
	if (scroll_steps == 0) { return }
	if (!explorer_modal_open() && transition_progress == 0 && frame_pointer_x > 3 && frame_pointer_x < width - 3 && frame_pointer_y > 12 && frame_pointer_y < height - 10 && !explorer_pointer_in_sidebar_panel(3, 12, height - 24)) {
		if ((input_modifiers & graphics::MOD_SHIFT) != 0) {
			rotation_target = (rotation_target + scroll_steps * 8) % 360
			if (rotation_target < 0) { rotation_target += 360 }
		}
		else { call adjust_explorer_zoom(scroll_steps * 10) }
	}
}

proc draw_explorer_scene() {
	if (width < 104 || height < 72) {
		zoom_controls_hovered = false
		call draw_file_atom(2, 3, width - 4, height - 6)
		return
	}
	call refresh_explorer_toolbar_geometry()
	drop_path_active = false
	if (drag_entry >= 0 && drag_moved && !current_path_is_root) {
		if (frame_pointer_x >= EXPLORER_TOOLBAR_SIDE_PADDING && frame_pointer_x < EXPLORER_TOOLBAR_SIDE_PADDING + 32 && frame_pointer_y >= EXPLORER_TOOLBAR_Y && frame_pointer_y < EXPLORER_TOOLBAR_Y + EXPLORER_TOOLBAR_HEIGHT) {
			call graphics::fill_rect(explorer_window, EXPLORER_TOOLBAR_SIDE_PADDING, EXPLORER_TOOLBAR_Y, 32, EXPLORER_TOOLBAR_HEIGHT, visual_accent)
			drop_path_active = true
			call explorer_set(drop_path_target, cached_parent_path)
		}
		else { call graphics::fill_rect(explorer_window, EXPLORER_TOOLBAR_SIDE_PADDING, EXPLORER_TOOLBAR_Y, 32, EXPLORER_TOOLBAR_HEIGHT, visual_surface) }
		call draw_explorer_fixed_label_centered(EXPLORER_TOOLBAR_SIDE_PADDING, EXPLORER_TOOLBAR_Y + 1, 32, "Back", back_label_width, visual_outline)
	}
	elseif (!current_path_is_root) {
		if (!explorer_modal_open()) {
			if (explorer_fixed_label_button(EXPLORER_TOOLBAR_SIDE_PADDING, EXPLORER_TOOLBAR_Y, 32, EXPLORER_TOOLBAR_HEIGHT, "Back", back_label_width, visual_surface, explorer_control_text_color())) { call begin_path_transition(explorer_parent_path(current_path)) }
		}
		else {
			call graphics::fill_rect(explorer_window, EXPLORER_TOOLBAR_SIDE_PADDING, EXPLORER_TOOLBAR_Y, 32, EXPLORER_TOOLBAR_HEIGHT, visual_surface)
			call draw_explorer_fixed_label_centered(EXPLORER_TOOLBAR_SIDE_PADDING, EXPLORER_TOOLBAR_Y + 1, 32, "Back", back_label_width, visual_outline)
		}
	}
	else {
		call graphics::fill_rect(explorer_window, EXPLORER_TOOLBAR_SIDE_PADDING, EXPLORER_TOOLBAR_Y, 32, EXPLORER_TOOLBAR_HEIGHT, visual_surface)
		call draw_explorer_fixed_label_centered(EXPLORER_TOOLBAR_SIDE_PADDING, EXPLORER_TOOLBAR_Y + 1, 32, "Back", back_label_width, visual_outline)
	}
	call draw_breadcrumbs(toolbar_breadcrumb_x, EXPLORER_TOOLBAR_Y, toolbar_breadcrumb_width)
	call draw_file_atom(3, 12, width - 6, height - 24)
	call draw_explorer_sidebar(3, 12, height - 24)
	call draw_explorer_toolbar_controls()
	if (marquee_active) { call draw_selection_marquee() }
	if (drag_entry >= 0 || drag_template > 0) { call draw_explorer_drag_overlay() }
}

proc handle_explorer_canvas_input() {
	var dx: int
	var dy: int
	if (!frame_mouse_pressed && !frame_mouse_down && !frame_mouse_released && !canvas_press_pending && !rotating && !marquee_active) { return }
	if (width >= 104 && height >= 72) {
		if (frame_mouse_pressed && hovered_entry < 0 && drag_entry < 0 && drag_template == 0 && !shell_button_hovered && !zoom_controls_hovered && transition_progress == 0 && !explorer_modal_open() && frame_pointer_x > 3 && frame_pointer_x < width - 3 && frame_pointer_y > 12 && frame_pointer_y < height - 12 && !explorer_pointer_in_sidebar_panel(3, 12, height - 24)) {
			if ((input_modifiers & graphics::MOD_CTRL) != 0 || (input_modifiers & graphics::MOD_SHIFT) != 0) {
				marquee_active = true
				marquee_start_x = frame_pointer_x
				marquee_start_y = frame_pointer_y
				marquee_current_x = marquee_start_x
				marquee_current_y = marquee_start_y
				rotating = false
				canvas_press_pending = false
				last_click_entry = -1
			}
			else {
				canvas_press_pending = true
				canvas_press_x = frame_pointer_x
				canvas_press_y = frame_pointer_y
				rotating = false
			}
			last_pointer_x = frame_pointer_x
			last_pointer_y = frame_pointer_y
		}
		if (canvas_press_pending && frame_mouse_down) {
			dx = frame_pointer_x - canvas_press_x
			dy = frame_pointer_y - canvas_press_y
			if (dx * dx + dy * dy > POINTER_MOVE_THRESHOLD_SQUARED) {
				canvas_press_pending = false
				rotating = true
				call clear_entry_selection()
				selection_anchor = -1
				call update_selection_status()
				last_click_entry = -1
			}
		}
		if (rotating) {
			if (frame_mouse_down) {
				rotation_target += frame_pointer_x - last_pointer_x
				rotation_target %= 360
				if (rotation_target < 0) { rotation_target += 360 }
				tilt_target += frame_pointer_y - last_pointer_y
				if (tilt_target > 70) { tilt_target = 70 }
				if (tilt_target < -70) { tilt_target = -70 }
				last_pointer_x = frame_pointer_x
				last_pointer_y = frame_pointer_y
			}
		}
	}
	if (marquee_active && frame_mouse_down) {
		marquee_current_x = frame_pointer_x
		marquee_current_y = frame_pointer_y
	}
	if (frame_mouse_released) {
		if (canvas_press_pending) {
			call clear_entry_selection()
			selection_anchor = -1
			call update_selection_status()
			last_click_entry = -1
		}
		canvas_press_pending = false
		if (marquee_active) {
			marquee_current_x = frame_pointer_x
			marquee_current_y = frame_pointer_y
			call finish_marquee_selection()
			marquee_active = false
		}
		rotating = false
	}
	elseif (canvas_press_pending && !frame_mouse_down) { canvas_press_pending = false }
}

proc recover_lost_pointer_capture() {
	if (frame_mouse_pressed || frame_mouse_down || frame_mouse_released) { return }
	if (drag_entry >= 0) { call clear_entry_drag() }
	drag_template = 0
	if (marquee_active) {
		marquee_current_x = frame_pointer_x
		marquee_current_y = frame_pointer_y
		call finish_marquee_selection()
		marquee_active = false
	}
	rotating = false
	canvas_press_pending = false
	context_hold_entry = -1
	context_hold_triggered = false
}

proc draw_explorer_modal_layer() {
	if (context_open) { call draw_context_menu() }
	elseif (rename_open) { call draw_inline_rename() }
	elseif (delete_confirm) { call draw_delete_dialog() }
}

proc handle_explorer_keys() {
	key = graphics::read_key()
	while (key != 0) {
		if (rename_open) {
			if (key == graphics::KEY_ENTER) { call commit_rename() }
			else { call handle_rename_key(key) }
		}
		elseif (context_open && key == graphics::KEY_ESCAPE) { context_open = false }
		elseif (delete_confirm && key == graphics::KEY_ESCAPE) { delete_confirm = false }
		elseif (key == '+' || key == '=') { call adjust_explorer_zoom(15) }
		elseif (key == '-') { call adjust_explorer_zoom(-15) }
		key = graphics::read_key()
	}
}

proc draw_explorer_content() {
	call capture_explorer_input()
	call dismiss_context_menu_outside_press()
	call draw_explorer_scene()
	call handle_explorer_canvas_input()
	call recover_lost_pointer_capture()
	call draw_explorer_modal_layer()
	call handle_explorer_keys()
}

proc draw_explorer_frame() {
	var minimized: bool
	minimized = explorer_window.is_minimized()
	if (!minimized) { call update_explorer_animation() }
	else {
		previous_ticks = os::ticks()
		fixed_update_accumulator = 0
	}
	call graphics::begin_draw(explorer_window)
	if (!minimized) { call draw_explorer_content() }
	call graphics::update(explorer_window)
	if (transition_progress >= 100 && !transition_committed) { call commit_folder_transition() }
}

proc capture_file_viewer_input() {
	viewer_width[viewer_active_slot] = viewer_content_width()
	viewer_height[viewer_active_slot] = viewer_content_height()
	scroll_steps = graphics::scroll_delta()
	if (scroll_steps != 0) {
		viewer_scroll[viewer_active_slot] -= scroll_steps
		if (viewer_scroll[viewer_active_slot] < 0) { viewer_scroll[viewer_active_slot] = 0 }
	}
}

proc handle_file_viewer_keys() {
	key = graphics::read_key()
	while (key != 0) {
		if (key == graphics::KEY_ESCAPE) { call request_file_viewer_close() }
		elseif (key == graphics::KEY_UP && viewer_scroll[viewer_active_slot] > 0) { viewer_scroll[viewer_active_slot] -= 1 }
		elseif (key == graphics::KEY_DOWN) { viewer_scroll[viewer_active_slot] += 1 }
		key = graphics::read_key()
	}
}

proc draw_file_viewer_frame() {
	var minimized: bool
	call refresh_explorer_style()
	call begin_viewer_window_draw()
	call capture_viewer_window_state()
	if (viewer_current_state == graphics::WINDOW_CLOSED) {
		call release_file_viewer()
		return
	}
	minimized = viewer_window_is_minimized()
	if (!minimized) {
		call capture_file_viewer_input()
		call draw_file_viewer()
		call handle_file_viewer_keys()
	}
	call update_viewer_window()
	call capture_viewer_window_state()
	if (viewer_close_requested || viewer_current_state == graphics::WINDOW_CLOSED) {
		call close_file_viewer()
	}
}

proc draw_file_viewer_frames() {
	var slot: int
	slot = 0
	while (slot < MAX_FILE_VIEWERS) {
		if (viewer_is_open[slot]) {
			viewer_active_slot = slot
			call draw_file_viewer_frame()
		}
		slot += 1
	}
}

