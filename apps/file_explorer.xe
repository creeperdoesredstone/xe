			# descriptor table inside the native batch.
			orbit_stream_result = graphics::draw_commands(explorer_window, orbit_command_stream, orbit_stream_words, entry_label_short_cache, entry_label_short_cache, entry_selected, entry_render_x, entry_render_y, entry_render_depth, entry_node_radius, entry_depth_order)
		}
		else {
			orbit_stream_result = graphics::draw_commands(explorer_window, orbit_command_stream, orbit_stream_words, entry_name_cache, entry_label_short_cache, entry_selected, entry_render_x, entry_render_y, entry_render_depth, entry_node_radius, entry_depth_order)
		}
		if (orbit_stream_result >= 0) {
			orbit_native_drawn = true
			hovered_shell = (orbit_stream_result / 256) % 256 - 1
			hovered_entry = orbit_stream_result % 256 - 1
			if (hovered_entry >= count) { hovered_entry = -1 }
			pointer_in_scene = pointer_x > x && pointer_x < x + area_width && pointer_y >= y && pointer_y < y + area_height
			if (explorer_pointer_in_sidebar_panel(x, y, area_height) || zoom_controls_hovered) { pointer_in_scene = false }
			dx = pointer_x - atom_center_x
			dy = pointer_y - atom_center_y
			if (dx < 0) { dx = -dx }
			if (dy < 0) { dy = -dy }
			outside_nucleus = false
			if (dx > atom_center_radius || dy > atom_center_radius) { outside_nucleus = true }
			elseif (dx * dx + dy * dy > atom_center_radius * atom_center_radius) { outside_nucleus = true }
			if (!pointer_in_scene) {
				hovered_entry = -1
				hovered_shell = -1
			}
			if (!outside_nucleus && hovered_entry < 0) { hovered_shell = -1 }
			elseif (hovered_entry < 0 && pointer_in_scene) {
				nearest_entry_distance_squared = 2147483647
				index = 0
				while (index < cached_entry_count) {
					dx = pointer_x - entry_render_x[index]
					dy = pointer_y - entry_render_y[index]
					distance_squared = dx * dx + dy * dy
					hit_radius = entry_node_radius[index] + 18
					if (hit_radius < 20) { hit_radius = 20 }
					if (distance_squared <= hit_radius * hit_radius && distance_squared < nearest_entry_distance_squared) {
						nearest_entry_distance_squared = distance_squared
						hovered_entry = index
						hovered_shell = entry_shell[index]
					}
					index += 1
				}
			}
			if (shell_button_hovered && all_shells_full) { hovered_entry = -1; pointer_in_scene = false; hovered_shell = -1 }
			elseif (hovered_entry >= 0) { shell_button_hovered = false }
			elseif (shell_button_hovered) { pointer_in_scene = false; hovered_shell = -1 }
			capture_entry = entry_pointer_capture_candidate(hovered_entry, capture_entry)
			if (entry_pointer_capture_ready(capture_entry, interaction_allowed)) { call begin_entry_pointer_capture(capture_entry) }
		}
