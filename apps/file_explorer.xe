						}
					}
				}
			}
			index += 1
		}
		if (shell_button_hovered && all_shells_full) { hovered_entry = -1; pointer_in_scene = false; hovered_shell = -1 }
		elseif (hovered_entry >= 0) { shell_button_hovered = false }
		elseif (shell_button_hovered) { pointer_in_scene = false; hovered_shell = -1 }
		capture_entry = entry_pointer_capture_candidate(hovered_entry, capture_entry)
		if (entry_pointer_capture_ready(capture_entry, interaction_allowed)) { call begin_entry_pointer_capture(capture_entry) }
