# Xenon Minesweeper: deterministic, Scratch-portable board logic and UI.

# App metadata and default geometry.
const APP_TITLE = "Xenon Minesweeper"
const APP_DEFAULT_WIDTH = 292
const APP_DEFAULT_HEIGHT = 248

const MINE_BEGINNER = 0
const MINE_INTERMEDIATE = 1
const MINE_EXPERT = 2
const MINE_PLAYING = 0
const MINE_WON = 1
const MINE_LOST = 2

# Model and state.
var mine_window: graphics::Window
array mine_cells: int[480]
array mine_revealed: int[480]
array mine_flagged: int[480]
array mine_queue: int[480]
var mine_columns: int
var mine_rows: int
var mine_total: int
var mine_count: int
var mine_flags_used: int
var mine_revealed_count: int
var mine_difficulty: int
var mine_state: int
var mine_seed: int
var mine_random_state: int
var mine_first_reveal: bool
var mine_flag_mode: bool
var mine_start_ticks: int
var mine_finish_ticks: int
var mine_focus_column: int
var mine_focus_row: int

proc mine_clear_board() {
	var index: int
	index = 0
	while (index < 480) {
		mine_cells[index] = 0
		mine_revealed[index] = 0
		mine_flagged[index] = 0
		mine_queue[index] = 0
		index += 1
	}
}

proc mine_apply_difficulty(difficulty: int) {
	mine_difficulty = difficulty
	if (difficulty == MINE_BEGINNER) {
		mine_columns = 9
		mine_rows = 9
		mine_count = 10
	}
	elseif (difficulty == MINE_INTERMEDIATE) {
		mine_columns = 16
		mine_rows = 16
		mine_count = 40
	}
	else {
		mine_columns = 30
		mine_rows = 16
		mine_count = 99
	}
	mine_total = mine_columns * mine_rows
}

proc mine_reset() {
	call mine_clear_board()
	mine_flags_used = 0
	mine_revealed_count = 0
	mine_state = MINE_PLAYING
	mine_first_reveal = true
	mine_flag_mode = false
	mine_start_ticks = 0
	mine_finish_ticks = 0
	mine_focus_column = mine_columns / 2
	mine_focus_row = mine_rows / 2
	mine_random_state = mine_seed % 65536
	if (mine_random_state < 0) { mine_random_state = -mine_random_state }
}

fn mine_next_random() int {
	mine_random_state = (mine_random_state * 25173 + 13849) % 65536
	if (mine_random_state < 0) { mine_random_state = -mine_random_state }
	return mine_random_state
}

fn mine_valid(column: int, row: int) bool {
	return column >= 0 && column < mine_columns && row >= 0 && row < mine_rows
}

fn mine_index(column: int, row: int) int {
	return row * mine_columns + column
}

fn mine_in_safe_area(index: int, safe_column: int, safe_row: int) bool {
	var column: int
	var row: int
	column = index % mine_columns
	row = index / mine_columns
	return column >= safe_column - 1 && column <= safe_column + 1 && row >= safe_row - 1 && row <= safe_row + 1
}

proc mine_place_exact(intro_column: int, intro_row: int) {
	var placed: int
	var candidate: int
	placed = 0
	while (placed < mine_count) {
		candidate = mine_next_random() % mine_total
		if (mine_cells[candidate] == 0 && !mine_in_safe_area(candidate, intro_column, intro_row)) {
			mine_cells[candidate] = 1
			placed += 1
		}
	}
}

fn mine_adjacent_count(column: int, row: int) int {
	var dx: int
	var dy: int
	var count: int
	count = 0
	dy = -1
	while (dy <= 1) {
		dx = -1
		while (dx <= 1) {
			if ((dx != 0 || dy != 0) && mine_valid(column + dx, row + dy)) {
				count += mine_cells[mine_index(column + dx, row + dy)]
			}
			dx += 1
		}
		dy += 1
	}
	return count
}

fn mine_adjacent_flags(column: int, row: int) int {
	var dx: int
	var dy: int
	var count: int
	count = 0
	dy = -1
	while (dy <= 1) {
		dx = -1
		while (dx <= 1) {
			if ((dx != 0 || dy != 0) && mine_valid(column + dx, row + dy)) {
				count += mine_flagged[mine_index(column + dx, row + dy)]
			}
			dx += 1
		}
		dy += 1
	}
	return count
}

proc mine_reveal_all_mines() {
	var index: int
	index = 0
	while (index < mine_total) {
		if (mine_cells[index] != 0) { mine_revealed[index] = 1 }
		index += 1
	}
}

proc mine_finish_if_won() {
	if (mine_state == MINE_PLAYING && mine_revealed_count == mine_total - mine_count) {
		mine_state = MINE_WON
		mine_finish_ticks = os::ticks()
	}
}

# Input and interaction.
proc mine_reveal_cell(column: int, row: int) {
	var start: int
	var head: int
	var tail: int
	var current: int
	var current_column: int
	var current_row: int
	var dx: int
	var dy: int
	var neighbor: int
	if (mine_state != MINE_PLAYING || !mine_valid(column, row)) { return }
	start = mine_index(column, row)
	if (mine_flagged[start] != 0 || mine_revealed[start] != 0) { return }
	if (mine_first_reveal) {
		call mine_place_exact(column, row)
		mine_first_reveal = false
		mine_start_ticks = os::ticks()
	}
	if (mine_cells[start] != 0) {
		mine_revealed[start] = 1
		mine_state = MINE_LOST
		mine_finish_ticks = os::ticks()
		call mine_reveal_all_mines()
		return
	}
	head = 0
	tail = 1
	mine_queue[0] = start
	mine_revealed[start] = 1
	mine_revealed_count += 1
	while (head < tail) {
		current = mine_queue[head]
		head += 1
		current_column = current % mine_columns
		current_row = current / mine_columns
		if (mine_adjacent_count(current_column, current_row) == 0) {
			dy = -1
			while (dy <= 1) {
				dx = -1
				while (dx <= 1) {
					if ((dx != 0 || dy != 0) && mine_valid(current_column + dx, current_row + dy)) {
						neighbor = mine_index(current_column + dx, current_row + dy)
						if (mine_revealed[neighbor] == 0 && mine_flagged[neighbor] == 0 && mine_cells[neighbor] == 0) {
							mine_revealed[neighbor] = 1
							mine_revealed_count += 1
							mine_queue[tail] = neighbor
							tail += 1
						}
					}
					dx += 1
				}
				dy += 1
			}
		}
	}
	call mine_finish_if_won()
}

proc mine_toggle_flag(column: int, row: int) {
	var index: int
	if (mine_state != MINE_PLAYING || !mine_valid(column, row)) { return }
	index = mine_index(column, row)
	if (mine_revealed[index] != 0) { return }
	if (mine_flagged[index] != 0) {
		mine_flagged[index] = 0
		mine_flags_used -= 1
	}
	elseif (mine_flags_used < mine_count) {
		mine_flagged[index] = 1
		mine_flags_used += 1
	}
}

proc mine_chord(column: int, row: int) {
	var index: int
	var adjacent: int
	var dx: int
	var dy: int
	if (!mine_valid(column, row)) { return }
	index = mine_index(column, row)
	if (mine_revealed[index] == 0) { return }
	adjacent = mine_adjacent_count(column, row)
	if (adjacent == 0 || mine_adjacent_flags(column, row) != adjacent) { return }
	dy = -1
	while (dy <= 1 && mine_state == MINE_PLAYING) {
		dx = -1
		while (dx <= 1 && mine_state == MINE_PLAYING) {
			if ((dx != 0 || dy != 0) && mine_valid(column + dx, row + dy)) { call mine_reveal_cell(column + dx, row + dy) }
			dx += 1
		}
		dy += 1
	}
}

fn mine_elapsed_seconds() int {
	var finish: int
	if (mine_start_ticks == 0) { return 0 }
	finish = os::ticks()
	if (mine_state != MINE_PLAYING) { finish = mine_finish_ticks }
	return (finish - mine_start_ticks) / 1000
}

# Layout helpers.
fn mine_small_text_width(text: string) int {
	var index: int
	var width: int
	index = 0
	width = 0
	while (index < xestring::strlen(text)) {
		width += graphics::char_advance(text[index], graphics::FONT_SMALL)
		index += 1
	}
	return width
}

fn mine_number_color(value: int, light: bool) int {
	if (value == 1) { return graphics::COLOR_10 }
	if (value == 2) { return graphics::COLOR_8 }
	if (value == 3) { return graphics::COLOR_14 }
	if (value == 4) { return graphics::COLOR_11 }
	if (value == 5) { return graphics::COLOR_6 }
	if (value == 6) { return graphics::COLOR_12 }
	if (value == 7) { return graphics::COLOR_7 }
	if (light) { return graphics::COLOR_1 }
	return graphics::WHITE
}

# Paint and replaceable asset hooks.
proc mine_draw_flag(x: int, y: int, size: int) {
	var center_x: int
	var top: int
	center_x = x + size / 2
	top = y + 1
	call graphics::draw_line(mine_window, center_x - 1, top, center_x - 1, y + size - 2, graphics::COLOR_14)
	call graphics::draw_line(mine_window, center_x - 1, top, center_x + size / 3, top + size / 4, graphics::COLOR_14)
	call graphics::draw_line(mine_window, center_x - 2, y + size - 2, center_x + 2, y + size - 2, graphics::COLOR_7)
}

proc mine_draw_mine(x: int, y: int, size: int) {
	var center_x: int
	var center_y: int
	center_x = x + size / 2
	center_y = y + size / 2
	if (size >= 9) {
		call graphics::draw_circle(mine_window, center_x, center_y, 2, graphics::COLOR_6)
		call graphics::draw_line(mine_window, center_x - 3, center_y, center_x + 3, center_y, graphics::COLOR_6)
		call graphics::draw_line(mine_window, center_x, center_y - 3, center_x, center_y + 3, graphics::COLOR_6)
		call graphics::set_pixel(mine_window, center_x - 1, center_y - 1, graphics::WHITE)
	}
	else { call graphics::set_pixel(mine_window, center_x, center_y, graphics::COLOR_6) }
}

proc mine_draw_cell(x: int, y: int, size: int, column: int, row: int, hovered: bool, focused: bool, light: bool) {
	var index: int
	var value: int
	var fill: int
	var text: int
	index = mine_index(column, row)
	fill = graphics::COLOR_5
	text = graphics::WHITE
	if (light) { fill = graphics::COLOR_7; text = graphics::COLOR_1 }
	if (mine_revealed[index] != 0) {
		fill = graphics::COLOR_1
		if (light) { fill = graphics::WHITE }
		call graphics::fill_rect(mine_window, x, y, size, size, fill)
		if (mine_cells[index] != 0) {
			call mine_draw_mine(x, y, size)
		}
		else {
			value = mine_adjacent_count(column, row)
			if (value > 0 && size >= 7) { call graphics::draw_int_small(mine_window, x + (size - 3) / 2, y + (size - 5) / 2, value, mine_number_color(value, light)) }
		}
	}
	else {
		if (hovered) { fill = graphics::COLOR_8 }
		call graphics::fill_rect(mine_window, x, y, size, size, fill)
		if (size >= 4) {
			call graphics::draw_line(mine_window, x, y, x + size - 1, y, graphics::COLOR_7)
			call graphics::draw_line(mine_window, x, y, x, y + size - 1, graphics::COLOR_7)
			call graphics::draw_line(mine_window, x, y + size - 1, x + size - 1, y + size - 1, graphics::COLOR_1)
			call graphics::draw_line(mine_window, x + size - 1, y, x + size - 1, y + size - 1, graphics::COLOR_1)
		}
		if (mine_flagged[index] != 0) {
			if (size >= 7) { call mine_draw_flag(x, y, size) }
			else { call graphics::set_pixel(mine_window, x + size / 2, y + size / 2, graphics::COLOR_14) }
		}
	}
	if (focused && size >= 5) { call graphics::draw_rect(mine_window, x + 1, y + 1, size - 2, size - 2, graphics::WHITE) }
}

mine_seed = 131
call mine_apply_difficulty(MINE_BEGINNER)
call mine_reset()

var mine_width: int
var mine_height: int
var mine_board_x: int
var mine_board_y: int
var mine_board_width: int
var mine_board_height: int
var mine_cell_size: int
var mine_column: int
var mine_row: int
var mine_pointer_column: int
var mine_pointer_row: int
var mine_pointer_x: int
var mine_pointer_y: int
var mine_key: int
var mine_light: bool
var mine_button_width: int
var mine_action_width: int
var mine_status_color: int
var mine_mode_label: string
var mine_status_label: string
var mine_status_width: int
var mine_easy_label: string
var mine_medium_label: string
var mine_hard_label: string
var mine_focus_visible: bool
var mine_beginner_tone: int
var mine_intermediate_tone: int
var mine_expert_tone: int
var mine_view_column: int
var mine_view_row: int
var mine_visible_columns: int
var mine_visible_rows: int
var mine_available_width: int
var mine_available_height: int

# Application driver.
mine_window.x = 74
mine_window.y = 44
mine_window.width = APP_DEFAULT_WIDTH
mine_window.height = APP_DEFAULT_HEIGHT
mine_window.title = APP_TITLE
mine_window.ui_scale = 1
mine_window.state = graphics::WINDOW_NORMAL
mine_focus_visible = false
mine_view_column = 0
mine_view_row = 0

while (mine_window.state != graphics::WINDOW_CLOSED) {
	call graphics::begin_draw(mine_window)
	if (!mine_window.is_minimized()) {
		mine_width = graphics::content_width(mine_window)
		mine_height = graphics::content_height(mine_window)
		mine_pointer_x = graphics::pointer_x(mine_window)
		mine_pointer_y = graphics::pointer_y(mine_window)
		mine_light = os::theme_mode == os::THEME_LIGHT
		mine_status_color = graphics::COLOR_10
		if (mine_light) { mine_status_color = graphics::COLOR_2 }
		mine_beginner_tone = graphics::COLOR_5
		mine_intermediate_tone = graphics::COLOR_5
		mine_expert_tone = graphics::COLOR_5
		if (mine_difficulty == MINE_BEGINNER) { mine_beginner_tone = graphics::COLOR_8 }
		elseif (mine_difficulty == MINE_INTERMEDIATE) { mine_intermediate_tone = graphics::COLOR_8 }
		else { mine_expert_tone = graphics::COLOR_8 }
		mine_easy_label = "Beginner"
		mine_medium_label = "Intermediate"
		mine_hard_label = "Expert"
		if (mine_width < 210) {
			mine_easy_label = "B"
			mine_medium_label = "I"
			mine_hard_label = "E"
		}
		if (mine_width >= 5) {
			call graphics::fill_rect(mine_window, 2, 2, mine_width - 4, 20, graphics::COLOR_1)
			call graphics::draw_rect(mine_window, 2, 2, mine_width - 4, 20, graphics::COLOR_5)
		}
		mine_button_width = (mine_width - 12) / 3
		if (mine_button_width >= 1 && graphics::button_flat(mine_window, 3, 3, mine_button_width, 8, mine_easy_label, mine_beginner_tone)) {
			call mine_apply_difficulty(MINE_BEGINNER)
			call mine_reset()
		}
		if (mine_button_width >= 1 && graphics::button_flat(mine_window, 6 + mine_button_width, 3, mine_button_width, 8, mine_medium_label, mine_intermediate_tone)) {
			call mine_apply_difficulty(MINE_INTERMEDIATE)
			call mine_reset()
		}
		if (mine_button_width >= 1 && graphics::button_flat(mine_window, 9 + mine_button_width * 2, 3, mine_button_width, 8, mine_hard_label, mine_expert_tone)) {
			call mine_apply_difficulty(MINE_EXPERT)
			call mine_reset()
		}
		mine_mode_label = "Reveal"
		if (mine_flag_mode) { mine_mode_label = "Flag" }
		if (mine_width < 230) {
			if (mine_flag_mode) { mine_mode_label = "F" }
			else { mine_mode_label = "R" }
			mine_action_width = (mine_width - 12) / 3
			if (graphics::button_tone(mine_window, 3, 13, mine_action_width, 8, mine_mode_label, graphics::COLOR_8)) { mine_flag_mode = !mine_flag_mode }
			if (graphics::button_flat(mine_window, 6 + mine_action_width, 13, mine_action_width, 8, "Reset", graphics::COLOR_8)) { call mine_reset() }
			if (graphics::button_flat(mine_window, 9 + mine_action_width * 2, 13, mine_action_width, 8, "+ Seed", graphics::COLOR_5)) {
				mine_seed += 1
				call mine_reset()
			}
		}
		else {
			if (graphics::button_tone(mine_window, 3, 13, 48, 8, mine_mode_label, graphics::COLOR_8)) { mine_flag_mode = !mine_flag_mode }
			if (graphics::button_flat(mine_window, 54, 13, 42, 8, "Reset", graphics::COLOR_8)) { call mine_reset() }
			if (graphics::button_flat(mine_window, 99, 13, 42, 8, "+ Seed", graphics::COLOR_5)) {
				mine_seed += 1
				call mine_reset()
			}
			call graphics::draw_text_small(mine_window, 147, 15, "M", mine_status_color)
			call graphics::draw_int_small(mine_window, 152, 15, mine_count - mine_flags_used, mine_status_color)
			call graphics::draw_text_small(mine_window, mine_width - 42, 15, "T", mine_status_color)
			call graphics::draw_int_small(mine_window, mine_width - 36, 15, mine_elapsed_seconds(), mine_status_color)
		}

		mine_board_y = 25
		mine_available_width = mine_width - 8
		mine_available_height = mine_height - mine_board_y - 6
		if (mine_available_width < 1) { mine_available_width = 1 }
		if (mine_available_height < 1) { mine_available_height = 1 }
		mine_cell_size = mine_available_width / mine_columns
		if (mine_available_height / mine_rows < mine_cell_size) { mine_cell_size = mine_available_height / mine_rows }
		if (mine_cell_size < 1) { mine_cell_size = 1 }
		if (mine_cell_size > 19) { mine_cell_size = 19 }
		mine_visible_columns = mine_available_width / mine_cell_size
		mine_visible_rows = mine_available_height / mine_cell_size
		if (mine_visible_columns < 1) { mine_visible_columns = 1 }
		if (mine_visible_rows < 1) { mine_visible_rows = 1 }
		if (mine_visible_columns > mine_columns) { mine_visible_columns = mine_columns }
		if (mine_visible_rows > mine_rows) { mine_visible_rows = mine_rows }
		if (mine_focus_column < mine_view_column) { mine_view_column = mine_focus_column }
		if (mine_focus_column >= mine_view_column + mine_visible_columns) { mine_view_column = mine_focus_column - mine_visible_columns + 1 }
		if (mine_focus_row < mine_view_row) { mine_view_row = mine_focus_row }
		if (mine_focus_row >= mine_view_row + mine_visible_rows) { mine_view_row = mine_focus_row - mine_visible_rows + 1 }
		if (mine_view_column < 0) { mine_view_column = 0 }
		if (mine_view_row < 0) { mine_view_row = 0 }
		if (mine_view_column > mine_columns - mine_visible_columns) { mine_view_column = mine_columns - mine_visible_columns }
		if (mine_view_row > mine_rows - mine_visible_rows) { mine_view_row = mine_rows - mine_visible_rows }
		mine_board_width = mine_cell_size * mine_visible_columns
		mine_board_height = mine_cell_size * mine_visible_rows
		mine_board_x = (mine_width - mine_board_width) / 2
		mine_pointer_column = -1
		mine_pointer_row = -1
		if (mine_pointer_x >= mine_board_x && mine_pointer_x < mine_board_x + mine_board_width && mine_pointer_y >= mine_board_y && mine_pointer_y < mine_board_y + mine_board_height) {
			mine_pointer_column = mine_view_column + (mine_pointer_x - mine_board_x) / mine_cell_size
			mine_pointer_row = mine_view_row + (mine_pointer_y - mine_board_y) / mine_cell_size
		}
		mine_column = mine_view_column
		while (mine_column < mine_view_column + mine_visible_columns) {
			mine_row = mine_view_row
			while (mine_row < mine_view_row + mine_visible_rows) {
				call mine_draw_cell(mine_board_x + (mine_column - mine_view_column) * mine_cell_size, mine_board_y + (mine_row - mine_view_row) * mine_cell_size, mine_cell_size, mine_column, mine_row, mine_column == mine_pointer_column && mine_row == mine_pointer_row, mine_focus_visible && mine_column == mine_focus_column && mine_row == mine_focus_row, mine_light)
				mine_row += 1
			}
			mine_column += 1
		}
		if (mine_state != MINE_PLAYING && mine_board_width >= 8 && mine_board_height >= 8) {
			mine_status_label = "Board cleared"
			if (mine_state == MINE_LOST) { mine_status_label = "Mine hit - press Restart" }
			if (mine_board_width < 50) {
				if (mine_state == MINE_LOST) { mine_status_label = "X" }
				else { mine_status_label = "OK" }
			}
			elseif (mine_board_width < 100) {
				if (mine_state == MINE_LOST) { mine_status_label = "Mine hit" }
				else { mine_status_label = "Cleared" }
			}
			mine_status_width = mine_small_text_width(mine_status_label)
			call graphics::fill_rect(mine_window, mine_board_x + 3, mine_board_y + mine_board_height / 2 - 6, mine_board_width - 6, 12, graphics::COLOR_1)
			call graphics::draw_text_small(mine_window, mine_board_x + (mine_board_width - mine_status_width) / 2, mine_board_y + mine_board_height / 2 - 2, mine_status_label, graphics::WHITE)
		}

		if ((graphics::mouse_pressed() || graphics::right_mouse_pressed()) && mine_pointer_column >= 0 && mine_pointer_row >= 0) {
			mine_focus_column = mine_pointer_column
			mine_focus_row = mine_pointer_row
			mine_focus_visible = false
			if (graphics::right_mouse_pressed() || mine_flag_mode) { call mine_toggle_flag(mine_pointer_column, mine_pointer_row) }
			elseif (mine_revealed[mine_index(mine_pointer_column, mine_pointer_row)] != 0) { call mine_chord(mine_pointer_column, mine_pointer_row) }
			else { call mine_reveal_cell(mine_pointer_column, mine_pointer_row) }
		}

		mine_key = graphics::read_key()
		while (mine_key != 0) {
			if (mine_key == 49) {
				call mine_apply_difficulty(MINE_BEGINNER)
				call mine_reset()
			}
			elseif (mine_key == 50) {
				call mine_apply_difficulty(MINE_INTERMEDIATE)
				call mine_reset()
			}
			elseif (mine_key == 51) {
				call mine_apply_difficulty(MINE_EXPERT)
				call mine_reset()
			}
			elseif (mine_key == 70 || mine_key == 102) { mine_flag_mode = !mine_flag_mode }
			elseif (mine_key == 82 || mine_key == 114) { call mine_reset() }
			elseif (mine_key == graphics::KEY_LEFT) {
				if (mine_focus_column > 0) { mine_focus_column -= 1 }
				mine_focus_visible = true
			}
			elseif (mine_key == graphics::KEY_RIGHT) {
				if (mine_focus_column + 1 < mine_columns) { mine_focus_column += 1 }
				mine_focus_visible = true
			}
			elseif (mine_key == graphics::KEY_UP) {
				if (mine_focus_row > 0) { mine_focus_row -= 1 }
				mine_focus_visible = true
			}
			elseif (mine_key == graphics::KEY_DOWN) {
				if (mine_focus_row + 1 < mine_rows) { mine_focus_row += 1 }
				mine_focus_visible = true
			}
			elseif (mine_key == graphics::KEY_ENTER) {
				if (mine_revealed[mine_index(mine_focus_column, mine_focus_row)] != 0) { call mine_chord(mine_focus_column, mine_focus_row) }
				else { call mine_reveal_cell(mine_focus_column, mine_focus_row) }
			}
			elseif (mine_key == graphics::KEY_SPACE) { call mine_toggle_flag(mine_focus_column, mine_focus_row) }
			mine_key = graphics::read_key()
		}
	}
	call graphics::update(mine_window)
}
