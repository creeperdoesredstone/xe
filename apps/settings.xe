# Xenon Settings. All edits are staged and committed atomically through Apply.

# App metadata and default geometry.
const APP_TITLE = "Xenon Settings"
const APP_DEFAULT_WIDTH = 280
const APP_DEFAULT_HEIGHT = 210
const FIXED_UPDATE_HZ = 60
const MILLISECONDS_PER_SECOND = 1000
const MAX_FRAME_DELTA_MS = 100

# Exact Xenon font advances for labels used on every Settings frame.
const LABEL_WIDTH_APPLY_NORMAL = 28
const LABEL_WIDTH_APPLY_SMALL = 19
const LABEL_WIDTH_CANCEL_NORMAL = 34
const LABEL_WIDTH_CANCEL_SMALL = 23
const LABEL_WIDTH_ON_NORMAL = 12
const LABEL_WIDTH_OFF_NORMAL = 16
const LABEL_WIDTH_AA_OFF_NORMAL = 18
const LABEL_WIDTH_AA_OFF_SMALL = 12
const LABEL_WIDTH_AA_PERFORMANCE_NORMAL = 119
const LABEL_WIDTH_AA_PERFORMANCE_SMALL = 82
const LABEL_WIDTH_AA_QUALITY_NORMAL = 150
const LABEL_WIDTH_AA_QUALITY_SMALL = 103
const LABEL_WIDTH_SOUND_SMALL = 20
const LABEL_WIDTH_THEME_SMALL = 22
const LABEL_WIDTH_SYSTEM_SMALL = 26
const LABEL_WIDTH_PERSONALIZATION_SMALL = 54
const LABEL_WIDTH_TIME_SMALL = 16
const LABEL_WIDTH_MOTION_ON_SMALL = 52
const LABEL_WIDTH_MOTION_OFF_SMALL = 56

# Model and state.
var settings_window: graphics::Window

# Layout helpers.
fn previous_setting_id(value: int, count: int) int {
	if (count <= 0) { return 0 }
	value -= 1
	if (value < 0) { return count - 1 }
	return value
}

fn next_setting_id(value: int, count: int) int {
	if (count <= 0) { return 0 }
	value += 1
	if (value >= count) { return 0 }
	return value
}

fn ease_menu(value: int) int {
	return value * (200 - value) / 100
}

# Paint and replaceable asset hooks.
proc draw_menu_arrow(x: int, y: int, opened: bool, color: int) {
	if (opened) {
		call graphics::set_pixel(settings_window, x, y, color)
		call graphics::set_pixel(settings_window, x + 1, y + 1, color)
		call graphics::set_pixel(settings_window, x + 2, y + 2, color)
		call graphics::set_pixel(settings_window, x + 3, y + 1, color)
		call graphics::set_pixel(settings_window, x + 4, y, color)
	}
	else {
		call graphics::set_pixel(settings_window, x, y, color)
		call graphics::set_pixel(settings_window, x + 1, y + 1, color)
		call graphics::set_pixel(settings_window, x + 2, y + 2, color)
		call graphics::set_pixel(settings_window, x + 1, y + 3, color)
		call graphics::set_pixel(settings_window, x, y + 4, color)
	}
}

fn draw_step_button(x: int, y: int, right: bool) bool {
	var clicked: bool
	var center_x: int
	var center_y: int
	clicked = graphics::button(settings_window, x, y, 15, 11, " ")
	center_x = x + 7
	center_y = y + 5
	if (right) {
		call graphics::set_pixel(settings_window, center_x - 1, center_y - 2, graphics::WHITE)
		call graphics::set_pixel(settings_window, center_x, center_y - 1, graphics::WHITE)
		call graphics::set_pixel(settings_window, center_x + 1, center_y, graphics::WHITE)
		call graphics::set_pixel(settings_window, center_x, center_y + 1, graphics::WHITE)
		call graphics::set_pixel(settings_window, center_x - 1, center_y + 2, graphics::WHITE)
	}
	else {
		call graphics::set_pixel(settings_window, center_x + 1, center_y - 2, graphics::WHITE)
		call graphics::set_pixel(settings_window, center_x, center_y - 1, graphics::WHITE)
		call graphics::set_pixel(settings_window, center_x - 1, center_y, graphics::WHITE)
		call graphics::set_pixel(settings_window, center_x, center_y + 1, graphics::WHITE)
		call graphics::set_pixel(settings_window, center_x + 1, center_y + 2, graphics::WHITE)
	}
	return clicked
}

# Input and interaction.
proc reload_os_settings(master: int*, music: int*, effects: int*, background: int*, palette: int*, theme: int*, corners: int*, clock: int*, enabled: bool*, motion_blur: bool*, anti_aliasing: int*) {
	*master = os::volume
	*music = os::music_volume
	*effects = os::sound_effect_volume
	*background = os::background_id
	*palette = os::palette
	*theme = os::theme_mode
	*corners = os::window_corner_style
	*clock = os::clock_format
	*enabled = os::settings_enabled
	*motion_blur = os::motion_blur_enabled
	*anti_aliasing = os::anti_aliasing_mode
}

proc apply_staged_settings() {
	applied = os::apply_preferences_v2(staged_master, staged_music, staged_effects, staged_background, staged_palette, staged_theme, 0, staged_corners, os::icon_size, staged_clock, staged_enabled, staged_motion_blur, staged_anti_aliasing)
	call reload_os_settings(&staged_master, &staged_music, &staged_effects, &staged_background, &staged_palette, &staged_theme, &staged_corners, &staged_clock, &staged_enabled, &staged_motion_blur, &staged_anti_aliasing)
	staged_master_baseline = staged_master
	staged_master_dirty = false
	apply_failed = !applied
}

fn settings_apply_label() string {
	if (apply_failed) { return "Retry" }
	return "Apply"
}

fn settings_apply_color() int {
	if (apply_failed) { return graphics::COLOR_4 }
	return graphics::COLOR_2
}

proc cancel_staged_settings() {
	call reload_os_settings(&staged_master, &staged_music, &staged_effects, &staged_background, &staged_palette, &staged_theme, &staged_corners, &staged_clock, &staged_enabled, &staged_motion_blur, &staged_anti_aliasing)
	settings_window.close()
}

proc set_staged_master_volume(value: int) {
	staged_master = value
	staged_master_dirty = staged_master != staged_master_baseline
}

proc synchronize_master_volume() {
	if (!staged_master_dirty && os::volume != staged_master_baseline) {
		staged_master = os::volume
		staged_master_baseline = staged_master
	}
}

proc toggle_staged_theme() {
	if (staged_theme == os::THEME_DARK) {
		staged_theme = os::THEME_LIGHT
		if (staged_palette < palette_group_count) { staged_palette += palette_group_count }
	}
	else {
		staged_theme = os::THEME_DARK
		if (staged_palette >= palette_group_count) { staged_palette -= palette_group_count }
	}
}

proc select_previous_palette() {
	staged_palette = previous_setting_id(staged_palette, palette_count)
	if (staged_theme == os::THEME_DARK && staged_palette >= palette_group_count) { staged_palette = palette_group_count - 1 }
	if (staged_theme == os::THEME_LIGHT && staged_palette < palette_group_count) { staged_palette = palette_count - 1 }
}

proc select_next_palette() {
	staged_palette = next_setting_id(staged_palette, palette_count)
	if (staged_theme == os::THEME_DARK && staged_palette >= palette_group_count) { staged_palette = 0 }
	if (staged_theme == os::THEME_LIGHT && staged_palette < palette_group_count) { staged_palette = palette_group_count }
}

proc select_next_anti_aliasing() {
	if (staged_anti_aliasing == os::ANTI_ALIASING_OFF) { staged_anti_aliasing = os::ANTI_ALIASING_FAST }
	elseif (staged_anti_aliasing == os::ANTI_ALIASING_FAST) { staged_anti_aliasing = os::ANTI_ALIASING_QUALITY }
	else { staged_anti_aliasing = os::ANTI_ALIASING_OFF }
}

fn anti_aliasing_label() string {
	if (staged_anti_aliasing == os::ANTI_ALIASING_OFF) { return "OFF" }
	if (staged_anti_aliasing == os::ANTI_ALIASING_FAST) { return "Performance (Edge AA)" }
	return "Quality (Dual-pass Edge AA)"
}

fn anti_aliasing_label_width(small: bool) int {
	if (staged_anti_aliasing == os::ANTI_ALIASING_OFF) {
		if (small) { return LABEL_WIDTH_AA_OFF_SMALL }
		return LABEL_WIDTH_AA_OFF_NORMAL
	}
	if (staged_anti_aliasing == os::ANTI_ALIASING_FAST) {
		if (small) { return LABEL_WIDTH_AA_PERFORMANCE_SMALL }
		return LABEL_WIDTH_AA_PERFORMANCE_NORMAL
	}
	if (small) { return LABEL_WIDTH_AA_QUALITY_SMALL }
	return LABEL_WIDTH_AA_QUALITY_NORMAL
}

proc draw_value_line(label: string, y: int, value: int, content_x: int, content_width: int) {
	call graphics::draw_text(settings_window, content_x, y, label, graphics::COLOR_7)
	call graphics::draw_int(settings_window, content_x + content_width - 20, y, value, graphics::COLOR_14)
}

fn settings_text_width_prefix(text: string, count: int, font_size: int) int {
	var index: int
	var result: int
	index = 0
	result = 0
	while (index < count) {
		result += graphics::char_advance(text[index], font_size)
		index += 1
	}
	return result
}

fn settings_nonnegative_int_width(value: int, font_size: int) int {
	var result: int
	result = graphics::char_advance('0', font_size)
	while (value >= 10) {
		result += graphics::char_advance('0', font_size)
		value /= 10
	}
	return result
}

fn settings_label_can_draw_as_text(text: string, count: int) bool {
	var index: int
	if (count != xestring::strlen(text)) { return false }
	index = 0
	while (index < count) {
		if ((int)(text[index]) < 32 || (int)(text[index]) > 126) { return false }
		index += 1
	}
	return true
}

proc draw_centered_button_label_width(x: int, y: int, width: int, height: int, label: string, known_width: int, color: int) {
	var count: int
	var index: int
	var font_size: int
	var glyph_height: int
	var text_width: int
	var normal_width: int
	var draw_x: int
	var draw_y: int
	count = xestring::strlen(label)
	font_size = graphics::FONT_NORMAL
	glyph_height = 7
	if (height < 7) {
		font_size = graphics::FONT_SMALL
		glyph_height = 5
	}
	elseif (height < 9) {
		normal_width = settings_text_width_prefix(label, count, graphics::FONT_NORMAL)
		if (normal_width > width - 2) {
			font_size = graphics::FONT_SMALL
			glyph_height = 5
		}
	}
	text_width = known_width
	if (text_width < 0 || height <= 9) { text_width = settings_text_width_prefix(label, count, font_size) }
	while (count > 0 && text_width > width - 2) {
		count -= 1
		text_width = settings_text_width_prefix(label, count, font_size)
	}
	draw_x = x + (width - text_width) / 2
	draw_y = y + (height - glyph_height) / 2
	if (known_width >= 0 && count == xestring::strlen(label)) {
		if (font_size == graphics::FONT_SMALL) {
			call graphics::draw_text_small(settings_window, draw_x, draw_y, label, color)
		}
		else { call graphics::draw_text(settings_window, draw_x, draw_y, label, color) }
		return
	}
	if (settings_label_can_draw_as_text(label, count)) {
		if (font_size == graphics::FONT_SMALL) {
			call graphics::draw_text_small(settings_window, draw_x, draw_y, label, color)
		}
		else { call graphics::draw_text(settings_window, draw_x, draw_y, label, color) }
		return
	}
	index = 0
	while (index < count) {
		if (font_size == graphics::FONT_SMALL) {
			call graphics::draw_char_small(settings_window, draw_x, draw_y, label[index], color)
		}
		else {
			call graphics::draw_char(settings_window, draw_x, draw_y, label[index], color)
		}
		draw_x += graphics::char_advance(label[index], font_size)
		index += 1
	}
}

fn settings_hover_color(color: int) int {
	if (color == graphics::COLOR_8) { return graphics::COLOR_7 }
	if (color > graphics::COLOR_0 && color < graphics::COLOR_8) { return color + 8 }
	return color
}

fn settings_button_aligned_width(x: int, y: int, width: int, height: int, label: string, label_width: int, color: int) bool {
	var clicked: bool
	var foreground: int
	var pointer_x: int
	var pointer_y: int
	var surface: int
	pointer_x = settings_pointer_x
	pointer_y = settings_pointer_y
	surface = color
	if (pointer_x >= x && pointer_x < x + width && pointer_y >= y && pointer_y < y + height) {
		surface = settings_hover_color(color)
	}
	clicked = graphics::button_tone(settings_window, x, y, width, height, " ", surface)
	foreground = graphics::WHITE
	if (color == graphics::COLOR_7 && pointer_x >= x && pointer_x < x + width && pointer_y >= y && pointer_y < y + height) {
		foreground = graphics::COLOR_1
		if (os::theme_mode == os::THEME_LIGHT) { foreground = graphics::COLOR_0 }
	}
	call draw_centered_button_label_width(x, y, width, height, label, label_width, foreground)
	return clicked
}

fn settings_button_aligned(x: int, y: int, width: int, height: int, label: string, color: int) bool {
	return settings_button_aligned_width(x, y, width, height, label, -1, color)
}

fn settings_flat_button_aligned_width(x: int, y: int, width: int, height: int, label: string, label_width: int, surface: int, foreground: int) bool {
	var clicked: bool
	clicked = graphics::button_flat(settings_window, x, y, width, height, " ", surface)
	call draw_centered_button_label_width(x, y, width, height, label, label_width, foreground)
	return clicked
}

fn settings_flat_button_aligned(x: int, y: int, width: int, height: int, label: string, surface: int, foreground: int) bool {
	return settings_flat_button_aligned_width(x, y, width, height, label, -1, surface, foreground)
}

proc draw_preview_box(x: int, y: int, width: int, height: int, corner_style: int, surface: int, outline: int) {
	var cut: int
	var border: int
	cut = 0
	border = graphics::WINDOW_BORDER_WIDTH
	if (corner_style == os::CORNER_ROUNDED) { cut = graphics::WINDOW_ROUNDED_INSET }
	if (cut == 0) {
		call graphics::fill_rect(settings_window, x, y, width, height, surface)
	}
	else {
		call graphics::fill_rect(settings_window, x + cut, y, width - cut * 2, height, surface)
		call graphics::fill_rect(settings_window, x, y + cut, width, height - cut * 2, surface)
	}
	call graphics::fill_rect(settings_window, x + cut, y, width - cut * 2, border, outline)
	call graphics::fill_rect(settings_window, x + cut, y + height - border, width - cut * 2, border, outline)
	call graphics::fill_rect(settings_window, x, y + cut, border, height - cut * 2, outline)
	call graphics::fill_rect(settings_window, x + width - border, y + cut, border, height - cut * 2, outline)
	if (cut > 0) {
		call graphics::draw_line(settings_window, x, y + cut, x + cut, y, outline)
		call graphics::draw_line(settings_window, x + width - cut - 1, y, x + width - 1, y + cut, outline)
		call graphics::draw_line(settings_window, x, y + height - cut - 1, x + cut, y + height - 1, outline)
		call graphics::draw_line(settings_window, x + width - cut - 1, y + height - 1, x + width - 1, y + height - cut - 1, outline)
	}
}

fn settings_preview_accent() int {
	return graphics::WINDOW_TITLE_COLOR
}

fn settings_preview_background() int {
	if (staged_background == 1) { return graphics::COLOR_1 }
	if (staged_background == 2) { return graphics::COLOR_8 }
	return graphics::COLOR_0
}

proc draw_preview_window_title(x: int, y: int, text: string, maximum_width: int) {
	var index: int
	var advance: int
	var cursor: int
	index = 0
	cursor = 0
	while (index < xestring::strlen(text)) {
		advance = graphics::char_advance(text[index], graphics::FONT_LARGE)
		if (cursor + advance > maximum_width) { return }
		call graphics::draw_char_styled(settings_window, x + cursor, y, text[index], graphics::WINDOW_TEXT_COLOR, graphics::FONT_LARGE, 0)
		cursor += advance
		index += 1
	}
}

proc draw_preview_window_chrome(preview_x: int, preview_y: int, preview_width: int, preview_height: int) {
	var title_height: int
	var corner_inset: int
	var control_size: int
	var control_gap: int
	var close_x: int
	var maximize_x: int
	corner_inset = 0
	if (staged_corners == os::CORNER_ROUNDED) { corner_inset = graphics::WINDOW_ROUNDED_INSET }
	call draw_preview_box(preview_x, preview_y, preview_width, preview_height, staged_corners, graphics::WINDOW_CONTENT_COLOR, graphics::WINDOW_BORDER_COLOR)
	title_height = graphics::WINDOW_TITLE_HEIGHT
	call graphics::fill_rect(settings_window, preview_x + corner_inset, preview_y + graphics::WINDOW_BORDER_WIDTH, preview_width - corner_inset * 2, title_height - graphics::WINDOW_BORDER_WIDTH, graphics::WINDOW_TITLE_COLOR)
	call graphics::fill_rect(settings_window, preview_x + graphics::WINDOW_BORDER_WIDTH, preview_y + title_height, preview_width - graphics::WINDOW_BORDER_WIDTH * 2, preview_height - title_height - graphics::WINDOW_BORDER_WIDTH, graphics::WINDOW_CONTENT_COLOR)
	control_size = graphics::WINDOW_CONTROL_SIZE
	control_gap = graphics::WINDOW_CONTROL_GAP
	close_x = preview_x + preview_width - control_size - corner_inset - 1
	maximize_x = close_x - control_size - control_gap
	call draw_preview_window_title(preview_x + graphics::WINDOW_TITLE_TEXT_OFFSET, preview_y + 2, "Window", maximize_x - preview_x - graphics::WINDOW_TITLE_TEXT_OFFSET)
	call graphics::fill_rect(settings_window, maximize_x + 2, preview_y + 3, 8, 2, graphics::WINDOW_CONTROL_COLOR)
	call graphics::fill_rect(settings_window, maximize_x + 2, preview_y + 9, 8, 2, graphics::WINDOW_CONTROL_COLOR)
	call graphics::fill_rect(settings_window, maximize_x + 2, preview_y + 3, 2, 8, graphics::WINDOW_CONTROL_COLOR)
	call graphics::fill_rect(settings_window, maximize_x + 8, preview_y + 3, 2, 8, graphics::WINDOW_CONTROL_COLOR)
	call graphics::draw_line(settings_window, close_x + 2, preview_y + 3, close_x + 9, preview_y + 10, graphics::WINDOW_CONTROL_COLOR)
	call graphics::draw_line(settings_window, close_x + 3, preview_y + 3, close_x + 10, preview_y + 10, graphics::WINDOW_CONTROL_COLOR)
	call graphics::draw_line(settings_window, close_x + 9, preview_y + 3, close_x + 2, preview_y + 10, graphics::WINDOW_CONTROL_COLOR)
	call graphics::draw_line(settings_window, close_x + 10, preview_y + 3, close_x + 3, preview_y + 10, graphics::WINDOW_CONTROL_COLOR)
}

proc draw_palette_background_preview(x: int, y: int, width: int, height: int) {
	var background: int
	var background_label_width: int
	var background_value_x: int
	var sample_x: int
	var sample_y: int
	var sample_width: int
	var sample_height: int
	var palette_label_width: int
	var palette_value_width: int
	var palette_value_x: int
	var swatch_top: int
	var swatch_width: int
	var swatch_height: int
	var index: int
	var column: int
	var row: int
	if (width < 38 || height < 24) { return }
	if (width > 260) {
		x += (width - 260) / 2
		width = 260
	}
	if (height > 96) {
		y += (height - 96) / 2
		height = 96
	}
	background = settings_preview_background()
	call graphics::fill_rect(settings_window, x, y, width, height, background)
	call graphics::draw_rect(settings_window, x, y, width, height, graphics::COLOR_8)
	swatch_top = y + height - 12
	swatch_width = (width - 4) / 8
	if (swatch_width < 4) { swatch_width = 4 }
	swatch_height = 5
	index = 0
	while (index < 16) {
		column = index % 8
		row = index / 8
		call graphics::fill_rect(settings_window, x + 2 + column * swatch_width, swatch_top + row * swatch_height, swatch_width - 1, swatch_height - 1, index)
		index += 1
	}
	sample_width = width * 2 / 5
	if (sample_width < 72) { sample_width = 72 }
	if (sample_width > 100) { sample_width = 100 }
	if (sample_width > width - 4) { sample_width = width - 4 }
	sample_height = swatch_top - y - 6
	if (sample_height > 54) { sample_height = 54 }
	if (sample_height < 10) { sample_height = 10 }
	sample_x = x + (width - sample_width) / 2
	sample_y = y + (swatch_top - y - sample_height) / 2
	if (sample_width >= 72 && sample_height >= 54) { call draw_preview_window_chrome(sample_x, sample_y, sample_width, sample_height) }
	else { call draw_preview_box(sample_x, sample_y, sample_width, sample_height, staged_corners, graphics::WINDOW_CONTENT_COLOR, graphics::WINDOW_BORDER_COLOR) }
	if (width >= 92 && height >= 40) {
		background_label_width = settings_text_width_prefix("BG", 2, graphics::FONT_NORMAL)
		background_value_x = x + 7 + background_label_width
		palette_label_width = settings_text_width_prefix("PAL", 3, graphics::FONT_NORMAL)
		palette_value_width = settings_nonnegative_int_width(staged_palette, graphics::FONT_NORMAL)
		palette_value_x = x + width - 4 - palette_value_width
		call graphics::draw_text(settings_window, x + 4, y + 3, "BG", graphics::COLOR_7)
		call graphics::draw_int(settings_window, background_value_x, y + 3, staged_background, graphics::COLOR_14)
		call graphics::draw_text(settings_window, palette_value_x - 3 - palette_label_width, y + 3, "PAL", graphics::COLOR_7)
		call graphics::draw_int(settings_window, palette_value_x, y + 3, staged_palette, graphics::COLOR_14)
	}
}

proc draw_clock_preview(x: int, y: int, width: int, height: int, accent: int) {
	var hour: int
	var minute: int
	var pm: bool
	var text_width: int
	var draw_x: int
	var draw_y: int
	var hour_tens: char
	var hour_ones: char
	var minute_tens: char
	var minute_ones: char
	var font_size: int
	var glyph_height: int
	if (width < 27 || height < 13) { return }
	font_size = graphics::FONT_SMALL
	glyph_height = 5
	if (width >= 46 && height >= 18) {
		font_size = graphics::FONT_NORMAL
		glyph_height = 7
	}
	hour = os::hour()
	minute = os::minute()
	pm = hour >= 12
	if (staged_clock == os::CLOCK_12_HOUR) {
		hour = hour % 12
		if (hour == 0) { hour = 12 }
	}
	hour_tens = (char)(48 + hour / 10)
	hour_ones = (char)(48 + hour % 10)
	minute_tens = (char)(48 + minute / 10)
	minute_ones = (char)(48 + minute % 10)
	text_width = graphics::char_advance(hour_ones, font_size)
	if (staged_clock == os::CLOCK_24_HOUR || hour >= 10) { text_width += graphics::char_advance(hour_tens, font_size) }
	text_width += graphics::char_advance(':', font_size)
	text_width += graphics::char_advance(minute_tens, font_size)
	text_width += graphics::char_advance(minute_ones, font_size)
	if (staged_clock == os::CLOCK_12_HOUR && width >= 42) {
		text_width += graphics::char_advance(' ', font_size)
		text_width += graphics::char_advance('A', font_size)
		text_width += graphics::char_advance('M', font_size)
	}
	draw_x = x + (width - text_width) / 2
	draw_y = y + (height - glyph_height) / 2
	call draw_preview_box(x, y, width, height, os::CORNER_ROUNDED, graphics::COLOR_1, accent)
	if (staged_clock == os::CLOCK_24_HOUR || hour >= 10) {
		if (font_size == graphics::FONT_SMALL) { call graphics::draw_char_small(settings_window, draw_x, draw_y, hour_tens, graphics::WHITE) }
		else { call graphics::draw_char(settings_window, draw_x, draw_y, hour_tens, graphics::WHITE) }
		draw_x += graphics::char_advance(hour_tens, font_size)
	}
	if (font_size == graphics::FONT_SMALL) { call graphics::draw_char_small(settings_window, draw_x, draw_y, hour_ones, graphics::WHITE) }
	else { call graphics::draw_char(settings_window, draw_x, draw_y, hour_ones, graphics::WHITE) }
	draw_x += graphics::char_advance(hour_ones, font_size)
	if (font_size == graphics::FONT_SMALL) { call graphics::draw_char_small(settings_window, draw_x, draw_y, ':', accent) }
	else { call graphics::draw_char(settings_window, draw_x, draw_y, ':', accent) }
	draw_x += graphics::char_advance(':', font_size)
	if (font_size == graphics::FONT_SMALL) { call graphics::draw_char_small(settings_window, draw_x, draw_y, minute_tens, graphics::WHITE) }
	else { call graphics::draw_char(settings_window, draw_x, draw_y, minute_tens, graphics::WHITE) }
	draw_x += graphics::char_advance(minute_tens, font_size)
	if (font_size == graphics::FONT_SMALL) { call graphics::draw_char_small(settings_window, draw_x, draw_y, minute_ones, graphics::WHITE) }
	else { call graphics::draw_char(settings_window, draw_x, draw_y, minute_ones, graphics::WHITE) }
	draw_x += graphics::char_advance(minute_ones, font_size)
	if (staged_clock == os::CLOCK_12_HOUR && width >= 42) {
		draw_x += graphics::char_advance(' ', font_size)
		if (font_size == graphics::FONT_SMALL) {
			if (pm) { call graphics::draw_char_small(settings_window, draw_x, draw_y, 'P', accent) }
			else { call graphics::draw_char_small(settings_window, draw_x, draw_y, 'A', accent) }
		}
		else {
			if (pm) { call graphics::draw_char(settings_window, draw_x, draw_y, 'P', accent) }
			else { call graphics::draw_char(settings_window, draw_x, draw_y, 'A', accent) }
		}
		draw_x += graphics::char_advance('A', font_size)
		if (font_size == graphics::FONT_SMALL) { call graphics::draw_char_small(settings_window, draw_x, draw_y, 'M', accent) }
		else { call graphics::draw_char(settings_window, draw_x, draw_y, 'M', accent) }
	}
}

proc draw_time_preview(x: int, y: int, width: int, height: int) {
	if (width < 27 || height < 13) { return }
	if (width > 260) {
		x += (width - 260) / 2
		width = 260
	}
	if (height > 96) {
		y += (height - 96) / 2
		height = 96
	}
	call draw_clock_preview(x, y, width, height, settings_preview_accent())
}

proc draw_settings_icon(x: int, y: int, tab: int) {
	var icon: string
	if (tab == 0) {
		icon = "....B......B3.F.BBB33.8F33333..F33333..F88833.F8...83.8.....8..."
	}
	elseif (tab == 1) {
		icon = "BBBBB.BB3888.33.3...33833...88.33333333388833888..3333....8888.."
	}
	elseif (tab == 2) {
		icon = "..BBBB...B8888B.B8.FF.8B3..F...33......3.3....3..833338...8888.."
	}
	else {
		icon = "BB.BB.BB83.33.38.833338.3338833388333388.383383.33.33.3388.88.88"
	}
	call graphics::draw_icon(settings_window, x, y, 8, 8, icon)
}

var staged_master: int
var staged_master_baseline: int
var staged_master_dirty: bool
var staged_music: int
var staged_effects: int
var staged_background: int
var staged_palette: int
var staged_theme: int
var staged_corners: int
var staged_clock: int
var staged_enabled: bool
var staged_motion_blur: bool
var staged_anti_aliasing: int
var background_count: int
var palette_count: int
var palette_group_count: int
var content_width: int
var content_height: int
var panel_x: int
var panel_width: int
var panel_height: int
var layout_panel_width: int
var control_x: int
var control_width: int
var action_width: int
var action_y: int
var active_tab: int
var drawer_open: bool
var drawer_progress: int
var drawer_eased: int
var drawer_width: int
var drawer_height: int
var drawer_target_width: int
var drawer_compact: bool
var applied: bool
var apply_failed: bool
var drawer_surface: int
var drawer_foreground: int
var previous_ticks: int
var current_ticks: int
var delta_ms: int
var fixed_update_accumulator: int
var frame_steps: int
var drawer_step: int
var drawer_scroll: int
var drawer_scroll_maximum: int
var drawer_item_y: int
var drawer_scroll_delta: int
var page_scroll: int
var page_scroll_maximum: int
var page_scroll_tab: int
var settings_pointer_x: int
var settings_pointer_y: int

fn settings_compact_row_visible(row_y: int, row_height: int, viewport_top: int, viewport_bottom: int) bool {
	return row_y >= viewport_top && row_y + row_height <= viewport_bottom
}

proc draw_settings_scroll_arrow(x: int, y: int, down: bool, color: int) {
	if (down) {
		call graphics::draw_line(settings_window, x, y, x + 2, y + 2, color)
		call graphics::draw_line(settings_window, x + 2, y + 2, x + 4, y, color)
	}
	else {
		call graphics::draw_line(settings_window, x, y + 2, x + 2, y, color)
		call graphics::draw_line(settings_window, x + 2, y, x + 4, y + 2, color)
	}
}

proc draw_scrollable_compact_page() {
	var page_total: int
	var viewport_top: int
	var viewport_bottom: int
	var page_y: int
	var page_control_width: int
	var pointer_x: int
	var pointer_y: int
	var scroll_value: int
	viewport_top = 5
	viewport_bottom = 4 + panel_height
	page_total = 50
	if (active_tab == 0) { page_total = 76 }
	elseif (active_tab == 1) { page_total = 68 }
	page_scroll_maximum = page_total - (panel_height - 2)
	if (page_scroll_maximum < 0) { page_scroll_maximum = 0 }
	if (page_scroll_tab != active_tab) {
		page_scroll = 0
		page_scroll_tab = active_tab
	}
	pointer_x = graphics::pointer_x(settings_window)
	pointer_y = graphics::pointer_y(settings_window)
	if (pointer_x >= panel_x && pointer_x < panel_x + panel_width && pointer_y >= viewport_top && pointer_y < viewport_bottom) {
		scroll_value = graphics::scroll_delta()
		if (scroll_value != 0) { page_scroll -= scroll_value * 7 }
	}
	if (page_scroll < 0) { page_scroll = 0 }
	if (page_scroll > page_scroll_maximum) { page_scroll = page_scroll_maximum }
	page_control_width = panel_width - 9
	if (page_control_width < 4) { page_control_width = 4 }
	call graphics::fill_rect(settings_window, panel_x, 4, panel_width, panel_height, graphics::COLOR_1)

	page_y = 7 - page_scroll
	if (settings_compact_row_visible(page_y, 5, viewport_top, viewport_bottom)) {
		if (active_tab == 0) { call graphics::draw_text_small(settings_window, panel_x + 3, page_y, "Sound", graphics::WHITE) }
		elseif (active_tab == 1) { call graphics::draw_text_small(settings_window, panel_x + 3, page_y, "Personalization", graphics::WHITE) }
		elseif (active_tab == 2) { call graphics::draw_text_small(settings_window, panel_x + 3, page_y, "Time", graphics::WHITE) }
		else { call graphics::draw_text_small(settings_window, panel_x + 3, page_y, "System", graphics::WHITE) }
	}

	if (active_tab == 0) {
		page_y = 14 - page_scroll
		if (settings_compact_row_visible(page_y, 5, viewport_top, viewport_bottom)) { call graphics::draw_text_small(settings_window, panel_x + 3, page_y, "Master", graphics::COLOR_7) }
		page_y = 20 - page_scroll
		if (settings_compact_row_visible(page_y, 5, viewport_top, viewport_bottom)) { call set_staged_master_volume(graphics::slider(settings_window, panel_x + 3, page_y, page_control_width, staged_master, 0, 100)) }
		page_y = 29 - page_scroll
		if (settings_compact_row_visible(page_y, 5, viewport_top, viewport_bottom)) { call graphics::draw_text_small(settings_window, panel_x + 3, page_y, "Music", graphics::COLOR_7) }
		page_y = 35 - page_scroll
		if (settings_compact_row_visible(page_y, 5, viewport_top, viewport_bottom)) { staged_music = graphics::slider(settings_window, panel_x + 3, page_y, page_control_width, staged_music, 0, 100) }
		page_y = 44 - page_scroll
		if (settings_compact_row_visible(page_y, 5, viewport_top, viewport_bottom)) { call graphics::draw_text_small(settings_window, panel_x + 3, page_y, "Effects", graphics::COLOR_7) }
		page_y = 50 - page_scroll
		if (settings_compact_row_visible(page_y, 5, viewport_top, viewport_bottom)) { staged_effects = graphics::slider(settings_window, panel_x + 3, page_y, page_control_width, staged_effects, 0, 100) }
		page_y = 59 - page_scroll
	}
	elseif (active_tab == 1) {
		page_y = 15 - page_scroll
		if (settings_compact_row_visible(page_y, 7, viewport_top, viewport_bottom)) {
			if (staged_theme == os::THEME_DARK) {
				if (settings_flat_button_aligned(panel_x + 3, page_y, page_control_width, 7, "Dark theme", graphics::COLOR_8, graphics::WHITE)) { call toggle_staged_theme() }
			}
			else {
				if (settings_flat_button_aligned(panel_x + 3, page_y, page_control_width, 7, "Light theme", graphics::COLOR_8, graphics::WHITE)) { call toggle_staged_theme() }
			}
		}
		page_y = 24 - page_scroll
		if (settings_compact_row_visible(page_y, 7, viewport_top, viewport_bottom) && settings_flat_button_aligned(panel_x + 3, page_y, page_control_width, 7, "Background", graphics::COLOR_8, graphics::WHITE)) { staged_background = next_setting_id(staged_background, background_count) }
		page_y = 33 - page_scroll
		if (settings_compact_row_visible(page_y, 7, viewport_top, viewport_bottom) && settings_flat_button_aligned(panel_x + 3, page_y, page_control_width, 7, "Palette", graphics::COLOR_8, graphics::WHITE)) { call select_next_palette() }
		page_y = 42 - page_scroll
		if (settings_compact_row_visible(page_y, 7, viewport_top, viewport_bottom)) {
			if (staged_corners == os::CORNER_SQUARE) { if (settings_flat_button_aligned(panel_x + 3, page_y, page_control_width, 7, "Square corners", graphics::COLOR_8, graphics::WHITE)) { staged_corners = os::CORNER_ROUNDED } }
			else { if (settings_flat_button_aligned(panel_x + 3, page_y, page_control_width, 7, "Rounded corners", graphics::COLOR_8, graphics::WHITE)) { staged_corners = os::CORNER_SQUARE } }
		}
		page_y = 51 - page_scroll
	}
	elseif (active_tab == 2) {
		page_y = 15 - page_scroll
		if (settings_compact_row_visible(page_y, 7, viewport_top, viewport_bottom)) {
			if (staged_clock == os::CLOCK_24_HOUR) { if (settings_flat_button_aligned(panel_x + 3, page_y, page_control_width, 7, "24 hour clock", graphics::COLOR_8, graphics::WHITE)) { staged_clock = os::CLOCK_12_HOUR } }
			else { if (settings_flat_button_aligned(panel_x + 3, page_y, page_control_width, 7, "12 hour clock", graphics::COLOR_8, graphics::WHITE)) { staged_clock = os::CLOCK_24_HOUR } }
		}
		page_y = 24 - page_scroll
	}
	else {
		page_y = 15 - page_scroll
		if (settings_compact_row_visible(page_y, 7, viewport_top, viewport_bottom)) {
			if (staged_motion_blur) { if (settings_flat_button_aligned_width(panel_x + 3, page_y, page_control_width, 7, "Motion blur on", LABEL_WIDTH_MOTION_ON_SMALL, graphics::COLOR_8, graphics::WHITE)) { staged_motion_blur = false } }
			else { if (settings_flat_button_aligned_width(panel_x + 3, page_y, page_control_width, 7, "Motion blur off", LABEL_WIDTH_MOTION_OFF_SMALL, graphics::COLOR_8, graphics::WHITE)) { staged_motion_blur = true } }
		}
		page_y = 24 - page_scroll
		if (settings_compact_row_visible(page_y, 7, viewport_top, viewport_bottom)) {
			if (settings_flat_button_aligned_width(panel_x + 3, page_y, page_control_width, 7, anti_aliasing_label(), anti_aliasing_label_width(true), graphics::COLOR_8, graphics::WHITE)) { call select_next_anti_aliasing() }
		}
		page_y = 33 - page_scroll
	}

	if (settings_compact_row_visible(page_y, 7, viewport_top, viewport_bottom) && settings_button_aligned_width(panel_x + 3, page_y, page_control_width, 7, settings_apply_label(), LABEL_WIDTH_APPLY_SMALL, settings_apply_color())) {
		call apply_staged_settings()
	}
	page_y += 8
	if (settings_compact_row_visible(page_y, 7, viewport_top, viewport_bottom) && settings_button_aligned_width(panel_x + 3, page_y, page_control_width, 7, "Cancel", LABEL_WIDTH_CANCEL_SMALL, graphics::COLOR_5)) {
		call cancel_staged_settings()
	}

	if (page_scroll > 0 && panel_width >= 12 && panel_height >= 8) {
		if (graphics::button_flat(settings_window, panel_x + panel_width - 6, viewport_top, 5, 6, " ", graphics::COLOR_8)) { page_scroll -= 7 }
		call draw_settings_scroll_arrow(panel_x + panel_width - 6, viewport_top + 1, false, graphics::WHITE)
	}
	if (page_scroll < page_scroll_maximum && panel_width >= 12 && panel_height >= 8) {
		if (graphics::button_flat(settings_window, panel_x + panel_width - 6, viewport_bottom - 6, 5, 6, " ", graphics::COLOR_8)) { page_scroll += 7 }
		call draw_settings_scroll_arrow(panel_x + panel_width - 6, viewport_bottom - 4, true, graphics::WHITE)
	}
	if (page_scroll < 0) { page_scroll = 0 }
	if (page_scroll > page_scroll_maximum) { page_scroll = page_scroll_maximum }
}

proc accumulate_frame_time(elapsed_ms: int) {
	delta_ms = elapsed_ms
	if (delta_ms < 0) { delta_ms = 0 }
	if (delta_ms > MAX_FRAME_DELTA_MS) { delta_ms = MAX_FRAME_DELTA_MS }
	fixed_update_accumulator += delta_ms * FIXED_UPDATE_HZ
	frame_steps = fixed_update_accumulator / MILLISECONDS_PER_SECOND
	fixed_update_accumulator %= MILLISECONDS_PER_SECOND
}

proc update_settings_animation() {
	current_ticks = os::ticks()
	call accumulate_frame_time(current_ticks - previous_ticks)
	previous_ticks = current_ticks
	drawer_step = frame_steps * 8
}

proc measure_settings_layout() {
	content_width = graphics::content_width(settings_window)
	content_height = graphics::content_height(settings_window)
	settings_pointer_x = graphics::pointer_x(settings_window)
	settings_pointer_y = graphics::pointer_y(settings_window)
	drawer_surface = graphics::COLOR_8
	drawer_foreground = graphics::WHITE
	if (os::theme_mode == os::THEME_LIGHT) {
		drawer_surface = graphics::COLOR_7
		drawer_foreground = graphics::COLOR_1
	}
	if (drawer_open && drawer_progress < 100) {
		drawer_progress += drawer_step
		if (drawer_progress > 100) { drawer_progress = 100 }
	}
	elseif (!drawer_open && drawer_progress > 0) {
		drawer_progress -= drawer_step
		if (drawer_progress < 0) { drawer_progress = 0 }
	}
	drawer_target_width = 100
	if (content_width < 180) { drawer_target_width = content_width / 2 }
	elseif (drawer_target_width > content_width - 72) { drawer_target_width = content_width - 72 }
	if (drawer_target_width < 14) { drawer_target_width = 14 }
	drawer_height = content_height - 8
	if (drawer_height < 9) { drawer_height = 9 }
	drawer_compact = drawer_target_width < 76 || drawer_height < 45
	drawer_eased = ease_menu(drawer_progress)
	drawer_width = 14 + (drawer_target_width - 14) * drawer_eased / 100
	panel_x = drawer_width + 8
	panel_width = content_width - panel_x - 4
	if (panel_width < 8) { panel_width = 8 }
	panel_height = content_height - 8
	if (panel_height < 1) { panel_height = 1 }
	layout_panel_width = content_width - drawer_target_width - 12
	if (layout_panel_width < 8) { layout_panel_width = 8 }
	control_x = panel_x + 4
	control_width = panel_width - 8
	if (control_width < 4) { control_width = 4 }
}

proc draw_drawer_tab(tab: int, y: int, height: int, label: string, label_width: int) {
	if (settings_flat_button_aligned_width(8, y, drawer_width - 12, height, label, label_width, drawer_surface, drawer_foreground)) {
		active_tab = tab
		drawer_open = false
	}
}

proc draw_settings_drawer() {
	if (drawer_progress > 0) { call graphics::fill_rect(settings_window, 4, 4, drawer_width, drawer_height, drawer_surface) }
	if (drawer_open) {
		if (graphics::button_flat(settings_window, 4, 4, 14, 9, " ", drawer_surface)) {
			drawer_open = false
		}
		call draw_menu_arrow(9, 7, true, drawer_foreground)
	}
	else {
		if (graphics::button_flat(settings_window, 4, 4, 14, 9, " ", drawer_surface)) {
			drawer_open = true
		}
		call draw_menu_arrow(9, 6, false, drawer_foreground)
	}

	drawer_scroll_maximum = 37 - drawer_height
	if (drawer_scroll_maximum < 0) { drawer_scroll_maximum = 0 }
	if (drawer_scroll_maximum > 28) { drawer_scroll_maximum = 28 }
	if (drawer_open && drawer_progress == 100 && drawer_compact && drawer_width >= 40 && settings_pointer_x >= 4 && settings_pointer_x < 4 + drawer_width && settings_pointer_y >= 13 && settings_pointer_y < 4 + drawer_height) {
		drawer_scroll_delta = graphics::scroll_delta()
		if (drawer_scroll_delta != 0) { drawer_scroll -= drawer_scroll_delta * 7 }
	}
	if (drawer_scroll < 0) { drawer_scroll = 0 }
	if (drawer_scroll > drawer_scroll_maximum) { drawer_scroll = drawer_scroll_maximum }
	if (drawer_open && drawer_progress == 100 && drawer_compact && drawer_width >= 40) {
		drawer_item_y = 13 - drawer_scroll
		if (drawer_item_y >= 13 && drawer_item_y + 7 <= 4 + drawer_height) { call draw_drawer_tab(0, drawer_item_y, 7, "Sound", LABEL_WIDTH_SOUND_SMALL) }
		drawer_item_y = 20 - drawer_scroll
		if (drawer_item_y >= 13 && drawer_item_y + 7 <= 4 + drawer_height) { call draw_drawer_tab(1, drawer_item_y, 7, "Theme", LABEL_WIDTH_THEME_SMALL) }
		drawer_item_y = 27 - drawer_scroll
		if (drawer_item_y >= 13 && drawer_item_y + 7 <= 4 + drawer_height) { call draw_drawer_tab(2, drawer_item_y, 7, "Time", LABEL_WIDTH_TIME_SMALL) }
		drawer_item_y = 34 - drawer_scroll
		if (drawer_item_y >= 13 && drawer_item_y + 7 <= 4 + drawer_height) { call draw_drawer_tab(3, drawer_item_y, 7, "System", LABEL_WIDTH_SYSTEM_SMALL) }
	}
	elseif (drawer_open && drawer_progress == 100 && drawer_width >= 76) {
		if (drawer_height >= 18) { call draw_drawer_tab(0, 13, 9, "Sound", -1) }
		if (drawer_height >= 27) { call draw_drawer_tab(1, 22, 9, "Personalization", -1) }
		if (drawer_height >= 36) { call draw_drawer_tab(2, 31, 9, "Time", -1) }
		if (drawer_height >= 45) { call draw_drawer_tab(3, 40, 9, "System", LABEL_WIDTH_SYSTEM_SMALL) }
	}

}

proc draw_settings_panel_surface() {
	call graphics::fill_rect(settings_window, panel_x, 4, panel_width, panel_height, graphics::COLOR_1)
}

proc draw_settings_actions(x: int, y: int, width: int, height: int, gap: int) {
	var apply_width: int
	var cancel_width: int
	apply_width = LABEL_WIDTH_APPLY_NORMAL
	cancel_width = LABEL_WIDTH_CANCEL_NORMAL
	if (height < 7) {
		apply_width = LABEL_WIDTH_APPLY_SMALL
		cancel_width = LABEL_WIDTH_CANCEL_SMALL
	}
	if (settings_button_aligned_width(x, y, width, height, settings_apply_label(), apply_width, settings_apply_color())) {
		call apply_staged_settings()
	}
	if (settings_button_aligned_width(x + width + gap, y, width, height, "Cancel", cancel_width, graphics::COLOR_5)) {
		call cancel_staged_settings()
	}
}

proc draw_standard_sound_settings() {
	call graphics::draw_text(settings_window, panel_x + 16, 8, "Sound", graphics::COLOR_3)
	call draw_value_line("Master", 31, staged_master, panel_x + 4, panel_width - 8)
	call set_staged_master_volume(graphics::slider(settings_window, control_x, 39, control_width, staged_master, 0, 100))
	call draw_value_line("Music", 55, staged_music, panel_x + 4, panel_width - 8)
	staged_music = graphics::slider(settings_window, control_x, 63, control_width, staged_music, 0, 100)
	call draw_value_line("Effects", 79, staged_effects, panel_x + 4, panel_width - 8)
	staged_effects = graphics::slider(settings_window, control_x, 87, control_width, staged_effects, 0, 100)
}

proc draw_standard_personalization_settings() {
	call graphics::draw_text(settings_window, panel_x + 16, 8, "Personalization", graphics::COLOR_3)
	call graphics::draw_text(settings_window, panel_x + 4, 23, "Theme", graphics::COLOR_7)
	if (staged_theme == os::THEME_DARK) {
		if (settings_button_aligned(panel_x + panel_width - 50, 19, 46, 11, "Dark", graphics::COLOR_5)) {
			call toggle_staged_theme()
		}
	}
	else {
		if (settings_button_aligned(panel_x + panel_width - 50, 19, 46, 11, "Light", graphics::COLOR_7)) {
			call toggle_staged_theme()
		}
	}
	call graphics::draw_text(settings_window, panel_x + 4, 43, "Background", graphics::COLOR_7)
	call graphics::draw_int(settings_window, panel_x + panel_width - 55, 43, staged_background, graphics::COLOR_14)
	if (draw_step_button(panel_x + panel_width - 34, 41, false)) {
		staged_background = previous_setting_id(staged_background, background_count)
	}
	if (draw_step_button(panel_x + panel_width - 18, 41, true)) {
		staged_background = next_setting_id(staged_background, background_count)
	}
	call graphics::draw_text(settings_window, panel_x + 4, 63, "Palette", graphics::COLOR_7)
	call graphics::draw_int(settings_window, panel_x + panel_width - 55, 63, staged_palette, graphics::COLOR_14)
	if (draw_step_button(panel_x + panel_width - 34, 61, false)) { call select_previous_palette() }
	if (draw_step_button(panel_x + panel_width - 18, 61, true)) { call select_next_palette() }
	call graphics::draw_text(settings_window, panel_x + 4, 83, "Corner style", graphics::COLOR_7)
	if (staged_corners == os::CORNER_SQUARE) {
		if (settings_button_aligned(panel_x + panel_width - 74, 79, 70, 11, "Square", graphics::COLOR_5)) { staged_corners = os::CORNER_ROUNDED }
	}
	else {
		if (settings_button_aligned(panel_x + panel_width - 74, 79, 70, 11, "Rounded", graphics::COLOR_5)) { staged_corners = os::CORNER_SQUARE }
	}
	call draw_palette_background_preview(panel_x + 8, 99, panel_width - 16, action_y - 103)
}

proc draw_standard_time_settings() {
	call graphics::draw_text(settings_window, panel_x + 16, 8, "Time", graphics::COLOR_3)
	call graphics::draw_text(settings_window, panel_x + 4, 23, "Clock format", graphics::COLOR_7)
	if (staged_clock == os::CLOCK_24_HOUR) {
		if (settings_button_aligned(panel_x + 4, 33, panel_width - 8, 11, "24 hour", graphics::COLOR_5)) { staged_clock = os::CLOCK_12_HOUR }
	}
	else {
		if (settings_button_aligned(panel_x + 4, 33, panel_width - 8, 11, "12 hour", graphics::COLOR_5)) { staged_clock = os::CLOCK_24_HOUR }
	}
	call draw_time_preview(panel_x + 8, 51, panel_width - 16, action_y - 55)
}

proc draw_standard_system_settings() {
	call graphics::draw_text(settings_window, panel_x + 16, 8, "System", graphics::COLOR_3)
	call graphics::draw_text(settings_window, panel_x + 4, 23, "Motion blur", graphics::COLOR_7)
	if (staged_motion_blur) {
		if (settings_button_aligned_width(control_x, 34, control_width, 11, "On", LABEL_WIDTH_ON_NORMAL, graphics::COLOR_2)) { staged_motion_blur = false }
	}
	else {
		if (settings_button_aligned_width(control_x, 34, control_width, 11, "OFF", LABEL_WIDTH_OFF_NORMAL, graphics::COLOR_5)) { staged_motion_blur = true }
	}
	call graphics::draw_text(settings_window, panel_x + 4, 54, "Anti-aliasing", graphics::COLOR_7)
	if (staged_anti_aliasing == os::ANTI_ALIASING_OFF) {
		if (settings_button_aligned_width(control_x, 65, control_width, 11, anti_aliasing_label(), anti_aliasing_label_width(false), graphics::COLOR_5)) { call select_next_anti_aliasing() }
	}
	elseif (staged_anti_aliasing == os::ANTI_ALIASING_FAST) {
		if (settings_button_aligned_width(control_x, 65, control_width, 11, anti_aliasing_label(), anti_aliasing_label_width(false), graphics::COLOR_2)) { call select_next_anti_aliasing() }
	}
	else {
		if (settings_button_aligned_width(control_x, 65, control_width, 11, anti_aliasing_label(), anti_aliasing_label_width(false), graphics::COLOR_3)) { call select_next_anti_aliasing() }
	}
}

proc draw_standard_settings_page() {
	call draw_settings_panel_surface()
	action_y = content_height - 16
	action_width = (panel_width - 10) / 2
	call draw_settings_icon(panel_x + 4, 8, active_tab)
	if (active_tab == 0) { call draw_standard_sound_settings() }
	elseif (active_tab == 1) { call draw_standard_personalization_settings() }
	elseif (active_tab == 2) { call draw_standard_time_settings() }
	else { call draw_standard_system_settings() }
	call draw_settings_actions(panel_x + 4, action_y, action_width, 11, 2)
}

proc draw_compact_sound_settings() {
	call graphics::draw_text_small(settings_window, panel_x + 3, 7, "Sound", graphics::WHITE)
	call graphics::draw_text_small(settings_window, panel_x + 3, 14, "Master", graphics::COLOR_7)
	call set_staged_master_volume(graphics::slider(settings_window, control_x, 20, control_width, staged_master, 0, 100))
	if (content_height >= 45) {
		call graphics::draw_text_small(settings_window, panel_x + 3, 26, "Music", graphics::COLOR_7)
		staged_music = graphics::slider(settings_window, control_x, 32, control_width, staged_music, 0, 100)
	}
	if (content_height >= 58) {
		call graphics::draw_text_small(settings_window, panel_x + 3, 38, "Effects", graphics::COLOR_7)
		staged_effects = graphics::slider(settings_window, control_x, 44, control_width, staged_effects, 0, 100)
	}
}

proc draw_compact_personalization_settings() {
	call graphics::draw_text_small(settings_window, panel_x + 3, 7, "Personalization", graphics::WHITE)
	if (staged_theme == os::THEME_DARK) {
		if (settings_flat_button_aligned(control_x, 15, control_width, 7, "Dark theme", graphics::COLOR_8, graphics::WHITE)) { call toggle_staged_theme() }
	}
	else {
		if (settings_flat_button_aligned(control_x, 15, control_width, 7, "Light theme", graphics::COLOR_8, graphics::WHITE)) { call toggle_staged_theme() }
	}
	if (content_height >= 43) {
		if (settings_flat_button_aligned(control_x, 24, control_width, 7, "Background", graphics::COLOR_8, graphics::WHITE)) { staged_background = next_setting_id(staged_background, background_count) }
		if (settings_flat_button_aligned(control_x, 33, control_width, 7, "Palette", graphics::COLOR_8, graphics::WHITE)) { call select_next_palette() }
	}
	if (content_height >= 52) {
		if (staged_corners == os::CORNER_SQUARE) {
			if (settings_flat_button_aligned(control_x, 42, control_width, 7, "Square corners", graphics::COLOR_8, graphics::WHITE)) { staged_corners = os::CORNER_ROUNDED }
		}
		else {
			if (settings_flat_button_aligned(control_x, 42, control_width, 7, "Rounded corners", graphics::COLOR_8, graphics::WHITE)) { staged_corners = os::CORNER_SQUARE }
		}
	}
	if (action_y >= 71) { call draw_palette_background_preview(panel_x + 5, 51, panel_width - 10, action_y - 55) }
}

proc draw_compact_time_settings() {
	call graphics::draw_text_small(settings_window, panel_x + 3, 7, "Time", graphics::WHITE)
	if (staged_clock == os::CLOCK_24_HOUR) {
		if (settings_flat_button_aligned(control_x, 15, control_width, 7, "24 hour clock", graphics::COLOR_8, graphics::WHITE)) { staged_clock = os::CLOCK_12_HOUR }
	}
	else {
		if (settings_flat_button_aligned(control_x, 15, control_width, 7, "12 hour clock", graphics::COLOR_8, graphics::WHITE)) { staged_clock = os::CLOCK_24_HOUR }
	}
	if (action_y >= 49) { call draw_time_preview(panel_x + 5, 25, panel_width - 10, action_y - 29) }
}

proc draw_compact_system_settings() {
	call graphics::draw_text_small(settings_window, panel_x + 3, 7, "System", graphics::WHITE)
	if (staged_motion_blur) {
		if (settings_flat_button_aligned_width(control_x, 15, control_width, 7, "Motion blur on", LABEL_WIDTH_MOTION_ON_SMALL, graphics::COLOR_8, graphics::WHITE)) { staged_motion_blur = false }
	}
	else {
		if (settings_flat_button_aligned_width(control_x, 15, control_width, 7, "Motion blur off", LABEL_WIDTH_MOTION_OFF_SMALL, graphics::COLOR_8, graphics::WHITE)) { staged_motion_blur = true }
	}
	if (staged_anti_aliasing == os::ANTI_ALIASING_OFF) {
		if (settings_flat_button_aligned_width(control_x, 24, control_width, 7, anti_aliasing_label(), anti_aliasing_label_width(true), graphics::COLOR_8, graphics::WHITE)) { call select_next_anti_aliasing() }
	}
	elseif (staged_anti_aliasing == os::ANTI_ALIASING_FAST) {
		if (settings_flat_button_aligned_width(control_x, 24, control_width, 7, anti_aliasing_label(), anti_aliasing_label_width(true), graphics::COLOR_8, graphics::WHITE)) { call select_next_anti_aliasing() }
	}
	else {
		if (settings_flat_button_aligned_width(control_x, 24, control_width, 7, anti_aliasing_label(), anti_aliasing_label_width(true), graphics::COLOR_8, graphics::WHITE)) { call select_next_anti_aliasing() }
	}
}

proc draw_compact_settings_page() {
	call draw_settings_panel_surface()
	action_y = content_height - 9
	action_width = (panel_width - 7) / 2
	if (active_tab == 0) { call draw_compact_sound_settings() }
	elseif (active_tab == 1) { call draw_compact_personalization_settings() }
	elseif (active_tab == 2) { call draw_compact_time_settings() }
	else { call draw_compact_system_settings() }
	call draw_settings_actions(panel_x + 3, action_y, action_width, 6, 1)
}

proc draw_settings_page() {
	if (layout_panel_width >= 142 && panel_height >= 126) { call draw_standard_settings_page() }
	elseif (panel_height < 32 || layout_panel_width < 44 || (active_tab == 3 && panel_height < 34)) { call draw_scrollable_compact_page() }
	else { call draw_compact_settings_page() }
	call draw_settings_drawer()
}

proc draw_settings_content() {
	call synchronize_master_volume()
	call measure_settings_layout()
	call graphics::fill_rect(settings_window, 0, 0, content_width, content_height, graphics::COLOR_1)
	call draw_settings_page()
}

proc draw_settings_frame() {
	call update_settings_animation()
	call graphics::begin_draw(settings_window)
	if (!settings_window.is_minimized()) { call draw_settings_content() }
	call graphics::update(settings_window)
}

# Keep the legacy ABI field pinned to opaque windows.
os::window_transparency = 0
call os::clear_preview()
call reload_os_settings(&staged_master, &staged_music, &staged_effects, &staged_background, &staged_palette, &staged_theme, &staged_corners, &staged_clock, &staged_enabled, &staged_motion_blur, &staged_anti_aliasing)
staged_master_baseline = staged_master
staged_master_dirty = false
background_count = os::background_count()
palette_count = os::palette_count()
palette_group_count = palette_count / 2
if (palette_group_count < 1) { palette_group_count = 1 }
active_tab = 0
drawer_open = false
drawer_progress = 0
drawer_scroll = 0
apply_failed = false
page_scroll = 0
page_scroll_maximum = 0
page_scroll_tab = -1
# Application driver.
settings_window.x = 48
settings_window.y = 34
settings_window.width = APP_DEFAULT_WIDTH
settings_window.height = APP_DEFAULT_HEIGHT
settings_window.title = APP_TITLE
settings_window.ui_scale = 1
settings_window.state = graphics::WINDOW_NORMAL
previous_ticks = os::ticks()
fixed_update_accumulator = 0
frame_steps = 0

while (settings_window.state != graphics::WINDOW_CLOSED) {
	call draw_settings_frame()
}
call os::clear_preview()
